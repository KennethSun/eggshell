Q,IAAImrC,SAAS,cAAb,EAChB,CAAE,MAAOpqB,GACR,GAAsB,kBAAXnF,OAAqB,OAAOA,MACxC,CACA,CAPuB,E,eCAxB4tB,EAAoBuB,EAAI,SAASK,EAAKjuB,GAAQ,OAAOoB,OAAO8sB,UAAUC,eAAevB,KAAKqB,EAAKjuB,EAAO,C,eCCtGqsB,EAAoBjuC,EAAI,SAASouC,GACX,qBAAX4B,QAA0BA,OAAOC,aAC1CjtB,OAAOysB,eAAerB,EAAS4B,OAAOC,YAAa,CAAEn1C,MAAO,WAE7DkoB,OAAOysB,eAAerB,EAAS,aAAc,CAAEtzC,OAAO,GACvD,C,eCNAmzC,EAAoBiC,IAAM,SAAS7B,GAGlC,OAFAA,EAAO8B,MAAQ,GACV9B,EAAO+B,WAAU/B,EAAO+B,SAAW,IACjC/B,CACR,C,eCCA,IAAIgC,EAAkB,CACrB,IAAK,GAaNpC,EAAoBU,EAAEO,EAAI,SAASoB,GAAW,OAAoC,IAA7BD,EAAgBC,EAAgB,EAGrF,IAAIC,EAAuB,SAASC,EAA4BhsC,GAC/D,IAKI0pC,EAAUoC,EALV1B,EAAWpqC,EAAK,GAChBisC,EAAcjsC,EAAK,GACnBksC,EAAUlsC,EAAK,GAGI8F,EAAI,EAC3B,GAAGskC,EAASp0B,MAAK,SAAShM,GAAM,OAA+B,IAAxB6hC,EAAgB7hC,EAAW,IAAI,CACrE,IAAI0/B,KAAYuC,EACZxC,EAAoBuB,EAAEiB,EAAavC,KACrCD,EAAoBQ,EAAEP,GAAYuC,EAAYvC,IAGhD,GAAGwC,EAAS,IAAI/nB,EAAS+nB,EAAQzC,EAClC,CAEA,IADGuC,GAA4BA,EAA2BhsC,GACrD8F,EAAIskC,EAAS1qC,OAAQoG,IACzBgmC,EAAU1B,EAAStkC,GAChB2jC,EAAoBuB,EAAEa,EAAiBC,IAAYD,EAAgBC,IACrED,EAAgBC,GAAS,KAE1BD,EAAgBC,GAAW,EAE5B,OAAOrC,EAAoBU,EAAEhmB,EAC9B,EAEIgoB,EAAqBC,KAAK,4BAA8BA,KAAK,6BAA+B,GAChGD,EAAmBztB,QAAQqtB,EAAqBM,KAAK,KAAM,IAC3DF,EAAmBloC,KAAO8nC,EAAqBM,KAAK,KAAMF,EAAmBloC,KAAKooC,KAAKF,G,IC/CvF,IAAIG,EAAsB7C,EAAoBU,OAAElzB,EAAW,CAAC,MAAM,WAAa,OAAOwyB,EAAoB,KAAO,IACjH6C,EAAsB7C,EAAoBU,EAAEmC,E","sources":["webpack://vuetify-test/./src/App.vue","webpack://vuetify-test/./src/App.vue?7ccd","webpack://vuetify-test/./src/components/AppBrand.vue","webpack://vuetify-test/./src/components/AppBrand.vue?2bfe","webpack://vuetify-test/./src/components/CreateVideoDialog.vue","webpack://vuetify-test/./src/utils/CommonMethods.js","webpack://vuetify-test/./src/components/CreateVideoDialog.vue?c881","webpack://vuetify-test/./src/components/HomePage.vue","webpack://vuetify-test/./src/components/HomePage.vue?8b1a","webpack://vuetify-test/./src/components/CreateAudio.vue","webpack://vuetify-test/./src/components/CreateAudio.vue?2f89","webpack://vuetify-test/./src/components/EditVideoProject.vue","webpack://vuetify-test/./src/assets/variables.js","webpack://vuetify-test/./src/components/EditVideoProject.vue?bb6b","webpack://vuetify-test/./src/components/LoginPage.vue","webpack://vuetify-test/./src/components/LoginPage.vue?8d24","webpack://vuetify-test/./src/components/RegisterPage.vue","webpack://vuetify-test/./src/components/RegisterPage.vue?471c","webpack://vuetify-test/./src/components/ResetPasswordPage.vue","webpack://vuetify-test/./src/components/ResetPasswordPage.vue?702a","webpack://vuetify-test/./src/components/ChangePasswordPage.vue","webpack://vuetify-test/./src/components/ChangePasswordPage.vue?1ef0","webpack://vuetify-test/./src/router/index.js","webpack://vuetify-test/./src/locales/zh.js","webpack://vuetify-test/./src/locales/en.js","webpack://vuetify-test/./src/locales/i18n.js","webpack://vuetify-test/./src/plugins/vuetify.js","webpack://vuetify-test/./src/main.js","webpack://vuetify-test/webpack/bootstrap","webpack://vuetify-test/webpack/runtime/chunk loaded","webpack://vuetify-test/webpack/runtime/compat get default export","webpack://vuetify-test/webpack/runtime/define property getters","webpack://vuetify-test/webpack/runtime/global","webpack://vuetify-test/webpack/runtime/hasOwnProperty shorthand","webpack://vuetify-test/webpack/runtime/make namespace object","webpack://vuetify-test/webpack/runtime/node module decorator","webpack://vuetify-test/webpack/runtime/jsonp chunk loading","webpack://vuetify-test/webpack/startup"],"sourcesContent":["<template>\n  <v-app>\n    <v-main>\n      <router-view />\n    </v-main>\n  </v-app>\n</template>\n\n<script setup>\nimport { useTheme } from 'vuetify'\n\nconst theme = useTheme()\nconst savedTheme = localStorage.getItem('appTheme') || 'lightClean'\ntheme.global.name.value = savedTheme\n</script>\n","import script from \"./App.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./App.vue?vue&type=script&setup=true&lang=js\"\n\nconst __exports__ = script;\n\nexport default __exports__","<template>\r\n  <v-card\r\n    class=\"d-flex flex-column align-center pa-4 brand-card\"\r\n    elevation=\"0\"\r\n    :style=\"cardStyle\"\r\n     width=\"500\"\r\n  >\r\n                            <v-avatar class=\"ma-3\" rounded=\"0\" size=\"120\">\r\n    <!-- LOGO -->\r\n    <v-img\r\n      src=\"/eggshell.png\"\r\n      class=\"mb-3 brand-logo\"\r\n      alt=\"App Logo\"\r\n      contain\r\n    />\r\n                            </v-avatar>\r\n\r\n    <!-- 主宣传语 -->\r\n    <div\r\n      :class=\"[\r\n        'text-center font-weight-bold',\r\n        isSmall ? 'text-h5' : 'text-h3'\r\n      ]\"\r\n      :style=\"{ color: primaryTextColor }\"\r\n    >\r\n      {{ $t('mainSlogan') }}\r\n    </div>\r\n\r\n    <!-- 副宣传语 -->\r\n    <div\r\n      :class=\"[\r\n        'text-center mt-1',\r\n        isSmall ? 'text-h7' : 'text-h5'\r\n      ]\"\r\n      :style=\"{ color: secondaryTextColor }\"\r\n    >\r\n      {{ $t('secondSlogan') }}\r\n    </div>\r\n  </v-card>\r\n</template>\r\n\r\n<script setup>\r\n/* eslint-disable no-unused-vars */ \r\n/* eslint-disable no-undef */\r\nimport { computed } from 'vue'\r\nimport { useTheme } from 'vuetify'\r\n\r\n// ✅ 如果图片在 public 文件夹里\r\nconst props = defineProps({\r\n  size: { type: String, default: 'large' },\r\n  logoSrc: { type: String, default: '/eggshell2.ico' }, // ✅ 这里改为 public 的路径\r\n})\r\n\r\nconst isSmall = computed(() => props.size === 'small')\r\nconst theme = useTheme()\r\nconst isDark = computed(() => theme.global.current.value.dark)\r\n\r\n// ✅ 背景透明\r\nconst cardStyle = computed(() => ({\r\n  background: 'transparent',\r\n  borderRadius: '16px',\r\n  transition: 'transform 0.3s ease, box-shadow 0.3s ease',\r\n  animation: 'fadeIn 0.6s ease forwards',\r\n}))\r\n\r\nconst primaryTextColor = computed(() =>\r\n  isDark.value ? '#90caf9' : '#3f51b5'\r\n)\r\nconst secondaryTextColor = computed(() =>\r\n  isDark.value ? 'rgba(255, 255, 255, 0.7)' : 'rgba(0, 0, 0, 0.6)'\r\n)\r\n</script>\r\n\r\n<style scoped>\r\n.v-card {\r\n  border: none !important;\r\n}\r\n.brand-logo {\r\n  border-radius: 50%;\r\n  animation: float 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes float {\r\n  0%, 100% {\r\n    transform: translateY(0);\r\n  }\r\n  50% {\r\n    transform: translateY(-4px);\r\n  }\r\n}\r\n\r\n@keyframes fadeIn {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(12px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n</style>\r\n","import script from \"./AppBrand.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./AppBrand.vue?vue&type=script&setup=true&lang=js\"\n\nimport \"./AppBrand.vue?vue&type=style&index=0&id=01013beb&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['__scopeId',\"data-v-01013beb\"]])\n\nexport default __exports__","<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"600\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h6\">{{ $t('newVideoProject') }}</v-card-title>\r\n\r\n      <v-card-text>\r\n        <!-- 名称 -->\r\n        <v-text-field\r\n          v-model=\"newSequence.name\"\r\n          :label=\"$t('projectName')\"\r\n          :rules=\"[validateName]\"\r\n          clearable\r\n        />\r\n\r\n        <!-- 路径 + 浏览按钮 -->\r\n        <v-row dense>\r\n          <v-col cols=\"9\">\r\n            <v-text-field\r\n              v-model=\"newSequence.path\"\r\n              :label=\"$t('path')\"\r\n              clearable\r\n              :error=\"!!pathError\"\r\n              :error-messages=\"pathError\"\r\n            />\r\n          </v-col>\r\n          <v-col cols=\"3\">\r\n            <v-btn color=\"primary\" block @click=\"browsePath\">{{ $t('browseButton') }}</v-btn>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <!-- 宽度 + 高度 + 分辨率下拉框 -->\r\n        <v-row dense>\r\n          <v-col cols=\"3\">\r\n            <v-text-field\r\n              v-model.number=\"newSequence.outputSize.width\"\r\n              :label=\"$t('width')\"\r\n              type=\"number\"\r\n              :rules=\"[v => validateDimension(v, $t('width'))]\"\r\n            />\r\n          </v-col>\r\n          <v-col cols=\"3\">\r\n            <v-text-field\r\n              v-model.number=\"newSequence.outputSize.height\"\r\n              :label=\"$t('height')\"\r\n              type=\"number\"\r\n              :rules=\"[v => validateDimension(v, $t('height'))]\"\r\n            />\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-select\r\n              v-model=\"resolutionOption\"\r\n              :items=\"resolutions\"\r\n              :label=\"$t('selectResolutionTemplate')\"\r\n              @update:modelValue=\"applyResolution\"\r\n            />\r\n          </v-col>\r\n        </v-row>\r\n\r\n      </v-card-text>\r\n\r\n      <v-card-actions>\r\n        <v-spacer />\r\n        <v-btn text @click=\"close\">{{ $t('cancel') }}</v-btn>\r\n        <v-btn color=\"primary\" @click=\"confirm\">{{ $t('confirm') }}</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n\r\n<script>\r\nimport aardio from \"aardio\";\r\nimport { getDefaultSequence} from '@/utils/CommonMethods';\r\n\r\nexport default {\r\n  name: 'CreateVideoDialog',\r\n  props: {\r\n    modelValue: Boolean,\r\n  },\r\n  emits: ['update:modelValue', 'confirm'],\r\n  data() {\r\n    return {\r\n      dialog: false,\r\n      resolutionOption: null,\r\n      resolutions: [\r\n        this.$t('landscape1280x720'),\r\n        this.$t('landscape1920x1080'),\r\n        this.$t('portrait720x1280'),\r\n        this.$t('portrait1080x1920'),\r\n        this.$t('chooseReferenceVideo')\r\n      ],\r\n      newSequence: getDefaultSequence(),\r\n      project_extension: '.json',\r\n      pathError: ''\r\n    };\r\n  },\r\n  watch: {\r\n    modelValue(val) {\r\n      this.dialog = val;\r\n      if (val) this.resetForm();\r\n    },\r\n    dialog(val) {\r\n      this.$emit('update:modelValue', val);\r\n    }\r\n  },\r\n  methods: {\r\n    resetForm() {\r\n      this.newSequence = getDefaultSequence();\r\n      this.resolutionOption = null;\r\n      this.pathError = '';\r\n    },\r\n    close() {\r\n      this.dialog = false;\r\n    },\r\n    async browsePath() {\r\n      const dir_project = await aardio.getProjectDir();\r\n      if (dir_project !== '') {\r\n        this.pathError = '';\r\n        this.newSequence.path = dir_project;\r\n      }\r\n    },\r\n    async applyResolution(option) {\r\n      const map = {\r\n        [this.$t('landscape1280x720')]: [1280, 720],\r\n        [this.$t('landscape1920x1080')]: [1920, 1080],\r\n        [this.$t('portrait720x1280')]: [720, 1280],\r\n        [this.$t('portrait1080x1920')]: [1080, 1920]\r\n      };\r\n\r\n      if (map[option]) {\r\n        [this.newSequence.outputSize.width, this.newSequence.outputSize.height] = map[option];\r\n      } else if (option === this.$t('chooseReferenceVideo')) {\r\n        await this.chooseReferenceVideo();\r\n      }\r\n\r\n      this.resolutionOption = null;\r\n    },\r\n    async chooseReferenceVideo() {\r\n      const dir_video = await aardio.selectFile('Video files|*.mp4;*.mkv;*.avi');\r\n      if (dir_video === '') return;\r\n\r\n      const videoInfo = await aardio.getVideoInfo(dir_video);\r\n      const j_videoInfo = JSON.parse(videoInfo);\r\n      this.newSequence.outputSize.width = j_videoInfo.Width;\r\n      this.newSequence.outputSize.height = j_videoInfo.Height;\r\n    },\r\n    validateName(value) {\r\n      const invalid = /[\\\\/:*?\"<>|]/;\r\n      if (!value) return this.$t('enterProjectName');\r\n      if (invalid.test(value)) return this.$t('invalidCharacters');\r\n      return true;\r\n    },\r\n    validateDimension(value, label) {\r\n      if (!Number.isInteger(value) || value < 200) {\r\n        return `${label}${this.$t('mustBePositiveInteger')}`;\r\n      }\r\n      return true;\r\n    },\r\n    formatDate(date) {\r\n      const year = date.getFullYear();\r\n      const month = String(date.getMonth() + 1).padStart(2, '0');\r\n      const day = String(date.getDate()).padStart(2, '0');\r\n      const hours = String(date.getHours()).padStart(2, '0');\r\n      const minutes = String(date.getMinutes()).padStart(2, '0');\r\n      const seconds = String(date.getSeconds()).padStart(2, '0');\r\n      return `${year}/${month}/${day} ${hours}:${minutes}:${seconds}`;\r\n    },\r\n    async confirm() {\r\n      const nameValid = this.validateName(this.newSequence.name) === true;\r\n      const widthValid = this.validateDimension(this.newSequence.outputSize.width, this.$t('width')) === true;\r\n      const heightValid = this.validateDimension(this.newSequence.outputSize.height, this.$t('height')) === true;\r\n\r\n      if (!nameValid) {\r\n        alert(this.$t('enterValidProjectName'));\r\n        return;\r\n      }\r\n      if (!widthValid) {\r\n        alert(this.$t('enterValidWidth'));\r\n        return;\r\n      }\r\n      if (!heightValid) {\r\n        alert(this.$t('enterValidHeight'));\r\n        return;\r\n      }\r\n      /*\r\n      const sequenceToSave = JSON.parse(JSON.stringify(this.newSequence));\r\n      sequenceToSave.clips.unshift(getDefaultClip());\r\n\r\n              // ✅ 判断 clips 是否只有一个\r\n      if (\r\n        sequenceToSave.clips &&\r\n        sequenceToSave.clips.length === 1\r\n      ) {\r\n        const clip = sequenceToSave.clips[0];\r\n\r\n        // ✅ 确保 narration 存在\r\n        if (!clip.narration) {\r\n          clip.narration = {};\r\n        }\r\n\r\n        // ✅ 判断 locale 和 voiceName 是否为空\r\n        if (\r\n          (!clip.narration.locale || clip.narration.locale === '') &&\r\n          (!clip.narration.voiceName || clip.narration.voiceName === '')\r\n        ) {\r\n          const lang = localStorage.getItem('lang');\r\n\r\n          if (lang === 'zh') {\r\n            clip.narration.locale = \"zh-CN\";\r\n            clip.narration.voiceName = \"Yunxi\";\r\n          } else {\r\n            clip.narration.locale = \"en-US\";\r\n            clip.narration.voiceName = \"Ava\";\r\n          }\r\n        }\r\n      }\r\n      */\r\n      const dir_project = this.newSequence.path + '\\\\' + this.newSequence.name;\r\n      const path_project = dir_project + '\\\\' + this.newSequence.name + this.project_extension;\r\n      const isDirProjExist = await aardio.isDirExist(dir_project);\r\n\r\n      if (isDirProjExist) {\r\n        const isFileExist = await aardio.isFileExist(path_project);\r\n        if (isFileExist) {\r\n          alert(this.$t('projectAlreadyExists'));\r\n          return;\r\n        } else {\r\n          const jsonString = JSON.stringify(this.newSequence);\r\n          await aardio.saveTextFile(jsonString, path_project);\r\n          await this.updateAndNavigate(path_project);\r\n        }\r\n      } else {\r\n        await aardio.createDir(dir_project, false);\r\n        const jsonString = JSON.stringify(this.newSequence);\r\n        await aardio.saveTextFile(jsonString, path_project);\r\n        await this.updateAndNavigate(path_project);\r\n      }\r\n      this.close();\r\n    },\r\n    async updateAndNavigate(projectPath) {\r\n      const newProject = {\r\n        name: this.newSequence.name,\r\n        path: projectPath,\r\n        createdTime: this.formatDate(new Date())\r\n      };\r\n      this.$emit('projectCreated', newProject, true);\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n","\r\nexport const getDefaultSequence = () => ({\r\n      name: \"\",\r\n      path: \"\",\r\n      frameRate: 24,\r\n      outputSize: { width: 1280, height: 720 },\r\n      backgroundColor: { r: 0, g: 0, b: 0 },\r\n      smartAdjust: true,\r\n      clipThumbnailScale: 1.2,\r\n      sceneThumbnailScale: 2,\r\n      selectedIndex: 0,\r\n      durationThreshold: 4,\r\n      clips: []\r\n    });\r\n// 默认 clip 结构\r\nexport const getDefaultClip = () => ({\r\n        sentence: '',\r\n        comment1: '',\r\n        comment2: '',\r\n        narration: {\r\n          locale: '',\r\n          voiceName: '',\r\n          rate: 1.00,\r\n          speed: 1.0,\r\n          pauseBefore: 0.25,\r\n          pauseAfter: 0.25,\r\n          audioMedia: { filePath: '', duration: 0 },\r\n        },\r\n        scenes: [],\r\n        videoMedia: { filePath: '', duration: 0 },\r\n        editedSceneIndex: 0, \r\n      });\r\nexport const getDefaultScene = () => ({\r\n        proportion: 2,\r\n        type: '',\r\n        fullName: '',\r\n        width: 0,\r\n        height: 0,\r\n        fps: 0,\r\n        countFrame: 0,\r\n        analyzeFile: '',\r\n        sourceRange: [0, 0],\r\n        frameRange: [0, 0],\r\n        sourceHex:'',\r\n        base64Thumbnail: '',\r\n        anchorX: 0,\r\n        anchorY: 0,\r\n        scale: 1,\r\n        upend: false,\r\n        horizontalFlip: false,\r\n        growFrame: false,\r\n        sourceVolume: 0,\r\n        alignSource: false,\r\n      });\r\n// 格式化时间\r\nexport const formatTime = (seconds) => {\r\n  if (seconds < 60) {\r\n    // 小于1分钟，直接显示秒数（保留两位小数）\r\n    return seconds.toFixed(2); // 可以加 's' 表示秒，或者不加\r\n  } else {\r\n    // 大于等于1分钟，显示分钟和秒\r\n    const mins = Math.floor(seconds / 60);\r\n    const secs = (seconds % 60).toFixed(2).padStart(5, '0');\r\n    return `${mins}:${secs}`;\r\n  }\r\n};\r\n// 其他共用方法...\r\nexport const splitSentences = (input) => {\r\n  if (!input || typeof input !== 'string') return [];\r\n  \r\n  // 常见缩写列表（可根据需要扩展）\r\n  const abbreviationsPattern = /(?:Mr|Mrs|Ms|Dr|Rev|Hon|Sir|Dame|Dott|Sr|Jr|Hr|Fru|Pan|Pani|M|Mme|Mlle|Herr|Fr|Hra|Rva|Dhr|Mevr|Sr|Sra|Srta|Hr|Fru|Κος|Κα|Sig|Sig\\.ra|Sig\\.na|M\\.|Dr\\.|Prof\\.)\\./g;\r\n  // 分割规则：中文句号/感叹号/问号，或英文句点/问号/感叹号后跟空格/引号/换行\r\n  const splitPattern = /(?<=[。！？])|(?<=[.!?])(?=\\s|[\"'\\n])|(?<=\\n)/g;\r\n  const specialCharacter = '¦'; // 临时替换字符\r\n  \r\n  try {\r\n    // 1. 处理缩写，临时替换缩写中的句点\r\n    let processedInput = input.replace(abbreviationsPattern, match => \r\n      match.replace('.', specialCharacter)\r\n    );\r\n    \r\n    // 2. 分割句子\r\n    let sentences = processedInput.split(splitPattern);\r\n    \r\n    // 3. 清理结果\r\n    return sentences\r\n      .map(sentence => \r\n        sentence.replace(new RegExp(specialCharacter, 'g'), '.')\r\n          .trim()\r\n          // 合并被错误分割的连续标点\r\n          .replace(/([。！？.!?])\\s*([。！？.!?])/g, '$1$2')\r\n      )\r\n      .filter(sentence => \r\n        // 过滤空字符串和纯空格\r\n        sentence.length > 0 && !/^\\s+$/.test(sentence)\r\n      );\r\n  } catch (error) {\r\n    console.error('句子分割出错:', error);\r\n    // 出错时返回整个文本作为单个句子\r\n    return [input.trim()].filter(Boolean);\r\n  }\r\n};","import { render } from \"./CreateVideoDialog.vue?vue&type=template&id=b9436da4\"\nimport script from \"./CreateVideoDialog.vue?vue&type=script&lang=js\"\nexport * from \"./CreateVideoDialog.vue?vue&type=script&lang=js\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['render',render]])\n\nexport default __exports__","<template>\r\n  <v-app>\r\n    <v-main>\r\n      <v-container fluid class=\"pa-0 fill-height\">\r\n        <v-row no-gutters class=\"fill-height\">\r\n          <v-col cols=\"3\" class=\"left-sidebar-wrapper\">\r\n            <v-card\r\n              class=\"pa-4 fill-height rounded-0 d-flex flex-column\"\r\n              elevation=\"4\"\r\n            >\r\n              <v-card-title class=\"text-h7 font-weight-bold\">\r\n                {{ $t('learnVideoTitle') }}\r\n              </v-card-title>\r\n\r\n              <div class=\"flex-grow-1 overflow-y-auto mt-4 px-2\">\r\n                <v-row dense style=\"row-gap: 16px\">\r\n                  <v-col cols=\"12\">\r\n                    <v-card class=\"pa-0\" elevation=\"2\" color=\"#1A1A1A\">\r\n                      <v-card-title class=\"text-subtitle-1 font-weight-bold\">\r\n                        {{ $t('step1Title') }}\r\n                      <