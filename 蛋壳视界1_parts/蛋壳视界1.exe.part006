         :label=\"$t('phoneNumber')\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n          class=\"mb-3\"\r\n        />\r\n\r\n        <v-text-field\r\n          v-model=\"password\"\r\n          :label=\"$t('password')\"\r\n          type=\"password\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n        />\r\n\r\n        <!-- 忘记密码 -->\r\n        <div class=\"d-flex justify-end mt-1 mb-3\">\r\n          <span\r\n            class=\"text-primary text-body-2 forgot-password\"\r\n            @click=\"goResetPassword\"\r\n          >\r\n            {{ $t('forgetPassword') }}\r\n          </span>\r\n        </div>\r\n\r\n        <!-- ⭐ 登录失败的提示 -->\r\n        <v-alert\r\n          v-if=\"errorMessage\"\r\n          type=\"error\"\r\n          variant=\"tonal\"\r\n          class=\"mt-3\"\r\n          density=\"comfortable\"\r\n        >\r\n          {{ errorMessage }}\r\n        </v-alert>\r\n      </v-card-text>\r\n\r\n      <v-card-actions class=\"d-flex justify-space-between\">\r\n        <v-btn\r\n          color=\"primary\"\r\n          @click=\"login\"\r\n          :loading=\"loading\"\r\n          >{{ $t('login') }}</v-btn\r\n        >\r\n        <v-btn variant=\"text\" @click=\"goRegister\">{{ $t('register') }}</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-container>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, inject } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport aardio from 'aardio'\r\nimport AppBrand from '@/components/AppBrand.vue'\r\n\r\nconst router = useRouter()\r\n\r\n// ⭐ 获取全局 license\r\nconst license = inject('license')\r\n\r\nconst username = ref('')\r\nconst password = ref('')\r\nconst loading = ref(false)\r\nconst errorMessage = ref('')\r\n\r\nasync function login() {\r\n\r\n  errorMessage.value = ''\r\n  loading.value = true\r\n\r\n  try {\r\n\r\n    const machineCode = await aardio.getMachineCode()\r\n\r\n    const rawResult = await aardio.login(\r\n      username.value,\r\n      password.value,\r\n      machineCode\r\n    )\r\n\r\n    let result\r\n\r\n    try {\r\n      result = JSON.parse(rawResult)\r\n    } catch (e) {\r\n      throw new Error('Invalid response format: ' + rawResult)\r\n    }\r\n\r\n    switch (result.code) {\r\n\r\n      case 'SUCCESS':\r\n\r\n        // 1️⃣ 保存本地 license\r\n        await aardio.saveLocalKey(\r\n          username.value,\r\n          machineCode,\r\n          result.token\r\n        )\r\n\r\n        // 2️⃣ 更新全局 license\r\n        license.username = username.value\r\n        license.machineCode = machineCode\r\n        license.serverToken = result.token\r\n\r\n        // 3️⃣ 跳转主页\r\n        router.push({\r\n          path: '/home',\r\n          query: { justLogin: '1' }\r\n        })\r\n\r\n        break\r\n\r\n      case 'TOO_MANY_DEVICES':\r\n\r\n        errorMessage.value = result.message\r\n\r\n        setTimeout(() => {\r\n          router.push('/change-password')\r\n        }, 1200)\r\n\r\n        break\r\n\r\n      default:\r\n\r\n        errorMessage.value = result?.message || 'Login failed'\r\n\r\n    }\r\n\r\n  } catch (err) {\r\n\r\n    errorMessage.value = 'Login exception: ' + err.message\r\n\r\n  } finally {\r\n\r\n    loading.value = false\r\n\r\n  }\r\n}\r\n\r\nfunction goRegister() {\r\n  router.push('/register')\r\n}\r\n\r\nfunction goResetPassword() {\r\n  router.push('/reset-password')\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-card {\r\n  width: 90%;\r\n  max-width: 400px;\r\n}\r\n\r\n/* 鼠标移上去有手型 */\r\n.forgot-password {\r\n  cursor: pointer;\r\n}\r\n</style>\r\n","import script from \"./LoginPage.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./LoginPage.vue?vue&type=script&setup=true&lang=js\"\n\nimport \"./LoginPage.vue?vue&type=style&index=0&id=4ae07d4b&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['__scopeId',\"data-v-4ae07d4b\"]])\n\nexport default __exports__","<template>\r\n  <v-container\r\n    class=\"fill-height d-flex flex-column align-center justify-center\"\r\n  >\r\n    <!-- LOGO部分 -->\r\n    <div class=\"d-flex justify-center mb-6\">\r\n      <AppBrand size=\"large\" />\r\n    </div>\r\n    <v-card class=\"pa-6\" max-width=\"500\" elevation=\"10\" rounded=\"xl\">\r\n      <v-card-title\r\n        class=\"text-h6 text-center mb-4\"\r\n        >{{ $t('userRegistration') }}</v-card-title\r\n      >\r\n\r\n      <v-card-text>\r\n        <v-text-field\r\n          v-model=\"phone\"\r\n          :label=\"$t('phoneNumber')\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n          class=\"mb-3\"\r\n          :rules=\"[validatePhone]\"\r\n        />\r\n        <v-text-field\r\n          v-model=\"password\"\r\n          :label=\"$t('password')\"\r\n          type=\"password\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n        />\r\n        <v-text-field\r\n          v-model=\"confirmPassword\"\r\n          :label=\"$t('confirmPassword')\"\r\n          type=\"password\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n        />\r\n        <v-text-field\r\n          v-model=\"licenseCode\"\r\n          :label=\"$t('licenseCode')\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n          class=\"mb-3\"\r\n        />\r\n        <v-text-field\r\n          v-model=\"referralCode\"\r\n          :label=\"$t('referralCode')\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n          class=\"mb-3\"\r\n        />\r\n        <v-alert\r\n          v-if=\"successMessage\"\r\n          type=\"success\"\r\n          variant=\"tonal\"\r\n          class=\"mt-3\"\r\n          density=\"comfortable\"\r\n        >\r\n          {{ successMessage }}\r\n        </v-alert>\r\n        <!-- ⭐ 登录失败的提示 -->\r\n        <v-alert\r\n          v-if=\"errorMessage\"\r\n          type=\"error\"\r\n          variant=\"tonal\"\r\n          class=\"mt-3\"\r\n          density=\"comfortable\"\r\n        >\r\n          {{ errorMessage }}\r\n        </v-alert>\r\n      </v-card-text>\r\n\r\n      <v-card-actions class=\"d-flex justify-space-between\">\r\n        <v-btn\r\n          color=\"primary\"\r\n          @click=\"register\"\r\n          :loading=\"loading\"\r\n          >{{ $t('register') }}</v-btn\r\n        >\r\n        <v-btn variant=\"text\" @click=\"goLogin\">{{ $t('backToLogin') }}</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport aardio from 'aardio'\r\nimport AppBrand from '@/components/AppBrand.vue'\r\n\r\nexport default {\r\n  components: { AppBrand },\r\n  data() {\r\n    return {\r\n      phone: '',\r\n      password: '',\r\n      confirmPassword: '',\r\n      licenseCode: '',\r\n      referralCode: '',\r\n      loading: false,\r\n      errorMessage: '',\r\n      successMessage: '',\r\n    };\r\n  },\r\n  methods: {\r\n    // ✅ 手机号格式验证函数（使用国际化提示）\r\n    validatePhone(value) {\r\n      const phoneRegex = /^1[3-9]\\d{9}$/;\r\n      if (!value) return this.$t('phoneEmpty');\r\n      if (!phoneRegex.test(value)) return this.$t('invalidPhone');\r\n      return true;\r\n    },\r\n\r\n    async register() {\r\n      this.errorMessage = '';\r\n      this.successMessage = '';\r\n\r\n      const phoneRegex = /^1[3-9]\\d{9}$/;\r\n      if (!this.phone) {\r\n        this.errorMessage = this.$t('phoneEmpty');\r\n        return;\r\n      }\r\n      if (!phoneRegex.test(this.phone)) {\r\n        this.errorMessage = this.$t('invalidPhone');\r\n        return;\r\n      }\r\n      if (!this.password) {\r\n        this.errorMessage = this.$t('passwordEmpty');\r\n        return;\r\n      }\r\n      if (this.password !== this.confirmPassword) {\r\n        this.errorMessage = this.$t('passwordMismatch');\r\n        return;\r\n      }\r\n      if (!this.licenseCode) {\r\n        this.errorMessage = this.$t('licenseCodeEmpty');\r\n        return;\r\n      }\r\n      if (!this.referralCode) {\r\n        this.errorMessage = this.$t('referralCodeEmpty');\r\n        return;\r\n      }\r\n\r\n      this.loading = true;\r\n      try {\r\n        const machineCode = await aardio.getMachineCode();\r\n        const rawResult = await aardio.register(\r\n          this.phone,\r\n          this.password,\r\n          this.licenseCode,\r\n          this.referralCode,\r\n          machineCode\r\n        );\r\n\r\n        let result;\r\n        try {\r\n          result = typeof rawResult === 'string'\r\n            ? JSON.parse(rawResult)\r\n            : rawResult;\r\n        } catch (e) {\r\n          result = null;\r\n        }\r\n\r\n        if (result && result.success) {\r\n          await aardio.saveLocalKey(this.phone, machineCode, result?.token);\r\n          this.successMessage = this.$t('registrationSuccess');\r\n          setTimeout(() => this.$router.push('/home'), 1200);\r\n        } else {\r\n          this.errorMessage = result?.message || this.$t('registrationFailed');\r\n        }\r\n      } catch (err) {\r\n        this.errorMessage = this.$t('registrationException') + ': ' + err.message;\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n\r\n    goLogin() {\r\n      this.$router.push('/login');\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.v-card {\r\n  width: 90%;\r\n  max-width: 400px;\r\n}\r\n</style>\r\n","import { render } from \"./RegisterPage.vue?vue&type=template&id=6ead14d2&scoped=true\"\nimport script from \"./RegisterPage.vue?vue&type=script&lang=js\"\nexport * from \"./RegisterPage.vue?vue&type=script&lang=js\"\n\nimport \"./RegisterPage.vue?vue&type=style&index=0&id=6ead14d2&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['render',render],['__scopeId',\"data-v-