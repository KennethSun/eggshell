le\": \"年长女性\"\r\n    },\r\n    {\r\n      \"Key\": \"OlderAdultMale\",\r\n      \"Title\": \"年长男性\"\r\n    },\r\n    {\r\n      \"Key\": \"SeniorFemale\",\r\n      \"Title\": \"老年女性\"\r\n    },\r\n    {\r\n      \"Key\": \"SeniorMale\",\r\n      \"Title\": \"老年男性\"\r\n    },\r\n    {\r\n      \"Key\": \"Girl\",\r\n      \"Title\": \"女孩\"\r\n    },\r\n    {\r\n      \"Key\": \"Boy\",\r\n      \"Title\": \"男孩\"\r\n    },\r\n    {\r\n      \"Key\": \"Narrator\",\r\n      \"Title\": \"旁白\"\r\n    }\r\n  ];\r\nexport var list_honorifics = ['Mr. ', 'Mrs. ', 'Ms. ', 'Dr. ', 'Prof. ', 'Rev. ', 'Hon. ', 'Sr. ', 'Jr. ', \r\n    'Sir. ', 'Dame. ',\r\n    'M. ', 'Mme. ', 'Mlle. ', \r\n    'Hr. ', 'Fr. ', \r\n    'Sra. ', 'Srta. ', \r\n    'Sig. ', 'Dott. ', \r\n    'Dhr. ', 'Mevr. ', \r\n    'Pan. ', 'Pani. ', \r\n    'Herr. ', 'Fru. '];\r\nexport var list_terminal_punctuation = {\r\n  locals:['zh-CN','zh-CN-liaoning', 'zh-CN-shaanxi', 'zh-TW','zh-HK','ja-JP'],\r\n  terminals:['。','？','！']\r\n}","import { render } from \"./EditVideoProject.vue?vue&type=template&id=10ba7b86&scoped=true\"\nimport script from \"./EditVideoProject.vue?vue&type=script&lang=js\"\nexport * from \"./EditVideoProject.vue?vue&type=script&lang=js\"\n\nimport \"./EditVideoProject.vue?vue&type=style&index=0&id=10ba7b86&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['render',render],['__scopeId',\"data-v-10ba7b86\"]])\n\nexport default __exports__","<template>\r\n  <v-container\r\n    class=\"fill-height d-flex flex-column align-center justify-center\"\r\n  >\r\n    <!-- LOGO部分 -->\r\n    <div class=\"d-flex justify-center mb-6\">\r\n      <AppBrand size=\"large\" />\r\n    </div>\r\n\r\n    <!-- 登录卡片 -->\r\n    <v-card class=\"pa-6\" max-width=\"500\" elevation=\"10\" rounded=\"xl\">\r\n      <v-card-title\r\n        class=\"text-h6 text-center mb-4\"\r\n        >{{ $t('userLogin') }}</v-card-title\r\n      >\r\n\r\n      <v-card-text>\r\n        <v-text-field\r\n          v-model=\"username\"\r\n          :label=\"$t('phoneNumber')\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n          class=\"mb-3\"\r\n        />\r\n\r\n        <v-text-field\r\n          v-model=\"password\"\r\n          :label=\"$t('password')\"\r\n          type=\"password\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n        />\r\n\r\n        <!-- 忘记密码 -->\r\n        <div class=\"d-flex justify-end mt-1 mb-3\">\r\n          <span\r\n            class=\"text-primary text-body-2 forgot-password\"\r\n            @click=\"goResetPassword\"\r\n          >\r\n            {{ $t('forgetPassword') }}\r\n          </span>\r\n        </div>\r\n\r\n        <!-- ⭐ 登录失败的提示 -->\r\n        <v-alert\r\n          v-if=\"errorMessage\"\r\n          type=\"error\"\r\n          variant=\"tonal\"\r\n          class=\"mt-3\"\r\n          density=\"comfortable\"\r\n        >\r\n          {{ errorMessage }}\r\n        </v-alert>\r\n      </v-card-text>\r\n\r\n      <v-card-actions class=\"d-flex justify-space-between\">\r\n        <v-btn\r\n          color=\"primary\"\r\n          @click=\"login\"\r\n          :loading=\"loading\"\r\n          >{{ $t('login') }}</v-btn\r\n        >\r\n        <v-btn variant=\"text\" @click=\"goRegister\">{{ $t('register') }}</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-container>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, inject } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport aardio from 'aardio'\r\nimport AppBrand from '@/components/AppBrand.vue'\r\n\r\nconst router = useRouter()\r\n\r\n// ⭐ 获取全局 license\r\nconst license = inject('license')\r\n\r\nconst username = ref('')\r\nconst password = ref('')\r\nconst loading = ref(false)\r\nconst errorMessage = ref('')\r\n\r\nasync function login() {\r\n\r\n  errorMessage.value = ''\r\n  loading.value = true\r\n\r\n  try {\r\n\r\n    const machineCode = await aardio.getMachineCode()\r\n\r\n    const rawResult = await aardio.login(\r\n      username.value,\r\n      password.value,\r\n      machineCode\r\n    )\r\n\r\n    let result\r\n\r\n    try {\r\n      result = JSON.parse(rawResult)\r\n    } catch (e) {\r\n      throw new Error('Invalid response format: ' + rawResult)\r\n    }\r\n\r\n    switch (result.code) {\r\n\r\n      case 'SUCCESS':\r\n\r\n        // 1️⃣ 保存本地 license\r\n        await aardio.saveLocalKey(\r\n          username.value,\r\n          machineCode,\r\n          result.token\r\n        )\r\n\r\n        // 2️⃣ 更新全局 license\r\n        license.username = username.value\r\n        license.machineCode = machineCode\r\n        license.serverToken = result.token\r\n\r\n        // 3️⃣ 跳转主页\r\n        router.push({\r\n          path: '/home',\r\n          query: { justLogin: '1' }\r\n        })\r\n\r\n        break\r\n\r\n      case 'TOO_MANY_DEVICES':\r\n\r\n        errorMessage.value = result.message\r\n\r\n        setTimeout(() => {\r\n          router.push('/change-password')\r\n        }, 1200)\r\n\r\n        break\r\n\r\n      default:\r\n\r\n        errorMessage.value = result?.message || 'Login failed'\r\n\r\n    }\r\n\r\n  } catch (err) {\r\n\r\n    errorMessage.value = 'Login exception: ' + err.message\r\n\r\n  } finally {\r\n\r\n    loading.value = false\r\n\r\n  }\r\n}\r\n\r\nfunction goRegister() {\r\n  router.push('/register')\r\n}\r\n\r\nfunction goResetPassword() {\r\n  router.push('/reset-password')\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-card {\r\n  width: 90%;\r\n  max-width: 400px;\r\n}\r\n\r\n/* 鼠标移上去有手型 */\r\n.forgot-password {\r\n  cursor: pointer;\r\n}\r\n</style>\r\n","import script from \"./LoginPage.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./LoginPage.vue?vue&type=script&setup=true&lang=js\"\n\nimport \"./LoginPage.vue?vue&type=style&index=0&id=4ae07d4b&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['__scopeId',\"data-v-4ae07d4b\"]])\n\nexport default __exports__","<template>\r\n  <v-container\r\n    class=\"fill-height d-flex flex-column align-center justify-center\"\r\n  >\r\n    <!-- LOGO部分 -->\r\n    <div class=\"d-flex justify-center mb-6\">\r\n      <AppBrand size=\"large\" />\r\n    </div>\r\n    <v-card class=\"pa-6\" max-width=\"500\" elevation=\"10\" rounded=\"xl\">\r\n      <v-card-title\r\n        class=\"text-h6 text-center mb-4\"\r\n        >{{ $t('userRegistration') }}</v-card-title\r\n      >\r\n\r\n      <v-card-text>\r\n        <v-text-field\r\n          v-model=\"phone\"\r\n          :label=\"$t('phoneNumber')\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n          class=\"mb-3\"\r\n          :rules=\"[validatePhone]\"\r\n        />\r\n        <v-text-field\r\n          v-model=\"password\"\r\n          :label=\"$t('password')\"\r\n          type=\"password\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n        />\r\n        <v-text-field\r\n          v-model=\"confirmPassword\"\r\n          :label=\"$t('confirmPassword')\"\r\n          type=\"password\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n        />\r\n        <v-text-field\r\n          v-model=\"licenseCode\"\r\n          :label=\"$t('licenseCode')\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n          class=\"mb-3\"\r\n        />\r\n        <v-text-field\r\n          v-model=\"referralCode\"\r\n          :label=\"$t('referralCode')\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n          class=\"mb-3\"\r\n        />\r\n        <v-alert\r\n          v-if=\"successMessage\"\r\n          type=\"success\"\r\n          variant=\"tonal\"\r\n          class=\"mt-3\"\r\n          density=\"comfortable\"\r\n        >\r\n          {{ successMessage }}\r\n        </v-alert>\r\n        <!-- ⭐ 登录失败的提示 -->\r\n        <v-alert\r\n          v-if=\"errorMessage\"\r\n          type=\"error\"\r\n          variant=\"tonal\"\r\n          class=\"mt-3\"\r\n          density=\"comfortable\"\r\n        >\r\n          {{ errorMessage }}\r\n        </v-alert>\r\n      </v-card-text>\r\n\r\n      <v-card-actions class=\"d-flex justify-space-between\">\r\n        <v-btn\r\n          color=\"primary\"\r\n          @click=\"register\"\r\n          :loading=\"loading\"\r\n          >{{ $t('register') }}</v-btn\r\n        >\r\n        <v-btn variant=\"text\" @click=\"goLogin\">{{ $t('backToLogin') }}</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport aardio from 'aardio'\r\nimport AppBrand from '@/components/AppBrand.vue'\r\n\r\nexport default {\r\n  components: { AppBrand },\r\n  data() {\r\n    return {\r\n      phone: '',\r\n      password: '',\r\n      confirmPassword: '',\r\n      licenseCode: '',\r\n      referralCode: '',\r\n      loading: false,\r\n      errorMessage: '',\r\n      successMessage: '',\r\n    };\r\n  },\r\n  methods: {\r\n    // ✅ 手机号格式验证函数（使用国际化提示）\r\n    validatePhone(value) {\r\n      const phoneRegex = /^1[3-9]\\d{9}$/;\r\n      if (!value) return this.$t('phoneEmpty');\r\n      if (!phoneRegex.test(value)) return this.$t('invalidPhone');\r\n      return true;\r\n    },\r\n\r\n    async register() {\r\n      this.errorMessage = '';\r\n      this.successMessage = '';\r\n\r\n      const phoneRegex = /^1[3-9]\\d{9}$/;\r\n      if (!this.phone) {\r\n        this.errorMessage = this.$t('phoneEmpty');\r\n        return;\r\n      }\r\n      if (!phoneRegex.test(this.phone)) {\r\n        this.errorMessage = this.$t('invalidPhone');\r\n        return;\r\n      }\r\n      if (!this.password) {\r\n        this.errorMessage = this.$t('passwordEmpty');\r\n        return;\r\n      }\r\n      if (this.password !== this.confirmPassword) {\r\n        this.errorMessage = this.$t('passwordMismatch');\r\n        return;\r\n      }\r\n      if (!this.licenseCode) {\r\n        this.errorMessage = this.$t('licenseCodeEmpty');\r\n        return;\r\n      }\r\n      if (!this.referralCode) {\r\n        this.errorMessage = this.$t('referralCodeEmpty');\r\n        return;\r\n      }\r\n\r\n      this.loading = true;\r\n      try {\r\n        const machineCode = await aardio.getMachineCode();\r\n        const rawResult = await aardio.register(\r\n          this.phone,\r\n          this.password,\r\n          this.licenseCode,\r\n          this.referralCode,\r\n          machineCode\r\n        );\r\n\r\n        let result;\r\n        try {\r\n          result = typeof rawResult === 'string'\r\n            ? JSON.parse(rawResult)\r\n            : rawResult;\r\n        } catch (e) {\r\n          result = null;\r\n        }\r\n\r\n        if (result && result.success) {\r\n          await aardio.saveLocalKey(this.phone, machineCode, result?.token);\r\n          this.successMessage = this.$t('registrationSuccess');\r\n          setTimeout(() => this.$router.push('/home'), 1200);\r\n        } else {\r\n          this.errorMessage = result?.message || this.$t('registrationFailed');\r\n        }\r\n      } catch (err) {\r\n        this.errorMessage = this.$t('registrationException') + ': ' + err.message;\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n\r\n    goLogin() {\r\n      this.$router.push('/login');\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.v-card {\r\n  width: 90%;\r\n  max-width: 400px;\r\n}\r\n</style>\r\n","import { render } from \"./RegisterPage.vue?vue&type=template&id=6ead14d2&scoped=true\"\nimport script from \"./RegisterPage.vue?vue&type=script&lang=js\"\nexport * from \"./RegisterPage.vue?vue&type=script&lang=js\"\n\nimport \"./RegisterPage.vue?vue&type=style&index=0&id=6ead14d2&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['render',render],['__scopeId',\"data-v-6ead14d2\"]])\n\nexport default __exports__","<template>\r\n  <v-container\r\n    class=\"fill-height d-flex flex-column align-center justify-center\"\r\n  >\r\n    <!-- LOGO部分 -->\r\n    <div class=\"d-flex justify-center mb-6\">\r\n      <AppBrand size=\"large\" />\r\n    </div>\r\n\r\n    <v-card class=\"pa-6\" max-width=\"500\" elevation=\"10\" rounded=\"xl\">\r\n      <v-card-title class=\"text-h6 text-center mb-4\">\r\n        {{ $t('resetPassword') }}\r\n      </v-card-title>\r\n\r\n      <v-card-text>\r\n        <v-text-field\r\n          v-model=\"licenseCode\"\r\n          :label=\"$t('licenseCode')\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n          class=\"mb-3\"\r\n        />\r\n\r\n        <v-text-field\r\n          v-model=\"newPassword\"\r\n          :label=\"$t('newPassword')\"\r\n          type=\"password\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n        />\r\n\r\n        <v-text-field\r\n          v-model=\"confirmNewPassword\"\r\n          :label=\"$t('confirmNewPassword')\"\r\n          type=\"password\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n        />\r\n\r\n        <!-- 错误提示 -->\r\n        <div v-if=\"errorMessage\" class=\"text-red mt-2\">\r\n          {{ errorMessage }}\r\n        </div>\r\n\r\n        <!-- 成功提示 -->\r\n        <div v-if=\"successMessage\" class=\"text-green mt-2\">\r\n          {{ successMessage }}\r\n        </div>\r\n      </v-card-text>\r\n\r\n      <v-card-actions class=\"d-flex justify-space-between\">\r\n        <v-btn color=\"primary\" @click=\"resetPassword\" :loading=\"loading\">\r\n          {{ $t('confirm') }}\r\n        </v-btn>\r\n\r\n        <v-btn variant=\"text\" @click=\"goLogin\">\r\n          {{ $t('backToLogin') }}\r\n        </v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport aardio from 'aardio'\r\nimport AppBrand from '@/components/AppBrand.vue'\r\n\r\nexport default {\r\n  components: { AppBrand },\r\n  data() {\r\n    return {\r\n      licenseCode: '',\r\n      newPassword: '',\r\n      confirmNewPassword: '',\r\n      loading: false,\r\n      errorMessage: '',\r\n      successMessage: '',\r\n    };\r\n  },\r\n  methods: {\r\n    async resetPassword() {\r\n      this.errorMessage = '';\r\n      this.successMessage = '';\r\n\r\n      if (!this.licenseCode) {\r\n        this.errorMessage = this.$t('licenseCodeEmpty');\r\n        return;\r\n      }\r\n\r\n      if (!this.newPassword) {\r\n        this.errorMessage = this.$t('passwordEmpty');\r\n        return;\r\n      }\r\n\r\n      if (this.newPassword !== this.confirmNewPassword) {\r\n        this.errorMessage = this.$t('passwordMismatch');\r\n        return;\r\n      }\r\n\r\n      this.loading = true;\r\n\r\n      try {\r\n        // 调用 Aardio 修改密码接口（按你的实际命名调整）\r\n        const rawResult = await aardio.resetPassword(this.licenseCode, this.newPassword);\r\n\r\n        let result;\r\n        try {\r\n          result = JSON.parse(rawResult);\r\n        } catch (e) {\r\n          this.errorMessage = \"Invalid response: \" + rawResult;\r\n          this.loading = false;\r\n          return;\r\n        }\r\n\r\n        if (result && result.success) {\r\n          this.successMessage = this.$t('resetPasswordSuccess');\r\n          setTimeout(() => this.$router.push('/login'), 1200);\r\n        } else {\r\n          this.errorMessage = result?.message || this.$t('resetPasswordFailed');\r\n        }\r\n      } catch (err) {\r\n        this.errorMessage =\r\n          this.$t('resetPasswordException') + ': ' + err.message;\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n\r\n    goLogin() {\r\n      this.$router.push('/login');\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.v-card {\r\n  width: 90%;\r\n  max-width: 400px;\r\n}\r\n.text-red {\r\n  color: #e53935;\r\n}\r\n.text-green {\r\n  color: #43a047;\r\n}\r\n</style>\r\n","import { render } from \"./ResetPasswordPage.vue?vue&type=template&id=c1b919ba&scoped=true\"\nimport script from \"./ResetPasswordPage.vue?vue&type=script&lang=js\"\nexport * from \"./ResetPasswordPage.vue?vue&type=script&lang=js\"\n\nimport \"./ResetPasswordPage.vue?vue&type=style&index=0&id=c1b919ba&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['render',render],['__scopeId',\"data-v-c1b919ba\"]])\n\nexport default __exports__","<template>\r\n  <v-container\r\n    class=\"fill-height d-flex flex-column align-center justify-center\"\r\n  >\r\n    <!-- LOGO -->\r\n    <div class=\"d-flex justify-center mb-6\">\r\n      <AppBrand size=\"large\" />\r\n    </div>\r\n\r\n    <v-card class=\"pa-6\" max-width=\"500\" elevation=\"10\" rounded=\"xl\">\r\n      <v-card-title class=\"text-h6 text-center mb-4\">\r\n        {{ $t('resetPassword') }}\r\n      </v-card-title>\r\n\r\n      <v-card-text>\r\n\r\n        <!-- 用户名 -->\r\n        <v-text-field\r\n          v-model=\"username\"\r\n          :label=\"$t('phoneNumber')\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n          class=\"mb-3\"\r\n        />\r\n\r\n        <!-- 当前密码 -->\r\n        <v-text-field\r\n          v-model=\"currentPassword\"\r\n          :label=\"$t('currentPassword')\"\r\n          type=\"password\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n        />\r\n\r\n        <!-- 新密码 -->\r\n        <v-text-field\r\n          v-model=\"newPassword\"\r\n          :label=\"$t('newPassword')\"\r\n          type=\"password\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n        />\r\n\r\n        <!-- 确认新密码 -->\r\n        <v-text-field\r\n          v-model=\"confirmNewPassword\"\r\n          :label=\"$t('confirmNewPassword')\"\r\n          type=\"password\"\r\n          variant=\"outlined\"\r\n          density=\"comfortable\"\r\n        />\r\n\r\n        <!-- 错误提示 -->\r\n        <div v-if=\"errorMessage\" class=\"text-red mt-2\">\r\n          {{ errorMessage }}\r\n        </div>\r\n\r\n        <!-- 成功提示 -->\r\n        <div v-if=\"successMessage\" class=\"text-green mt-2\">\r\n          {{ successMessage }}\r\n        </div>\r\n\r\n      </v-card-text>\r\n\r\n      <v-card-actions class=\"d-flex justify-space-between\">\r\n\r\n        <v-btn\r\n          color=\"primary\"\r\n          @click=\"changePassword\"\r\n          :loading=\"loading\"\r\n        >\r\n          {{ $t('confirm') }}\r\n        </v-btn>\r\n\r\n        <v-btn\r\n          variant=\"text\"\r\n          @click=\"goHome\"\r\n        >\r\n          {{ $t('backToHomePage') }}\r\n        </v-btn>\r\n\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport aardio from 'aardio'\r\nimport AppBrand from '@/components/AppBrand.vue'\r\n\r\nexport default {\r\n\r\n  components: { AppBrand },\r\n\r\n  data() {\r\n    return {\r\n      username: '',\r\n      machineCode: '',\r\n      currentPassword: '',\r\n      newPassword: '',\r\n      confirmNewPassword: '',\r\n      loading: false,\r\n      errorMessage: '',\r\n      successMessage: '',\r\n    }\r\n  },\r\n\r\n  mounted() {\r\n\r\n    // ⭐ 如果已经登录\r\n    if (this.$license && this.$license.username) {\r\n      this.username = this.$license.username\r\n      this.machineCode = this.$license.machineCode\r\n    }\r\n\r\n  },\r\n\r\n  methods: {\r\n\r\n    async changePassword() {\r\n\r\n      this.errorMessage = ''\r\n      this.successMessage = ''\r\n\r\n      if (!this.currentPassword) {\r\n        this.errorMessage = this.$t('currentPasswordEmpty')\r\n        return\r\n      }\r\n\r\n      if (!this.newPassword) {\r\n        this.errorMessage = this.$t('passwordEmpty')\r\n        return\r\n      }\r\n\r\n      if (this.newPassword !== this.confirmNewPassword) {\r\n        this.errorMessage = this.$t('passwordMismatch')\r\n        return\r\n      }\r\n\r\n      this.loading = true\r\n\r\n      try {\r\n\r\n        let machineCode = this.machineCode\r\n\r\n        // ⭐ 未登录获取 machineCode\r\n        if (!machineCode) {\r\n          machineCode = await aardio.getMachineCode()\r\n        }\r\n\r\n        const rawResult = await aardio.changePassword(\r\n          this.username,\r\n          machineCode,\r\n          this.currentPassword,\r\n          this.newPassword\r\n        )\r\n\r\n        let result\r\n\r\n        try {\r\n          result = JSON.parse(rawResult)\r\n        } catch (e) {\r\n          this.errorMessage = \"Invalid response: \" + rawResult\r\n          this.loading = false\r\n          return\r\n        }\r\n\r\n        if (result && result.code === 'SUCCESS') {\r\n\r\n          // ⭐ 保存新的 license\r\n          await aardio.saveLocalKey(\r\n            this.username,\r\n            machineCode,\r\n            result.token\r\n          )\r\n\r\n          // ⭐ 更新全局 license\r\n          if (this.$license) {\r\n            this.$license.username = this.username\r\n            this.$license.machineCode = machineCode\r\n            this.$license.serverToken = result.token\r\n          }\r\n\r\n          this.successMessage = this.$t('changePasswordSuccess')\r\n\r\n          setTimeout(() => {\r\n\r\n            this.$router.push({\r\n              path: '/home',\r\n              query: { justLogin: '1' }\r\n            })\r\n\r\n          }, 1200)\r\n\r\n        } else {\r\n\r\n          this.errorMessage =\r\n            result?.message || this.$t('changePasswordFailed')\r\n\r\n        }\r\n\r\n      } catch (err) {\r\n\r\n        this.errorMessage =\r\n          this.$t('changePasswordException') + ': ' + err.message\r\n\r\n      } finally {\r\n\r\n        this.loading = false\r\n\r\n      }\r\n\r\n    },\r\n\r\n    goHome() {\r\n\r\n      // ⭐ 已登录\r\n      if (this.$license && this.$license.username) {\r\n\r\n        this.$router.push({\r\n          path: '/home',\r\n          query: { justLogin: '1' }\r\n        })\r\n\r\n      } else {\r\n\r\n        // ⭐ 未登录\r\n        this.$router.push('/login')\r\n\r\n      }\r\n\r\n    }\r\n\r\n  }\r\n\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n.v-card {\r\n  width: 90%;\r\n  max-width: 400px;\r\n}\r\n\r\n.text-red {\r\n  color: #e53935;\r\n}\r\n\r\n.text-green {\r\n  color: #43a047;\r\n}\r\n\r\n</style>","import { render } from \"./ChangePasswordPage.vue?vue&type=template&id=17dcc48a&scoped=true\"\nimport script from \"./ChangePasswordPage.vue?vue&type=script&lang=js\"\nexport * from \"./ChangePasswordPage.vue?vue&type=script&lang=js\"\n\nimport \"./ChangePasswordPage.vue?vue&type=style&index=0&id=17dcc48a&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['render',render],['__scopeId',\"data-v-17dcc48a\"]])\n\nexport default __exports__","import { createRouter, createWebHashHistory } from 'vue-router';\r\n\r\nimport Home from '../components/HomePage.vue';\r\nimport CreateAudio from '../components/CreateAudio.vue';\r\nimport CreateVideoProject from '../components/CreateVideoDialog.vue';\r\nimport EditVideoProject from '../components/EditVideoProject.vue';\r\n\r\nimport Login from '../components/LoginPage.vue';\r\nimport Register from '../components/RegisterPage.vue';\r\nimport ResetPassword from '../components/ResetPasswordPage.vue';\r\nimport ChangePassword from '../components/ChangePasswordPage.vue';\r\n\r\nconst routes = [\r\n  { path: '/', redirect: '/home' },\r\n\r\n  {\r\n    path: '/home',\r\n    name: 'Home',\r\n    component: Home,\r\n  },\r\n\r\n  {\r\n    path: '/create-audio',\r\n    name: 'CreateAudio',\r\n    component: CreateAudio,\r\n  },\r\n\r\n  {\r\n    path: '/create-video-project',\r\n    name: 'CreateVideoProject',\r\n    component: CreateVideoProject,\r\n  },\r\n\r\n  {\r\n    path: '/edit-video',\r\n    name: 'EditVideo',\r\n    component: EditVideoProject,\r\n    props: route => ({ projectPath: route.query.projectPath }),\r\n  },\r\n\r\n  // 🔐 认证相关\r\n  { path: '/login', name: 'Login', component: Login },\r\n  { path: '/register', name: 'Register', component: Register },\r\n\r\n  // 忘记密码 / 重置密码\r\n  { path: '/reset-password', name: 'ResetPassword', component: ResetPassword },\r\n\r\n  // 已登录用户修改密码\r\n  {\r\n    path: '/change-password',\r\n    name: 'ChangePassword',\r\n    component: ChangePassword,\r\n    // meta: { requiresAuth: true } // 后续可启用\r\n  },\r\n];\r\n\r\nconst router = createRouter({\r\n  history: createWebHashHistory(),\r\n  routes,\r\n});\r\n\r\nexport default router;\r\n","export default {\r\n  mainSlogan: \"蛋壳视界\",\r\n  secondSlogan: \"自媒体入门级软件，小白也能轻松做视频。\",\r\n  newVideoProject: \"新建视频项目\",\r\n  projectName: \"项目名称\",\r\n  path: \"路径\",\r\n  browseButton: \"浏览\",\r\n  width: \"宽度\",\r\n  height: \"高度\",\r\n  selectResolutionTemplate: \"选择分辨率模板\",\r\n  cancel: \"取消\",\r\n  confirm: \"确认\",\r\n  landscape1280x720: \"横屏1280 x 720\",\r\n  landscape1920x1080: \"横屏1920 x 1080\",\r\n  portrait720x1280: \"竖屏720 x 1280\",\r\n  portrait1080x1920: \"竖屏1080 x 1920\",\r\n  chooseReferenceVideo: \"选择参考视频\",\r\n  videoFileFilter: \"视频文件|*.mp4;*.mkv;*.avi\",\r\n  enterProjectName: \"请输入项目名称\",\r\n  invalidCharacters: \"名称包含非法字符：\\\\ / : * ? \\\" < > |\",\r\n  mustBePositiveInteger: \"必须是至少为 200 的正整数\",\r\n  enterValidProjectName: \"请输入有效的项目名称。\",\r\n  enterValidWidth: \"请输入有效的宽度。\",\r\n  enterValidHeight: \"请输入有效的高度。\",\r\n  projectAlreadyExists: \"当前目录已存在同名项目。\",\r\n\r\n  addNewClip: \"添加新片段\",\r\n  bodyText: \"正文\",\r\n  comment: \"备注\",\r\n  commentTooltip: \"这只是一份备注，有时正文使用外语，那么备注就可以是中文翻译，方便我们阅读。\",\r\n  rate: \"语速\",\r\n  speed: \"加速\",\r\n  pauseBefore: \"句前停顿\",\r\n  pauseAfter: \"句后停顿\",\r\n  language: \"语言\",\r\n  speaker: \"播音员\",\r\n  autoSplitSentences: \"自