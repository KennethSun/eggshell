å¯†ç  -->\r\n        <div class=\"d-flex justify-end mt-1 mb-3\">\r\n          <span\r\n            class=\"text-primary text-body-2 forgot-password\"\r\n            @click=\"goResetPassword\"\r\n          >\r\n            {{ $t('forgetPassword') }}\r\n          </span>\r\n        </div>\r\n\r\n        <!-- â­ ç™»å½•å¤±è´¥çš„æç¤º -->\r\n        <v-alert\r\n          v-if=\"errorMessage\"\r\n          type=\"error\"\r\n          variant=\"tonal\"\r\n          class=\"mt-3\"\r\n          density=\"comfortable\"\r\n        >\r\n          {{ errorMessage }}\r\n        </v-alert>\r\n      </v-card-text>\r\n\r\n      <v-card-actions class=\"d-flex justify-space-between\">\r\n        <v-btn\r\n          color=\"primary\"\r\n          @click=\"login\"\r\n          :loading=\"loading\"\r\n          >{{ $t('login') }}</v-btn\r\n        >\r\n        <v-btn variant=\"text\" @click=\"goRegister\">{{ $t('register') }}</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-container>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, inject } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport aardio from 'aardio'\r\nimport AppBrand from '@/components/AppBrand.vue'\r\n\r\nconst router = useRouter()\r\n\r\n// â­ èŽ·å–å…¨å±€ license\r\nconst license = inject('license')\r\n\r\nconst username = ref('')\r\nconst password = ref('')\r\nconst loading = ref(false)\r\nconst errorMessage = ref('')\r\n\r\nasync function login() {\r\n\r\n  errorMessage.value = ''\r\n  loading.value = true\r\n\r\n  try {\r\n\r\n    const machineCode = await aardio.getMachineCode()\r\n\r\n    const rawResult = await aardio.login(\r\n      username.value,\r\n      password.value,\r\n      machineCode\r\n    )\r\n\r\n    let result\r\n\r\n    try {\r\n      result = JSON.parse(rawResult)\r\n    } catch (e) {\r\n      throw new Error('Invalid response format: ' + rawResult)\r\n    }\r\n\r\n    switch (result.code) {\r\n\r\n      case 'SUCCESS':\r\n\r\n        // 1ï¸âƒ£ ä¿å­˜æœ¬åœ° license\r\n        await aardio.saveLocalKey(\r\n          username.value,\r\n          machineCode,\r\n          result.token\r\n        )\r\n\r\n        // 2ï¸âƒ£ æ›´æ–°å…¨å±€ license\r\n        license.username = username.value\r\n        license.machineCode = machineCode\r\n        license.serverToken = result.token\r\n\r\n        // 3ï¸âƒ£ è·³è½¬ä¸»é¡µ\r\n        router.push({\r\n          path: '/home',\r\n          query: { justLogin: '1' }\r\n        })\r\n\r\n        break\r\n\r\n      case 'TOO_MANY_DEVICES':\r\n\r\n        errorMessage.value = result.message\r\n\r\n        setTimeout(() => {\r\n          router.push('/change-password')\r\n        }, 1200)\r\n\r\n        break\r\n\r\n      default:\r\n\r\n        errorMessage.value = result?.message || 'Login failed'\r\n\r\n    }\r\n\r\n  } catch (err) {\r\n\r\n    errorMessage.value = 'Login exception: ' + err.message\r\n\r\n  } finally {\r\n\r\n    loading.value = false\r\n\r\n  }\r\n}\r\n\r\nfunction goRegister() {\r\n  router.push('/register')\r\n}\r\n\r\nfunction goResetPassword() {\r\n  router.push('/reset-password')\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.v-card {\r\n  width: 90%;\r\n  max-width: 400px;\r\n}\r\n\r\n/* é¼ æ ‡ç§»ä¸ŠåŽ»æœ‰æ‰‹åž‹ */\r\n.forgot-password {\r\n  cursor: pointer;\r\n}\r\n</style>\r\n","import script from \"./LoginPage.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./LoginPage.vue?vue&type=script&setup=true&lang=js\"\n\nimport \"./LoginPage.vue?vue&type=style&index=0&id=4ae07d4b&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['__scopeId',\"data-v-4ae07d4b\"]])\n\nexport default __exports__","<template>\r\n  <v-container\r\n    class=\"fill-height d-flex flex-column align-center justify-center\"\r\n  >\r\n    <!-- LOGOéƒ¨åˆ† -->\r\n    <div class=\"d-flex justify-center mb-6\">\r\n      <AppBrand size=\"large\" />\r\n    </div>\r\n    <v-card cla