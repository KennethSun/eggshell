  {{ errorMessage }}\r\n        </div>\r\n\r\n        <!-- æˆåŠŸæç¤º -->\r\n        <div v-if=\"successMessage\" class=\"text-green mt-2\">\r\n          {{ successMessage }}\r\n        </div>\r\n\r\n      </v-card-text>\r\n\r\n      <v-card-actions class=\"d-flex justify-space-between\">\r\n\r\n        <v-btn\r\n          color=\"primary\"\r\n          @click=\"changePassword\"\r\n          :loading=\"loading\"\r\n        >\r\n          {{ $t('confirm') }}\r\n        </v-btn>\r\n\r\n        <v-btn\r\n          variant=\"text\"\r\n          @click=\"goHome\"\r\n        >\r\n          {{ $t('backToHomePage') }}\r\n        </v-btn>\r\n\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport aardio from 'aardio'\r\nimport AppBrand from '@/components/AppBrand.vue'\r\n\r\nexport default {\r\n\r\n  components: { AppBrand },\r\n\r\n  data() {\r\n    return {\r\n      username: '',\r\n      machineCode: '',\r\n      currentPassword: '',\r\n      newPassword: '',\r\n      confirmNewPassword: '',\r\n      loading: false,\r\n      errorMessage: '',\r\n      successMessage: '',\r\n    }\r\n  },\r\n\r\n  mounted() {\r\n\r\n    // â­ å¦‚æžœå·²ç»ç™»å½•\r\n    if (this.$license && this.$license.username) {\r\n      this.username = this.$license.username\r\n      this.machineCode = this.$license.machineCode\r\n    }\r\n\r\n  },\r\n\r\n  methods: {\r\n\r\n    async changePassword() {\r\n\r\n      this.errorMessage = ''\r\n      this.successMessage = ''\r\n\r\n      if (!this.currentPassword) {\r\n        this.errorMessage = this.$t('currentPasswordEmpty')\r\n        return\r\n      }\r\n\r\n      if (!this.newPassword) {\r\n        this.errorMessage = this.$t('passwordEmpty')\r\n        return\r\n      }\r\n\r\n      if (this.newPassword !== this.confirmNewPassword) {\r\n        this.errorMessage = this.$t('passwordMismatch')\r\n        return\r\n      }\r\n\r\n      this.loading = true\r\n\r\n      try {\r\n\r\n        let machineCode = this.machineCode\r\n\r\n        // â­ æœªç™»å½•èŽ·å– machineCode\r\n        if (!machineCode) {\r\n          machineCode = await aardio.getMachineCode()\r\n        }\r\n\r\n        const rawResult = await aardio.changePassword(\r\n          this.username,\r\n          machineCode,\r\n          this.currentPassword,\r\n          this.newPassword\r\n        )\r\n\r\n        let result\r\n\r\n        try {\r\n          result = JSON.parse(rawResult)\r\n        } catch (e) {\r\n          this.errorMessage = \"Invalid response: \" + rawResult\r\n          this.loading = false\r\n          return\r\n        }\r\n\r\n        if (result && result.code === 'SUCCESS') {\r\n\r\n          // â­ ä¿å­˜æ–°çš„ license\r\n          await aardio.saveLocalKey(\r\n            this.username,\r\n            machineCode,\r\n            result.token\r\n          )\r\n\r\n          // â­ æ›´æ–°å…¨å±€ license\r\n          if (this.$license) {\r\n            this.$license.username = this.username\r\n            this.$license.machineCode = machineCode\r\n            this.$license.serverToken = result.token\r\n          }\r\n\r\n          this.successMessage = this.$t('changePasswordSuccess')\r\n\r\n          setTimeout(() => {\r\n\r\n            this.$router.push({\r\n              path: '/home',\r\n              query: { justLogin: '1' }\r\n            })\r\n\r\n          }, 1200)\r\n\r\n        } else {\r\n\r\n          this.errorMessage =\r\n            result?.message || this.$t('changePasswordFailed')\r\n\r\n        }\r\n\r\n      } catch (err) {\r\n\r\n        this.errorMessage =\r\n          this.$t('changePasswordException') + ': ' + err.message\r\n\r\n      } finally {\r\n\r\n        this.loading = false\r\n\r\n      }\r\n\r\n    },\r\n\r\n    goHome() {\r\n\r\n      // â­ å·²ç™»å½•\r\n      if (this.$license && this.$license.username) {\r\n\r\n        this.$router.push({\r\n          path: '/home',\r\n          query: { justLogin: '1' }\r\n        })\r\n\r\n      } else {\r\n\r\n        // â­ æœªç™»å½•\r\n        this.$router.push('/login')\r\n\r\n      }\r\n\r\n    }\r\n\r\n  }\r\n\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n.v-card {\r\n  width: 90%;\r\n  max-width: 400px;\r\n}\r\n\r\n.text-red {\r\n  color: #e53935;\r\n}\r\n\r\n.text-green {\r\n  color: #43a047;\r\n}\r\n\r\n</style>","import { render } from \"./ChangePasswordPage.vue?vue&type=template&id=17dcc48a&scoped=true\"\nimport script from \"./ChangePasswordPage.vue?vue&type=script&lang=js\"\nexport * from \"./ChangePasswordPage.vue?vue&type=script&lang=js\"\n\nimport \"./ChangePasswordPage.vue?vue&type=style&index=0&id=17dcc48a&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['render',render],['__scopeId',\"data-v-17dcc48a\"]])\n\nexport default __exports__","import { createRouter, createWebHashHistory } from 'vue-router';\r\n\r\nimport Home from '../components/HomePage.vue';\r\nimport CreateAudio from '../components/CreateAudio.vue';\r\nimport CreateVideoProject from '../components/CreateVideoDialog.vue';\r\nimport EditVideoProject from '../components/EditVideoProject.vue';\r\n\r\nimport Login from '../components/LoginPage.vue';\r\nimport Register from '../components/RegisterPage.vue';\r\nimport ResetPassword from '../components/ResetPasswordPage.vue';\r\nimport ChangePassword from '../components/ChangePasswordPage.vue';\r\n\r\nconst routes = [\r\n  { path: '/', redirect: '/home' },\r\n\r\n  {\r\n    path: '/home',\r\n    name: 'Home',\r\n    component: Home,\r\n  },\r\n\r\n  {\r\n    path: '/create-audio',\r\n    name: 'CreateAudio',\r\n    component: CreateAudio,\r\n  },\r\n\r\n  {\r\n    path: '/create-video-project',\r\n    name: 'CreateVideoProject',\r\n    component: CreateVideoProject,\r\n  },\r\n\r\n  {\r\n    path: '/edit-video',\r\n    name: 'EditVideo',\r\n    component: EditVideoProject,\r\n    props: route => ({ projectPath: route.quer