n      successMessage: '',\r\n    };\r\n  },\r\n  methods: {\r\n    async resetPassword() {\r\n      this.errorMessage = '';\r\n      this.successMessage = '';\r\n\r\n      if (!this.licenseCode) {\r\n        this.errorMessage = this.$t('licenseCodeEmpty');\r\n        return;\r\n      }\r\n\r\n      if (!this.newPassword) {\r\n        this.errorMessage = this.$t('passwordEmpty');\r\n        return;\r\n      }\r\n\r\n      if (this.newPassword !== this.confirmNewPassword) {\r\n        this.errorMessage = this.$t('passwordMismatch');\r\n        return;\r\n      }\r\n\r\n      this.loading = true;\r\n\r\n      try {\r\n        // è°ƒç”¨ Aardio ä¿®æ”¹å¯†ç æŽ¥å£ï¼ˆæŒ‰ä½ çš„å®žé™…å‘½åè°ƒæ•´ï¼‰\r\n        const rawResult = await aardio.resetPassword(this.licenseCode, this.newPassword);\r\n\r\n        let result;\r\n        try {\r\n          result = JSON.parse(rawResult);\r\n        } catch (e) {\r\n          this.errorMessage = \"Invalid response: \" + rawResult;\r\n          this.loading = false;\r\n          return;\r\n        }\r\n\r\n        if (result && result.success) {\r\n          this.successMessage = this.$t('resetPasswordSuccess');\r\n          setTimeout(() => this.$router.push('/login'), 1200);\r\n        } else {\r\n          this.errorMessage = result?.message || this.$t('resetPasswordFailed');\r\n        }\r\n      } catch (err) {\r\n        this.errorMessage =\r\n          this.$t('resetPasswordException') + ': ' + err.message;\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n\r\n    goLogin() {\r\n      this.$router.push('/login');\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.v-card {\r\n  width: 90%;\r\n  max-width: 400px;\r\n}\r\n.text-red {\r\n  color: #e53935;\r\n}\r\n.text-green {\r\n  color: #43a047;\r\n}\r\n</style>\r\n","import { render } from \"./ResetPasswordPage.vue?vue&type=template&id=c1b919ba&scoped=true\"\nimport script from \"./ResetPasswordPage.vue?vue&type=script&lang=js\"\nexport * f