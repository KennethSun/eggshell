GhD,GAAGwC,EAAS,IAAI3nB,EAAS2nB,EAAQzC,EAClC,CAEA,IADGuC,GAA4BA,EAA2BtrC,GACrDgG,EAAI0jC,EAAShqC,OAAQsG,IACzBolC,EAAU1B,EAAS1jC,GAChB+iC,EAAoBuB,EAAEa,EAAiBC,IAAYD,EAAgBC,IACrED,EAAgBC,GAAS,KAE1BD,EAAgBC,GAAW,EAE5B,OAAOrC,EAAoBU,EAAE5lB,EAC9B,EAEI4nB,EAAqBC,KAAK,4BAA8BA,KAAK,6BAA+B,GAChGD,EAAmBntB,QAAQ+sB,EAAqBM,KAAK,KAAM,IAC3DF,EAAmBtnC,KAAOknC,EAAqBM,KAAK,KAAMF,EAAmBtnC,KAAKwnC,KAAKF,G,IC/CvF,IAAIG,EAAsB7C,EAAoBU,OAAE7yB,EAAW,CAAC,MAAM,WAAa,OAAOmyB,EAAoB,KAAO,IACjH6C,EAAsB7C,EAAoBU,EAAEmC,E","sources":["webpack://vuetify-test/./src/App.vue","webpack://vuetify-test/./src/App.vue?7ccd","webpack://vuetify-test/./src/components/AppBrand.vue","webpack://vuetify-test/./src/components/AppBrand.vue?2bfe","webpack://vuetify-test/./src/components/CreateVideoDialog.vue","webpack://vuetify-test/./src/utils/CommonMethods.js","webpack://vuetify-test/./src/components/CreateVideoDialog.vue?c881","webpack://vuetify-test/./src/components/HomePage.vue","webpack://vuetify-test/./src/components/HomePage.vue?8b1a","webpack://vuetify-test/./src/components/CreateAudio.vue","webpack://vuetify-test/./src/components/CreateAudio.vue?2f89","webpack://vuetify-test/./src/components/EditVideoProject.vue","webpack://vuetify-test/./src/assets/variables.js","webpack://vuetify-test/./src/components/EditVideoProject.vue?bb6b","webpack://vuetify-test/./src/components/LoginPage.vue","webpack://vuetify-test/./src/components/LoginPage.vue?8d24","webpack://vuetify-test/./src/components/RegisterPage.vue","webpack://vuetify-test/./src/components/RegisterPage.vue?471c","webpack://vuetify-test/./src/components/ResetPasswordPage.vue","webpack://vuetify-test/./src/components/ResetPasswordPage.vue?702a","webpack://vuetify-test/./src/components/ChangePasswordPage.vue","webpack://vuetify-test/./src/components/ChangePasswordPage.vue?1ef0","webpack://vuetify-test/./src/router/index.js","webpack://vuetify-test/./src/locales/zh.js","webpack://vuetify-test/./src/locales/en.js","webpack://vuetify-test/./src/locales/i18n.js","webpack://vuetify-test/./src/plugins/vuetify.js","webpack://vuetify-test/./src/main.js","webpack://vuetify-test/webpack/bootstrap","webpack://vuetify-test/webpack/runtime/chunk loaded","webpack://vuetify-test/webpack/runtime/compat get default export","webpack://vuetify-test/webpack/runtime/define property getters","webpack://vuetify-test/webpack/runtime/global","webpack://vuetify-test/webpack/runtime/hasOwnProperty shorthand","webpack://vuetify-test/webpack/runtime/make namespace object","webpack://vuetify-test/webpack/runtime/node module decorator","webpack://vuetify-test/webpack/runtime/jsonp chunk loading","webpack://vuetify-test/webpack/startup"],"sourcesContent":["<template>\n  <v-app>\n    <v-main>\n      <router-view />\n    </v-main>\n  </v-app>\n</template>\n\n<script setup>\nimport { useTheme } from 'vuetify'\n\nconst theme = useTheme()\nconst savedTheme = localStorage.getItem('appTheme') || 'lightClean'\ntheme.global.name.value = savedTheme\n</script>\n","import script from \"./App.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./App.vue?vue&type=script&setup=true&lang=js\"\n\nconst __exports__ = script;\n\nexport default __exports__","<template>\r\n  <v-card\r\n    class=\"d-flex flex-column align-center pa-4 brand-card\"\r\n    elevation=\"0\"\r\n    :style=\"cardStyle\"\r\n     width=\"500\"\r\n  >\r\n                            <v-avatar class=\"ma-3\" rounded=\"0\" size=\"120\">\r\n    <!-- LOGO -->\r\n    <v-img\r\n      src=\"/eggshell.png\"\r\n      class=\"mb-3 brand-logo\"\r\n      alt=\"App Logo\"\r\n      contain\r\n    />\r\n                            </v-avatar>\r\n\r\n    <!-- ä¸»å®£ä¼ è¯­ -->\r\n    <div\r\n      :class=\"[\r\n        'text-center font-weight-bold',\r\n        isSmall ? 'text-h5' : 'text-h3'\r\n      ]\"\r\n      :style=\"{ color: primaryTextColor }\"\r\n    >\r\n      {{ $t('mainSlogan') }}\r\n    </div>\r\n\r\n    <!-- å‰¯å®£ä¼ è¯­ -->\r\n    <div\r\n      :class=\"[\r\n        'text-center mt-1',\r\n        isSmall ? 'text-h7' : 'text-h5'\r\n      ]\"\r\n      :style=\"{ color: secondaryTextColor }\"\r\n    >\r\n      {{ $t('secondSlogan') }}\r\n    </div>\r\n  </v-card>\r\n</template>\r\n\r\n<script setup>\r\n/* eslint-disable no-unused-vars */ \r\n/* eslint-disable no-undef */\r\nimport { computed } from 'vue'\r\nimport { useTheme } from 'vuetify'\r\n\r\n// âœ… å¦‚æžœå›¾ç‰‡åœ¨ public æ–‡ä»¶å¤¹é‡Œ\r\nconst props = defineProps({\r\n  size: { type: String, default: 'large' },\r\n  logoSrc: { type: String, default: '/eggshell2.ico' }, // âœ… è¿™é‡Œæ”¹ä¸º public çš„è·¯å¾„\r\n})\r\n\r\nconst isSmall = computed(() => props.size === 'small')\r\nconst theme = useTheme()\r\nconst isDark = computed(() => theme.global.current.value.dark)\r\n\r\n// âœ… èƒŒæ™¯é€æ˜Ž\r\nconst cardStyle = computed(() => ({\r\n  background: 'transparent',\r\n  borderRadius: '16px',\r\n  transition: 'transform 0.3s ease, box-shadow 0.3s ease',\r\n  animation: 'fadeIn 0.6s ease forwards',\r\n}))\r\n\r\nconst primaryTextColor = computed(() =>\r\n  isDark.value ? '#90caf9' : '#3f51b5'\r\n)\r\nconst secondaryTextColor = computed(() =>\r\n  isDark.value ? 'rgba(255, 255, 255, 0.7)' : 'rgba(0, 0, 0, 0.6)'\r\n)\r\n</script>\r\n\r\n<style scoped>\r\n.v-card {\r\n  border: none !important;\r\n}\r\n.brand-logo {\r\n  border-radius: 50%;\r\n  animation: float 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes float {\r\n  0%, 100% {\r\n    transform: translateY(0);\r\n  }\r\n  50% {\r\n    transform: translateY(-4px);\r\n  }\r\n}\r\n\r\n@keyframes fadeIn {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(12px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n</style>\r\n","import script from \"./AppBrand.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./AppBrand.vue?vue&type=script&setup=true&lang=js\"\n\nimport \"./AppBrand.vue?vue&type=style&index=0&id=01013beb&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['__scopeId',\"data-v-01013beb\"]])\n\nexport default __exports__","<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"600\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h6\">{{ $t('newVideoProject') }}</v-card-title>\r\n\r\n      <v-card-text>\r\n        <!-- åç§° -->\r\n        <v-text-field\r\n          v-model=\"newSequence.name\"\r\n          :label=\"$t('projectName')\"\r\n          :rules=\"[validateName]\"\r\n          clearable\r\n        />\r\n\r\n        <!-- è·¯å¾„ + æµè§ˆæŒ‰é’® -->\r\n        <v-row dense>\r\n          <v-col cols=\"9\">\r\n            <v-text-field\r\n              v-model=\"newSequence.path\"\r\n              :label=\"$t('path')\"\r\n              clearable\r\n              :error=\"!!pathError\"\r\n              :error-messages=\"pathError\"\r\n            />\r\n          </v-col>\r\n          <v-col cols=\"3\">\r\n            <v-btn color=\"primary\" block @click=\"browsePath\">{{ $t('browseButton') }}</v-btn>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <!-- å®½åº¦ + é«˜åº¦ + åˆ†è¾¨çŽ‡ä¸‹æ‹‰æ¡† -->\r\n        <v-row dense>\r\n          <v-col cols=\"3\">\r\n            <v-text-field\r\n              v-model.number=\"newSequence.outputSize.width\"\r\n              :label=\"$t('width')\"\r\n              type=\"number\"\r\n              :rules=\"[v => validateDimension(v, $t('width'))]\"\r\n            />\r\n          </v-col>\r\n          <v-col cols=\"3\">\r\n            <v-text-field\r\n              v-model.number=\"newSequence.outputSize.height\"\r\n              :label=\"$t('height')\"\r\n              type=\"number\"\r\n              :rules=\"[v => validateDimension(v, $t('height'))]\"\r\n            />\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-select\r\n              v-model=\"resolutionOption\"\r\n              :items=\"resolutions\"\r\n              :label=\"$t('selectResolutionTemplate')\