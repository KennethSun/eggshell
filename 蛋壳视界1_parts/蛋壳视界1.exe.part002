mbnail-right-icon {\r\n  position: absolute;\r\n  right: 4px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  background: rgba(0, 0, 0, 0.6);\r\n  color: #fff;\r\n  border-radius: 50%;\r\n  cursor: pointer;\r\n}\r\n\r\n.preview-right-icon {\r\n  position: absolute;\r\n  right: 4px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  background: rgba(0, 0, 0, 0.6);\r\n  color: #fff;\r\n  border-radius: 50%;\r\n  cursor: pointer;\r\n}\r\n.frame-range-text {\r\n  position: absolute;\r\n  left: 4px;\r\n  bottom: 4px;\r\n  font-size: 0.75rem;\r\n  color: white;\r\n  background: rgba(0, 0, 0, 0.5);\r\n  padding: 2px 4px;\r\n  border-radius: 2px;\r\n}\r\n.preview-overlay {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-size: 400% 300%;\r\n  background-repeat: no-repeat;\r\n  background-position: 0% 0%;\r\n  opacity: 0;\r\n  transition: opacity 0.3s;\r\n  pointer-events: none;\r\n}\r\n\r\n.preview-overlay.playing {\r\n  opacity: 1;\r\n  animation: preview-play 2s steps(1) infinite; /* 12å¸§ Ã· 24fps = 0.5ç§’ */\r\n}\r\n\r\n@keyframes preview-play {\r\n  0% {\r\n    background-position: 0% 0%;\r\n  }\r\n  8.33% {\r\n    background-position: 33.333% 0%;\r\n  }\r\n  16.67% {\r\n    background-position: 66.667% 0%;\r\n  }\r\n  25% {\r\n    background-position: 100% 0%;\r\n  }\r\n  33.33% {\r\n    background-position: 0% 50%;\r\n  }\r\n  41.67% {\r\n    background-position: 33.333% 50%;\r\n  }\r\n  50% {\r\n    background-position: 66.667% 50%;\r\n  }\r\n  58.33% {\r\n    background-position: 100% 50%;\r\n  }\r\n  66.67% {\r\n    background-position: 0% 100%;\r\n  }\r\n  75% {\r\n    background-position: 33.333% 100%;\r\n  }\r\n  83.33% {\r\n    background-position: 66.667% 100%;\r\n  }\r\n  91.67% {\r\n    background-position: 100% 100%;\r\n  }\r\n  100% {\r\n    background-position: 0% 0%;\r\n  }\r\n}\r\n.tab-item {\r\n  min-width: 160px; /* tab å®½åº¦å¯è°ƒ */\r\n  padding: 0 !important; /* åŽ»æŽ‰é»˜è®¤ padding */\r\n}\r\n/* é’ˆå¯¹æ‰€æœ‰æ»šåŠ¨æ¡ */\r\n::-webkit-scrollbar {\r\n  width: 3px; /* åž‚ç›´æ»šåŠ¨æ¡å®½åº¦ */\r\n  height: 8px; /* æ°´å¹³æ»šåŠ¨æ¡é«˜åº¦ */\r\n}\r\n\r\n/* æ»šåŠ¨æ¡è½¨é“ */\r\n::-webkit-scrollbar-track {\r\n  background: #f1f1f1;\r\n  border-radius: 4px;\r\n}\r\n\r\n/* æ»šåŠ¨æ¡æ»‘å— */\r\n::-webkit-scrollbar-thumb {\r\n  background: #888;\r\n  border-radius: 4px;\r\n}\r\n\r\n/* æ»‘å— hover */\r\n::-webkit-scrollbar-thumb:hover {\r\n  background: #555;\r\n}\r\n.compact-range-slider {\r\n  --v-slider-track-size: 4px; /* è½¨é“åŽšåº¦ */\r\n  --v-slider-thumb-size: 12px; /* æ»‘å—ç›´å¾„ */\r\n  --v-slider-track-inactive-opacity: 0.2;\r\n  padding-top: 0 !important;\r\n  padding-bottom: 0 !important;\r\n  margin-top: -4px; /* å‡å°‘ä¸Šä¸‹ç©ºç™½ */\r\n  margin-bottom: -14px;\r\n}\r\n\r\n.compact-range-slider .v-slider-track__container {\r\n  height: 4px !important;\r\n}\r\n\r\n.compact-range-slider .v-slider-thumb__surface {\r\n  width: 12px !important;\r\n  height: 12px !important;\r\n}\r\n.time-current,\r\n.time-total {\r\n  position: absolute;\r\n  bottom: 4px;\r\n  font-size: 0.75rem;\r\n  color: #fff;\r\n  background-color: rgba(0, 0, 0, 0.6);\r\n  padding: 2px 6px;\r\n  border-radius: 4px;\r\n}\r\n\r\n.time-current {\r\n  left: 6px;\r\n}\r\n\r\n.time-total {\r\n  right: 6px;\r\n}\r\n\r\n.v-card {\r\n  background-color: rgb(var(--v-theme-surface));\r\n  border: 1px solid #3a3a3a;\r\n  color: #e0e0e0;\r\n}\r\n\r\n.v-toolbar {\r\n  background-color: #2b2b2b !important;\r\n  border-bottom: 1px solid #333;\r\n}\r\n\r\n.v-slider-track__fill {\r\n  background-color: rgb(var(--v-theme-primary)) !important;\r\n}\r\n\r\n.v-slider-thumb {\r\n  border-color: rgb(var(--v-theme-primary)) !important;\r\n}\r\n\r\n.v-text-field input,\r\n.v-textarea textarea {\r\n  color: #e0e0e0 !important;\r\n}\r\n\r\n.v-data-table {\r\n  background-color: #1e1e1e !important;\r\n  color: #e0e0e0 !important;\r\n}\r\n\r\n.v-data-table-header {\r\n  background-color: #2b2b2b !important;\r\n}\r\n\r\n.v-data-table__tr:hover {\r\n  background-color: rgba(0, 188, 212, 0.1) !important;\r\n}\r\n\r\n/* å ä½å—è§†è§‰ */\r\n.library-placeholder,\r\n.timeline-placeholder,\r\n.property-placeholder {\r\n  background-color: #1e1e1e;\r\n  color: #9e9e9e;\r\n  border: 1px dashed #3a3a3a;\r\n  border-radius: 4px;\r\n  text-align: center;\r\n  padding: 40px 0;\r\n  font-size: 0.9rem;\r\n  user-select: none;\r\n}\r\n\r\n.timeline-row {\r\n  align-items: stretch !important; /* ä¿è¯æ‰€æœ‰åˆ—é«˜åº¦å¯¹é½ */\r\n}\r\n\r\n.timeline-col {\r\n  display: flex;\r\n  align-items: stretch;\r\n}\r\n\r\n.timeline,\r\n.paste-area {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n.selected-item {\r\n  background-color: rgba(33, 150, 243, 0.15); /* æµ…è“è‰²é€æ˜ŽèƒŒæ™¯ */\r\n  border-left: 3px solid #2196f3; /* å·¦ä¾§åŠ ä¸€ç‚¹æ ‡è¯†çº¿ï¼Œå¯é€‰ */\r\n  transition: background-color 0.2s ease;\r\n}\r\n\r\n.v-list-item:hover {\r\n  background-color: rgba(33, 150, 243, 0.08); /* æ‚¬åœæ—¶æ·¡è“ */\r\n}\r\n</style>\r\n","export var types = ['å›½å†…å½•éŸ³ç‰ˆ','å›½å¤–ä¸‹è½½ç‰ˆ'];\r\nexport var list_language_cn = [\r\n    { locale: 'zh-CN', localeName: 'ä¸­æ–‡(ä¸­å›½)' },\r\n    { locale: 'zh-CN-liaoning', localeName: 'ä¸­æ–‡(è¾½å®)' },\r\n    { locale: 'zh-CN-shaanxi', localeName: 'ä¸­æ–‡(é™•è¥¿)' },\r\n    { locale: 'zh-TW', localeName: 'ä¸­æ–‡(å°æ¹¾)' },\r\n    { locale: 'zh-HK', localeName: 'ä¸­æ–‡(é¦™æ¸¯)' },\r\n    { locale: 'en-US', localeName: 'è‹±è¯­(ç¾Žå›½)' },\r\n    { locale: 'en-AU', localeName: 'è‹±è¯­(æ¾³å¤§åˆ©äºš)' },\r\n    { locale: 'en-CA', localeName: 'è‹±è¯­(åŠ æ‹¿å¤§)' },\r\n    { locale: 'en-HK', localeName: 'è‹±è¯­(é¦™æ¸¯)' },\r\n    { locale: 'en-IN', localeName: 'è‹±è¯­(å°åº¦)' },\r\n    { locale: 'en-IE', localeName: 'è‹±è¯­(çˆ±å°”å…°)' },\r\n    { locale: 'en-KE', localeName: 'è‹±è¯­(è‚¯å°¼äºš)' },\r\n    { locale: 'en-NZ', localeName: 'è‹±è¯­(æ–°è¥¿å…°)' },\r\n    { locale: 'en-NG', localeName: 'è‹±è¯­(å°¼æ—¥åˆ©äºš)' },\r\n    { locale: 'en-PH', 