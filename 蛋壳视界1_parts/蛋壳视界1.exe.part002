         {{ $t('voiceLabel') }} {{ filters.voice.join(', ') }}\r\n                </v-chip>\r\n\r\n                <v-chip\r\n                  v-if=\"filters.audioPending\"\r\n                  closable\r\n                  @click:close=\"removeFilter('audioPending')\"\r\n                  color=\"orange\"\r\n                  class=\"ma-1\"\r\n                  size=\"small\"\r\n                >\r\n                  {{ $t('audioPendingLabel') }}\r\n                </v-chip>\r\n\r\n                <v-chip\r\n                  v-if=\"filters.videoPending\"\r\n                  closable\r\n                  @click:close=\"removeFilter('videoPending')\"\r\n                  color=\"red\"\r\n                  class=\"ma-1\"\r\n                  size=\"small\"\r\n                >\r\n                  {{ $t('videoPendingLabel') }}\r\n                </v-chip>\r\n              </div>\r\n            </v-col>\r\n          </v-row>\r\n\r\n          <!-- æ’­éŸ³å‘˜ç­›é€‰å¯¹è¯æ¡† -->\r\n          <v-card\r\n            v-if=\"voiceDialog\"\r\n            width=\"200\"\r\n            style=\"\r\n              position: absolute;\r\n              top: 80px;\r\n              left: 10px;\r\n              z-index: 1000;\r\n              box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);\r\n            \"\r\n          >\r\n            <v-card-text class=\"pa-2\">\r\n              <v-list>\r\n                <v-list-item v-for=\"voice in availableVoices\" :key=\"voice\">\r\n                  <template v-slot:prepend>\r\n                    <v-checkbox-btn\r\n                      color=\"primary\"\r\n                      v-model=\"selectedVoices\"\r\n                      :value=\"voice\"\r\n                    ></v-checkbox-btn>\r\n                  </template>\r\n                  <v-list-item-title>{{ voice }}</v-list-item-title>\r\n                </v-list-item>\r\n              </v-list>\r\n            </v-card-text>\r\n            <v-card-actions class=\"pa-2\">\r\n              <v-spacer></v-spacer>\r\n              <v-btn\r\n                color=\"error\"\r\n                size=\"small\"\r\n                @click=\"voiceDialog = false\"\r\n                >{{ $t('cancel') }}</v-btn\r\n              >\r\n              <v-btn\r\n                color=\"success\"\r\n                size=\"small\"\r\n                @click=\"applyVoiceFilter\"\r\n                >{{ $t('apply') }}</v-btn\r\n              >\r\n            </v-card-actions>\r\n          </v-card>\r\n\r\n          <v-row\r\n            v-if=\"isBatchGeneratingAudio\"\r\n            dense\r\n            class=\"align-center mt-2 ml-1\"\r\n          >\r\n            <v-col cols=\"12\">\r\n              <v-card color=\"info\" variant=\"tonal\">\r\n                <v-card-text class=\"pa-2\">\r\n                  <v-row align=\"center\" dense>\r\n                    <v-col cols=\"8\">\r\n                      <div class=\"text-caption\">\r\n                        {{ $t('batchAudioGenerating') }}\r\n                      </div>\r\n                      <v-progress-linear\r\n                        v-model=\"batchAudioGenerationProgress\"\r\n                        color=\"primary\"\r\n                        height=\"8\"\r\n                        striped\r\n                      ></v-progress-linear>\r\n                      <div class=\"text-caption\">\r\n                        {{ $t('progressLabel') }}:\r\n                        {{ currentBatchAudioIndex}}/{{ totalBatchAudioCount }}\r\n                        ({{ batchAudioGenerationProgress }}%)\r\n                      </div>\r\n                    </v-col>\r\n                    <v-col cols=\"4\" class=\"text-right\">\r\n                      <v-btn\r\n                        color=\"error\"\r\n                        size=\"small\"\r\n                        @click=\"cancelBatchAudioGeneration = true\"\r\n                        :disabled=\"!isBatchGeneratingAudio\"\r\n                      >\r\n                        {{ $t('cancel') }}\r\n                      </v-btn>\r\n                    </v-col>\r\n                  </v-row>\r\n                </v-card-text>\r\n              </v-card>\r\n            </v-col>\r\n          </v-row>\r\n\r\n          <v-row\r\n            v-if=\"isBatchGeneratingVideo\"\r\n            dense\r\n            class=\"align-center mt-2 ml-1\"\r\n          >\r\n            <v-col cols=\"12\">\r\n              <v-card color=\"info\" variant=\"tonal\">\r\n                <v-card-text class=\"pa-2\">\r\n                  <v-row align=\"center\" dense>\r\n                    <v-col cols=\"8\">\r\n                      <div class=\"text-caption\">\r\n                        {{ $t('batchVideoGenerating') }}\r\n                      </div>\r\n                      <v-progress-linear\r\n                        v-model=\"batchVideoGenerationProgress\"\r\n                        color=\"primary\"\r\n                        height=\"8\"\r\n                        striped\r\n                      ></v-progress-linear>\r\n                      <div class=\"text-caption\">\r\n                        {{ $t('progressLabel') }}:\r\n                        {{ currentBatchVideoIndex}}/{{ totalBatchVideoCount }}\r\n                        ({{ batchVideoGenerationProgress }}%)\r\n                      </div>\r\n                    </v-col>\r\n                    <v-col cols=\"4\" class=\"text-right\">\r\n                      <v-btn\r\n                        color=\"error\"\r\n                        size=\"small\"\r\n                        @click=\"cancelBatchVideoGeneration = true\"\r\n                        :disabled=\"!isBatchGeneratingVideo\"\r\n                      >\r\n                        {{ $t('cancel') }}\r\n                      </v-btn>\r\n                    </v-col>\r\n                  </v-row>\r\n                </v-card-text>\r\n              </v-card>\r\n            </v-col>\r\n          </v-row>\r\n\r\n          <v-row dense>\r\n            <v-list\r\n              density=\"compact\"\r\n              :style=\"{ maxHeight: `calc(100vh - 185px)`, overflowY: 'auto' }\"\r\n              class=\"sidebar-list\"\r\n              :disabled=\"isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n            >\r\n              <template\r\n                v-for=\"(clip, index) in sequence.clips\"\r\n                :key=\"clip.id || index\"\r\n              >\r\n                <v-list-item\r\n                  class=\"my-0 pr-0\"\r\n                  @click=\"selectClip(index)\"\r\n                  :class=\"{ 'selected-item': sequence.selectedIndex === index }\"\r\n                >\r\n                  <template #prepend>\r\n                    <div\r\n                      class=\"image-container\"\r\n                      :style=\"{width: `${itemPreviewWidth * sequence.clipThumbnailScale}px`, height: `${itemPreviewHeight * sequence.clipThumbnailScale}px`, position: 'relative', overflow: 'hidden', backgroundColor: '#000000ff'}\"\r\n                    >\r\n                      <img\r\n                        v-if=\"clip.scenes && clip.scenes.length > 0\"\r\n                        :src=\"clip.scenes[0].base64Thumbnail\"\r\n                        :style=\"getItemContentStyle(clip.scenes[0], sequence.clipThumbnailScale)\"\r\n                      />\r\n                      <div\r\n                        class=\"time-overlay\"\r\n                        :style=\"getClipDurationStyle(clip)\"\r\n                      >\r\n                        {{ formatTime(getClipDuration(clip)) }}\r\n                      </div>\r\n                    </div>\r\n                  </template>\r\n\r\n                  <template #default>\r\n                    <div class=\"flex-column px-1 w-100\">\r\n                      <div class=\"item-title\">\r\n                        {{ clip.sentence || $t('noTextContent') }}\r\n                      </div>\r\n                      <div class=\"item-meta d-flex mt-0\">\r\n                        <span style=\"white-space: pre\">\r\n                          {{ String(index + 1).padStart(3, ' ') }}\r\n                        </span>\r\n                        <v-divider vertical class=\"mx-2\" />\r\n                        <span>\r\n                          <!-- éŸ³é¢‘å›¾æ ‡ï¼šç‚¹å‡»å±•å¼€èœå• -->\r\n                          <v-icon\r\n                            :color=\"clip.narration?.audioMedia?.duration > 0 ? 'purple' : 'grey'\"\r\n                            @click=\"openFileInFolder(clip.narration.audioMedia.filePath)\"\r\n                          >\r\n                            {{ mdiWaveform }}\r\n                          </v-icon>\r\n                        </span>\r\n                        <v-divider vertical class=\"mx-2\" />\r\n                        <span>\r\n                          <!-- è§†é¢‘å›¾æ ‡ï¼šç‚¹å‡»å±•å¼€èœå• -->\r\n                          <v-icon\r\n                            :color=\"getVideoIconColor(clip)\"\r\n                            @click=\"openFileInFolder(clip.videoMedia.filePath)\"\r\n                          >\r\n                            {{ mdiVideoVintage }}\r\n                          </v-icon>\r\n                        </span>\r\n                        <v-divider vertical class=\"mx-2\" />\r\n                        <span style=\"white-space: pre\">\r\n                          {{ (clip.narration?.voiceName || '').slice(0, 10).padEnd(10, ' ') }}\r\n                        </span>\r\n\r\n                        <v-divider\r\n                          v-if=\"isBatchGeneratingAudio && currentBatchAudioIndex === index\"\r\n                          vertical\r\n                          class=\"mx-2\"\r\n                        />\r\n                        <span\r\n                          v-if=\"isBatchGeneratingAudio && currentBatchAudioIndex === index\"\r\n                          class=\"ml-1 text-primary text-caption\"\r\n                          style=\"white-space: nowrap\"\r\n                        >\r\n                          {{ $t('generatingAudioNow') }}\r\n                        </span>\r\n                        <v-divider\r\n                          v-if=\"isBatchGeneratingVideo && currentBatchVideoIndex === index\"\r\n                          vertical\r\n                          class=\"mx-2\"\r\n                        />\r\n                        <span\r\n                          v-if=\"isBatchGeneratingVideo && currentBatchVideoIndex === index\"\r\n                          class=\"ml-1 text-primary text-caption\"\r\n                          style=\"white-space: nowrap\"\r\n                        >\r\n                          {{ $t('generatingVideoNow') }}\r\n                        </span>\r\n                        <v-spacer></v-spacer><v-spacer></v-spacer>\r\n                        <v-checkbox-btn\r\n                          color=\"primary\"\r\n                          :model-value=\"isClipSelected(index)\"\r\n                          @click.stop=\"toggleClipSelection(index)\"\r\n                          density=\"compact\"\r\n                          hide-details\r\n                        ></v-checkbox-btn>\r\n                      </div>\r\n                    </div>\r\n                  </template>\r\n                </v-list-item>\r\n              </template>\r\n            </v-list>\r\n          </v-row>\r\n\r\n          <v-row v-show=\"false\" dense class=\"justify-end align-center mt-2\">\r\n            <v-icon\r\n              size=\"x-small\"\r\n              @click=\"sequence.clipThumbnailScale = Math.max(0.5, sequence.clipThumbnailScale - 0.1)\"\r\n            >\r\n              {{ mdiMinus }}\r\n            </v-icon>\r\n\r\n            <span class=\"mx-2\" style=\"min-width: 40px; text-align: center\">\r\n              {{ Math.round(sequence.clipThumbnailScale * 100) }}%\r\n            </span>\r\n\r\n            <v-icon\r\n              size=\"x-small\"\r\n              @click=\"sequence.clipThumbnailScale = Math.min(2.0, sequence.clipThumbnailScale + 0.1)\"\r\n            >\r\n              {{ mdiPlus }}\r\n            </v-icon>\r\n          </v-row>\r\n\r\n          <v-row dense style=\"height: 10px;\">\r\n            <v-text-field\r\n              variant=\"outlined\"\r\n              :label=\"$t('projectPathLabel')\"\r\n              v-model=\"projectDirectory\"\r\n              readonly\r\n            ></v-text-field>\r\n          </v-row>\r\n        </v-col>\r\n\r\n        <!-- å³ä¾§å†…å®¹åŒºåŸŸ (9/12å®½åº¦) -->\r\n        <v-col>\r\n          <v-card class=\"my-3 pa-2\">\r\n            <v-row dense align=\"stretch\" class=\"timeline-row\" style=\"height: 100px;\">\r\n              <!-- å·¦ä¾§å§‹ç»ˆä¸ºç©ºç™½ -->\r\n              <v-col cols=\"1\" class=\"text-center pa-0\"></v-col>\r\n\r\n              <!-- ä¸­é—´æ—¶é—´è½´åŒºåŸŸ -->\r\n              <v-col\r\n                cols=\"10\"\r\n                class=\"text-center pa-0 timeline-col\"\r\n                v-if=\"editedClip.scenes && editedClip.scenes.length > 0\"\r\n              >\r\n                <div\r\n                  ref=\"timeline\"\r\n                  class=\"timeline\"\r\n                  :style=\"{ height: `${itemPreviewHeight * sequence.sceneThumbnailScale}px` }\"\r\n                >\r\n                  <div\r\n                    v-for=\"(scene, index) in editedClip.scenes\"\r\n                    :key=\"index\"\r\n                    class=\"segment\"\r\n                    :style=\"getSegmentStyle(editedClip, scene)\"\r\n                    @click=\"selectScene(index)\"\r\n                    tabindex=\"0\"\r\n                    @paste=\"replaceSceneWithPaste(editedClip.editedSceneIndex)\"\r\n                  >\r\n                    <!-- æ‹–åŠ¨æ‰‹æŸ„ -->\r\n                    <div\r\n                      v-if=\"index < editedClip.scenes.length - 1\"\r\n                      class=\"handle\"\r\n                      @mousedown=\"startDrag($event, index)\"\r\n                    ></div>\r\n\r\n                    <!-- æ—¶é•¿æ–‡å­— -->\r\n                    <div\r\n                      class=\"duration-text1\"\r\n                      style=\"font-size: 150%\"\r\n                      :style=\"getDurationClass(editedClip, scene)\"\r\n                    >\r\n                      {{ formatSeconds(getSceneDuration(editedClip, scene)) }}\r\n                    </div>\r\n\r\n                    <!-- å·¦ç§»æŒ‰é’® -->\r\n                    <v-btn\r\n                      v-if=\"index > 0\"\r\n                      icon\r\n                      color=\"transparent\"\r\n                      size=\"x-small\"\r\n                      @click.stop=\"moveSceneLeft(index)\"\r\n                      style=\"\r\n                        position: absolute;\r\n                        top: 50%;\r\n                        left: 12px;\r\n                        transform: translateY(-50%);\r\n                        z-index: 2;\r\n                      \"\r\n                    >\r\n                      <v-icon color=\"white\">{{ mdiChevronLeft }}</v-icon>\r\n                    </v-btn>\r\n\r\n                    <!-- åˆ é™¤æŒ‰é’® -->\r\n                    <v-btn\r\n                      icon\r\n                      color=\"transparent\"\r\n                      size=\"small\"\r\n                      @click.stop=\"removeScene(index)\"\r\n                      style=\"\r\n                        position: absolute;\r\n                        top: 0px;\r\n                        right: 12px;\r\n                        z-index: 2;\r\n                      \"\r\n                    >\r\n                      <v-icon color=\"error\">{{ mdiDelete }}</v-icon>\r\n                    </v-btn>\r\n                  </div>\r\n                </div>\r\n              </v-col>\r\n\r\n              <!-- æ— åœºæ™¯æ—¶ï¼Œä¸­é—´åŒºåŸŸå…è®¸ç²˜è´´ -->\r\n              <v-col\r\n                v-else\r\n                cols=\"10\"\r\n                class=\"text-center pa-0 timeline-col\"\r\n                @paste=\"handlePaste\"\r\n              >\r\n                <div\r\n                  class=\"d-flex flex-column align-center justify-center paste-area\"\r\n                  :style=\"{ height: `${itemPreviewHeight * sequence.sceneThumbnailScale}px` }\"\r\n                >\r\n                  {{ $t('pasteHintPrefix') }}\r\n                  <v-btn\r\n                    color=\"primary\"\r\n                    density=\"compact\"\r\n                    min-width=\"auto\"\r\n                    class=\"ma-1\"\r\n                    style=\"height: 50px;font-size: 200%\"\r\n                    @click=\"handlePaste\"\r\n                  >\r\n                    {{ $t('pasteButton') }}\r\n                  </v-btn>\r\n                  {{ $t('pasteHintSuffix') }}\r\n                </div>\r\n              </v-col>\r\n\r\n              <!-- å³ä¾§å§‹ç»ˆå…è®¸ç²˜è´´ -->\r\n              <v-col\r\n                cols=\"1\"\r\n                class=\"text-center pa-0 timeline-col\"\r\n                @paste=\"handlePaste\"\r\n              >\r\n                <div\r\n                  class=\"d-flex flex-column align-center justify-center paste-area\"\r\n                  :style=\"{ height: `${itemPreviewHeight * sequence.sceneThumbnailScale}px` }\"\r\n                >\r\n                  {{ $t('pasteHintPrefix') }}\r\n                  <v-btn\r\n                    color=\"primary\"\r\n                    density=\"compact\"\r\n                    min-width=\"auto\"\r\n                    class=\"ma-1\"\r\n                    style=\"height: 50px;font-size: 200%\"\r\n                    @click=\"handlePaste\"\r\n                  >\r\n                    {{ $t('pasteButton') }}\r\n                  </v-btn>\r\n                  {{ $t('pasteHintSuffix') }}\r\n                </div>\r\n              </v-col>\r\n            </v-row>\r\n\r\n            <v-row dense align=\"center\" style=\"flex-wrap: nowrap; height: 20px;\">\r\n              <!-- æ’­æ”¾æŒ‰é’® -->\r\n              <v-col cols=\"1\" class=\"text-right\">\r\n                <v-icon\r\n                  size=\"36\"\r\n                  class=\"rounded-circle pa-1\"\r\n                  v-if=\"editedClip.narration?.audioMedia?.duration > 0\"\r\n                  @click=\"toggleAudioPlayback\"\r\n                >\r\n                  {{ isPlaying ? mdiPause : mdiPlay }}\r\n                </v-icon>\r\n                <span\r\n                  v-if=\"editedClip.narration?.audioMedia?.duration > 0\"\r\n                  >{{ (currentTime ?? 0).toFixed(2) }}</span\r\n                >\r\n              </v-col>\r\n\r\n              <!-- æ³¢å½¢å›¾ -->\r\n              <v-col cols=\"10\" class=\"text-center pa-0\">\r\n                <div ref=\"waveform\"></div>\r\n\r\n                <div v-if=\"editedClip.narration?.audioMedia?.duration <= 0\">\r\n                  {{ $t('noAudioPleaseGenerate') }}\r\n                </div>\r\n              </v-col>\r\n              <v-col cols=\"1\">\r\n                <span\r\n                  v-if=\"editedClip.narration?.audioMedia?.duration > 0\"\r\n                  >{{ (totalTime ?? 0).toFixed(2) }}</span\r\n                >\r\n              </v-col>\r\n            </v-row>\r\n          </v-card>\r\n\r\n          <v-row dense style=\"flex-wrap: nowrap\">\r\n            <v-col style=\"flex: 1 1 auto\">\r\n              <v-card\r\n                class=\"mb-4\"\r\n                color=\"surface\"\r\n                :disabled=\"isBatchGeneratingAudio\"\r\n              >\r\n                <v-card-text class=\"pa-1\">\r\n                  <v-row\r\n                    dense\r\n                    align=\"stretch\"\r\n                    class=\"mb-n1\"\r\n                    style=\"flex-wrap: nowrap; height: 220px;\"\r\n                  >\r\n                    <!-- å·¦ä¾§ -->\r\n                    <v-col class=\"px-1\" style=\"flex: 1 1 auto\">\r\n                      <v-row dense style=\"height: 155px;\">\r\n                        <v-col cols=\"12\" class=\"px-1 py-0\" style=\"position: relative;\">\r\n                          <!-- æŽ§åˆ¶å­—ä½“çš„å›¾æ ‡ -->\r\n                          <div\r\n                            style=\"position: absolute; top: 6px; right: 20px; display: flex; gap: 4px; z-index: 10;\"\r\n                          >\r\n                            <v-icon size=\"x-small\" @click=\"decreaseSentenceFontSize\">{{ mdiMinus }}</v-icon>\r\n                            <v-icon size=\"x-small\" @click=\"increaseSentenceFontSize\">{{ mdiPlus }}</v-icon>\r\n                          </div>\r\n                          <!-- sentence è¾“å…¥æ¡† -->\r\n                          <v-textarea\r\n                            outlined\r\n                            :label=\"$t('contentLabel')\"\r\n                            v-model=\"editedClip.sentence\"\r\n                            autofocus\r\n                            class=\"large-textarea\"\r\n                            :style=\"{ '--textarea-font-size': fontSize + 'px' }\"\r\n                          ></v-textarea>\r\n                        </v-col>\r\n                      </v-row>\r\n\r\n                      <v-row dense style=\"height: 80px;\">\r\n                        <v-col cols=\"12\" class=\"px-1 py-0\">\r\n                          <!-- comment1 è¾“å…¥æ¡† + tooltip -->\r\n                          <v-tooltip\r\n                            :disabled=\"!enableTooltips\"\r\n                            location=\"bottom\"\r\n                            open-on-hover\r\n                          >\r\n                            <template v-slot:activator=\"{ props }\">\r\n                              <v-textarea\r\n                                outlined\r\n                                :label=\"$t('commentLabel')\"\r\n                                v-model=\"editedClip.comment1\"\r\n                                rows=\"1\"\r\n                                v-bind=\"props\"\r\n                                class=\"second-large-textarea\"\r\n                              ></v-textarea>\r\n                            </template>\r\n                            {{ $t('noteTooltip') }}\r\n                          </v-tooltip>\r\n                        </v-col>\r\n                      </v-row>\r\n                    </v-col>\r\n                    <!-- å³ä¾§ -->\r\n                    <v-col class=\"px-1\" style=\"flex: 0 0 250px\">\r\n                      <v-row dense style=\"height: 50px;\">\r\n                        <v-col cols=\"6\" class=\"px-1 py-0\">\r\n                          <v-number-input\r\n                            v-model=\"editedClip.narration.rate\"\r\n                            :label=\"$t('rateLabel')\"\r\n                            density=\"compact\"\r\n                            :min=\"0.75\"\r\n                            :max=\"1.5\"\r\n                            :step=\"0.05\"\r\n                            :suffix=\"$t('times')\"\r\n                            control-variant=\"stacked\"\r\n                          />\r\n                        </v-col>\r\n                        <v-col cols=\"6\" class=\"px-1 py-0\">\r\n                          <v-number-input\r\n                            v-model=\"editedClip.narration.speed\"\r\n                            :label=\"$t('speedLabel')\"\r\n                            density=\"compact\"\r\n                            :min=\"0.5\"\r\n                            :max=\"3\"\r\n                            :step=\"0.01\"\r\n                            :suffix=\"$t('times')\"\r\n                            control-variant=\"stacked\"\r\n                          />\r\n                        </v-col>\r\n                      </v-row>\r\n\r\n                      <v-row dense style=\"height: 50px;\">\r\n                        <v-col cols=\"6\" class=\"px-1 py-0\">\r\n                          <v-number-input\r\n                            v-model=\"editedClip.narration.pauseBefore\"\r\n                            :label=\"$t('pauseBeforeLabel')\"\r\n                            density=\"compact\"\r\n                            :min=\"0.2\"\r\n                            :max=\"1\"\r\n                            :step=\"0.05\"\r\n                            :suffix=\"$t('seconds')\"\r\n                            control-variant=\"stacked\"\r\n                          />\r\n                        </v-col>\r\n                        <v-col cols=\"6\" class=\"px-1 py-0\">\r\n                          <v-number-input\r\n                            v-model=\"editedClip.narration.pauseAfter\"\r\n                            :label=\"$t('pauseAfterLabel')\"\r\n                            density=\"compact\"\r\n                            :min=\"0.2\"\r\n                            :max=\"1\"\r\n                            :step=\"0.05\"\r\n                            :suffix=\"$t('seconds')\"\r\n                            control-variant=\"stacked\"\r\n                          />\r\n                        </v-col>\r\n                      </v-row>\r\n\r\n                      <v-row dense style=\"height: 50px;\">\r\n                        <v-col cols=\"6\" class=\"px-1 py-0\">\r\n                          <v-select\r\n                            v-model=\"editedClip.narration.locale\"\r\n                            :items=\"list_language_cn.map(lang => lang.locale)\"\r\n                            density=\"compact\"\r\n                            :label=\"$t('languageLabel')\"\r\n                            @update:modelValue=\"onEditedClipLanguageChange\"\r\n                          />\r\n                        </v-col>\r\n                        <v-col cols=\"6\" class=\"px-1 py-0\">\r\n                          <v-select\r\n                            v-model=\"editedClip.narration.voiceName\"\r\n                            :items=\"voiceItems\"\r\n                            density=\"compact\"\r\n                            :label=\"$t('voiceLabelShort')\"\r\n                          />\r\n                        </v-col>\r\n                      </v-row>\r\n                      <v-row dense style=\"height: 100px;\">\r\n                        <v-col class=\"d-flex justify-center px-1 py-0\">\r\n                          <v-btn\r\n                            style=\"height: 60px;font-size: 300%\"\r\n                            :color=\"isGeneratingAudio ? 'error' : 'primary'\"\r\n                            @click=\"generateAudio_click(editedClip)\"\r\n                          >\r\n                            {{ isGeneratingAudio ? $t('cancel') : $t('generateAudioButton') }}\r\n                          </v-btn>\r\n                        </v-col>\r\n                      </v-row>\r\n                    </v-col>\r\n                  </v-row>\r\n                </v-card-text>\r\n              </v-card>\r\n            </v-col>\r\n\r\n            <v-col\r\n              class=\"px-1\"\r\n              :style=\"`flex: 0 0 auto; min-width: ${scenePreviewWidth + 120}px; max-width: ${scenePreviewWidth + 120}px;`\"\r\n            >\r\n              <!-- âœ… å•ç‹¬çš„ v-cardï¼Œç”¨äºŽæ˜¾ç¤ºå½“å‰é€‰ä¸­çš„åœºæ™¯ -->\r\n              <v-card\r\n                ref=\"card-editedScene\"\r\n                class=\"mb-4\"\r\n              >\r\n                <v-card-text class=\"pa-2\">\r\n                  <v-row dense class=\"mb-n2\" style=\"flex-wrap: nowrap\">\r\n                    <v-col\r\n                      cols=\"auto\"\r\n                      :style=\"`flex: 0 0 auto; min-width: ${scenePreviewWidth + 10}px;`\"\r\n                    >\r\n                      <v-row dense class=\"g-0\">\r\n                        <div\r\n                          class=\"scene-container\"\r\n                          :style=\"{\r\n                            width: `${scenePreviewWidth}px`,\r\n                            height: `${scenePreviewHeight}px`,\r\n                            minWidth: `${scenePreviewWidth}px`,\r\n                            minHeight: `${scenePreviewHeight}px`,\r\n                            position: 'relative',\r\n                            overflow: 'hidden',\r\n                            backgroundColor: '#000000ff'\r\n                          }\"\r\n                        >\r\n                          <img\r\n                            tabindex=\"0\"\r\n                            :src=\"editedScene.base64Thumbnail\"\r\n                            class=\"scene-content\"\r\n                            :style=\"getSceneContentStyle(editedScene)\"\r\n                            @paste=\"replaceSceneWithPaste(editedClip.editedSceneIndex)\"\r\n                          />\r\n\r\n                          <div\r\n                            class=\"duration-text\"\r\n                            :class=\"getDurationClass(editedClip, editedScene)\"\r\n                          >\r\n                            {{ formatSeconds(getSceneDuration(editedClip, editedScene)) }}\r\n                          </div>\r\n\r\n                          <!-- å·¦ä¾§æŒ‰é’®: + / - -->\r\n                          <div\r\n                            style=\"\r\n                              position: absolute;\r\n                              left: 0;\r\n                              top: 50%;\r\n                              transform: translateY(-50%);\r\n                              display: flex;\r\n                              flex-direction: column;\r\n                              align-items: center;\r\n                              gap: 8px;\r\n                              z-index: 10;\r\n                            \"\r\n                          >\r\n                            <v-btn\r\n                              icon\r\n                              size=\"small\"\r\n                              color=\"transparent\"\r\n                              @mousedown=\"handleButtonDown('zoom-in', editedScene)\"\r\n                              @mouseup=\"handleButtonUp\"\r\n                              @mouseleave=\"handleButtonUp\"\r\n                              :title=\"$t('zoomIn')\"\r\n                            >\r\n                              <v-icon>{{ mdiPlus }}</v-icon>\r\n                            </v-btn>\r\n                            <v-btn\r\n                              icon\r\n                              size=\"small\"\r\n                              color=\"transparent\"\r\n                              @mousedown=\"handleButtonDown('zoom-out', editedScene)\"\r\n                              @mouseup=\"handleButtonUp\"\r\n                              @mouseleave=\"handleButtonUp\"\r\n                              :title=\"$t('zoomOut')\"\r\n                            >\r\n                              <v-icon>{{ mdiMinus }}</v-icon>\r\n                            </v-btn>\r\n                          </div>\r\n\r\n                          <!-- å³ä¾§æŒ‰é’®: æ–¹å‘é”® -->\r\n                          <div\r\n                            style=\"\r\n                              position: absolute;\r\n                              right: 0;\r\n                              top: 50%;\r\n                              transform: translateY(-50%);\r\n                              display: flex;\r\n                              flex-direction: column;\r\n                              align-items: center;\r\n                              gap: 0px;\r\n                              z-index: 10;\r\n                            \"\r\n                          >\r\n                            <!-- ä¸Š -->\r\n                            <v-btn\r\n                              icon\r\n                              size=\"small\"\r\n                              color=\"transparent\"\r\n                              @mousedown=\"handleButtonDown('move-up', editedScene)\"\r\n                              @mouseup=\"handleButtonUp\"\r\n                              @mouseleave=\"handleButtonUp\"\r\n                              :title=\"$t('moveUp')\"\r\n                            >\r\n                              <v-icon>{{ mdiChevronUp }}</v-icon>\r\n                            </v-btn>\r\n\r\n                            <!-- å·¦å³ä¸€è¡Œ -->\r\n                            <div style=\"display: flex; gap: 4px; margin: 4px 0\">\r\n                              <v-btn\r\n                                icon\r\n                                size=\"small\"\r\n                                color=\"transparent\"\r\n                                @mousedown=\"handleButtonDown('move-left', editedScene)\"\r\n                                @mouseup=\"handleButtonUp\"\r\n                                @mouseleave=\"handleButtonUp\"\r\n                                :title=\"$t('moveLeft')\"\r\n                              >\r\n                                <v-icon>{{ mdiChevronLeft }}</v-icon>\r\n                              </v-btn>\r\n                              <v-btn\r\n                                icon\r\n                                size=\"small\"\r\n                                color=\"transparent\"\r\n                                @mousedown=\"handleButtonDown('move-right', editedScene)\"\r\n                                @mouseup=\"handleButtonUp\"\r\n                                @mouseleave=\"handleButtonUp\"\r\n                                :title=\"$t('moveRight')\"\r\n                              >\r\n                                <v-icon>{{ mdiChevronRight }}</v-icon>\r\n                              </v-btn>\r\n                            </div>\r\n\r\n                            <!-- ä¸‹ -->\r\n                            <v-btn\r\n                              icon\r\n                              size=\"small\"\r\n                              color=\"transparent\"\r\n                              @mousedown=\"handleButtonDown('move-down', editedScene)\"\r\n                              @mouseup=\"handleButtonUp\"\r\n                              @mouseleave=\"handleButtonUp\"\r\n                              :title=\"$t('moveDown')\"\r\n                            >\r\n                              <v-icon>{{ mdiChevronDown }}</v-icon>\r\n                            </v-btn>\r\n                          </div>\r\n                        </div>\r\n                      </v-row>\r\n\r\n                      <!-- å¸§èŒƒå›´æ»‘å— -->\r\n                      <v-row dense class=\"g-0 mb-n2\" style=\"height: 24px;\">\r\n                        <v-range-slider\r\n                          density=\"compact\"\r\n                          v-model=\"editedScene.frameRange\"\r\n                          :model-value=\"[\r\n                            editedScene.frameRange[0] - editedScene.sourceRange[0],\r\n                            editedScene.frameRange[1] - editedScene.sourceRange[0]\r\n                          ]\"\r\n                          :min=\"0\"\r\n                          :max=\"editedScene.sourceRange[1] - editedScene.sourceRange[0]\"\r\n                          :step=\"1\"\r\n                          :disabled=\"editedScene.type === 'image'\"\r\n                          @update:modelValue=\"val => {\r\n                            editedScene.frameRange = [\r\n                              val[0] + editedScene.sourceRange[0],\r\n                              val[1] + editedScene.sourceRange[0]\r\n                            ]\r\n                            handleFrameRangeChange(editedScene)\r\n                          }\"\r\n                          thumb-size=\"12\"\r\n                          class=\"compact-range-slider\"\r\n                        />\r\n                      </v-row>\r\n\r\n                      <!-- æ—¶é—´ä¿¡æ¯ -->\r\n                      <v-row class=\"justify-space-between g-0 mt-0 pt-0\" dense>\r\n                        <span>\r\n                          {{ frameToTime(editedScene.frameRange[0]- editedScene.sourceRange[0], editedScene.fps) }}\r\n                        </span>\r\n                        <span\r\n                          class=\"text-center\"\r\n                          :class=\"calculateRemainingTime(editedScene).class\"\r\n                        >\r\n                          {{ calculateRemainingTime(editedScene).time }}\r\n                        </span>\r\n                        <span class=\"text-right\">\r\n                          {{ frameToTime(editedScene.frameRange[1]- editedScene.sourceRange[0], editedScene.fps) }}\r\n                        </span>\r\n                      </v-row>\r\n                    </v-col>\r\n\r\n                    <v-col cols=\"auto\" style=\"flex: 0 0 100px\">\r\n                      <v-row dense class=\"g-0\">\r\n                        <v-checkbox\r\n                          v-model=\"editedScene.upend\"\r\n                          color=\"red-darken-3\"\r\n                          :label=\"$t('reverseLabel')\"\r\n                          :disabled=\"editedScene.type === 'image'\"\r\n                          density=\"compact\"\r\n                          hide-details\r\n                        ></v-checkbox>\r\n                      </v-row>\r\n\r\n                      <v-row dense class=\"g-0\">\r\n                        <v-checkbox\r\n                          v-model=\"editedScene.horizontalFlip\"\r\n                          color=\"red-darken-3\"\r\n                          :label=\"$t('horizontalFlipLabel')\"\r\n                          density=\"compact\"\r\n                          hide-details\r\n                        ></v-checkbox>\r\n                      </v-row>\r\n\r\n                      <v-row dense class=\"g-0\">\r\n                        <v-checkbox\r\n                          v-model=\"editedScene.growFrame\"\r\n                          color=\"red-darken-3\"\r\n                          :label=\"$t('growFrameLabel')\"\r\n                          v-if=\"editedScene.type === 'image'\"\r\n                          density=\"compact\"\r\n                          hide-details\r\n                        ></v-checkbox>\r\n                      </v-row>\r\n\r\n                      <v-row dense>\r\n                        <v-text-field\r\n                          v-model.number=\"editedScene.sourceVolume\"\r\n                          type=\"number\"\r\n                          step=\"0.1\"\r\n                          min=\"0\"\r\n                          max=\"1\"\r\n                          :label=\"$t('originalVolumeLabel')\"\r\n                          density=\"compact\"\r\n                          :disabled=\"editedScene.type === 'image'\"\r\n                        ></v-text-field>\r\n                      </v-row>\r\n\r\n                      <v-row dense>\r\n                        <v-tooltip location=\"top\" max-width=\"360\">\r\n                          <template v-slot:activator=\"{ props }\">\r\n                            <div\r\n                              v-bind=\"props\"\r\n                              class=\"text-caption\"\r\n                              style=\"\r\n                                white-space: nowrap;\r\n                                overflow: hidden;\r\n                                text-overflow: ellipsis;\r\n                              \"\r\n                            >\r\n                              {{ truncatePath(editedScene.fullName, 12) }}\r\n                            </div>\r\n                          </template>\r\n                          <div\r\n                            style=\"\r\n                              white-space: pre-wrap;\r\n                              word-break: break-word;\r\n                            \"\r\n                          >\r\n                            {{ editedScene.fullName }}\r\n                          </div>\r\n                        </v-tooltip>\r\n                      </v-row>\r\n                    </v-col>\r\n                  </v-row>\r\n                </v-card-text>\r\n              </v-card>\r\n            </v-col>\r\n          </v-row>\r\n\r\n          <v-card style=\"height: calc(100vh - 415px); overflow-y: auto;\">\r\n            <v-card-title\r\n              class=\"d-flex align-center justify-space-between py-1 px-3 text-body-2\"\r\n            >\r\n              <span>{{ $t('longVideoSlices') }}</span>\r\n            </v-card-title>\r\n\r\n            <!-- tabs åŒºåŸŸ -->\r\n            <v-tabs\r\n              v-model=\"activeLibrary\"\r\n              show-arrows\r\n              density=\"compact\"\r\n              class=\"tab-compact\"\r\n            >\r\n              <!-- å·²æœ‰çš„ tab -->\r\n              <v-tab\r\n                v-for=\"(lib, index) in materialLibraries\"\r\n                :key=\"index\"\r\n                class=\"tab-item\"\r\n                :value=\"index\"\r\n              >\r\n                {{ lib.loading ? $t('importingSegments') : lib.name }}\r\n                <v-icon v-if=\"!lib.loading\" @click.stop=\"removeLibrary(index)\">\r\n                  {{ mdiClose }}\r\n                </v-icon>\r\n              </v-tab>\r\n\r\n              <!-- æ·»åŠ  tab çš„æŒ‰é’® -->\r\n              <v-tab\r\n                :disabled=\"materialLibraries.some(lib => lib.loading)\"\r\n                @click=\"addMaterialLibrary\"\r\n                class=\"d-flex align-center\"\r\n              >\r\n                <v-icon color=\"warning\">{{ mdiPlus }}</v-icon>\r\n              </v-tab>\r\n            </v-tabs>\r\n\r\n            <!-- tabs å†…å®¹ -->\r\n            <v-tabs-window v-model=\"activeLibrary\">\r\n              <v-tabs-window-item\r\n                v-for=\"(lib, libIndex) in materialLibraries\"\r\n                :key=\"libIndex\"\r\n                :value=\"libIndex\"\r\n              >\r\n                <!-- ç‹¬ç«‹æ»šåŠ¨å®¹å™¨ -->\r\n                <div style=\"overflow-y: auto; padding: 8px\">\r\n                  <v-container fluid>\r\n                    <v-row>\r\n                      <v-col\r\n                        v-for=\"(segment, segIndex) in lib.segments\"\r\n                        :key=\"segIndex\"\r\n                        cols=\"3\"\r\n                      >\r\n                        <!-- ä½ çš„ç¼©ç•¥å›¾å¡ç‰‡ -->\r\n                        <div\r\n                          class=\"thumbnail-card\"\r\n                          :style=\"{ paddingTop: (100 * (segment.thumbHeight / segment.thumbWidth)) + '%' }\"\r\n                          @mouseenter=\"handleMouseEnter(libIndex, lib, segment, segIndex)\"\r\n                          @mouseleave=\"handleMouseLeave(libIndex, segIndex)\"\r\n                        >\r\n                          <img\r\n                            v-if=\"segment.base64Thumbnail\"\r\n                            :src=\"segment.base64Thumbnail\"\r\n                            class=\"thumbnail-img\"\r\n                          />\r\n                          <!-- é¢„è§ˆå±‚ -->\r\n                          <div\r\n                            v-if=\"segment.previewBase64\"\r\n                            class=\"preview-overlay\"\r\n                            :class=\"{ playing: segment.isPlaying }\"\r\n                            :style=\"{ \r\n                              backgroundImage: 'url(' + segment.previewBase64 + ')',\r\n                              backgroundPosition: segment.currentFrame !== undefined ? \r\n                                `${(segment.currentFrame % 4) * 33.333}% ${Math.floor(segment.currentFrame / 4) * 50}%` : '0% 0%'\r\n                            }\"\r\n                            :data-lib=\"libIndex\"\r\n                            :data-seg=\"segIndex\"\r\n                          ></div>\r\n                          <v-btn\r\n                            class=\"thumbnail-left-icon\"\r\n                            variant=\"text\"\r\n                            size=\"small\"\r\n                            @click.stop=\"addScene(lib.info, segment, segment.base64Thumbnail)\"\r\n                          >\r\n                            {{ $t('addScene') }}\r\n                          </v-btn>\r\n\r\n                          <v-btn\r\n                            class=\"thumbnail-right-icon\"\r\n                            variant=\"text\"\r\n                            size=\"small\"\r\n                            @click.stop=\"replaceScene(lib.info, segment, segment.base64Thumbnail)\"\r\n                          >\r\n                            {{ $t('replaceScene') }}\r\n                          </v-btn>\r\n                          <span class=\"duration-text\">\r\n                            {{ formatSeconds(segment.duration) }}\r\n                          </span>\r\n                          <span class=\"frame-range-text\">\r\n                            {{ frameToTime(segment.StartFrame, materialLibraries[libIndex].fps) }}\r\n                            /\r\n                            {{ frameToTime(segment.EndFrame, materialLibraries[libIndex].fps) }}\r\n                          </span>\r\n                        </div>\r\n                      </v-col>\r\n                    </v-row>\r\n                  </v-container>\r\n                </div>\r\n              </v-tabs-window-item>\r\n            </v-tabs-window>\r\n          </v-card>\r\n        </v-col>\r\n      </v-row>\r\n    </template>\r\n\r\n    <!-- å½“æ²¡æœ‰ç‰‡æ®µæ—¶æ˜¾ç¤ºæ·»åŠ æŒ‰é’® -->\r\n    <template v-else>\r\n      <v-row align=\"center\" justify=\"center\" class=\"px-2 py-10\">\r\n        <v-col cols=\"12\" class=\"text-center\">\r\n                      <v-tooltip location=\"end\" :disabled=\"!enableTooltips\">\r\n              <template v-slot:activator=\"{ props }\">\r\n                <v-icon\r\n                  size=\"64\"\r\n                  color=\"primary\"\r\n                  v-bind=\"props\"\r\n                  @click=\"goHomePage\"\r\n                  class=\"clickable-icon mr-3\"\r\n                >\r\n                  {{ mdiHome }}\r\n                </v-icon>\r\n              </template>\r\n              <span>{{ $t('returnToHomeTooltip') }}</span>\r\n            </v-tooltip>\r\n          <v-btn\r\n            color=\"primary\"\r\n            size=\"x-large\"\r\n            class=\"text-h8 mx-2\"\r\n            @click=\"addItem\"\r\n            :disabled=\"isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n          >\r\n            {{ $t('addFirstRow') }}\r\n          </v-btn>\r\n        </v-col>\r\n      </v-row>\r\n    </template>\r\n  </v-container>\r\n  <!-- æ·»åŠ æ–°Clipå¯¹è¯æ¡† -->\r\n  <v-dialog v-model=\"addDialog\" max-width=\"1000px\">\r\n    <v-card>\r\n      <v-card-title>{{ $t('addNewClip') }}</v-card-title>\r\n      <v-card-text class=\"pa-1\">\r\n        <v-row dense class=\"g-0\" align=\"stretch\">\r\n          <!-- å·¦ä¾§ -->\r\n          <v-col cols=\"12\" md=\"7\" class=\"px-1 d-flex flex-column\">\r\n            <v-textarea\r\n              outlined\r\n              :label=\"$t('content')\"\r\n              v-model=\"newClip.sentence\"\r\n              rows=\"3\"\r\n              autofocus\r\n              class=\"mb-2\"\r\n            ></v-textarea>\r\n\r\n            <v-tooltip\r\n              activator=\"parent\"\r\n              :disabled=\"!enableTooltips\"\r\n              location=\"bottom\"\r\n            >\r\n              <template v-slot:activator=\"{ on, attrs }\">\r\n                <v-textarea\r\n                  outlined\r\n                  :label=\"$t('comment')\"\r\n                  v-model=\"newClip.comment1\"\r\n                  rows=\"2\"\r\n                  v-bind=\"attrs\"\r\n                  v-on=\"on\"\r\n                ></v-textarea>\r\n              </template>\r\n              {{ $t('commentTooltip') }}\r\n            </v-tooltip>\r\n          </v-col>\r\n\r\n          <!-- å³ä¾§ -->\r\n          <v-col\r\n            cols=\"12\"\r\n            md=\"5\"\r\n            class=\"px-1 d-flex flex-column justify-space-between\"\r\n          >\r\n            <v-row dense>\r\n              <v-col cols=\"6\">\r\n                <v-number-input\r\n                  v-model=\"newClip.narration.rate\"\r\n                  :label=\"$t('rate')\"\r\n                  density=\"compact\"\r\n                  :min=\"0.75\"\r\n                  :max=\"1.5\"\r\n                  :step=\"0.05\"\r\n                  :suffix=\"$t('times')\"\r\n                  control-variant=\"stacked\"\r\n                />\r\n              </v-col>\r\n              <v-col cols=\"6\">\r\n                <v-number-input\r\n                  v-model=\"newClip.narration.speed\"\r\n                  :label=\"$t('speed')\"\r\n                  density=\"compact\"\r\n                  :min=\"0.5\"\r\n                  :max=\"3\"\r\n                  :step=\"0.01\"\r\n                  :suffix=\"$t('times')\"\r\n                  control-variant=\"stacked\"\r\n                />\r\n              </v-col>\r\n            </v-row>\r\n\r\n            <v-row dense>\r\n              <v-col cols=\"6\">\r\n                <v-number-input\r\n                  v-model=\"newClip.narration.pauseBefore\"\r\n                  :label=\"$t('pauseBefore')\"\r\n                  density=\"compact\"\r\n                  :min=\"0.2\"\r\n                  :max=\"1\"\r\n                  :step=\"0.05\"\r\n                  :suffix=\"$t('seconds')\"\r\n                  control-variant=\"stacked\"\r\n                />\r\n              </v-col>\r\n              <v-col cols=\"6\">\r\n                <v-number-input\r\n                  v-model=\"newClip.narration.pauseAfter\"\r\n                  :label=\"$t('pauseAfter')\"\r\n                  density=\"compact\"\r\n                  :min=\"0.2\"\r\n                  :max=\"1\"\r\n                  :step=\"0.05\"\r\n                  :suffix=\"$t('seconds')\"\r\n                  control-variant=\"stacked\"\r\n                />\r\n              </v-col>\r\n            </v-row>\r\n\r\n            <v-row dense>\r\n              <v-col cols=\"5\">\r\n                <v-select\r\n                  v-model=\"newClip.narration.locale\"\r\n                  :items=\"list_language_cn.map(lang => lang.locale)\"\r\n                  density=\"compact\"\r\n                  :label=\"$t('language')\"\r\n                  @update:modelValue=\"onNewClipLanguageChange\"\r\n                />\r\n              </v-col>\r\n              <v-col cols=\"7\">\r\n                <v-select\r\n                  v-model=\"newClip.narration.voiceName\"\r\n                  :items=\"newClipVoiceItems\"\r\n                  density=\"compact\"\r\n                  :label=\"$t('voice')\"\r\n                />\r\n              </v-col>\r\n            </v-row>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <v-row dense>\r\n          <v-col cols=\"12\">\r\n            <v-checkbox\r\n              v-model=\"autoSplitSentences\"\r\n              :label=\"$t('autoSplitSentences')\"\r\n            ></v-checkbox>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <v-row dense>\r\n          <v-col cols=\"2\">\r\n            <v-select\r\n              v-model=\"insertClipMode\"\r\n              :items=\"[\r\n                  { title: $t('insertClipAtPosition'), value: 'insertClip' },\r\n                  { title: $t('appendClipBelow'), value: 'appendClip' }\r\n                ]\"\r\n              :label=\"$t('insertClipMode')\"\r\n              density=\"compact\"\r\n            />\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn\r\n          color=\"error\"\r\n          @click=\"addDialog = false\"\r\n          >{{ $t('cancel') }}</v-btn\r\n        >\r\n        <v-btn\r\n          color=\"success\"\r\n          @click=\"confirmAddClip\"\r\n          >{{ $t('confirm') }}</v-btn\r\n        >\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n\r\n  <!-- æ‰¹é‡ç¼–è¾‘ç‰‡æ®µå¯¹è¯æ¡† -->\r\n  <v-dialog v-model=\"batchEditDialog\" max-width=\"1000px\">\r\n    <v-card>\r\n      <v-card-title>{{ $t('batchEditClips') }}</v-card-title>\r\n      <v-card-text>\r\n        <v-row dense class=\"g-2\">\r\n          <!-- å·¦åˆ—: v-textarea -->\r\n          <v-col cols=\"12\" md=\"6\">\r\n            <v-textarea\r\n              outlined\r\n              :label=\"$t('selectedTextContent')\"\r\n              :model-value=\"batchEditTextContent\"\r\n              readonly\r\n              rows=\"12\"\r\n              class=\"mb-2\"\r\n            ></v-textarea>\r\n          </v-col>\r\n\r\n          <!-- å³åˆ—: å‚æ•°æŽ§ä»¶ -->\r\n          <v-col cols=\"12\" md=\"6\" class=\"d-flex flex-column\">\r\n            <!-- ç¬¬ä¸€è¡Œ: rate / speed -->\r\n            <v-row dense>\r\n              <v-col cols=\"6\">\r\n                <v-number-input\r\n                  v-model=\"batchEditParams.rate\"\r\n                  :label=\"$t('rate')\"\r\n                  density=\"compact\"\r\n                  :min=\"0.75\"\r\n                  :max=\"1.5\"\r\n                  :step=\"0.05\"\r\n                  :suffix=\"$t('times')\"\r\n                  control-variant=\"stacked\"\r\n                />\r\n              </v-col>\r\n              <v-col cols=\"6\">\r\n                <v-number-input\r\n                  v-model=\"batchEditParams.speed\"\r\n                  :label=\"$t('speed')\"\r\n                  density=\"compact\"\r\n                  :min=\"0.5\"\r\n                  :max=\"3\"\r\n                  :step=\"0.01\"\r\n                  :suffix=\"$t('times')\"\r\n                  control-variant=\"stacked\"\r\n                />\r\n              </v-col>\r\n            </v-row>\r\n\r\n            <!-- ç¬¬äºŒè¡Œ: pauseBefore / pauseAfter -->\r\n            <v-row dense>\r\n              <v-col cols=\"6\">\r\n                <v-number-input\r\n                  v-model=\"batchEditParams.pauseBefore\"\r\n                  :label=\"$t('pauseBefore')\"\r\n                  density=\"compact\"\r\n                  :min=\"0.2\"\r\n                  :max=\"1\"\r\n                  :step=\"0.05\"\r\n                  :suffix=\"$t('seconds')\"\r\n                  control-variant=\"stacked\"\r\n                />\r\n              </v-col>\r\n              <v-col cols=\"6\">\r\n                <v-number-input\r\n                  v-model=\"batchEditParams.pauseAfter\"\r\n                  :label=\"$t('pauseAfter')\"\r\n                  density=\"compact\"\r\n                  :min=\"0.2\"\r\n                  :max=\"1\"\r\n                  :step=\"0.05\"\r\n                  :suffix=\"$t('seconds')\"\r\n                  control-variant=\"stacked\"\r\n                />\r\n              </v-col>\r\n            </v-row>\r\n\r\n            <!-- ç¬¬ä¸‰è¡Œ: locale / voiceName -->\r\n            <v-row dense>\r\n              <v-col cols=\"6\">\r\n                <v-select\r\n                  v-model=\"batchEditParams.locale\"\r\n                  :items=\"list_language_cn.map(lang => lang.locale)\"\r\n                  :label=\"$t('language')\"\r\n                  density=\"compact\"\r\n                ></v-select>\r\n              </v-col>\r\n              <v-col cols=\"6\">\r\n                <v-select\r\n                  v-model=\"batchEditParams.voiceName\"\r\n                  :items=\"batchEditVoiceItems\"\r\n                  :label=\"$t('voice')\"\r\n                  density=\"compact\"\r\n                ></v-select>\r\n              </v-col>\r\n            </v-row>\r\n\r\n            <!-- ç¬¬å››è¡Œ: selectedPreset -->\r\n            <v-row dense>\r\n              <v-col cols=\"12\">\r\n                <v-select\r\n                  v-model=\"selectedPreset\"\r\n                  :items=\"parameterPresets\"\r\n                  item-title=\"title\"\r\n                  return-object\r\n                  :label=\"$t('presetSettings')\"\r\n                  density=\"compact\"\r\n                  class=\"mt-2\"\r\n                  @update:modelValue=\"applyPreset\"\r\n                ></v-select>\r\n              </v-col>\r\n            </v-row>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn\r\n          color=\"error\"\r\n          @click=\"batchEditDialog = false\"\r\n          >{{ $t('cancel') }}</v-btn\r\n        >\r\n        <v-btn color=\"success\" @click=\"applyBatchEdit\">{{ $t('apply') }}</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n\r\n  <!-- æ‰¹é‡åˆ é™¤ç¡®è®¤ -->\r\n  <v-dialog v-model=\"deleteConfirmDialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-text>\r\n        <p>\r\n          {{ $t('deleteConfirmText', { count: selectedClipIndices.length }) }}\r\n        </p>\r\n        <p class=\"text-caption text-medium-emphasis\">\r\n          {{ $t('deleteWarning') }}\r\n        </p>\r\n\r\n        <v-list\r\n          v-if=\"previewDeleteItems.length > 0\"\r\n          density=\"compact\"\r\n          class=\"mt-2\"\r\n        >\r\n          <v-list-item\r\n            v-for=\"(item, index) in previewDeleteItems\"\r\n            :key=\"index\"\r\n            class=\"text-caption\"\r\n          >\r\n            <template v-slot:prepend\r\n              ><v-icon size=\"small\">{{ mdiMenuRight }}</v-icon></template\r\n            >\r\n            <v-list-item-title>{{ item }}</v-list-item-title>\r\n          </v-list-item>\r\n          <v-list-item v-if=\"selectedClipIndices.length > 3\">\r\n            <v-list-item-title class=\"text-caption text-medium-emphasis\">\r\n              {{ $t('remainingClips', { count: selectedClipIndices.length - 3 }) }}\r\n            </v-list-item-title>\r\n          </v-list-item>\r\n        </v-list>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn\r\n          color=\"grey\"\r\n          variant=\"text\"\r\n          @click=\"deleteConfirmDialog = false\"\r\n          >{{ $t('cancel') }}</v-btn\r\n        >\r\n        <v-btn\r\n          color=\"error\"\r\n          variant=\"elevated\"\r\n          @click=\"confirmBatchDelete\"\r\n          >{{ $t('confirm') }}</v-btn\r\n        >\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n\r\n  <!-- å¯¼å‡ºå¯¹è¯æ¡† -->\r\n  <v-dialog v-model=\"exportDialog\" max-width=\"600px\" persistent>\r\n    <v-card>\r\n      <v-card-title>{{ $t('exportClips') }}</v-card-title>\r\n      <v-card-text>\r\n        <!-- å¯¼å‡ºç±»åž‹é€‰æ‹© -->\r\n        <v-row dense>\r\n          <v-col cols=\"12\">\r\n            <v-select\r\n              v-model=\"exportType\"\r\n              :items=\"[\r\n              { text: $t('videoMP4'), value: 'video' },\r\n              { text: $t('audioMP3'), value: 'audio' }\r\n            ]\"\r\n              item-title=\"text\"\r\n              item-value=\"value\"\r\n              :label=\"$t('exportType')\"\r\n              density=\"compact\"\r\n            ></v-select>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <!-- ç¼ºå¤±æ–‡ä»¶æç¤º -->\r\n        <v-row dense>\r\n          <v-col cols=\"12\">\r\n            <v-alert\r\n              v-if=\"exportType === 'audio' && missingAudioFiles.length > 0\"\r\n              type=\"warning\"\r\n              density=\"compact\"\r\n              class=\"mb-3\"\r\n            >\r\n              {{ $t('missingAudioFiles', { count: missingAudioFiles.length }) }}\r\n              <div class=\"text-caption mt-1\">\r\n                {{ missingAudioFiles.map(f => f.index + 1).join(', ') }}\r\n              </div>\r\n            </v-alert>\r\n\r\n            <v-alert\r\n              v-if=\"exportType === 'video' && missingVideoFiles.length > 0\"\r\n              type=\"warning\"\r\n              density=\"compact\"\r\n              class=\"mb-3\"\r\n            >\r\n              {{ $t('missingVideoFiles', { count: missingVideoFiles.length }) }}\r\n              <div class=\"text-caption mt-1\">\r\n                {{ missingVideoFiles.map(f => f.index + 1).join(', ') }}\r\n              </div>\r\n            </v-alert>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <!-- å¿½ç•¥ç¼ºå¤±æ–‡ä»¶æŒ‰é’® -->\r\n        <template\r\n          v-if=\"!ignoreMissing && ((exportType === 'audio' && missingAudioFiles.length > 0) ||\r\n                                  (exportType === 'video' && missingVideoFiles.length > 0))\"\r\n        >\r\n          <v-row dense>\r\n            <v-col cols=\"10\"></v-col>\r\n            <v-col cols=\"2\">\r\n              <v-btn color=\"primary\" block @click=\"ignoreMissingFiles\">\r\n                {{ $t('ignoreAndContinue') }}\r\n              </v-btn>\r\n            </v-col>\r\n          </v-row>\r\n        </template>\r\n\r\n        <!-- æ²¡æœ‰å¯å¯¼å‡ºæ–‡ä»¶çš„æç¤º -->\r\n        <v-alert\r\n          v-if=\"(exportType === 'audio' && exportAudioFiles.length === 0) || \r\n              (exportType === 'video' && exportVideoFiles.length === 0)\"\r\n          type=\"error\"\r\n          density=\"compact\"\r\n          class=\"mb-3\"\r\n        >\r\n          {{ $t('noFilesToExport') }}\r\n        </v-alert>\r\n\r\n        <!-- èƒŒæ™¯éŸ³ä¹è®¾ç½® -->\r\n        <template\r\n          v-if=\"ignoreMissing || ((exportType === 'audio' && exportAudioFiles.length > 0) || \r\n                                (exportType === 'video' && exportVideoFiles.length > 0))\"\r\n        >\r\n          <v-row dense>\r\n            <v-col cols=\"10\">\r\n              <v-text-field\r\n                v-model=\"backgroundMusicPath\"\r\n                :label=\"$t('backgroundMusic')\"\r\n                readonly\r\n                density=\"compact\"\r\n                clearable\r\n                :disabled=\"!ignoreMissing && ((exportType === 'audio' && missingAudioFiles.length > 0) ||\r\n                                           (exportType === 'video' && missingVideoFiles.length > 0))\"\r\n              ></v-text-field>\r\n            </v-col>\r\n            <v-col cols=\"2\">\r\n              <v-btn\r\n                color=\"primary\"\r\n                @click=\"browseBackgroundMusic\"\r\n                block\r\n                :disabled=\"!ignoreMissing && ((exportType === 'audio' && missingAudioFiles.length > 0) ||\r\n                                           (exportType === 'video' && missingVideoFiles.length > 0))\"\r\n              >\r\n                {{ $t('browse') }}\r\n              </v-btn>\r\n            </v-col>\r\n          </v-row>\r\n\r\n          <v-row dense>\r\n            <v-col cols=\"10\">\r\n              <v-slider\r\n                v-model=\"backgroundMusicVolume\"\r\n                :label=\"$t('backgroundMusicVolume')\"\r\n                max=\"2\"\r\n                min=\"0.1\"\r\n                step=\"0.1\"\r\n                thumb-label\r\n                density=\"compact\"\r\n                :disabled=\"!ignoreMissing && ((exportType === 'audio' && missingAudioFiles.length > 0) ||\r\n                                           (exportType === 'video' && missingVideoFiles.length > 0))\"\r\n              ></v-slider>\r\n            </v-col>\r\n          </v-row>\r\n        </template>\r\n\r\n        <!-- å¯¼å‡ºè·¯å¾„ -->\r\n        <v-row\r\n          dense\r\n          v-if=\"ignoreMissing || ((exportType === 'audio' && exportAudioFiles.length > 0) || \r\n                                (exportType === 'video' && exportVideoFiles.length > 0))\"\r\n        >\r\n          <v-col cols=\"10\">\r\n            <v-text-field\r\n              v-model=\"exportPath\"\r\n              :label=\"$t('savePath')\"\r\n              readonly\r\n              density=\"compact\"\r\n              :disabled=\"!ignoreMissing && ((exportType === 'audio' && missingAudioFiles.length > 0) ||\r\n                                         (exportType === 'video' && missingVideoFiles.length > 0))\"\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"2\">\r\n            <v-btn\r\n              color=\"primary\"\r\n              @click=\"browseExportPath\"\r\n              block\r\n              :disabled=\"!ignoreMissing && ((exportType === 'audio' && missingAudioFiles.length > 0) ||\r\n                                         (exportType === 'video' && missingVideoFiles.length > 0))\"\r\n            >\r\n              {{ $t('browse') }}\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <!-- æ–‡ä»¶å·²å­˜åœ¨æç¤º -->\r\n        <v-alert\r\n          v-if=\"fileExistsWarning\"\r\n          type=\"warning\"\r\n          density=\"compact\"\r\n          class=\"mb-3\"\r\n        >\r\n          <div>{{ $t('fileExists') }}</div>\r\n          <div class=\"text-caption mt-1\">\r\n            {{ exportPathTemp.split('\\\\').pop() }}\r\n          </div>\r\n          <div class=\"text-caption\">{{ $t('overwritePrompt') }}</div>\r\n\r\n          <v-row class=\"mt-2\">\r\n            <v-col cols=\"6\">\r\n              <v-btn\r\n                color=\"error\"\r\n                @click=\"cancelOverwrite\"\r\n                block\r\n                >{{ $t('cancel') }}</v-btn\r\n              >\r\n            </v-col>\r\n            <v-col cols=\"6\">\r\n              <v-btn\r\n                color=\"success\"\r\n                @click=\"confirmOverwrite\"\r\n                block\r\n                >{{ $t('overwriteButton') }}</v-btn\r\n              >\r\n            </v-col>\r\n          </v-row>\r\n        </v-alert>\r\n\r\n        <!-- å¯¼å‡ºè¿›åº¦ -->\r\n        <v-row v-if=\"isExporting\" dense>\r\n          <v-col cols=\"12\">\r\n            <v-progress-linear\r\n              v-model=\"exportProgress\"\r\n              color=\"primary\"\r\n              height=\"20\"\r\n              striped\r\n            ></v-progress-linear>\r\n            <div class=\"text-caption text-center mt-1\">\r\n              {{ $t('exportingProgress', { progress: exportProgress }) }}\r\n            </div>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn\r\n          color=\"error\"\r\n          @click=\"exportDialog = false\"\r\n          :disabled=\"isExporting\"\r\n        >\r\n          {{ $t('cancel') }}\r\n        </v-btn>\r\n        <v-btn\r\n          color=\"success\"\r\n          @click=\"confirmExport\"\r\n          :disabled=\"isExporting || \r\n                  (!ignoreMissing && \r\n                   ((exportType === 'audio' && exportAudioFiles.length === 0) || \r\n                    (exportType === 'video' && exportVideoFiles.length === 0))) ||\r\n                  !exportPath ||\r\n                  (fileExistsWarning && !fileExistsResolved)\"\r\n        >\r\n          {{ $t('confirm') }}\r\n        </v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport aardio from \"aardio\";\r\nimport WaveSurfer from 'wavesurfer.js';\r\nimport _ from 'lodash';\r\nimport { nextTick } from 'vue'\r\nimport {\r\n  mdiHome,\r\n  mdiDelete,\r\n  mdiMenuRight,\r\n  mdiSelectAll,\r\n  mdiPencil,\r\n  mdiMinus,\r\n  mdiPlus,\r\n  mdiChevronLeft,\r\n  mdiChevronRight,\r\n  mdiChevronUp,\r\n  mdiChevronDown,\r\n  mdiPlay,\r\n  mdiPause,\r\n  mdiContentSave,\r\n  mdiVideoVintage,\r\n  mdiMerge,\r\n  mdiWaveform,\r\n  mdiMenuClose,\r\n  mdiTuneVariant,\r\n  mdiClose,\r\n} from '@mdi/js';\r\nimport { list_language_cn } from '@/assets/variables.js';\r\nimport { getDefaultSequence, getDefaultClip, getDefaultScene, formatTime, splitSentences } from '@/utils/CommonMethods';\r\nimport AppBrand from '@/components/AppBrand.vue'\r\n\r\nexport default {\r\n  components: { AppBrand },\r\n  data() {\r\n    return {\r\n      mdiHome,\r\n      mdiPencil,\r\n      mdiMinus,\r\n      mdiPlus,\r\n      mdiDelete,\r\n      mdiMenuRight,\r\n      mdiSelectAll,\r\n      mdiChevronLeft,\r\n      mdiChevronRight,\r\n      mdiChevronUp,\r\n      mdiChevronDown,\r\n      mdiContentSave,\r\n      mdiPlay,\r\n      mdiPause,\r\n      mdiVideoVintage,\r\n      mdiMerge,\r\n      mdiWaveform,\r\n      mdiMenuClose,\r\n      mdiTuneVariant,\r\n      mdiClose,\r\n      snackbar: {\r\n        visible: false,\r\n        message: '',\r\n        color: 'success'\r\n      },\r\n      isLoading: true, // æ·»åŠ åŠ è½½çŠ¶æ€\r\n      settingsMenu: false, // æŽ§åˆ¶è®¾ç½®èœå•çš„æ˜¾ç¤ºçŠ¶æ€\r\n      enableTooltips: true, // æŽ§åˆ¶æ‰€æœ‰tooltipçš„å¯ç”¨æ€§\r\n      debounceTimers: {}, // ç”¨äºŽå­˜å‚¨æ¯ä¸ªåœºæ™¯çš„é˜²æŠ–å®šæ—¶å™¨\r\n      defaultDebounceTime: 200, // é»˜è®¤é˜²æŠ–æ—¶é—´\r\n      minDebounceTime: 100, // æœ€å°é˜²æŠ–æ—¶é—´\r\n      maxDebounceTime: 500, // æœ€å¤§é˜²æŠ–æ—¶é—´\r\n      lastSliderChangeTime: 0, // è®°å½•ä¸Šæ¬¡æ»‘å—å˜åŒ–æ—¶é—´\r\n      // é¡¹ç›®ç›¸å…³\r\n      projectFullName: '',\r\n      projectDirectory:'',\r\n      projectName:'',\r\n      list_language_cn,\r\n\r\n      // é€‰æ‹©çŠ¶æ€\r\n      selectedClipIndices: [],\r\n      addDialog: false,\r\n      newClip: getDefaultClip(),\r\n      newClipVoiceItems: [],\r\n      autoSplitSentences: true,\r\n      insertClipMode: 'appendClip',\r\n\r\n      // é¢„è§ˆå°ºå¯¸\r\n      scenePreviewWidth: 320,\r\n      scenePreviewHeight: 180,\r\n      itemPreviewWidth: 320,\r\n      itemPreviewHeight: 180,\r\n      previewScale: 1,\r\n\r\n      // ä¸»æ•°æ®ç»“æž„\r\n      sequence: getDefaultSequence(),\r\n      //editedClip: getDefaultClip(),\r\n      // é»˜è®¤åœºæ™¯\r\n      defaultScene: getDefaultScene(),\r\n\r\n      // è¯­éŸ³ç›¸å…³\r\n      synth: window.speechSynthesis,\r\n      list_voice_edge: [],\r\n      voiceItems: [],\r\n      isGeneratingAudio: false,\r\n      cancelAudioGeneration: false,\r\n      currentUtterance: null, // ç”¨äºŽå­˜å‚¨å½“å‰çš„è¯­éŸ³åˆæˆå¯¹è±¡\r\n      audioSrc: null,  // å­˜å‚¨ç”Ÿæˆçš„éŸ³é¢‘æ–‡ä»¶URL\r\n      folder_audio:'AudioClip',\r\n      folder_buff:'Buff',\r\n      audio_original:'original.wav',\r\n      audio_with_silence:'undefine.wav',\r\n      audio_with_speed:'adjust.wav',\r\n      audio_concate:'fullAudio.wav',\r\n      audioPlayer: null,\r\n      folder_video:'VideoClip',\r\n      audioReady: false,\r\n      wavesurfer: null,\r\n      isPlaying: false,\r\n      currentTime: 0,\r\n      totalTime: 0,\r\n      playbackProgress: 0,\r\n      audioDurationFrames: 0,\r\n      seekInProgress: false,\r\n      wasPlayingBeforeSeek: false,\r\n      audioUpdateInterval: null,\r\n      activeButton: null,\r\n      buttonInterval: null,\r\n      buttonActions: {\r\n        'zoom-in': { prop: 'scale', value: 0.01 },\r\n        'zoom-out': { prop: 'scale', value: -0.01 },\r\n        'move-up': { prop: 'anchorY', value: -2 },\r\n        'move-down': { prop: 'anchorY', value: 2 },\r\n        'move-left': { prop: 'anchorX', value: -2 },\r\n        'move-right': { prop: 'anchorX', value: 2 }\r\n      },\r\n      deleteConfirmDialog: false,\r\n      // æ‰¹é‡ç¼–è¾‘ç›¸å…³æ•°æ®\r\n      batchEditDialog: false,\r\n      batchEditParams: {\r\n        rate: 1.0,\r\n        speed: 1.0,\r\n        pauseBefore: 0.25,\r\n        pauseAfter: 0.25,\r\n        locale: '',\r\n        voiceName: ''\r\n      },\r\n      batchEditVoiceItems: [],\r\n      selectedPreset: null,\r\n      parameterPresets: [],\r\n      clearAudioMedia: true,\r\n      clearVideoMedia: true,\r\n\r\n      // ç­›é€‰ç›¸å…³æ•°æ®\r\n      filterMenu: false,\r\n      voiceDialog: false,\r\n      filters: {\r\n        all: false,\r\n        voice: [],\r\n        audioPending: false,\r\n        videoPending: false\r\n      },\r\n      selectedVoices: [],\r\n      isBatchGeneratingAudio: false,\r\n      cancelBatchAudioGeneration: false,\r\n      batchAudioGenerationProgress: 0, // è¿›åº¦ 0-100\r\n      currentBatchAudioIndex: 0, // å½“å‰æ­£åœ¨å¤„ç†çš„clipç´¢å¼•\r\n      totalBatchAudioCount: 0, // æ€»clipæ•°é‡\r\n\r\n      isBatchGeneratingVideo: false,\r\n      cancelBatchVideoGeneration: false,\r\n      batchVideoGenerationProgress: 0, // è¿›åº¦ 0-100\r\n      currentBatchVideoIndex: 0, // å½“å‰æ­£åœ¨å¤„ç†çš„clipç´¢å¼•\r\n      totalBatchVideoCount: 0, // æ€»clipæ•°é‡\r\n      // å¯¼å‡ºç›¸å…³æ•°æ®\r\n      exportDialog: false,\r\n      exportType: 'video', // 'audio' æˆ– 'video'\r\n      backgroundMusicPath: '',\r\n      backgroundMusicVolume: 0.25,\r\n      exportPath: '',\r\n      lastExportType: '', // è®°å½•ä¸Šæ¬¡çš„å¯¼å‡ºç±»åž‹\r\n      lastExportPath: '', // è®°å½•ä¸Šæ¬¡çš„å¯¼å‡ºè·¯å¾„\r\n      exportAudioFiles: [],\r\n      exportVideoFiles: [],\r\n      missingAudioFiles: [],\r\n      missingVideoFiles: [],\r\n      ignoreMissing: false,\r\n      isExporting: false,\r\n      exportProgress: 0,\r\n      fileExistsWarning: false,\r\n      fileExistsResolved: false,\r\n      exportPathTemp: '',\r\n      dragUpdateTimeout: null,\r\n      materialLibraries: [],\r\n      activeLibrary: 0,\r\n      menuAnalyzeSoftwareOpen: false,\r\n      fontSize: 40,\r\n      //editedScene: getDefaultScene(),\r\n    }\r\n  },\r\n\r\n  watch: {\r\n    exportDialog(newVal) {\r\n      if (!newVal) {\r\n        // å¯¹è¯æ¡†å…³é—­æ—¶é‡ç½®çŠ¶æ€\r\n        this.fileExistsWarning = false;\r\n        this.fileExistsResolved = false;\r\n        this.exportPathTemp = '';\r\n      }\r\n    },\r\n    exportType(newType, oldType) {\r\n      // å½“å¯¼å‡ºç±»åž‹æ”¹å˜æ—¶ï¼Œè‡ªåŠ¨è°ƒæ•´å¯¼å‡ºè·¯å¾„\r\n      if (newType !== oldType && this.exportPath) {\r\n        this.resetExportPathForType();\r\n      }\r\n    },\r\n\r\n\r\n    // ç›‘å¬åºåˆ—è¾“å‡ºå°ºå¯¸å˜åŒ–ï¼Œæ›´æ–°é¢„è§ˆå°ºå¯¸\r\n    'sequence.outputSize': {\r\n      deep: true,\r\n      handler() {\r\n        this.calculatePreviewSize();\r\n      }\r\n    },\r\n    'editedClip.narration.audioMedia.duration'(val) {\r\n        this.currentTime = 0;\r\n        this.totalTime = 0;\r\n        if (val > 0 && this.editedClip?.narration?.audioMedia?.filePath) {\r\n          this.$nextTick(() => {\r\n            this.loadAudio(this.editedClip.narration.audioMedia.filePath, this.editedClip.narration.audioMedia.duration)\r\n          })\r\n        }else {\r\n          // æ¸…é™¤æ³¢å½¢\r\n          if (this.wavesurfer) {\r\n            this.wavesurfer.empty()   // æ¸…ç©ºæ³¢å½¢æ•°æ®\r\n            this.wavesurfer.destroy() // å¦‚æžœéœ€è¦å½»åº•é”€æ¯å®žä¾‹\r\n            this.wavesurfer = null\r\n          }\r\n        }\r\n      }\r\n  },\r\n  // æ·»åŠ ç»„ä»¶é”€æ¯æ—¶çš„æ¸…ç†\r\nbeforeUnmount() {\r\n  // æ¸…é™¤æ‰€æœ‰é˜²æŠ–å®šæ—¶å™¨\r\n  Object.values(this.debounceTimers).forEach(timer => {\r\n    clearTimeout(timer);\r\n  });\r\n    document.removeEventListener('mousemove', this.onDrag);\r\n    document.removeEventListener('mouseup', this.stopDrag);\r\n},\r\nasync created() {\r\n  this.isLoading = true; // å¼€å§‹åŠ è½½\r\n  const startTime = Date.now(); // è®°å½•å¼€å§‹æ—¶é—´\r\n\r\n  try {\r\n    // å¹¶è¡Œæ‰§è¡Œè¯­éŸ³èŽ·å–å’Œé¡¹ç›®åŠ è½½\r\n    const [voices, projectData] = await Promise.all([\r\n      // èŽ·å–è¯­éŸ³åˆ—è¡¨ï¼ˆä½¿ç”¨setTimeoutç¡®ä¿è¯­éŸ³åˆæˆå™¨å·²åˆå§‹åŒ–ï¼‰\r\n      new Promise(resolve => {\r\n        setTimeout(() => {\r\n          const voices = this.synth.getVoices();\r\n          // å¦‚æžœè¯­éŸ³åˆ—è¡¨ä¸ºç©ºï¼Œå¯èƒ½éœ€è¦ç­‰å¾…è¯­éŸ³åˆæˆå™¨åˆå§‹åŒ–\r\n          if (voices && voices.length > 0) {\r\n            resolve(voices);\r\n          } else {\r\n            // å¦‚æžœè¯­éŸ³åˆ—è¡¨ä¸ºç©ºï¼Œç­‰å¾…ä¸€æ®µæ—¶é—´å†å°è¯•\r\n            setTimeout(() => {\r\n              resolve(this.synth.getVoices() || []);\r\n            }, 300);\r\n          }\r\n        }, 100);\r\n      }),\r\n\r\n      // å¦‚æžœæœ‰é¡¹ç›®è·¯å¾„ï¼Œåˆ™åŠ è½½é¡¹ç›®\r\n      this.$route.query.projectFullName\r\n        ? this.loadProjectData(this.$route.query.projectFullName)\r\n        : Promise.resolve(null)\r\n    ]);\r\n\r\n    this.list_voice_edge = voices;\r\n    this.initializeComboboxes();\r\n    this.calculatePreviewSize();\r\n\r\n    // å¦‚æžœåŠ è½½äº†é¡¹ç›®æ•°æ®ï¼Œåˆ™åº”ç”¨åˆ°sequence\r\n    if (projectData) {\r\n      this.sequence = projectData;\r\n\r\n      // å¦‚æžœæœ‰é€‰ä¸­çš„clipï¼Œåˆ™é€‰ä¸­å®ƒ\r\n      if (this.sequence.clips.length > this.sequence.selectedIndex && this.sequence.selectedIndex >= 0) {\r\n        this.selectClip(this.sequence.selectedIndex);\r\n      }\r\n    }\r\n\r\n    // è®¡ç®—å‰©ä½™ç­‰å¾…æ—¶é—´\r\n    const elapsedTime = Date.now() - startTime;\r\n    const remainingWaitTime = Math.max(0, 400 - elapsedTime);\r\n\r\n    // å¦‚æžœæœ‰å‰©ä½™ç­‰å¾…æ—¶é—´ï¼Œåˆ™ç­‰å¾…\r\n    if (remainingWaitTime > 0) {\r\n      await new Promise(resolve => setTimeout(resolve, remainingWaitTime));\r\n    }\r\n  } catch (error) {\r\n    console.error(\"Initialization failed:\", error);\r\n    // ç¡®ä¿åŸºæœ¬åŠŸèƒ½å¯ç”¨\r\n    this.list_voice_edge = this.synth.getVoices() || [];\r\n    this.initializeComboboxes();\r\n    this.calculatePreviewSize();\r\n  }finally {\r\n      this.isLoading = false; // ç»“æŸåŠ è½½\r\n    }\r\n\r\n  // åˆå§‹åŒ–ç¼–è¾‘clipçš„åœºæ™¯æ•°ç»„\r\n  if (!this.editedClip.scenes) {\r\n    this.editedClip.scenes = [];\r\n  }\r\n},\r\ncomputed: {\r\n  editedClip: {\r\n    get() {\r\n      return this.sequence?.clips?.[this.sequence.selectedIndex] || getDefaultClip();\r\n    },\r\n    set(val) {\r\n      if (this.sequence?.clips?.[this.sequence.selectedIndex]) {\r\n        Object.assign(this.sequence.clips[this.sequence.selectedIndex], val);\r\n      }\r\n    },\r\n  },\r\n\r\n  editedScene: {\r\n    get() {\r\n      const clip = this.sequence?.clips?.[this.sequence.selectedIndex];\r\n      if (!clip || !clip.scenes) return getDefaultScene();\r\n\r\n      const sceneIndex = clip.editedSceneIndex ?? -1;\r\n      return clip.scenes?.[sceneIndex] || getDefaultScene();\r\n    },\r\n    set(val) {\r\n      const clip = this.sequence?.clips?.[this.sequence.selectedIndex];\r\n      const sceneIndex = clip.editedSceneIndex ?? -1;\r\n\r\n      if (clip && clip.scenes && clip.scenes[sceneIndex]) {\r\n        Object.assign(clip.scenes[sceneIndex], val);\r\n      }\r\n    },\r\n  },\r\n    // è®¡ç®—å¯ç”¨çš„æ’­éŸ³å‘˜åˆ—è¡¨ï¼ˆåŽ»é‡ï¼‰\r\n    availableVoices() {\r\n      const voices = new Set();\r\n      this.sequence.clips.forEach(clip => {\r\n        if (clip.narration && clip.narration.voiceName) {\r\n          voices.add(clip.narration.voiceName);\r\n        }\r\n      });\r\n      return Array.from(voices);\r\n    },\r\n    // è®¡ç®—é€‰ä¸­çš„æ–‡æœ¬å†…å®¹\r\n    batchEditTextContent() {\r\n      return this.selectedClipIndices\r\n        .map(index => {\r\n          const clip = this.sequence.clips[index];\r\n          return clip.sentence || this.$t('NoTextContent');\r\n        })\r\n        .join('\\n');\r\n    },\r\n    // é¢„è§ˆè¦åˆ é™¤çš„é¡¹ç›®ï¼ˆæœ€å¤šæ˜¾ç¤º3ä¸ªï¼‰\r\n    previewDeleteItems() {\r\n      return this.selectedClipIndices\r\n        .slice(0, 3)\r\n        .map(index => {\r\n          const clip = this.sequence.clips[index];\r\n          return clip.sentence ? clip.sentence.substring(0, 50) + (clip.sentence.length > 50 ? '...' : '') : this.$t('NoTextContent');\r\n        });\r\n    },\r\n  },\r\n  methods: {\r\n    showToast(message, color = 'success') {\r\n      this.snackbar.message = message;\r\n      this.snackbar.color = color;\r\n      this.snackbar.visible = true;\r\n    },\r\n    async openFileInFolder(filePath) {\r\n      if (!filePath) return;\r\n      const exists = await aardio.isFileExist(filePath);\r\n      if (!exists) {\r\n        this.showToast(this.$t('FileNotExist'), \"error\");\r\n        return;\r\n      }\r\n      await aardio.openFolderAndSelectFile(filePath);\r\n    },\r\n\r\n    async playFile(filePath) {\r\n      if (!filePath) return;\r\n      const exists = await aardio.isFileExist(filePath);\r\n      if (!exists) {\r\n        this.showToast(this.$t('FileNotExist'), \"error\");\r\n        return;\r\n      }\r\n      await aardio.openFile(filePath);\r\n    },\r\n      async loadProjectData(fullName_json) {\r\n      this.projectFullName = fullName_json;\r\n      if (this.projectFullName) {\r\n        this.projectDirectory = this.projectFullName.substring(0, this.projectFullName.lastIndexOf('\\\\'));\r\n        const fileName = this.projectFullName.split('\\\\').pop();\r\n        this.projectName = fileName;\r\n      }\r\n\r\n      const fileData = await aardio.getFileData(this.projectFullName);\r\n\r\n      if (fileData) {\r\n        try {\r\n          const jsonData = JSON.parse(fileData);\r\n          const sequenceData = Array.isArray(jsonData) ? jsonData[0] : jsonData;\r\n\r\n          if (!sequenceData.clips) {\r\n            sequenceData.clips = [];\r\n          }\r\n\r\n          return sequenceData;\r\n        } catch (e) {\r\n          console.error(\"Failed to parse the project file:\", e);\r\n          return getDefaultSequence();\r\n        }\r\n      } else {\r\n        return getDefaultSequence();\r\n      }\r\n    },\r\n      // å¤„ç†é¼ æ ‡æŒ‰ä¸‹äº‹ä»¶\r\n    handleButtonDown(action, scene) {\r\n      this.activeButton = action;\r\n      // ç«‹å³æ‰§è¡Œä¸€æ¬¡\r\n      this.executeButtonAction(action, scene);\r\n      // è®¾ç½®å®šæ—¶å™¨æŒç»­æ‰§è¡Œ\r\n      this.buttonInterval = setInterval(() => {\r\n        this.executeButtonAction(action, scene);\r\n      }, 100); // æ¯100æ¯«ç§’æ‰§è¡Œä¸€æ¬¡\r\n    },\r\n\r\n    // å¤„ç†é¼ æ ‡é‡Šæ”¾äº‹ä»¶\r\n    handleButtonUp() {\r\n      this.activeButton = null;\r\n      if (this.buttonInterval) {\r\n        clearInterval(this.buttonInterval);\r\n        this.buttonInterval = null;\r\n      }\r\n    },\r\n\r\n  // æ‰§è¡ŒæŒ‰é’®åŠ¨ä½œ\r\n    executeButtonAction(action, scene) {\r\n      const config = this.buttonActions[action];\r\n      if (!config || !scene) return;\r\n\r\n      // æ›´æ–°åœºæ™¯å±žæ€§\r\n      scene[config.prop] += config.value;\r\n\r\n      // å¯¹ç¼©æ”¾è¿›è¡Œé™åˆ¶ï¼ˆå¯é€‰ï¼‰\r\n      if (config.prop === 'scale') {\r\n        scene.scale = Math.max(0.01, Math.min(scene.scale, 10)); // é™åˆ¶åœ¨0.01-4ä¹‹é—´\r\n      }\r\n\r\n      // æ›´æ–°ç¼©ç•¥å›¾ä½ç½®\r\n      this.updateThumbnailPosition(scene);\r\n    },\r\n    goHomePage(){\r\n      this.saveProject();\r\n      this.$router.push('/');\r\n    },\r\n    formatTime(seconds) {\r\n      return formatTime(seconds); // ä½¿ç”¨å¯¼å…¥çš„å·¥å…·å‡½æ•°\r\n    },\r\n    getClipDuration(clip) {\r\n      // 1. ä¼˜å…ˆä½¿ç”¨ videoMedia.duration\r\n      if (clip.videoMedia?.duration > 0) {\r\n        return clip.videoMedia.duration;\r\n      }\r\n\r\n      // 2. å…¶æ¬¡ä½¿ç”¨ narration.audioMedia.duration\r\n      if (clip.narration?.audioMedia?.duration > 0) {\r\n        return clip.narration.audioMedia.duration;\r\n      }\r\n\r\n      // 3. å¦‚æžœ scenes ä¸ä¸ºç©ºï¼Œåˆ™è®¡ç®—æ€»æ—¶é•¿\r\n      if (clip.scenes && clip.scenes.length > 0) {\r\n        let clipDuration = 0;\r\n\r\n        for (const scene of clip.scenes) {\r\n          if (scene.type === 'video') {\r\n            const frameCount = scene.frameRange[1] - scene.frameRange[0] + 1;\r\n            clipDuration += frameCount / scene.fps;\r\n          } else {\r\n            clipDuration += scene.proportion;\r\n          }\r\n        }\r\n\r\n        return clipDuration;\r\n      }\r\n\r\n      // 4. é»˜è®¤è¿”å›ž 0\r\n      return 0;\r\n    },\r\ngetClipDurationStyle(clip) {\r\n  if (!clip || !clip.scenes || clip.scenes.length === 0) {\r\n    return { color: 'white', backgroundColor: 'rgba(169, 169, 169, 0.4)' };\r\n  }\r\n\r\n  let hasRedText = false;\r\n  let hasRedBg = false;\r\n\r\n  const sequenceFps = Math.round(this.sequence.frameRate || 0);\r\n\r\n  for (const scene of clip.scenes) {\r\n    const roundedFps = Math.round(scene.fps || 0);\r\n    const totalClipDuration = clip?.narration?.audioMedia?.duration || 0;\r\n    if (!roundedFps || !sequenceFps || !totalClipDuration) continue;\r\n\r\n    // ðŸŽ¯ ä½¿ç”¨å¸§æ•°è®¡ç®—å¯ç”¨æ—¶é•¿è¯¯å·®\r\n    const totalClipFrames = totalClipDuration * sequenceFps;\r\n    const totalProportion = _.sumBy(clip.scenes, 'proportion') || 1;\r\n    const requiredFrames = (scene.proportion / totalProportion) * totalClipFrames;\r\n\r\n    const startFrame = scene.frameRange?.[0] ?? 0;\r\n    const endFrame = scene.frameRange?.[1] ?? 0;\r\n    const actualFrames = (endFrame - startFrame + 1) * (sequenceFps / roundedFps);\r\n\r\n    const lackFrames = requiredFrames - actualFrames;\r\n    const tolerance = 1;\r\n\r\n    // è¶…å‡ºåœºæ™¯æœ€å¤§å…è®¸æ—¶é•¿ â†’ çº¢å­—\r\n    const duration = this.getSceneDuration(clip, scene);\r\n    if (duration >= (this.sequence.durationThreshold || 0)) {\r\n      hasRedText = true;\r\n    }\r\n\r\n    // å®žé™…ç´ ææ—¶é•¿ä¸è¶³ â†’ çº¢èƒŒæ™¯\r\n    if (lackFrames > tolerance) {\r\n      hasRedBg = true;\r\n    }\r\n\r\n    if (hasRedText && hasRedBg) break;\r\n  }\r\n  // âœ… æ¯æ¬¡è¿”å›žä¸€ä¸ªæ–°çš„å¯¹è±¡ï¼Œé¿å…è¢« Vue å¤ç”¨æˆ–ç¼“å­˜\r\n  return {\r\n  color: hasRedText ? 'red !important' : 'white !important',\r\n  backgroundColor: hasRedBg\r\n    ? 'rgba(255, 0, 0, 0.4) !important'\r\n    : hasRedText\r\n    ? 'rgba(255, 255, 255, 0.4) !important'\r\n    : 'rgba(169, 169, 169, 0.4) !important',\r\n};\r\n},\r\n\r\n    // è®¡ç®—é¢„è§ˆå°ºå¯¸\r\n    calculatePreviewSize() {\r\n      if (this.sequence.outputSize.width > this.sequence.outputSize.height) {\r\n        // æ¨ªå±è§†é¢‘\r\n        this.previewScale = 320 / this.sequence.outputSize.width;\r\n        this.scenePreviewWidth = 320;\r\n        this.scenePreviewHeight = this.sequence.outputSize.height * this.previewScale;\r\n      } else {\r\n        // ç«–å±è§†é¢‘\r\n        this.previewScale = 180 / this.sequence.outputSize.height;\r\n        this.scenePreviewHeight = 180;\r\n        this.scenePreviewWidth = this.sequence.outputSize.width * this.previewScale;\r\n      }\r\n\r\n      // åˆ—è¡¨é¡¹ç¼©ç•¥å›¾æ˜¯åœºæ™¯é¢„è§ˆçš„1/4å¤§å°\r\n      this.itemPreviewWidth = this.scenePreviewWidth / 4;\r\n      this.itemPreviewHeight = this.scenePreviewHeight / 4;\r\n    },\r\n    getSceneContentStyle(scene) {\r\n      // 1. è®¡ç®—å›¾ç‰‡åœ¨é¢„è§ˆä¸­çš„å®žé™…æ˜¾ç¤ºå°ºå¯¸ï¼ˆä»…è€ƒè™‘é¢„è§ˆç¼©æ”¾ï¼‰\r\n      const previewWidth = scene.width * this.previewScale;\r\n      const previewHeight = scene.height * this.previewScale;\r\n\r\n      // 2. åº”ç”¨åœºæ™¯ç¼©æ”¾æ¯”ä¾‹ï¼ˆè¿™æ˜¯å…³é”®åŒºåˆ«ï¼ï¼‰\r\n      const displayWidth = previewWidth * scene.scale;\r\n      const displayHeight = previewHeight * scene.scale;\r\n\r\n      // 3. è®¡ç®—é”šç‚¹åœ¨é¢„è§ˆå®¹å™¨ä¸­çš„ä½ç½®ï¼ˆç»å¯¹ä½ç½®ï¼‰\r\n      const anchorPreviewX = scene.anchorX * this.previewScale;\r\n      const anchorPreviewY = scene.anchorY * this.previewScale;\r\n\r\n      // 4. è®¡ç®—å›¾ç‰‡å·¦ä¸Šè§’ä½ç½®ï¼ˆç¡®ä¿é”šç‚¹æˆä¸ºå˜æ¢ä¸­å¿ƒï¼‰\r\n      const left = anchorPreviewX - (displayWidth / 2);\r\n      const top = anchorPreviewY - (displayHeight / 2);\r\n\r\n      return {\r\n        width: `${displayWidth}px`,\r\n        height: `${displayHeight}px`,\r\n        left: `${left}px`,\r\n        top: `${top}px`,\r\n        transform: scene.horizontalFlip ? 'scaleX(-1)' : 'none'\r\n      };\r\n    },\r\n    getItemContentStyle(scene, scale) {\r\n      if (!scene) {\r\n        return {\r\n          width: '100%',\r\n          height: '100%',\r\n          objectFit: 'cover'\r\n        };\r\n      }\r\n\r\n      // 1. è®¡ç®—å›¾ç‰‡åœ¨é¢„è§ˆä¸­çš„å®žé™…æ˜¾ç¤ºå°ºå¯¸ï¼ˆä»…è€ƒè™‘é¢„è§ˆç¼©æ”¾ï¼‰\r\n      const previewWidth = scene.width * this.previewScale * 0.25 * scale; // 1/4å¤§å°\r\n      const previewHeight = scene.height * this.previewScale * 0.25 * scale; // 1/4å¤§å°\r\n\r\n      // 2. åº”ç”¨åœºæ™¯ç¼©æ”¾æ¯”ä¾‹\r\n      const displayWidth = previewWidth * scene.scale;\r\n      const displayHeight = previewHeight * scene.scale;\r\n\r\n      // 3. è®¡ç®—é”šç‚¹åœ¨é¢„è§ˆå®¹å™¨ä¸­çš„ä½ç½®ï¼ˆç»å¯¹ä½ç½®ï¼‰\r\n      const anchorPreviewX = scene.anchorX * this.previewScale * 0.25 * scale;\r\n      const anchorPreviewY = scene.anchorY * this.previewScale * 0.25 * scale;\r\n\r\n      // 4. è®¡ç®—å›¾ç‰‡å·¦ä¸Šè§’ä½ç½®ï¼ˆç¡®ä¿é”šç‚¹æˆä¸ºå˜æ¢ä¸­å¿ƒï¼‰\r\n      const left = anchorPreviewX - (displayWidth / 2);\r\n      const top = anchorPreviewY - (displayHeight / 2);\r\n\r\n      return {\r\n        width: `${displayWidth}px`,\r\n        height: `${displayHeight}px`,\r\n        left: `${left}px`,\r\n        top: `${top}px`,\r\n        position: 'absolute',\r\n        transform: scene.horizontalFlip ? 'scaleX(-1)' : 'none',\r\n        objectFit: 'cover'\r\n      };\r\n    },\r\n        // æ›´æ–°ç¼©ç•¥å›¾ä½ç½®\r\n    updateThumbnailPosition(scene) {\r\n      // ç¡®ä¿ç¼©æ”¾æ¯”ä¾‹æœ‰æ•ˆ\r\n      if (!scene.scale || scene.scale <= 0) {\r\n        scene.scale = Math.min(\r\n          this.sequence.outputSize.width / scene.width,\r\n          this.sequence.outputSize.height / scene.height\r\n        );\r\n      }\r\n\r\n      // ç¡®ä¿é”šç‚¹åœ¨åˆç†èŒƒå›´å†…\r\n      scene.anchorX = Math.max(0, Math.min(scene.anchorX, this.sequence.outputSize.width));\r\n      scene.anchorY = Math.max(0, Math.min(scene.anchorY, this.sequence.outputSize.height));\r\n\r\n      // è§¦å‘è§†å›¾æ›´æ–°\r\n      this.$forceUpdate();\r\n    },\r\n        // å¸§æ•°è½¬æ—¶é—´ (æ ¼å¼: HH:MM:SS.FF)\r\n    frameToTime(frame, fps) {\r\n      if (!fps) return '00:00:00.00';\r\n\r\n      // å¸§çŽ‡å–æ•´\r\n      const roundedFps = Math.round(fps);\r\n\r\n      const totalSeconds = frame / roundedFps;\r\n      const hours = Math.floor(totalSeconds / 3600);\r\n      const minutes = Math.floor((totalSeconds % 3600) / 60);\r\n      const seconds = Math.floor(totalSeconds % 60);\r\n      const remainingFrames = Math.floor(frame % roundedFps);\r\n\r\n      return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}.${remainingFrames.toString().padStart(2, '0')}`;\r\n    },\r\nframeToTime1(frame, fps) {\r\n  if (!fps) return '00:00:00.00';\r\n\r\n  const roundedFps = Math.round(fps);\r\n\r\n  const totalSeconds = frame / roundedFps;\r\n  const hours = Math.floor(totalSeconds / 3600);\r\n  const minutes = Math.floor((totalSeconds % 3600) / 60);\r\n  const seconds = Math.floor(totalSeconds % 60);\r\n\r\n  // è®¡ç®—ä¸¤ä½æ¯«ç§’\r\n  const fractionalSeconds = totalSeconds - Math.floor(totalSeconds);\r\n  const milliseconds = Math.floor(fractionalSeconds * 100); // ä¿ç•™ä¸¤ä½\r\n\r\n  return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}.${milliseconds.toString().padStart(2, '0')}`;\r\n},\r\n\r\n        // è®¡ç®—å‰©ä½™æ—¶é—´ (è¿”å›žæ ¼å¼: HH:MM:SS.FF)\r\n    calculateRemainingTime(scene) {\r\n      if (!this.editedClip.narration?.audioMedia?.duration || !scene.fps) {\r\n        return {\r\n          time: '00:00:00.00',\r\n          class: 'time-positive'\r\n        };\r\n      }\r\n\r\n      const roundedFps = Math.round(scene.fps);\r\n      const sequenceFps = Math.round(this.sequence.frameRate);\r\n\r\n      const totalClipFrames = this.editedClip.narration.audioMedia.duration * sequenceFps;\r\n\r\n      const totalProportion = _.sumBy(this.editedClip.scenes, 'proportion');\r\n      const requiredFrames = (scene.proportion / totalProportion) * totalClipFrames;\r\n\r\n      const actualFrames = (scene.frameRange[1] - scene.frameRange[0] + 1) * (sequenceFps / roundedFps);\r\n\r\n      const remainingFrames = actualFrames - requiredFrames;\r\n      const absFrames = Math.abs(remainingFrames);\r\n\r\n      const timeStr = this.frameToTime(absFrames, sequenceFps);\r\n\r\n      // è¿™é‡Œè®¾å®šä¸€ä¸ªå®¹å·®ï¼Œæ¯”å¦‚ 1 å¸§\r\n      const tolerance = 1;\r\n\r\n      if (Math.abs(remainingFrames) <= tolerance) {\r\n        // åªè¦è¯¯å·®åœ¨å®¹å·®èŒƒå›´å†…ï¼Œå°±å½“ä½œ +00:00:00.00\r\n        return {\r\n          time: `+00:00:00.00`,\r\n          class: 'time-positive'\r\n        };\r\n      }\r\n\r\n      if (remainingFrames > 0) {\r\n        return {\r\n          time: `+${timeStr}`,\r\n          class: 'time-positive'\r\n        };\r\n      } else {\r\n        return {\r\n          time: `-${timeStr}`,\r\n          class: 'time-negative'\r\n        };\r\n      }\r\n    },\r\n\r\n    // å¤„ç†å¸§èŒƒå›´å˜åŒ–çš„é˜²æŠ–æ–¹æ³•\r\n    handleFrameRangeChange(scene) {\r\n\r\n      const now = Date.now();\r\n      const timeDiff = now - this.lastSliderChangeTime;\r\n      this.lastSliderChangeTime = now;\r\n\r\n      // åŠ¨æ€è®¡ç®—é˜²æŠ–æ—¶é—´ï¼šæ»‘åŠ¨è¶Šå¿«ï¼Œé˜²æŠ–æ—¶é—´è¶Šé•¿\r\n      let debounceTime = this.defaultDebounceTime;\r\n      if (timeDiff < 100) { // å¿«é€Ÿæ»‘åŠ¨\r\n        debounceTime = this.maxDebounceTime;\r\n      } else if (timeDiff < 300) { // ä¸­é€Ÿæ»‘åŠ¨\r\n        debounceTime = this.defaultDebounceTime;\r\n      } else { // æ…¢é€Ÿæ»‘åŠ¨\r\n        debounceTime = this.minDebounceTime;\r\n      }\r\n\r\n      // æ¸…é™¤ä¹‹å‰çš„å®šæ—¶å™¨\r\n      if (this.debounceTimers[scene.fullName]) {\r\n        clearTimeout(this.debounceTimers[scene.fullName]);\r\n      }\r\n\r\n      // è®¾ç½®æ–°çš„å®šæ—¶å™¨\r\n      this.debounceTimers[scene.fullName] = setTimeout(() => {\r\n        this.updateSceneFrameRange(scene);\r\n      }, debounceTime);\r\n    },\r\n\r\n    // æ›´æ–°åœºæ™¯å¸§èŒƒå›´\r\n    updateSceneFrameRange(scene) {\r\n      this.updateSceneThumbnail(scene);\r\n    },\r\n  // æ›´æ–°åœºæ™¯ç¼©ç•¥å›¾\r\n      async updateSceneThumbnail(scene) {\r\n        if (scene.fullName && scene.type === 'video') {\r\n          console.error('scene:', scene.sourceHex);\r\n          scene.base64Thumbnail = await aardio.getVideoFrameAsResizedBase64(\r\n            scene.fullName,\r\n            scene.fps,\r\n            scene.frameRange[0],\r\n            this.previewScale * scene.width,\r\n            this.previewScale * scene.height,\r\n            scene.sourceRange[0],\r\n            scene.sourceHex\r\n          );\r\n        }\r\n      },\r\n      // ç§»é™¤åœºæ™¯\r\n      removeScene(index) {\r\n        const clip = this.editedClip; // editedClip å·²ç»æ˜¯å½“å‰ clip çš„å¼•ç”¨\r\n        if (!clip?.scenes || index < 0 || index >= clip.scenes.length) return;\r\n\r\n        clip.scenes.splice(index, 1);\r\n\r\n        // è°ƒæ•´å½“å‰ clip çš„ editedSceneIndexï¼ˆclip è‡ªå·±ç»´æŠ¤ï¼‰\r\n        const cur = clip.editedSceneIndex ?? -1;\r\n\r\n        if (clip.scenes.length === 0) {\r\n          clip.editedSceneIndex = -1; // æ²¡æœ‰åœºæ™¯äº†\r\n        } else if (cur > index) {\r\n          // è¢«åˆ é¡¹åœ¨é€‰ä¸­é¡¹ä¹‹å‰ï¼Œé€‰ä¸­é¡¹å·¦ç§»ä¸€ä½\r\n          clip.editedSceneIndex = cur - 1;\r\n        } else if (cur === index) {\r\n          // åˆ é™¤çš„æ˜¯å½“å‰é€‰ä¸­é¡¹ï¼šå°è¯•é€‰ä¸­â€œåŒä½ç½®çš„ä¸‹ä¸€ä¸ªâ€ï¼Œå¦åˆ™é€‰ä¸Šä¸€ä¸ª\r\n          const newIndex = Math.min(index, clip.scenes.length - 1);\r\n          clip.editedSceneIndex = newIndex;\r\n        }\r\n        // å¦‚æžœ cur < indexï¼Œåˆ™ä¸éœ€è¦æ”¹åŠ¨\r\n      },\r\n      // å¤„ç†ç²˜è´´äº‹ä»¶\r\n      async handlePaste() {\r\n        const pbInfo = await aardio.getPasteboardInfo();\r\n        const result = JSON.parse(pbInfo);\r\n\r\n        if (!result.Type) {\r\n          return; // ä¸æ˜¯æˆ‘ä»¬æƒ³è¦çš„ç²˜è´´å†…å®¹\r\n        }\r\n\r\n        const newScene = _.cloneDeep(this.defaultScene);\r\n        newScene.type = result.Type;\r\n        newScene.fullName = result.FullName;\r\n\r\n        if (result.Type === 'video') {\r\n          newScene.width = result.Width;\r\n          newScene.height = result.Height;\r\n          newScene.fps = result.Fps;\r\n          newScene.countFrame = result.CountFrame;\r\n          newScene.sourceRange = [0, result.CountFrame - 1];\r\n          newScene.frameRange = [0, result.CountFrame - 1];\r\n          newScene.sourceHex = '';\r\n          // èŽ·å–è§†é¢‘ç¼©ç•¥å›¾\r\n          newScene.base64Thumbnail = await aardio.getVideoFrameAsResizedBase64(\r\n            newScene.fullName,\r\n            newScene.fps,\r\n            0,\r\n            this.previewScale * newScene.width,\r\n            this.previewScale * newScene.height,\r\n            newScene.sourceRange[0],\r\n            newScene.sourceHex\r\n          );\r\n        } else if (result.Type === 'image') {\r\n          newScene.width = result.Width;\r\n          newScene.height = result.Height;\r\n          newScene.countFrame = 1;\r\n          newScene.sourceRange = [0, 0];\r\n          newScene.frameRange = [0, 0];\r\n          newScene.sourceHex = '';\r\n\r\n          newScene.base64Thumbnail = await aardio.getImageAsResizedBase64(\r\n            newScene.fullName,\r\n            this.previewScale * newScene.width,\r\n            this.previewScale * newScene.height\r\n          );\r\n        }\r\n\r\n        // æ™ºèƒ½è°ƒæ•´åœºæ™¯å‚æ•°\r\n        if (this.sequence.smartAdjust) {\r\n          const matchedScene = this.findMatchingScene(newScene);\r\n          if (matchedScene) {\r\n            // å¤åˆ¶åŒ¹é…åœºæ™¯çš„å‚æ•°\r\n            newScene.scale = matchedScene.scale;\r\n            newScene.anchorX = matchedScene.anchorX;\r\n            newScene.anchorY = matchedScene.anchorY;\r\n            newScene.horizontalFlip = matchedScene.horizontalFlip;\r\n            newScene.upend = matchedScene.upend;\r\n            newScene.growFrame = matchedScene.growFrame;\r\n          } else {\r\n            // æ²¡æœ‰æ‰¾åˆ°åŒ¹é…åœºæ™¯ï¼Œä½¿ç”¨é»˜è®¤è®¡ç®—\r\n            newScene.scale = Math.min(\r\n              this.sequence.outputSize.width / newScene.width,\r\n              this.sequence.outputSize.height / newScene.height\r\n            );\r\n            newScene.anchorX = this.sequence.outputSize.width / 2;\r\n            newScene.anchorY = this.sequence.outputSize.height / 2;\r\n            newScene.growFrame = true;\r\n          }\r\n        } else {\r\n          // ä¸ä½¿ç”¨æ™ºèƒ½è°ƒæ•´ï¼Œä½¿ç”¨é»˜è®¤è®¡ç®—\r\n          newScene.scale = Math.min(\r\n            this.sequence.outputSize.width / newScene.width,\r\n            this.sequence.outputSize.height / newScene.height\r\n          );\r\n          newScene.anchorX = this.sequence.outputSize.width / 2;\r\n          newScene.anchorY = this.sequence.outputSize.height / 2;\r\n        }\r\n\r\n        // æ·»åŠ åˆ°åœºæ™¯åˆ—è¡¨\r\n        this.editedClip.scenes.push(newScene);\r\n        this.selectScene(this.editedClip.scenes.length - 1);\r\n      },\r\n      // æ›¿æ¢æŒ‡å®šç´¢å¼•çš„åœºæ™¯\r\n      async replaceSceneWithPaste(index) {\r\n        if (\r\n          index == null ||\r\n          index < 0 ||\r\n          index >= this.editedClip.scenes.length\r\n        ) {\r\n          console.warn('invalid scene index:', index);\r\n          return;\r\n        }\r\n\r\n        const pbInfo = await aardio.getPasteboardInfo();\r\n        const result = JSON.parse(pbInfo);\r\n\r\n        if (!result.Type) {\r\n          return; // ä¸æ˜¯æˆ‘ä»¬æƒ³è¦çš„ç²˜è´´å†…å®¹\r\n        }\r\n\r\n        const newScene = _.cloneDeep(this.defaultScene);\r\n        newScene.type = result.Type;\r\n        newScene.fullName = result.FullName;\r\n\r\n        if (result.Type === 'video') {\r\n          newScene.width = result.Width;\r\n          newScene.height = result.Height;\r\n          newScene.fps = result.Fps;\r\n          newScene.countFrame = result.CountFrame;\r\n          newScene.sourceRange = [0, result.CountFrame - 1];\r\n          newScene.frameRange = [0, result.CountFrame - 1];\r\n          newScene.sourceHex = '';\r\n\r\n          // èŽ·å–è§†é¢‘ç¼©ç•¥å›¾\r\n          newScene.base64Thumbnail = await aardio.getVideoFrameAsResizedBase64(\r\n            newScene.fullName,\r\n            newScene.fps,\r\n            0,\r\n            this.previewScale * newScene.width,\r\n            this.previewScale * newScene.height,\r\n            newScene.sourceRange[0],\r\n            newScene.sourceHex\r\n          );\r\n        } else if (result.Type === 'image') {\r\n          newScene.width = result.Width;\r\n          newScene.height = result.Height;\r\n          newScene.countFrame = 1;\r\n          newScene.sourceRange = [0, 0];\r\n          newScene.frameRange = [0, 0];\r\n          newScene.sourceHex = '';\r\n\r\n          newScene.base64Thumbnail = await aardio.getImageAsResizedBase64(\r\n            newScene.fullName,\r\n            this.previewScale * newScene.width,\r\n            this.previewScale * newScene.height\r\n          );\r\n        }\r\n\r\n        // æ™ºèƒ½è°ƒæ•´åœºæ™¯å‚æ•°\r\n        if (this.sequence.smartAdjust) {\r\n          // å°è¯•ä»Žå½“å‰åœºæ™¯å¤åˆ¶å‚æ•°\r\n          const currentScene = this.editedClip.scenes[index];\r\n          if (currentScene) {\r\n            newScene.scale = currentScene.scale;\r\n            newScene.anchorX = currentScene.anchorX;\r\n            newScene.anchorY = currentScene.anchorY;\r\n            newScene.horizontalFlip = currentScene.horizontalFlip;\r\n            newScene.upend = currentScene.upend;\r\n          } else {\r\n            // ä½¿ç”¨é»˜è®¤è®¡ç®—\r\n            newScene.scale = Math.min(\r\n              this.sequence.outputSize.width / newScene.width,\r\n              this.sequence.outputSize.height / newScene.height\r\n            );\r\n            newScene.anchorX = this.sequence.outputSize.width / 2;\r\n            newScene.anchorY = this.sequence.outputSize.height / 2;\r\n          }\r\n        } else {\r\n          // ä¸ä½¿ç”¨æ™ºèƒ½è°ƒæ•´ï¼Œä½¿ç”¨é»˜è®¤è®¡ç®—\r\n          newScene.scale = Math.min(\r\n            this.sequence.outputSize.width / newScene.width,\r\n            this.sequence.outputSize.height / newScene.height\r\n          );\r\n          newScene.anchorX = this.sequence.outputSize.width / 2;\r\n          newScene.anchorY = this.sequence.outputSize.height / 2;\r\n        }\r\n\r\n        newScene.proportion = this.editedClip.scenes[index].proportion;\r\n        // æ›¿æ¢åœºæ™¯\r\n        this.editedClip.scenes.splice(index, 1, newScene);\r\n      },\r\n      // æŸ¥æ‰¾åŒ¹é…çš„åœºæ™¯\r\n      findMatchingScene(newScene) {\r\n        // 1. é¦–å…ˆåœ¨å½“å‰clipçš„scenesä¸­æŸ¥æ‰¾\r\n        const currentClipIndex = this.sequence.selectedIndex;\r\n        const currentClip = currentClipIndex >= 0 ? this.sequence.clips[currentClipIndex] : null;\r\n        const currentScenes = currentClip ? currentClip.scenes : [];\r\n\r\n        // æŸ¥æ‰¾é¡ºåº: å½“å‰clipä¸­å‰é¢çš„åœºæ™¯ -> åŽé¢çš„åœºæ™¯\r\n        let matchedScene = this.findInCurrentClipScenes(newScene, currentScenes);\r\n        if (matchedScene) return matchedScene;\r\n\r\n        // 2. ç„¶åŽåœ¨å…¶ä»–clipä¸­æŸ¥æ‰¾\r\n        // å…ˆæŸ¥æ‰¾å‰é¢çš„clip(ä»Žè¿‘åˆ°è¿œ)\r\n        for (let i = currentClipIndex - 1; i >= 0; i--) {\r\n          matchedScene = this.findInClipScenes(newScene, this.sequence.clips[i].scenes);\r\n          if (matchedScene) return matchedScene;\r\n        }\r\n\r\n        // å†æŸ¥æ‰¾åŽé¢çš„clip(ä»Žè¿‘åˆ°è¿œ)\r\n        for (let i = currentClipIndex + 1; i < this.sequence.clips.length; i++) {\r\n          matchedScene = this.findInClipScenes(newScene, this.sequence.clips[i].scenes);\r\n          if (matchedScene) return matchedScene;\r\n        }\r\n\r\n        // 3. å¦‚æžœè¿˜æ²¡æœ‰æ‰¾åˆ°ï¼Œæ”¾å®½æ¡ä»¶ï¼šåªåŒ¹é…widthå’Œheight\r\n        matchedScene = this.findInCurrentClipScenes(newScene, currentScenes, false);\r\n        if (matchedScene) return matchedScene;\r\n\r\n        for (let i = currentClipIndex - 1; i >= 0; i--) {\r\n          matchedScene = this.findInClipScenes(newScene, this.sequence.clips[i].scenes, false);\r\n          if (matchedScene) return matchedScene;\r\n        }\r\n\r\n        for (let i = currentClipIndex + 1; i < this.sequence.clips.length; i++) {\r\n          matchedScene = this.findInClipScenes(newScene, this.sequence.clips[i].scenes, false);\r\n          if (matchedScene) return matchedScene;\r\n        }\r\n\r\n        return null;\r\n      },\r\n\r\n      // åœ¨å½“å‰clipçš„åœºæ™¯ä¸­æŸ¥æ‰¾åŒ¹é…é¡¹\r\n      findInCurrentClipScenes(newScene, scenes, matchType = true) {\r\n        const newSceneIndex = this.editedClip.scenes.length; // æ–°åœºæ™¯å°†æ·»åŠ åˆ°çš„ç´¢å¼•\r\n\r\n        // å…ˆå‘å‰æŸ¥æ‰¾\r\n        for (let i = newSceneIndex - 1; i >= 0; i--) {\r\n          const scene = scenes[i];\r\n          if (this.isSceneMatch(newScene, scene, matchType)) {\r\n            return scene;\r\n          }\r\n        }\r\n\r\n        // å†å‘åŽæŸ¥æ‰¾\r\n        for (let i = newSceneIndex; i < scenes.length; i++) {\r\n          const scene = scenes[i];\r\n          if (this.isSceneMatch(newScene, scene, matchType)) {\r\n            return scene;\r\n          }\r\n        }\r\n\r\n        return null;\r\n      },\r\n\r\n      // åœ¨æŒ‡å®šclipçš„åœºæ™¯ä¸­æŸ¥æ‰¾åŒ¹é…é¡¹\r\n      findInClipScenes(newScene, scenes, matchType = true) {\r\n        for (const scene of scenes) {\r\n          if (this.isSceneMatch(newScene, scene, matchType)) {\r\n            return scene;\r\n          }\r\n        }\r\n        return null;\r\n      },\r\n\r\n      // åˆ¤æ–­åœºæ™¯æ˜¯å¦åŒ¹é…\r\n      isSceneMatch(newScene, scene, matchType = true) {\r\n        if (!scene) return false;\r\n\r\n        // æ£€æŸ¥å®½åº¦å’Œé«˜åº¦æ˜¯å¦åŒ¹é…\r\n        const sizeMatch = scene.width === newScene.width && scene.height === newScene.height;\r\n        if (!sizeMatch) return false;\r\n\r\n        // å¦‚æžœè¦æ±‚ç±»åž‹åŒ¹é…ï¼Œåˆ™æ£€æŸ¥ç±»åž‹\r\n        if (matchType) {\r\n          return scene.type === newScene.type;\r\n        }\r\n\r\n        return true;\r\n      },\r\n\r\n    // è§¦å‘ç²˜è´´æ“ä½œ\r\n    triggerPaste() {\r\n      //this.handlePaste();\r\n    },\r\n\r\n    // åˆå§‹åŒ–ä¸‹æ‹‰æ¡†\r\n    initializeComboboxes() {\r\n      if (!this.editedClip.narration.locale && this.list_language_cn.length > 0) {\r\n        this.editedClip.narration.locale = this.list_language_cn[0].locale;\r\n      }\r\n      this.updateVoiceItems();\r\n    },\r\n\r\n    // è¯­è¨€å˜æ›´å¤„ç†\r\n    onEditedClipLanguageChange() {\r\n      this.updateVoiceItems();\r\n    },\r\n\r\n    // æ›´æ–°è¯­éŸ³åˆ—è¡¨\r\n    updateVoiceItems() {\r\n      const locale = this.list_language_cn.find(lang => lang.locale === this.editedClip.narration.locale)?.locale;\r\n      if (locale) {\r\n        const voices = this.list_voice_edge;\r\n        this.voiceItems = voices.filter(voice => voice.lang === locale).map(voice => voice.name.split(\" \")[1]);\r\n        if (!this.voiceItems.includes(this.editedClip.narration.voiceName)) {\r\n          this.editedClip.narration.voiceName = this.voiceItems[0] || '';\r\n        }\r\n      } else {\r\n        this.voiceItems = [];\r\n        this.editedClip.narration.voiceName = '';\r\n      }\r\n    },\r\n\r\n    // æ–°clipè¯­è¨€å˜æ›´å¤„ç†\r\n    onNewClipLanguageChange() {\r\n      const locale = this.list_language_cn.find(lang =>\r\n        lang.locale === this.newClip.narration.locale)?.locale;\r\n      if (locale) {\r\n        const voices = this.list_voice_edge;\r\n        this.newClipVoiceItems = voices.filter(voice => voice.lang === locale).map(voice => voice.name.split(\" \")[1]);\r\n        if (!this.newClipVoiceItems.includes(this.newClip.narration.voiceName)) {\r\n          this.newClip.narration.voiceName = this.newClipVoiceItems[0] || '';\r\n        }\r\n      } else {\r\n        this.newClipVoiceItems = [];\r\n        this.newClip.narration.voiceName = '';\r\n      }\r\n    },\r\n\r\n    // é¡¹ç›®æ“ä½œ\r\n    async openProjectPicker() {\r\n      const fullName_json = await aardio.openProject();\r\n      if (fullName_json) {\r\n        await this.openProject(fullName_json);\r\n      }\r\n    },\r\n\r\n    async openProject(fullName_json) {\r\n      this.projectFullName = fullName_json;\r\n      if (this.projectFullName) {\r\n        this.projectDirectory = this.projectFullName.substring(0, this.projectFullName.lastIndexOf('\\\\'));\r\n        const fileName = this.projectFullName.split('\\\\').pop();\r\n        this.projectName = fileName;\r\n      }\r\n      const fileData = await aardio.getFileData(this.projectFullName);\r\n\r\n      if (fileData) {\r\n        try {\r\n          const jsonData = JSON.parse(fileData);\r\n          this.sequence = Array.isArray(jsonData) ? jsonData[0] : jsonData;\r\n\r\n          if (!this.sequence.clips) {\r\n            this.sequence.clips = [];\r\n          }\r\n\r\n          if (this.sequence.clips.length > this.sequence.selectedIndex) {\r\n            this.selectClip(this.sequence.selectedIndex);\r\n          } else {\r\n            this.sequence.selectedIndex = -1;\r\n          }\r\n        } catch (e) {\r\n          console.error(\"Failed to parse the project file:\", e);\r\n          this.resetProject();\r\n        }\r\n      } else {\r\n        this.resetProject();\r\n      }\r\n    },\r\n\r\n    // é‡ç½®é¡¹ç›®\r\n    resetProject() {\r\n      this.sequence = {\r\n        ...this.sequence,\r\n        clips: [],\r\n        selectedIndex: -1\r\n      };\r\n      this.resetEditedClip();\r\n    },\r\n\r\n    async saveProject() {\r\n      if (this.projectFullName) {\r\n        const dataToSave = JSON.stringify(this.sequence, null, 2);\r\n        await aardio.saveTextFile(dataToSave, this.projectFullName);\r\n      }\r\n    },\r\n    async saveProjectClick() {\r\n      await this.saveProject();\r\n      this.showToast(this.$t('saveSuccessToast'), 'success');\r\n    },\r\n\r\n    // é€‰æ‹©ç‰‡æ®µ\r\n    selectClip(index) {\r\n      if (index >= 0 && index < this.sequence.clips.length) {\r\n        this.isPlaying = false;\r\n        this.sequence.selectedIndex = index;\r\n\r\n        // ä¸å† cloneDeepï¼ŒeditedClip ä¼šè‡ªåŠ¨æ ¹æ® computed æŒ‡å‘ç›®æ ‡ clip\r\n        if (this.editedClip.narration?.locale) {\r\n          this.onEditedClipLanguageChange();\r\n        }\r\n      } else {\r\n        this.resetEditedClip();\r\n      }\r\n    },\r\n\r\n    // é‡ç½®ç¼–è¾‘è¡¨å•\r\n    resetEditedClip() {\r\n      this.editedClip = getDefaultClip();\r\n      this.editedClip.scenes = [];\r\n    },\r\n\r\n    // ç¼–è¾‘ç‰‡æ®µ\r\n    editClip(index) {\r\n      this.selectClip(index);\r\n    },\r\n\r\n    // åˆ é™¤ç‰‡æ®µ\r\n    deleteClip(index) {\r\n      this.sequence.clips.splice(index, 1);\r\n\r\n      // æ›´æ–°é€‰ä¸­ç´¢å¼•\r\n      if (this.sequence.clips.length === 0) {\r\n        // å¦‚æžœæ²¡æœ‰clipäº†ï¼Œé‡ç½®é€‰ä¸­ç´¢å¼•ä¸º-1\r\n        this.sequence.selectedIndex = -1;\r\n      } else if (this.sequence.selectedIndex >= index) {\r\n        this.sequence.selectedIndex = Math.max(0, this.sequence.selectedIndex - 1);\r\n      }\r\n\r\n      // æ›´æ–°é€‰ä¸­çŠ¶æ€\r\n      this.selectedClipIndices = this.selectedClipIndices\r\n        .filter(i => i !== index)\r\n        .map(i => i > index ? i - 1 : i);\r\n    },\r\n\r\n    // åˆ é™¤å½“å‰\r\n    deleteCurrent() {\r\n      if (this.sequence.selectedIndex >= 0) {\r\n        this.deleteClip(this.sequence.selectedIndex);\r\n      }\r\n    },\r\n\r\n    // æ‰¹é‡æ“ä½œ\r\n    // æ˜¾ç¤ºåˆ é™¤ç¡®è®¤å¯¹è¯æ¡†\r\n    showDeleteConfirm() {\r\n      if (this.selectedClipIndices.length === 0) return;\r\n      this.deleteConfirmDialog = true;\r\n    },\r\n\r\n    // ç¡®è®¤æ‰¹é‡åˆ é™¤\r\n    confirmBatchDelete() {\r\n      // ä»Žå¤§åˆ°å°æŽ’åºç´¢å¼•ï¼Œé¿å…åˆ é™¤æ—¶ç´¢å¼•å˜åŒ–\r\n      const indicesToDelete = [...this.selectedClipIndices].sort((a, b) => b - a);\r\n\r\n      indicesToDelete.forEach(index => {\r\n        this.sequence.clips.splice(index, 1);\r\n      });\r\n\r\n      // æ›´æ–°é€‰ä¸­ç´¢å¼• - æ·»åŠ æ£€æŸ¥æ˜¯å¦æ²¡æœ‰clipäº†\r\n      if (this.sequence.clips.length === 0) {\r\n        this.sequence.selectedIndex = -1;\r\n      } else if (this.selectedClipIndices.includes(this.sequence.selectedIndex)) {\r\n        this.sequence.selectedIndex = Math.max(0, Math.min(this.sequence.selectedIndex, this.sequence.clips.length - 1));\r\n      }\r\n\r\n      // æ¸…ç©ºé€‰ä¸­çŠ¶æ€\r\n      this.selectedClipIndices = [];\r\n      this.saveProject();\r\n\r\n      // å…³é—­å¯¹è¯æ¡†\r\n      this.deleteConfirmDialog = false;\r\n    },\r\n\r\n    // åŽŸæ¥çš„batchDeleteæ–¹æ³•å¯ä»¥åˆ é™¤æˆ–ä¿ç•™ä½œä¸ºåˆ«å\r\n    batchDelete() {\r\n      this.showDeleteConfirm();\r\n    },\r\n    // æ‰¹é‡ç¼–è¾‘æ–¹æ³•\r\n    batchEdit() {\r\n      if (this.selectedClipIndices.length === 0) return;\r\n\r\n      // èŽ·å–ç¬¬ä¸€ä¸ªé€‰ä¸­clipçš„å‚æ•°ä½œä¸ºåˆå§‹å€¼\r\n      const firstClip = this.sequence.clips[this.selectedClipIndices[0]];\r\n      this.batchEditParams = {\r\n        rate: firstClip.narration.rate,\r\n        speed: firstClip.narration.speed,\r\n        pauseBefore: firstClip.narration.pauseBefore,\r\n        pauseAfter: firstClip.narration.pauseAfter,\r\n        locale: firstClip.narration.locale,\r\n        voiceName: firstClip.narration.voiceName\r\n      };\r\n\r\n      // æ›´æ–°è¯­éŸ³é€‰é¡¹\r\n      this.onBatchEditLanguageChange();\r\n\r\n      // ç”Ÿæˆå‚æ•°é¢„è®¾\r\n      this.generateParameterPresets();\r\n\r\n      // æ‰“å¼€å¯¹è¯æ¡†\r\n      this.batchEditDialog = true;\r\n    },\r\n\r\n    // æ‰¹é‡ç¼–è¾‘è¯­è¨€å˜æ›´å¤„ç†\r\n    onBatchEditLanguageChange() {\r\n      const locale = this.list_language_cn.find(lang =>\r\n        lang.locale === this.batchEditParams.locale)?.locale;\r\n      if (locale) {\r\n        const voices = this.list_voice_edge;\r\n        this.batchEditVoiceItems = voices\r\n          .filter(voice => voice.lang === locale)\r\n          .map(voice => voice.name.split(\" \")[1]);\r\n\r\n        if (!this.batchEditVoiceItems.includes(this.batchEditParams.voiceName)) {\r\n          this.batchEditParams.voiceName = this.batchEditVoiceItems[0] || '';\r\n        }\r\n      } else {\r\n        this.batchEditVoiceItems = [];\r\n        this.batchEditParams.voiceName = '';\r\n      }\r\n    },\r\n\r\n    // ç”Ÿæˆå‚æ•°é¢„è®¾\r\n    generateParameterPresets() {\r\n      const uniqueParams = new Map();\r\n      this.sequence.clips.forEach((clip) => {\r\n        if (!clip?.narration) return;\r\n        const key = JSON.stringify({\r\n          rate: clip.narration.rate,\r\n          speed: clip.narration.speed,\r\n          pauseBefore: clip.narration.pauseBefore,\r\n          pauseAfter: clip.narration.pauseAfter,\r\n          voiceName: clip.narration.voiceName\r\n        });\r\n        if (!uniqueParams.has(key)) {\r\n          uniqueParams.set(key, {\r\n            rate: clip.narration.rate,\r\n            speed: clip.narration.speed,\r\n            pauseBefore: clip.narration.pauseBefore,\r\n            pauseAfter: clip.narration.pauseAfter,\r\n            locale: clip.narration.locale,\r\n            voiceName: clip.narration.voiceName\r\n          });\r\n        }\r\n      });\r\n\r\n      this.parameterPresets = Array.from(uniqueParams.values()).map((params, index) => ({\r\n        value: index,\r\n        title: `${params.voiceName}___R${params.rate}___S${params.speed}___PB${params.pauseBefore}___PA${params.pauseAfter}`,\r\n        params\r\n      }));\r\n\r\n      if (this.parameterPresets.length > 0) {\r\n        //this.selectedPreset = this.parameterPresets[0];\r\n      }\r\n    },\r\n\r\n    // åº”ç”¨é¢„è®¾\r\n\r\n    applyPreset(preset) {\r\n      if (preset?.params) {\r\n        this.batchEditParams = { ...preset.params };\r\n        this.onBatchEditLanguageChange();\r\n      }\r\n    },\r\n\r\n    // åº”ç”¨æ‰¹é‡ç¼–è¾‘\r\n    applyBatchEdit() {\r\n      this.selectedClipIndices.forEach(index => {\r\n        const clip = this.sequence.clips[index];\r\n\r\n        // æ›´æ–°å‚æ•°\r\n        clip.narration.rate = this.batchEditParams.rate;\r\n        clip.narration.speed = this.batchEditParams.speed;\r\n        clip.narration.pauseBefore = this.batchEditParams.pauseBefore;\r\n        clip.narration.pauseAfter = this.batchEditParams.pauseAfter;\r\n        clip.narration.locale = this.batchEditParams.locale;\r\n        clip.narration.voiceName = this.batchEditParams.voiceName;\r\n\r\n        if(this.clearAudioMedia){\r\n          clip.narration.audioMedia.filePath = '';\r\n          clip.narration.audioMedia.duration = 0;\r\n        }\r\n        if(this.clearVideoMedia){\r\n          clip.videoMedia.filePath = '';\r\n          clip.videoMedia.duration = 0;\r\n        }\r\n\r\n        // å¦‚æžœæ­£åœ¨ç¼–è¾‘å½“å‰clipï¼Œæ›´æ–°ç¼–è¾‘è¡¨å•\r\n        if (index === this.sequence.selectedIndex) {\r\n          this.editedClip.narration = { ...clip.narration };\r\n        }\r\n      });\r\n\r\n      this.saveProject();\r\n      this.batchEditDialog = false;\r\n    },\r\n\r\n    // å¯¼èˆª\r\n    prevItem() {\r\n      if (this.sequence.selectedIndex > 0) {\r\n        this.selectClip(this.sequence.selectedIndex - 1);\r\n      }\r\n    },\r\n\r\n    nextItem() {\r\n      if (this.sequence.selectedIndex < this.sequence.clips.length - 1) {\r\n        this.selectClip(this.sequence.selectedIndex + 1);\r\n      }\r\n    },\r\n    // æ‰“å¼€æ·»åŠ å¯¹è¯æ¡†\r\n    addItem() {\r\n      // ç»§æ‰¿å½“å‰é€‰ä¸­clipçš„narrationè®¾ç½®\r\n      if (this.sequence.selectedIndex >= 0 && this.sequence.clips.length > 0) {\r\n        const currentClip = this.sequence.clips[this.sequence.selectedIndex];\r\n        Object.keys(currentClip.narration).forEach(key => {\r\n          const value = currentClip.narration[key];\r\n          if (value !== null && value !== undefined && value !== '') {\r\n            this.newClip.narration[key] = _.cloneDeep(value);\r\n          }\r\n        });\r\n        this.newClip.narration.audioMedia.filePath = '';\r\n        this.newClip.narration.audioMedia.duration = 0;\r\n      }else{\r\n        this.newClip.narration.locale = this.list_language_cn[0].locale;\r\n      }\r\n      this.onNewClipLanguageChange();\r\n      this.addDialog = true;\r\n    },\r\n\r\n    // ç¡®è®¤æ·»åŠ clip\r\n    confirmAddClip() {\r\n      if (this.autoSplitSentences) {\r\n        this.splitAndAddClips();\r\n      } else {\r\n        this.addSingleClip();\r\n      }\r\n      this.saveProject();\r\n      this.addDialog = false;\r\n    },\r\n\r\n    // æ·»åŠ å•ä¸ªclip\r\n    addSingleClip() {\r\n      const insertIndex = this.getInsertIndex();\r\n\r\n      this.sequence.clips.splice(insertIndex, 0, _.cloneDeep(this.newClip));\r\n      this.selectClip(insertIndex);\r\n      this.resetNewClip();\r\n    },\r\n\r\n    // åˆ†å‰²å¹¶æ·»åŠ å¤šä¸ªclip\r\n    splitAndAddClips() {\r\n      const sentences = splitSentences(this.newClip.sentence);\r\n      const comments1 = this.autoSplitSentences\r\n        ? splitSentences(this.newClip.comment1)\r\n        : [this.newClip.comment1 || ''];\r\n      const comments2 = this.autoSplitSentences\r\n        ? splitSentences(this.newClip.comment2)\r\n        : [this.newClip.comment2 || ''];\r\n\r\n      // â­ ç”¨ç»Ÿä¸€æ–¹æ³•\r\n      const insertIndex = this.getInsertIndex();\r\n\r\n      const newClips = sentences.map((sentence, index) => {\r\n        const clip = _.cloneDeep(this.newClip);\r\n        clip.sentence = sentence;\r\n        clip.comment1 = comments1[index % comments1.length] || '';\r\n        clip.comment2 = comments2[index % comments2.length] || '';\r\n        return clip;\r\n      });\r\n\r\n      if (newClips.length > 0) {\r\n        this.sequence.clips.splice(insertIndex, 0, ...newClips);\r\n        this.selectClip(insertIndex);\r\n      }\r\n\r\n      this.resetNewClip();\r\n    },\r\n\r\n\r\n      // é‡ç½®æ–°clipè¡¨å•\r\n      resetNewClip() {\r\n        this.newClip = getDefaultClip();\r\n        this.autoSplitSentences = true;\r\n        this.insertClipMode = 'appendClip';\r\n      },\r\n\r\n      getInsertIndex() {\r\n        const selectedIndex = this.sequence.selectedIndex;\r\n\r\n        // æ²¡é€‰ä¸­ â†’ é»˜è®¤åŠ åˆ°æœ€åŽ\r\n        if (selectedIndex < 0) {\r\n          return this.sequence.clips.length;\r\n        }\r\n\r\n        // æ ¹æ®æ¨¡å¼å†³å®š\r\n        if (this.insertClipMode === 'insertClip') {\r\n          return selectedIndex;       // ðŸ‘‰ æ’å…¥åˆ°å½“å‰å‰é¢\r\n        } else {\r\n          return selectedIndex + 1;   // ðŸ‘‰ æ’å…¥åˆ°å½“å‰åŽé¢\r\n        }\r\n      },\r\n      async batchGenerateVideo() {\r\n\r\n        // å¼€å§‹æ‰¹é‡ç”Ÿæˆ\r\n        this.isBatchGeneratingVideo = true;\r\n        this.cancelBatchVideoGeneration = false;\r\n        this.batchVideoGenerationProgress = 0;\r\n        this.totalBatchVideoCount = this.selectedClipIndices.length;\r\n        this.currentBatchVideoIndex = 0;\r\n\r\n        const dir_video = this.projectDirectory + '\\\\' + this.folder_video;\r\n        const dir_buff = this.projectDirectory + '\\\\' + this.folder_buff;\r\n\r\n        try {\r\n          // åˆ›å»ºå¿…è¦çš„ç›®å½•\r\n          await aardio.createDir(dir_video, false);\r\n\r\n          // æŒ‰é¡ºåºå¤„ç†æ¯ä¸ªé€‰ä¸­çš„clip\r\n          for (let i = 0; i < this.selectedClipIndices.length; i++) {\r\n            if (this.cancelBatchVideoGeneration) {\r\n              break;\r\n            }\r\n\r\n            // æ›´æ–°å½“å‰å¤„ç†ç´¢å¼•\r\n            this.currentBatchVideoIndex = i;\r\n            const clipIndex = this.selectedClipIndices[i];\r\n            const clip = this.sequence.clips[clipIndex];\r\n\r\n            // æ£€æŸ¥clipæ˜¯å¦æœ‰æ•ˆ\r\n            if (!clip || (!clip.sentence && (!clip.scenes || clip.scenes.length === 0))) {\r\n              console.warn(`Skip invalid clip (index: ${clipIndex})`);\r\n              continue;\r\n            }\r\n\r\n            try {\r\n\r\n              // å¦‚æžœéŸ³é¢‘ä¸å­˜åœ¨ï¼Œå…ˆç”ŸæˆéŸ³é¢‘\r\n              if (!clip.narration.audioMedia.duration || clip.narration.audioMedia.duration === 0) {\r\n                const dir_audio = this.projectDirectory + '\\\\' + this.folder_audio;\r\n                await aardio.createDir(dir_audio, false);\r\n\r\n                const audioName = await this.getMediaName(dir_audio, clipIndex, clip.sentence, 'wav');\r\n                const fullname_audio_output = dir_audio + '\\\\' + audioName + '.wav';\r\n\r\n                try {\r\n                  // ç¡®ä¿ä¸´æ—¶ç›®å½•å­˜åœ¨ä¸”ä¸ºç©º\r\n                  await aardio.createDir(dir_buff, true);\r\n                  await this.recordAudio(clip, dir_buff, fullname_audio_output);\r\n                } catch (error) {\r\n                  if (error.message !== 'CANCELLED') {\r\n                    console.error('Error generating audio:', error);\r\n                  }\r\n                } finally {\r\n                  await aardio.deleteDir(dir_buff);\r\n                }\r\n\r\n                // æ£€æŸ¥éŸ³é¢‘æ˜¯å¦æˆåŠŸç”Ÿæˆ\r\n                if (!clip.narration.audioMedia.duration || clip.narration.audioMedia.duration === 0) {\r\n                  console.warn(`Error generating audio, skip clip (index: ${clipIndex})`);\r\n                  continue;\r\n                }\r\n              }\r\n\r\n              // ç”Ÿæˆè§†é¢‘\r\n              await this.generateVideo(clipIndex, clip, dir_video);\r\n\r\n              // æ›´æ–°å½“å‰ç¼–è¾‘çš„clipï¼ˆå¦‚æžœæ­£åœ¨ç¼–è¾‘ï¼‰\r\n              if (this.sequence.selectedIndex === clipIndex) {\r\n                this.editedClip.videoMedia = {...clip.videoMedia};\r\n              }\r\n\r\n            } catch (error) {\r\n              console.error(`Error generating video ${i + 1}:`, error);\r\n              this.showToast(`Failed to generate video ${i + 1}: ${error.message}`, 'error');\r\n            } finally {\r\n              // æ¸…ç†ä¸´æ—¶ç›®å½•\r\n\r\n              // æ›´æ–°è¿›åº¦ï¼ˆæ— è®ºæˆåŠŸæˆ–å¤±è´¥ï¼‰\r\n              this.batchVideoGenerationProgress = Math.round(((i + 1) / this.selectedClipIndices.length) * 100);\r\n            }\r\n          }\r\n\r\n        } catch (error) {\r\n          console.error('Batch video generation error:', error);\r\n        } finally {\r\n          // æœ€ç»ˆæ¸…ç†\r\n          try {\r\n            await aardio.deleteDir(dir_buff);\r\n          } catch (cleanupError) {\r\n            console.error('Final cleanup of temporary directory failed:', cleanupError);\r\n          }\r\n          this.saveProject();\r\n          this.isBatchGeneratingVideo = false;\r\n          this.cancelBatchVideoGeneration = false;\r\n        }\r\n      },\r\n      async generateVideo(clipIndex, clip, dir_video){\r\n\r\n        const dir_buff = this.projectDirectory+'\\\\'+this.folder_buff;\r\n        await aardio.createDir(dir_buff, true);\r\n\r\n        const videoName = await this.getMediaName(dir_video, clipIndex, clip.sentence, 'mp4');\r\n        const fullname_video_output = dir_video+'\\\\'+videoName+'.mp4';\r\n\r\n        // åˆ›å»ºå‰¯æœ¬å¹¶å°† base64Thumbnail è®¾ç½®ä¸ºç©ºå­—ç¬¦ä¸²\r\n        const clipForProcessing = JSON.parse(JSON.stringify(clip));\r\n        clipForProcessing.scenes.forEach(scene => {\r\n            scene.base64Thumbnail = \"\"; // è®¾ç½®ä¸ºç©ºå­—ç¬¦ä¸²\r\n        });\r\n\r\n        const jsonString = JSON.stringify(clipForProcessing, null, 2);\r\n        const fullName_clip = dir_buff+'\\\\clip.json';\r\n        await aardio.saveTextFile(jsonString, fullName_clip);\r\n        await aardio.clipToH264Video(this.sequence.frameRate,\r\n          this.sequence.outputSize.width,\r\n          this.sequence.outputSize.height,\r\n          0,\r\n          0,\r\n          0,\r\n          fullName_clip,\r\n          fullname_video_output,\r\n          dir_buff\r\n        );\r\n        const isFileExist = await aardio.isFileExist(fullname_video_output);\r\n        if(isFileExist){\r\n          clip.videoMedia.filePath = fullname_video_output;\r\n          const videoInfo = await aardio.getVideoInfo(fullname_video_output);\r\n          const j_videoInfo = JSON.parse(videoInfo);\r\n          clip.videoMedia.duration = j_videoInfo.Duration;\r\n        }\r\n      },\r\n      // æ‰¹é‡ç”ŸæˆéŸ³é¢‘æ–¹æ³•\r\n      async batchGenerateAudio() {\r\n\r\n        // å¼€å§‹æ‰¹é‡ç”Ÿæˆ\r\n        this.isBatchGeneratingAudio = true;\r\n        this.cancelBatchAudioGeneration = false;\r\n        this.batchAudioGenerationProgress = 0;\r\n        this.totalBatchAudioCount = this.selectedClipIndices.length;\r\n        this.currentBatchAudioIndex = 0;\r\n\r\n        const dir_audio = this.projectDirectory + '\\\\' + this.folder_audio;\r\n        await aardio.createDir(dir_audio, false);\r\n\r\n        const dir_buff = this.projectDirectory + '\\\\' + this.folder_buff;\r\n\r\n        try {\r\n          // æŒ‰é¡ºåºå¤„ç†æ¯ä¸ªé€‰ä¸­çš„clip\r\n          for (let i = 0; i < this.selectedClipIndices.length; i++) {\r\n            if (this.cancelBatchAudioGeneration) {\r\n              break; // å¦‚æžœå–æ¶ˆåˆ™é€€å‡ºå¾ªçŽ¯\r\n            }\r\n\r\n            await aardio.createDir(dir_buff, true);\r\n\r\n            this.currentBatchAudioIndex = i;\r\n\r\n            const clipIndex = this.selectedClipIndices[i];\r\n            const clip = this.sequence.clips[clipIndex];\r\n            if (!clip.sentence || clip.sentence.trim() === \"\") {\r\n              continue;\r\n            }\r\n            const audioName = await this.getMediaName(dir_audio, clipIndex, clip.sentence, 'wav');\r\n            const fullname_audio_output = dir_audio + '\\\\' + audioName + '.wav';\r\n\r\n            try {\r\n              await this.recordAudio(clip, dir_buff, fullname_audio_output);\r\n              if(this.sequence.selectedIndex==clipIndex){\r\n                this.editedClip.narration.audioMedia = clip.narration.audioMedia;\r\n              }\r\n              // æˆåŠŸå®ŒæˆåŽæ›´æ–°è¿›åº¦\r\n              this.batchAudioGenerationProgress = Math.round(((i + 1) / this.selectedClipIndices.length) * 100);\r\n\r\n            } catch (error) {\r\n              if (error.message !== 'CANCELLED') {\r\n                console.error(`Error generating audio ${i + 1}:`, error);\r\n              } else {\r\n                break; // å¦‚æžœå–æ¶ˆåˆ™é€€å‡ºå¾ªçŽ¯\r\n              }\r\n            }finally {\r\n              // ç«‹å³æ¸…ç†å½“å‰clipçš„ä¸´æ—¶ç›®å½•\r\n              await aardio.deleteDir(dir_buff);\r\n            }\r\n\r\n          }\r\n\r\n        } catch (error) {\r\n          console.error('Batch audio generation error:', error);\r\n        } finally {\r\n          // ç¡®ä¿æœ€ç»ˆåœæ­¢æ‰€æœ‰å½•éŸ³\r\n          await aardio.stopRecord();\r\n          if (this.synth.speaking) {\r\n            this.synth.cancel();\r\n          }\r\n          await aardio.deleteDir(dir_buff);\r\n          this.saveProject();\r\n          this.isBatchGeneratingAudio = false;\r\n        }\r\n      },\r\n      async generateAudio_click(clip){\r\n        if (this.isGeneratingAudio) {\r\n          // å¦‚æžœæ­£åœ¨ç”Ÿæˆï¼Œç‚¹å‡»åˆ™å–æ¶ˆ\r\n          this.cancelAudioGeneration = true;\r\n          if (this.currentUtterance) {\r\n            this.synth.cancel(); // åœæ­¢è¯­éŸ³åˆæˆ\r\n          }\r\n          await aardio.stopRecord(); // åœæ­¢å½•éŸ³\r\n          this.isGeneratingAudio = false;\r\n          return;\r\n        }\r\n\r\n        // å¼€å§‹ç”ŸæˆéŸ³é¢‘\r\n        this.isGeneratingAudio = true;\r\n        this.cancelAudioGeneration = false;\r\n\r\n\r\n        const dir_audio = this.projectDirectory + '\\\\' + this.folder_audio;\r\n        await aardio.createDir(dir_audio, false);\r\n\r\n        const dir_buff = this.projectDirectory + '\\\\' + this.folder_buff;\r\n        await aardio.createDir(dir_buff, true);\r\n\r\n        const audioName = await this.getMediaName(dir_audio, this.sequence.selectedIndex, clip.sentence, 'wav');\r\n        const fullname_audio_output = dir_audio + '\\\\' + audioName + '.wav';\r\n\r\n        try {\r\n          await this.recordAudio(clip, dir_buff, fullname_audio_output);\r\n          const isFileExist = await aardio.isFileExist(fullname_audio_output);\r\n          if(isFileExist)\r\n          {\r\n            this.saveProject();\r\n          }\r\n        } catch (error) {\r\n          if (error.message !== 'CANCELLED') {\r\n            console.error('Error generating audio:', error);\r\n          }\r\n        } finally {\r\n          await aardio.deleteDir(dir_buff);\r\n          this.isGeneratingAudio = false;\r\n        }\r\n      },\r\n      async getMediaName(dir, clipIndex, sentence, ext) {\r\n        // 1ï¸âƒ£ å¤„ç† sentenceï¼ˆå‰10å­—ç¬¦ + åŽ»éžæ³•å­—ç¬¦ï¼‰\r\n        const safeSentence = (sentence || '')\r\n          .substring(0, 10)\r\n          .replace(/[\\\\/:*?\"<>|]/g, '')  // Windowséžæ³•å­—ç¬¦\r\n          .replace(/\\s+/g, '_');         // ç©ºæ ¼è½¬ä¸‹åˆ’çº¿\r\n\r\n        // 2ï¸âƒ£ æ—¶é—´å­—ç¬¦ä¸² MMDDHHmmss\r\n        const now = new Date();\r\n        const pad = (n) => n.toString().padStart(2, '0');\r\n        const timeStr =\r\n          pad(now.getMonth() + 1) +\r\n          pad(now.getDate()) +\r\n          pad(now.getHours()) +\r\n          pad(now.getMinutes()) +\r\n          pad(now.getSeconds());\r\n\r\n        // â­ æ³¨æ„ï¼šclipIndex + 1\r\n        let baseName = `${clipIndex + 1}_${safeSentence}_${timeStr}`;\r\n\r\n        let fullPath = `${dir}\\\\${baseName}.${ext}`;\r\n        let isFileExist = true;\r\n\r\n        try {\r\n          isFileExist = await aardio.isFileExist(fullPath);\r\n        } catch (error) {\r\n          console.error(error);\r\n        }\r\n\r\n        // 3ï¸âƒ£ é˜²é‡å\r\n        if (isFileExist) {\r\n          const randomSuffix = Math.floor(Math.random() * 10000);\r\n          baseName = `${baseName}_${randomSuffix}`;\r\n          fullPath = `${dir}\\\\${baseName}.${ext}`;\r\n\r\n          try {\r\n            isFileExist = await aardio.isFileExist(fullPath);\r\n          } catch (error) {\r\n            console.error(error);\r\n          }\r\n\r\n          // æžå°æ¦‚çŽ‡å†æ¬¡å†²çª â†’ é€’å½’\r\n          if (isFileExist) {\r\n            await new Promise(resolve => setTimeout(resolve, 50));\r\n            return await this.getMediaName(dir, clipIndex, sentence, ext);\r\n          }\r\n        }\r\n\r\n        return baseName;\r\n      },\r\n      generateUUID() {\r\n        // ä½¿ç”¨å½“å‰æ—¶é—´æˆ³å’Œéšæœºæ•°ç”Ÿæˆå”¯ä¸€æ ‡è¯†ç¬¦\r\n        const timestamp = Date.now().toString(36); // è½¬æ¢ä¸º36è¿›åˆ¶å­—ç¬¦ä¸²\r\n        const random = Math.random().toString(36).substring(2, 10); // éšæœºæ•°çš„36è¿›åˆ¶å­—ç¬¦ä¸²\r\n        const uuid = (timestamp + random).substring(0, 8); // æˆªå–å‰5ä½å­—ç¬¦\r\n        return uuid;\r\n      },\r\n      async recordAudio(clip, dir_buff, fullname_audio_output) {\r\n        try {\r\n          let audioStart = 0;\r\n          let audioEnd = 0;\r\n          const fullname_audio_original = dir_buff + '\\\\' + this.audio_original;\r\n\r\n          await this.record(clip.sentence, clip.narration.voiceName, clip.narration.rate, fullname_audio_original);\r\n          const fullname_audio_with_silence = dir_buff + '\\\\' + this.audio_with_silence;\r\n          await aardio.ffmpeg_add_silence(fullname_audio_original, 2, 2, fullname_audio_with_silence);\r\n\r\n          let fullname_audio_buff = fullname_audio_with_silence;\r\n          if (clip.narration.speed != 1) {\r\n            const fullname_audio_with_speed = dir_buff + '\\\\' + this.audio_with_speed;\r\n            await aardio.ffmpeg_change_speed(fullname_audio_with_silence, clip.narration.speed, fullname_audio_with_speed);\r\n            fullname_audio_buff = fullname_audio_with_speed;\r\n          }\r\n\r\n          const audioStartEnd = await aardio.getAudioStartEnd(fullname_audio_buff, clip.narration.pauseBefore, clip.narration.pauseAfter);\r\n          audioStart = parseFloat(audioStartEnd.split(\"-\")[0]);\r\n          audioEnd = parseFloat(audioStartEnd.split(\"-\")[1]);\r\n\r\n          await aardio.ffmpeg_audio_cut(fullname_audio_buff, audioStart, audioEnd, fullname_audio_output);\r\n\r\n          // åªæœ‰æˆåŠŸå®Œæˆæ‰æ›´æ–°clipçŠ¶æ€\r\n          clip.narration.audioMedia.filePath = fullname_audio_output;\r\n          clip.narration.audioMedia.duration = audioEnd - audioStart;\r\n\r\n        } catch (error) {\r\n          if (error.message === 'CANCELLED') {\r\n            console.log('Audio generation canceled.');\r\n            throw error;\r\n          } else {\r\n            console.error('generateAudio error: ', error);\r\n            throw error;\r\n          }\r\n        }\r\n      },\r\n      async record(text, voice, rate, fullname_audio) {\r\n\r\n        // å‘å®¿ä¸»å‘é€å¼€å§‹å½•åˆ¶è¯·æ±‚\r\n        await aardio.startRecord(fullname_audio);\r\n\r\n        try {\r\n          await this.speak(text, voice, rate);\r\n        } catch (error) {\r\n          // å¦‚æžœè¢«å–æ¶ˆï¼Œåœæ­¢å½•éŸ³\r\n          if (error.message === 'CANCELLED') {\r\n            await aardio.stopRecord();\r\n          }\r\n          throw error;\r\n        }\r\n      },\r\n      speak(text, voice, rate) {\r\n        return new Promise((resolve, reject) => {\r\n          this.utterThis = new SpeechSynthesisUtterance(text);\r\n\r\n          this.utterThis.onend = () => {\r\n            aardio.stopRecord();\r\n            resolve();\r\n          };\r\n\r\n          this.utterThis.onerror = (event) => {\r\n            console.error(\"SpeechSynthesis Error:\", event);\r\n            reject(event);\r\n          };\r\n\r\n          this.utterThis.voice = this.list_voice_edge.find(v => {\r\n            return v.name.split(\" \")[1] === voice;\r\n          });\r\n          this.utterThis.rate = (100 * rate) / 100;\r\n          this.synth.speak(this.utterThis);\r\n        });\r\n      },\r\n      truncatePath(fullPath, maxLength = 40) {\r\n        if (!fullPath) return '';\r\n\r\n        const separator = fullPath.includes('/') ? '/' : '\\\\';\r\n        const parts = fullPath.split(separator);\r\n        const fileName = parts.pop(); // æå–æ–‡ä»¶å\r\n\r\n        // å¦‚æžœæ€»é•¿åº¦ < maxLengthï¼Œç›´æŽ¥è¿”å›žåŽŸè·¯å¾„\r\n        if (fullPath.length <= maxLength) return fullPath;\r\n\r\n        // å¦åˆ™ï¼Œä»Žè·¯å¾„å¼€å¤´å’Œç»“å°¾å„å–ä¸€éƒ¨åˆ†ï¼Œä¸­é—´ç”¨ ... ä»£æ›¿\r\n        let remainingLength = maxLength - fileName.length - 3; // 3 æ˜¯ \"...\"\r\n        if (remainingLength <= 0) return `...${separator}${fileName}`;\r\n\r\n        const startLength = Math.floor(remainingLength / 2);\r\n        const endLength = remainingLength - startLength;\r\n\r\n        const startPath = parts.join(separator).substring(0, startLength);\r\n        const endPath = parts.join(separator).slice(-endLength);\r\n\r\n        return `${startPath}...${separator}${endPath}${separator}${fileName}`;\r\n      },\r\n\r\n    // åŠ è½½éŸ³é¢‘\r\n    async loadAudio(path, duration) {\r\n      const exists = await aardio.isFileExist(path);\r\n      if (!exists) return\r\n      const base64Audio = await aardio.convertAudioFileToBase64(path)\r\n      if (!base64Audio) return\r\n\r\n      // è§£ç  Base64 æˆ Blob\r\n      const byteCharacters = atob(base64Audio)\r\n      const byteNumbers = new Array(byteCharacters.length)\r\n      for (let i = 0; i < byteCharacters.length; i++) {\r\n        byteNumbers[i] = byteCharacters.charCodeAt(i)\r\n      }\r\n      const byteArray = new Uint8Array(byteNumbers)\r\n      const blob = new Blob([byteArray], { type: 'audio/wav' })\r\n      const objectUrl = URL.createObjectURL(blob)\r\n\r\n      // å¦‚æžœå·²å­˜åœ¨å®žä¾‹ï¼Œé”€æ¯\r\n      if (this.wavesurfer) {\r\n        this.wavesurfer.destroy()\r\n      }\r\n\r\n      await this.$nextTick()\r\n      if (!this.$refs.waveform) {\r\n        console.warn('Waveform container is pending. Will retry.')\r\n        setTimeout(() => this.loadAudio(path, duration), 100)\r\n        return\r\n      }\r\n      // åˆ›å»º wavesurfer\r\n      this.wavesurfer = WaveSurfer.create({\r\n        container: this.$refs.waveform,\r\n        waveColor: '#ccc',\r\n        progressColor: '#fccc84ff',\r\n        cursorColor: '#3f51b5',\r\n        height: 16,\r\n      })\r\n\r\n      await this.wavesurfer.load(objectUrl)\r\n        this.currentTime = 0;\r\n        this.totalTime = duration;\r\n\r\n      // ç›‘å¬äº‹ä»¶\r\n      this.wavesurfer.on('audioprocess', () => {\r\n        this.currentTime = this.wavesurfer.getCurrentTime()\r\n      })\r\n      this.wavesurfer.on('finish', () => {\r\n        this.isPlaying = false\r\n        this.currentTime = this.totalTime\r\n      })\r\n      this.wavesurfer.on('interaction', () => {\r\n        this.currentTime = this.wavesurfer.getCurrentTime()\r\n      })\r\n    },\r\n\r\n  // åˆ‡æ¢æ’­æ”¾/æš‚åœ\r\n  toggleAudioPlayback() {\r\n      if (this.wavesurfer) {\r\n        this.wavesurfer.playPause()\r\n        this.isPlaying = this.wavesurfer.isPlaying()\r\n      }\r\n    },\r\n  moveSceneLeft(index) {\r\n    if (index <= 0) return;\r\n    const scenes = [...this.editedClip.scenes];\r\n    // Swap current scene with previous one\r\n    [scenes[index - 1], scenes[index]] = [scenes[index], scenes[index - 1]];\r\n    this.editedClip.scenes = scenes;\r\n  },\r\n\r\n  moveSceneRight(index) {\r\n    if (index >= this.editedClip.scenes.length - 1) return;\r\n    const scenes = [...this.editedClip.scenes];\r\n    // Swap current scene with next one\r\n    [scenes[index], scenes[index + 1]] = [scenes[index + 1], scenes[index]];\r\n    this.editedClip.scenes = scenes;\r\n  },\r\n\r\ngetDurationClass(clip, scene) {\r\n  const duration = this.getSceneDuration(clip, scene);\r\n\r\n  // å›¾ç‰‡å§‹ç»ˆç™½è‰²\r\n  if (scene.type === 'image') {\r\n    return {\r\n      color: 'white',\r\n      backgroundColor: 'rgba(169, 169, 169, 0.4)',\r\n    };\r\n  }\r\n\r\n  const roundedFps = Math.round(scene.fps || 0);\r\n  const sequenceFps = Math.round(this.sequence.frameRate || 0);\r\n  const totalClipDuration = clip?.narration?.audioMedia?.duration || 0;\r\n\r\n  // å¦‚æžœå…³é”®æ•°æ®ç¼ºå¤±ï¼Œåˆ™ä½¿ç”¨é»˜è®¤æ ·å¼\r\n  if (!roundedFps || !sequenceFps || !totalClipDuration) {\r\n    return {\r\n      color: 'white',\r\n      backgroundColor: 'rgba(169, 169, 169, 0.4)',\r\n    };\r\n  }\r\n\r\n  // === è®¡ç®—é€»è¾‘ ===\r\n  const startFrame = scene.frameRange?.[0] ?? 0;\r\n  const endFrame = scene.frameRange?.[1] ?? 0;\r\n\r\n  // å®žé™…å¯ç”¨å¸§æ•°ï¼ˆä»¥åºåˆ—å¸§çŽ‡æ¢ç®—ï¼‰\r\n  const actualFrames = (endFrame - startFrame + 1) * (sequenceFps / roundedFps);\r\n\r\n  // åºåˆ—æ€»å¸§æ•°\r\n  const totalClipFrames = totalClipDuration * sequenceFps;\r\n\r\n  // å½“å‰ç‰‡æ®µç†è®ºéœ€è¦çš„å¸§æ•°ï¼ˆæŒ‰æ¯”ä¾‹åˆ†é…ï¼‰\r\n  const totalProportion = _.sumBy(clip.scenes, 'proportion') || 1;\r\n  const requiredFrames = (scene.proportion / totalProportion) * totalClipFrames;\r\n\r\n  // åˆ¤æ–­â€œå¯æä¾›æ—¶é•¿ä¸è¶³â€\r\n  const lackFrames = requiredFrames - actualFrames; // > 0 è¡¨ç¤ºç´ ææ—¶é•¿ä¸å¤Ÿ\r\n  const tolerance = 1; // å®¹å·®ï¼š1å¸§\r\n\r\n  // === æ ·å¼é€»è¾‘ ===\r\n  let color = 'white';\r\n  let backgroundColor = 'rgba(169, 169, 169, 0.4)';\r\n\r\n  // è¶…è¿‡æ—¶é•¿é˜ˆå€¼ â†’ çº¢å­—\r\n  if (duration >= (this.sequence.durationThreshold || 0)) {\r\n    color = 'red';\r\n    backgroundColor = 'rgba(255, 255, 255, 0.4)';\r\n  }\r\n\r\n  // ç´ æå¯æä¾›æ—¶é•¿ä¸å¤Ÿ â†’ çº¢èƒŒæ™¯\r\n  if (lackFrames > tolerance) {\r\n    backgroundColor = 'rgba(255, 0, 0, 0.4)';\r\n  }\r\n\r\n  return { color, backgroundColor };\r\n},\r\n\r\n  formatSeconds(seconds) {\r\n    return seconds.toFixed(2);\r\n  },\r\n  // åˆ‡æ¢å…¨é€‰çŠ¶æ€\r\n  toggleSelectAll() {\r\n    const totalClips = this.sequence.clips.length;\r\n\r\n    // æ£€æŸ¥æ˜¯å¦å·²ç»å…¨é€‰\r\n    const isAllSelected = this.selectedClipIndices.length === totalClips && totalClips > 0;\r\n\r\n    if (isAllSelected) {\r\n      // å¦‚æžœå·²ç»å…¨é€‰ï¼Œåˆ™å–æ¶ˆå…¨é€‰\r\n      this.selectedClipIndices = [];\r\n      this.filters.all = false;\r\n    } else {\r\n      // å¦‚æžœæ²¡æœ‰å…¨é€‰ï¼Œåˆ™å…¨é€‰\r\n      this.selectAll();\r\n    }\r\n  },\r\n\r\n  // å…¨é€‰ - ä¸Žå…¶ä»–ç­›é€‰æ¡ä»¶äº’æ–¥\r\n  selectAll() {\r\n    this.filterMenu = false;\r\n\r\n    // å…¨é€‰æ—¶æ¸…é™¤å…¶ä»–ç­›é€‰æ¡ä»¶\r\n    this.filters = {\r\n      all: true,\r\n      voice: [],\r\n      audioPending: false,\r\n      videoPending: false\r\n    };\r\n\r\n    // é€‰ä¸­æ‰€æœ‰ç‰‡æ®µ\r\n    this.selectedClipIndices = Array.from(\r\n      { length: this.sequence.clips.length },\r\n      (_, i) => i\r\n    );\r\n  },\r\n\r\n    // æ‰“å¼€æ’­éŸ³å‘˜ç­›é€‰\r\n    openVoiceFilter() {\r\n      this.filterMenu = false;\r\n      this.selectedVoices = [...this.filters.voice];\r\n      this.voiceDialog = true;\r\n    },\r\n\r\n    // åº”ç”¨æ’­éŸ³å‘˜ç­›é€‰ - å¯ä»¥ä¸Žå…¶ä»–æ¡ä»¶å…±å­˜\r\n    applyVoiceFilter() {\r\n      this.voiceDialog = false;\r\n\r\n      // å¦‚æžœå½“å‰æ˜¯å…¨é€‰çŠ¶æ€ï¼Œå…ˆå–æ¶ˆå…¨é€‰\r\n      if (this.filters.all) {\r\n        this.filters.all = false;\r\n      }\r\n\r\n      // æ›´æ–°è¯­éŸ³ç­›é€‰æ¡ä»¶ï¼Œä¿ç•™å…¶ä»–æ¡ä»¶\r\n      this.filters.voice = [...this.selectedVoices];\r\n\r\n      // é‡æ–°åº”ç”¨æ‰€æœ‰ç­›é€‰æ¡ä»¶\r\n      this.applyAllFilters();\r\n    },\r\n\r\n    // ç­›é€‰éŸ³é¢‘å¾…ç”Ÿæˆ - å¯ä»¥ä¸Žå…¶ä»–æ¡ä»¶å…±å­˜\r\n    filterByAudioPending() {\r\n      this.filterMenu = false;\r\n\r\n      // å¦‚æžœå½“å‰æ˜¯å…¨é€‰çŠ¶æ€ï¼Œå…ˆå–æ¶ˆå…¨é€‰\r\n      if (this.filters.all) {\r\n        this.filters.all = false;\r\n      }\r\n\r\n      // åˆ‡æ¢éŸ³é¢‘å¾…ç”ŸæˆçŠ¶æ€ï¼Œä¿ç•™å…¶ä»–æ¡ä»¶\r\n      this.filters.audioPending = !this.filters.audioPending;\r\n\r\n      // é‡æ–°åº”ç”¨æ‰€æœ‰ç­›é€‰æ¡ä»¶\r\n      this.applyAllFilters();\r\n    },\r\n\r\n    // ç­›é€‰è§†é¢‘å¾…ç”Ÿæˆ - å¯ä»¥ä¸Žå…¶ä»–æ¡ä»¶å…±å­˜\r\n    filterByVideoPending() {\r\n      this.filterMenu = false;\r\n\r\n      // å¦‚æžœå½“å‰æ˜¯å…¨é€‰çŠ¶æ€ï¼Œå…ˆå–æ¶ˆå…¨é€‰\r\n      if (this.filters.all) {\r\n        this.filters.all = false;\r\n      }\r\n\r\n      // åˆ‡æ¢è§†é¢‘å¾…ç”ŸæˆçŠ¶æ€ï¼Œä¿ç•™å…¶ä»–æ¡ä»¶\r\n      this.filters.videoPending = !this.filters.videoPending;\r\n\r\n      // é‡æ–°åº”ç”¨æ‰€æœ‰ç­›é€‰æ¡ä»¶\r\n      this.applyAllFilters();\r\n    },\r\n    // åº”ç”¨æ‰€æœ‰ç­›é€‰æ¡ä»¶\r\n    applyAllFilters() {\r\n      // å¦‚æžœæ²¡æœ‰æ¿€æ´»ä»»ä½•ç­›é€‰æ¡ä»¶ï¼Œæ¸…ç©ºé€‰ä¸­é¡¹\r\n      if (!this.filters.all &&\r\n          this.filters.voice.length === 0 &&\r\n          !this.filters.audioPending &&\r\n          !this.filters.videoPending) {\r\n        this.selectedClipIndices = [];\r\n        return;\r\n      }\r\n\r\n      const filteredIndices = [];\r\n\r\n      // æ ¹æ®æ‰€æœ‰æ¿€æ´»çš„ç­›é€‰æ¡ä»¶é€‰æ‹©ç‰‡æ®µ\r\n      this.sequence.clips.forEach((clip, index) => {\r\n        let shouldSelect = false;\r\n\r\n        // å…¨é€‰ä¼˜å…ˆçº§æœ€é«˜\r\n        if (this.filters.all) {\r\n          shouldSelect = true;\r\n        }\r\n        // å¤šä¸ªç­›é€‰æ¡ä»¶ç»„åˆ\r\n        else {\r\n          // æ£€æŸ¥è¯­éŸ³ç­›é€‰\r\n          const voiceMatch = this.filters.voice.length === 0 ||\r\n                          this.filters.voice.includes(clip.narration?.voiceName || '');\r\n\r\n          // æ£€æŸ¥éŸ³é¢‘å¾…ç”Ÿæˆç­›é€‰\r\n          const audioPendingMatch = !this.filters.audioPending ||\r\n                                  !clip.narration?.audioMedia?.duration ||\r\n                                  clip.narration.audioMedia.duration === 0;\r\n\r\n          // æ£€æŸ¥è§†é¢‘å¾…ç”Ÿæˆç­›é€‰\r\n          const videoPendingMatch = !this.filters.videoPending ||\r\n                                  !clip.videoMedia?.duration ||\r\n                                  clip.videoMedia.duration === 0;\r\n\r\n          // å¿…é¡»æ»¡è¶³æ‰€æœ‰æ¿€æ´»çš„ç­›é€‰æ¡ä»¶\r\n          shouldSelect = voiceMatch && audioPendingMatch && videoPendingMatch;\r\n        }\r\n\r\n        if (shouldSelect) {\r\n          filteredIndices.push(index);\r\n        }\r\n      });\r\n\r\n      // æ›´æ–°é€‰ä¸­é¡¹\r\n      this.selectedClipIndices = filteredIndices;\r\n    },\r\n\r\n    // ç§»é™¤ç­›é€‰æ¡ä»¶\r\n    removeFilter(type) {\r\n      if (type === 'all') {\r\n        this.filters.all = false;\r\n      } else if (type === 'voice') {\r\n        this.filters.voice = [];\r\n      } else if (type === 'audioPending') {\r\n        this.filters.audioPending = false;\r\n      } else if (type === 'videoPending') {\r\n        this.filters.videoPending = false;\r\n      }\r\n\r\n      // ç§»é™¤ç­›é€‰æ¡ä»¶åŽé‡æ–°åº”ç”¨å‰©ä½™çš„æ¡ä»¶\r\n      this.applyAllFilters();\r\n    },\r\n\r\n    // æ£€æŸ¥æ˜¯å¦é€‰ä¸­\r\n    isClipSelected(index) {\r\n      return this.selectedClipIndices.includes(index);\r\n    },\r\n\r\n    // åˆ‡æ¢é€‰æ‹©çŠ¶æ€\r\n    toggleClipSelection(index) {\r\n      const idx = this.selectedClipIndices.indexOf(index);\r\n      if (idx > -1) {\r\n        this.selectedClipIndices.splice(idx, 1);\r\n      } else {\r\n        this.selectedClipIndices.push(index);\r\n      }\r\n      // æŽ’åº\r\n      this.selectedClipIndices.sort((a, b) => a - b);\r\n    },\r\n    // å¯¼å‡ºç‰‡æ®µ\r\n  async exportClips() {\r\n    // åˆå§‹åŒ–æ•°ç»„\r\n    this.exportAudioFiles = [];\r\n    this.exportVideoFiles = [];\r\n    this.missingAudioFiles = [];\r\n    this.missingVideoFiles = [];\r\n\r\n    // æ£€æŸ¥é€‰ä¸­çš„ç‰‡æ®µ\r\n    for (const index of this.selectedClipIndices) {\r\n      const clip = this.sequence.clips[index];\r\n\r\n      // æ£€æŸ¥éŸ³é¢‘æ–‡ä»¶\r\n      if (clip.narration?.audioMedia?.filePath) {\r\n        const filePath = clip.narration.audioMedia.filePath;\r\n        const exists = await aardio.isFileExist(filePath);\r\n\r\n        if (exists) {\r\n          this.exportAudioFiles.push({\r\n            path: filePath,\r\n            index: index\r\n          });\r\n        } else {\r\n          this.missingAudioFiles.push({\r\n            path: filePath,\r\n            index: index\r\n          });\r\n          // æ›´æ–°åºåˆ—ä¸­çš„æ•°æ®\r\n          clip.narration.audioMedia.filePath = '';\r\n          clip.narration.audioMedia.duration = 0;\r\n        }\r\n      } else {\r\n        this.missingAudioFiles.push({\r\n          path: '',\r\n          index: index\r\n        });\r\n      }\r\n\r\n      // æ£€æŸ¥è§†é¢‘æ–‡ä»¶\r\n      if (clip.videoMedia?.filePath) {\r\n        const filePath = clip.videoMedia.filePath;\r\n        const exists = await aardio.isFileExist(filePath);\r\n\r\n        if (exists) {\r\n          this.exportVideoFiles.push({\r\n            path: filePath,\r\n            index: index\r\n          });\r\n        } else {\r\n          this.missingVideoFiles.push({\r\n            path: filePath,\r\n            index: index\r\n          });\r\n          // æ›´æ–°åºåˆ—ä¸­çš„æ•°æ®\r\n          clip.videoMedia.filePath = '';\r\n          clip.videoMedia.duration = 0;\r\n        }\r\n      } else {\r\n        this.missingVideoFiles.push({\r\n          path: '',\r\n          index: index\r\n        });\r\n      }\r\n    }\r\n    // é‡ç½®å¯¼å‡ºè·¯å¾„ï¼Œå¦‚æžœç±»åž‹ä¸åŒ¹é…æˆ–éœ€è¦æ›´æ–°\r\n    this.resetExportPathForType();\r\n    // æ‰“å¼€å¯¼å‡ºå¯¹è¯æ¡†\r\n    this.exportDialog = true;\r\n    this.ignoreMissing = false;\r\n  },\r\n\r\n  //æ ¹æ®å¯¼å‡ºç±»åž‹é‡ç½®è·¯å¾„\r\n  resetExportPathForType() {\r\n    // å¦‚æžœä¸Šæ¬¡å¯¼å‡ºç±»åž‹ä¸Žå½“å‰ç±»åž‹ä¸åŒï¼Œæˆ–è€…è·¯å¾„ä¸ºç©ºï¼Œé‡ç½®è·¯å¾„\r\n    if (this.lastExportType !== this.exportType || !this.exportPath) {\r\n      this.exportPath = '';\r\n      this.lastExportType = this.exportType;\r\n      this.lastExportPath = '';\r\n    }\r\n    // å¦‚æžœä¸Šæ¬¡å¯¼å‡ºç±»åž‹ç›¸åŒä½†è·¯å¾„å­˜åœ¨ï¼Œç¡®ä¿æ‰©å±•åæ­£ç¡®\r\n    else if (this.exportPath) {\r\n      const correctExtension = this.exportType === 'audio' ? '.mp3' : '.mp4';\r\n      if (!this.exportPath.toLowerCase().endsWith(correctExtension)) {\r\n        // ç§»é™¤æ—§æ‰©å±•åï¼Œæ·»åŠ æ–°æ‰©å±•å\r\n        const basePath = this.exportPath.replace(/\\.[^/.]+$/, \"\");\r\n        this.exportPath = basePath + correctExtension;\r\n      }\r\n    }\r\n  },\r\n  // æµè§ˆèƒŒæ™¯éŸ³ä¹\r\n  async browseBackgroundMusic() {\r\n    const fullName_music = await aardio.selectFile('Audio files|*.mp3;*.wav;*.aac|All files|*.*');\r\n    if (fullName_music !== '') {\r\n      this.backgroundMusicPath = fullName_music;\r\n    }\r\n  },\r\n\r\n  // æµè§ˆå¯¼å‡ºè·¯å¾„\r\nasync browseExportPath() {\r\n  const extension = this.exportType === 'audio' ? '.mp3' : '.mp4';\r\n  const filter = this.exportType === 'audio' ? 'MP3 files|*.mp3': 'MP4 files|*.mp4'\r\n\r\n  // å¦‚æžœå·²æœ‰è·¯å¾„ï¼Œä½¿ç”¨å®ƒä½œä¸ºé»˜è®¤è·¯å¾„ï¼ˆä½†ç¡®ä¿æ‰©å±•åæ­£ç¡®ï¼‰\r\n  let defaultPath = '';\r\n  if (this.exportPath) {\r\n    const basePath = this.exportPath.replace(/\\.[^/.]+$/, \"\");\r\n    defaultPath = basePath + extension;\r\n  }\r\n\r\n  const fullName_export = await aardio.saveFile(filter, defaultPath);\r\n  if (fullName_export) {\r\n    // ç¡®ä¿æ–‡ä»¶æ‰©å±•åæ­£ç¡®\r\n    let finalPath = fullName_export;\r\n    if (!finalPath.toLowerCase().endsWith(extension)) {\r\n      finalPath += extension;\r\n    }\r\n\r\n    // æ£€æŸ¥æ–‡ä»¶æ˜¯å¦å­˜åœ¨\r\n    const exists = await aardio.isFileExist(finalPath);\r\n    if (exists) {\r\n      // æ–‡ä»¶å·²å­˜åœ¨ï¼Œæ˜¾ç¤ºè­¦å‘Š\r\n      this.exportPathTemp = finalPath;\r\n      this.fileExistsWarning = true;\r\n      this.fileExistsResolved = false;\r\n    } else {\r\n      // æ–‡ä»¶ä¸å­˜åœ¨ï¼Œç›´æŽ¥è®¾ç½®è·¯å¾„\r\n      this.exportPath = finalPath;\r\n      this.lastExportPath = finalPath;\r\n      this.fileExistsResolved = true;\r\n    }\r\n  }\r\n},\r\n\r\n// ç¡®è®¤è¦†ç›–å·²å­˜åœ¨æ–‡ä»¶\r\nconfirmOverwrite() {\r\n  this.exportPath = this.exportPathTemp;\r\n  this.fileExistsWarning = false;\r\n  this.fileExistsResolved = true;\r\n},\r\n\r\n// å–æ¶ˆè¦†ç›–\r\ncancelOverwrite() {\r\n  this.exportPathTemp = '';\r\n  this.fileExistsWarning = false;\r\n  this.fileExistsResolved = false;\r\n},\r\n\r\n    // å¿½ç•¥ç¼ºå¤±æ–‡ä»¶\r\n    ignoreMissingFiles() {\r\n      this.ignoreMissing = true;\r\n    },\r\n\r\n    // ç¡®è®¤å¯¼å‡º\r\n    async confirmExport() {\r\n      this.isExporting = true;\r\n      this.exportProgress = 0;\r\n\r\n      const dir_buff = this.projectDirectory + '\\\\' + this.folder_buff;\r\n      try {\r\n        await aardio.createDir(dir_buff, true);\r\n\r\n        const concatFilePath = dir_buff + '\\\\concat.txt';\r\n\r\n        // åˆ›å»ºæ–‡ä»¶åˆ—è¡¨\r\n        const fileList = this.exportType === 'audio' ?\r\n          this.exportAudioFiles : this.exportVideoFiles;\r\n\r\n        if (fileList.length === 0) {\r\n          this.showToast(this.$t('NoFilesAvailableForExport'), 'error');\r\n          this.isExporting = false;\r\n          return;\r\n        }\r\n\r\n        // åˆ›å»ºconcatæ–‡ä»¶å†…å®¹\r\n        let concatContent = '';\r\n        for (const file of fileList) {\r\n          // è½¬ä¹‰è·¯å¾„ä¸­çš„å•å¼•å·\r\n          const escapedPath = file.path.replace(/'/g, \"'\\\\''\");\r\n          concatContent += `file '${escapedPath}'\\n`;\r\n        }\r\n\r\n        // ä¿å­˜concatæ–‡ä»¶\r\n        await aardio.saveTextFile(concatContent, concatFilePath);\r\n\r\n        if(await aardio.isFileExist(this.exportPath)) {\r\n          await aardio.deleteFile(this.exportPath);\r\n        }\r\n        const result = await aardio.exportClips(\r\n          concatFilePath,\r\n          this.exportPath,\r\n          this.backgroundMusicPath,\r\n          this.backgroundMusicVolume,\r\n          this.exportType,\r\n          dir_buff\r\n        );\r\n        console.error(\"result\",result);\r\n        // è°ƒç”¨åˆå¹¶å‡½æ•°\r\n        this.showToast(this.$t('ExportSuccess'), 'success');\r\n        this.exportDialog = false;\r\n\r\n      } catch (error) {\r\n        console.error('Export failed:', error);\r\n        this.showToast('Export failed.', 'error');\r\n      }\r\n      // æ¸…ç†ä¸´æ—¶ç›®å½•\r\n      await aardio.deleteDir(dir_buff);\r\n      this.isExporting = false;\r\n    },\r\n    // è®¡ç®—åœºæ™¯æŒç»­æ—¶é—´\r\n    getSceneDuration(clip, scene) {\r\n      // ç¬¬ä¸€ç§æƒ…å†µï¼šéŸ³é¢‘æ—¶é•¿å¤§äºŽ0\r\n      if (clip.narration?.audioMedia?.duration > 0) {\r\n        const totalProportion = _.sumBy(clip.scenes, 'proportion');\r\n        if (totalProportion <= 0) return 0;\r\n\r\n        return (scene.proportion / totalProportion) * clip.narration.audioMedia.duration;\r\n      }\r\n      // ç¬¬äºŒç§æƒ…å†µï¼šéŸ³é¢‘æ—¶é•¿å°äºŽç­‰äºŽ0\r\n      else {\r\n        // è§†é¢‘ç±»åž‹ï¼šä½¿ç”¨æœ‰æ•ˆæ—¶é•¿\r\n        if (scene.type === 'video') {\r\n          const frameCount = scene.frameRange[1] - scene.frameRange[0] + 1;\r\n          return frameCount / scene.fps;\r\n        }\r\n        // å›¾ç‰‡ç±»åž‹ï¼šä½¿ç”¨proportionä½œä¸ºæ—¶é•¿\r\n        else {\r\n          return scene.proportion;\r\n        }\r\n      }\r\n    },\r\n\r\n    // è®¡ç®—åœºæ™¯æœ‰æ•ˆæ—¶é•¿\r\n    getSceneEffectiveDuration(scene) {\r\n      if (scene.type === 'video') {\r\n        const frameCount = scene.frameRange[1] - scene.frameRange[0] + 1;\r\n        return frameCount / scene.fps;\r\n      } else {\r\n        // å›¾ç‰‡ç±»åž‹è®¤ä¸ºæœ‰æ•ˆæ—¶é•¿æ— é™å¤§\r\n        return Number.MAX_VALUE;\r\n      }\r\n    },\r\n\r\n    // èŽ·å–æ—¶é—´è½´åˆ†æ®µæ ·å¼\r\ngetSegmentStyle(clip, scene) {\r\n  const totalDuration = clip.narration?.audioMedia?.duration > 0\r\n    ? clip.narration.audioMedia.duration\r\n    : _.sumBy(clip.scenes, s => this.getSceneDuration(clip, s));\r\n\r\n  const sceneDuration = this.getSceneDuration(clip, scene);\r\n  const percentage = (sceneDuration / totalDuration) * 100;\r\n\r\n  let style = {\r\n    width: `${percentage}%`,\r\n    position: 'relative',\r\n    backgroundColor: '#000000', // å…œåº•èƒŒæ™¯\r\n  };\r\n\r\n  if (scene.base64Thumbnail) {\r\n    style.backgroundImage = `url(${scene.base64Thumbnail})`;\r\n    style.backgroundSize = 'cover';\r\n    //style.backgroundSize = '100% 100%'; // å¼ºåˆ¶å®½é«˜å¡«æ»¡\r\n    style.backgroundPosition = 'center';\r\n    style.opacity = 1; // è®¾ç½®é€æ˜Žåº¦\r\n  }\r\n\r\n  return style;\r\n},\r\n\r\n\r\n    // å¼€å§‹æ‹–æ‹½è°ƒæ•´åœºæ™¯æ¯”ä¾‹\r\n    startDrag(e, index) {\r\n      e.preventDefault();\r\n\r\n      // mark handle for stylingï¼ŒåŽé¢ stopDrag ä¼šç§»é™¤\r\n      if (e.target.classList && e.target.classList.contains('handle')) {\r\n        e.target.classList.add('dragging');\r\n        this._dragHandle = e.target; // ä¿å­˜å¼•ç”¨ï¼Œæ–¹ä¾¿ç§»é™¤ class\r\n      }\r\n\r\n      document.body.style.userSelect = 'none';\r\n      this.draggingIndex = index;\r\n      this.startX = e.clientX;\r\n\r\n      // ä¿å­˜èµ·å§‹ proportionsï¼ˆæ•°å€¼åŒ–ï¼‰\r\n      this.startProportions = this.editedClip.scenes.map(s => Number(s.proportion) || 0);\r\n\r\n      // èµ·å§‹æ€»å’Œ\r\n      this.totalProportion = _.sum(this.startProportions) || 0.000001; // é¿å… 0\r\n\r\n      document.addEventListener('mousemove', this.onDrag);\r\n      document.addEventListener('mouseup', this.stopDrag);\r\n    },\r\n    onDrag(e) {\r\n      if (this.draggingIndex === null) return;\r\n\r\n    // ç«‹å³æ›´æ–°ï¼Œä¸ä½¿ç”¨é˜²æŠ–ä»¥èŽ·å¾—æ›´æµç•…çš„ä½“éªŒ\r\n      const timeline = this.$refs.timeline;\r\n      if (!timeline) return;\r\n\r\n      const deltaX = e.clientX - this.startX;\r\n      const totalWidth = timeline.offsetWidth;\r\n\r\n      // è®¡ç®—æ¯”ä¾‹å˜åŒ–ï¼ˆåŸºäºŽæ€»å®½åº¦çš„ç™¾åˆ†æ¯”ï¼‰\r\n      const deltaProportionPercent = (deltaX / totalWidth) * this.totalProportion;\r\n\r\n      // æ›´æ–°å½“å‰åœºæ™¯çš„æ¯”ä¾‹ï¼ˆé™åˆ¶æœ€å°å€¼ï¼‰\r\n      const newProportions = [...this.startProportions];\r\n      const newCurrentProportion = Math.max(0.1, newProportions[this.draggingIndex] + deltaProportionPercent);\r\n\r\n      // è®¡ç®—éœ€è¦ä»Žç›¸é‚»åœºæ™¯è°ƒæ•´çš„æ¯”ä¾‹\r\n      const proportionDelta = newCurrentProportion - newProportions[this.draggingIndex];\r\n\r\n      // æ›´æ–°å½“å‰åœºæ™¯\r\n      newProportions[this.draggingIndex] = newCurrentProportion;\r\n\r\n      // è°ƒæ•´ä¸‹ä¸€ä¸ªåœºæ™¯çš„æ¯”ä¾‹ï¼ˆå¦‚æžœæœ‰ï¼‰\r\n      const nextIndex = this.draggingIndex + 1;\r\n      if (nextIndex < newProportions.length) {\r\n        newProportions[nextIndex] = Math.max(0.1, newProportions[nextIndex] - proportionDelta);\r\n      }\r\n\r\n      // ç¡®ä¿æ€»æ¯”ä¾‹ä¸å˜\r\n      const newTotal = _.sum(newProportions);\r\n      if (Math.abs(newTotal - this.totalProportion) > 0.01) {\r\n        // å¦‚æžœæœ‰è¯¯å·®ï¼Œè¿›è¡Œå¾®è°ƒï¼ˆé€šå¸¸ç”±äºŽæµ®ç‚¹è®¡ç®—ï¼‰\r\n        const adjustment = this.totalProportion - newTotal;\r\n        if (nextIndex < newProportions.length) {\r\n          newProportions[nextIndex] += adjustment;\r\n        } else if (this.draggingIndex > 0) {\r\n          newProportions[this.draggingIndex - 1] += adjustment;\r\n        }\r\n      }\r\n\r\n      // æ›´æ–°æ‰€æœ‰åœºæ™¯çš„æ¯”ä¾‹\r\n      this.editedClip.scenes.forEach((scene, i) => {\r\n        scene.proportion = newProportions[i];\r\n      });\r\n\r\n      // ç«‹å³åˆ·æ–°è§†å›¾ï¼ˆå¦‚æžœä½ çš„æ¡†æž¶å“åº”å¼æ­£å¸¸ï¼Œè¿™ä¸€æ­¥å¯ä»¥çœï¼‰\r\n      this.$forceUpdate();\r\n    },\r\n    // onDrag â€”â€” æ–°é€»è¾‘ï¼šåªä¿®æ”¹å½“å‰ scene çš„ valueï¼ˆproportionï¼‰\r\n    onDrag_proportion(e) {\r\n      if (this.draggingIndex === null) return;\r\n\r\n      const timeline = this.$refs.timeline;\r\n      if (!timeline) return;\r\n\r\n      const deltaX = e.clientX - this.startX;\r\n      const totalWidth = timeline.offsetWidth || 1;\r\n\r\n      // å°†é¼ æ ‡ä½ç§»æ¢ç®—ä¸º proportion çš„å¢žé‡ï¼ˆç›¸å¯¹äºŽèµ·å§‹æ€»å’Œï¼‰\r\n      const deltaProportion = (deltaX / totalWidth) * this.totalProportion;\r\n\r\n      // æ–°å€¼ = èµ·å§‹å€¼ + å¢žé‡ï¼ˆå¹¶è®¾ä¸‹é™ï¼‰\r\n      const MIN = 0.1;\r\n      let newValue = (this.startProportions[this.draggingIndex] || 0) + deltaProportion;\r\n      if (newValue < MIN) newValue = MIN;\r\n\r\n      // åªæ›´æ–°å½“å‰ scene çš„ proportionï¼Œå…¶ä»– scene ä¸å˜\r\n      this.editedClip.scenes[this.draggingIndex].proportion = newValue;\r\n\r\n      // ç«‹å³åˆ·æ–°è§†å›¾ï¼ˆå¦‚æžœä½ çš„æ¡†æž¶å“åº”å¼æ­£å¸¸ï¼Œè¿™ä¸€æ­¥å¯ä»¥çœï¼‰\r\n      this.$forceUpdate();\r\n    },\r\n\r\n    // stopDrag\r\n    stopDrag() {\r\n      // æ¸…é™¤æ‹–åŠ¨æ ·å¼\r\n      if (this._dragHandle && this._dragHandle.classList) {\r\n        this._dragHandle.classList.remove('dragging');\r\n        this._dragHandle = null;\r\n      }\r\n\r\n      // æ¸…é™¤é˜²æŠ–å®šæ—¶å™¨ï¼ˆå¦‚æžœä½ æœ‰ï¼‰\r\n      if (this.dragUpdateTimeout) {\r\n        clearTimeout(this.dragUpdateTimeout);\r\n        this.dragUpdateTimeout = null;\r\n      }\r\n\r\n      this.draggingIndex = null;\r\n      document.body.style.userSelect = '';\r\n      document.body.style.webkitUserSelect = '';\r\n\r\n      document.removeEventListener('mousemove', this.onDrag);\r\n      document.removeEventListener('mouseup', this.stopDrag);\r\n    },\r\n    getVideoIconColor(clip) {\r\n        // 1. æ—¶é•¿æ— æ•ˆ\r\n        if (!clip.videoMedia || clip.videoMedia.duration <= 0) {\r\n          return 'grey';\r\n        }\r\n\r\n        // 2. éåŽ† sceneï¼Œæ£€æŸ¥æ˜¯å¦å­˜åœ¨ type === 'video' ä¸” duration è¶…è¿‡é˜ˆå€¼\r\n        const threshold = this.sequence.durationThreshold || 0;\r\n\r\n        for (const scene of clip.scenes || []) {\r\n          if (scene.type === 'video') {\r\n            const duration = this.getSceneDurationForClip(scene, clip); // ä½¿ç”¨æ–°æ–¹æ³•\r\n            if (duration >= threshold) {\r\n              return 'error';\r\n            }\r\n          }\r\n        }\r\n\r\n        // 3. é»˜è®¤æƒ…å†µ\r\n        return 'green-darken-2';\r\n      },\r\n\r\n    // æ–°å¢žæ–¹æ³•ï¼šä¸ºç‰¹å®š clip è®¡ç®—åœºæ™¯æ—¶é•¿\r\n    getSceneDurationForClip(scene, clip) {\r\n      // ç¬¬ä¸€ç§æƒ…å†µï¼šéŸ³é¢‘æ—¶é•¿å¤§äºŽ0\r\n      if (clip.narration?.audioMedia?.duration > 0) {\r\n        const totalProportion = _.sumBy(clip.scenes, 'proportion');\r\n        if (totalProportion <= 0) return 0;\r\n\r\n        return (scene.proportion / totalProportion) * clip.narration.audioMedia.duration;\r\n      }\r\n      // ç¬¬äºŒç§æƒ…å†µï¼šéŸ³é¢‘æ—¶é•¿å°äºŽç­‰äºŽ0\r\n      else {\r\n        // è§†é¢‘ç±»åž‹ï¼šä½¿ç”¨æœ‰æ•ˆæ—¶é•¿\r\n        if (scene.type === 'video') {\r\n          const frameCount = scene.frameRange[1] - scene.frameRange[0] + 1;\r\n          return frameCount / scene.fps;\r\n        }\r\n        // å›¾ç‰‡ç±»åž‹ï¼šä½¿ç”¨proportionä½œä¸ºæ—¶é•¿\r\n        else {\r\n          return scene.proportion;\r\n        }\r\n      }\r\n    },\r\n    async addMaterialLibrary() {\r\n  const dir_analyzeFile = await aardio.selectFile('Json file|*.json');\r\n  if (!dir_analyzeFile) return;\r\n  const json = await aardio.getFileData(dir_analyzeFile);\r\n  const analyzeResult = JSON.parse(json);\r\n\r\n  const baseDir = dir_analyzeFile.substring(0, dir_analyzeFile.lastIndexOf(\"\\\\\"));\r\n\r\n  // å…ˆ push ä¸€ä¸ªå ä½çš„åº“ï¼Œtab ç«‹åˆ»æ˜¾ç¤º\r\n  const newLib = {\r\n    fullName: dir_analyzeFile,\r\n    name: this.$t('ImportingLibrary'),\r\n    info: analyzeResult.Info,\r\n    thumbsWidth: analyzeResult.ThumbsWidth,\r\n    thumbsHeight: analyzeResult.ThumbsHeight,\r\n    preview: analyzeResult.Preview,\r\n    fps: analyzeResult.Info.Fps,\r\n    segments: [],\r\n    loading: true, // ç”¨æ¥æ ‡è®°æ˜¯å¦æ­£åœ¨å¯¼å…¥\r\n  };\r\n  this.materialLibraries.push(newLib);\r\n  const libIndex = this.materialLibraries.length - 1;\r\n  this.activeLibrary = libIndex;\r\n\r\n  // å¼‚æ­¥åŠ è½½ segments\r\n  const segments = [];\r\n  for (const seg of analyzeResult.Segments) {\r\n    const thumbPath = `${baseDir}\\\\${analyzeResult.Thumbs}\\\\${seg.StartFrame}.jpg`.replace(/\\\\\\\\/g, '\\\\');\r\n    const base64Thumbnail = await aardio.getImageAsBase64(thumbPath);\r\n    const duration = (seg.EndFrame - seg.StartFrame + 1) / analyzeResult.Info.Fps;\r\n    segments.push({\r\n      ...seg,\r\n      base64Thumbnail,\r\n      duration,\r\n      thumbWidth: analyzeResult.ThumbsWidth,\r\n      thumbHeight: analyzeResult.ThumbsHeight,\r\n      previewBase64: '',\r\n      isPlaying: false,\r\n    });\r\n  }\r\n\r\n  // å¯¼å…¥å®ŒæˆåŽæ›´æ–°åº“\r\n  this.materialLibraries[libIndex] = {\r\n    ...newLib,\r\n    name: this.getFileNameWithoutExt(analyzeResult.Info.FullName),\r\n    segments,\r\n    loading: false,\r\n  };\r\n},\r\n    removeLibrary(index) {\r\n    this.materialLibraries.splice(index, 1);\r\n    if (this.activeLibrary >= this.materialLibraries.length) {\r\n    this.activeLibrary = this.materialLibraries.length - 1;\r\n    }\r\n    },\r\n    getFileNameWithoutExt(path) {\r\n    return path.split('\\\\').pop().replace(/\\.[^/.]+$/, '');\r\n    },\r\n    handleMouseEnter(libIndex, lib, segment, segIndex) {\r\n      // å…ˆæ¸…ç†æ—§çš„\r\n      if (segment.hoverTimer) {\r\n        clearTimeout(segment.hoverTimer);\r\n        segment.hoverTimer = null;\r\n      }\r\n\r\n      // è®¾ç½® 0.3 ç§’å»¶è¿Ÿ\r\n      segment.hoverTimer = setTimeout(() => {\r\n        this.startPreview(libIndex, lib, segment, segIndex);\r\n      }, 300);\r\n    },\r\n\r\n    handleMouseLeave(libIndex, segIndex) {\r\n      const segment = this.materialLibraries[libIndex].segments[segIndex];\r\n\r\n      // é¼ æ ‡ç§»å¼€æ—¶æ¸…é™¤å®šæ—¶å™¨\r\n      if (segment.hoverTimer) {\r\n        clearTimeout(segment.hoverTimer);\r\n        segment.hoverTimer = null;\r\n      }\r\n\r\n      // åœæ­¢é¢„è§ˆ\r\n      this.stopPreview(libIndex, segIndex);\r\n    },\r\n    stopAllSegments() {\r\n    if (!this.materialLibraries) return;\r\n\r\n    this.materialLibraries.forEach(library => {\r\n      if (library.segments && Array.isArray(library.segments)) {\r\n        library.segments.forEach(segment => {\r\n          segment.isPlaying = false;\r\n        });\r\n      }\r\n    });\r\n  },\r\nasync startPreview(libIndex, lib, segment, segIndex) {\r\n  this.stopAllSegments();\r\n  try {\r\n    if (!segment.previewBase64) {\r\n      const baseDir = lib.fullName.substring(0, lib.fullName.lastIndexOf(\"\\\\\"));\r\n      const previewPath = `${baseDir}\\\\${lib.preview}\\\\${segment.StartFrame}.jpg`.replace(/\\\\\\\\/g, '\\\\');\r\n      const base64Preview = await aardio.getVideoPreviewAsBase64(\r\n        lib.info.FullName,\r\n        lib.fps,\r\n        segment.StartFrame,\r\n        segment.StartFrameAHCHex,\r\n        lib.thumbsWidth,\r\n        lib.thumbsHeight,\r\n        0.5,\r\n        previewPath\r\n      );\r\n\r\n      if (base64Preview) {\r\n        const img = new Image();\r\n        img.onload = () => {\r\n          this.materialLibraries[libIndex].segments[segIndex].previewBase64 = base64Preview;\r\n\r\n          nextTick(() => {\r\n            setTimeout(() => {\r\n              this.startJsAnimation(libIndex, segIndex);\r\n            }, 100);\r\n          });\r\n        };\r\n        img.src = base64Preview;\r\n      }\r\n    } else {\r\n      this.startJsAnimation(libIndex, segIndex);\r\n    }\r\n  } catch (error) {\r\n    console.error('Preview failed.', error);\r\n  }\r\n},\r\n\r\nstartJsAnimation(libIndex, segIndex) {\r\n  const segment = this.materialLibraries[libIndex].segments[segIndex];\r\n  segment.isPlaying = true;\r\n  segment.currentFrame = 0;\r\n  segment.animationInterval = null;\r\n\r\n  const frameDuration = 1000 / 24; // 24fpsï¼Œæ¯å¸§çº¦41.67ms\r\n  const totalFrames = 12;\r\n\r\n  segment.animationInterval = setInterval(() => {\r\n    segment.currentFrame = (segment.currentFrame + 1) % totalFrames;\r\n\r\n    // è®¡ç®—èƒŒæ™¯ä½ç½®\r\n    const col = segment.currentFrame % 4;\r\n    const row = Math.floor(segment.currentFrame / 4);\r\n    const x = col * 33.333;\r\n    const y = row * 50;\r\n\r\n    // æ›´æ–°æ ·å¼\r\n    const previewElement = document.querySelector(`[data-lib=\"${libIndex}\"][data-seg=\"${segIndex}\"] .preview-overlay`);\r\n    if (previewElement) {\r\n      previewElement.style.backgroundPosition = `${x}% ${y}%`;\r\n    }\r\n\r\n  }, frameDuration);\r\n},\r\n\r\nstopPreview(libIndex, segIndex) {\r\n  const segment = this.materialLibraries[libIndex].segments[segIndex];\r\n  segment.isPlaying = false;\r\n  if (segment.animationInterval) {\r\n    clearInterval(segment.animationInterval);\r\n    segment.animationInterval = null;\r\n  }\r\n},\r\nasync addScene(videoInfo, segment, base64Thumbnail) {\r\n  // æ£€æŸ¥æ˜¯å¦å­˜åœ¨ç›¸é‚»ç‰‡æ®µ\r\n  const lastScene = this.editedClip.scenes[this.editedClip.scenes.length - 1];\r\n\r\n  if (lastScene &&\r\n      lastScene.fullName === videoInfo.FullName &&\r\n      lastScene.sourceRange[1] === segment.StartFrame - 1) {\r\n\r\n    // æç¤ºç”¨æˆ·æ˜¯å¦æ‹¼æŽ¥\r\n    const shouldMerge = await this.showMergeConfirm();\r\n\r\n    if (shouldMerge) {\r\n      // æ‹¼æŽ¥ç‰‡æ®µï¼šæ›´æ–°æœ€åŽä¸€ä¸ªsceneçš„ç»“æŸå¸§\r\n      lastScene.sourceRange[1] = segment.EndFrame;\r\n      lastScene.frameRange[1] = segment.EndFrame;\r\n\r\n      // æ›´æ–°ç¼©ç•¥å›¾ï¼ˆå¯é€‰ï¼Œä½¿ç”¨æ–°ç‰‡æ®µçš„ç¼©ç•¥å›¾ï¼‰\r\n      //lastScene.base64Thumbnail = base64Thumbnail;\r\n\r\n      console.log('Clip has been spliced to adjacent clip.');\r\n      return;\r\n    }\r\n  }\r\n\r\n  // å¦‚æžœä¸æ‹¼æŽ¥æˆ–ä¸ç¬¦åˆæ‹¼æŽ¥æ¡ä»¶ï¼Œæ·»åŠ æ–°ç‰‡æ®µ\r\n  await this.addNewScene(videoInfo, segment, base64Thumbnail);\r\n  this.selectScene(this.editedClip.scenes.length - 1);\r\n},\r\n\r\n// æ˜¾ç¤ºç¡®è®¤å¯¹è¯æ¡†çš„æ–¹æ³•\r\nasync showMergeConfirm() {\r\n  return new Promise((resolve) => {\r\n    const result = confirm(this.$t('confirmAppendORAdd'));\r\n    resolve(result);\r\n  });\r\n},\r\ncreateSceneFromSegment(videoInfo, segment, base64Thumbnail) {\r\n  const scene = _.cloneDeep(this.defaultScene);\r\n\r\n  scene.type = 'video';\r\n  scene.fullName = videoInfo.FullName;\r\n  scene.width = videoInfo.Width;\r\n  scene.height = videoInfo.Height;\r\n  scene.fps = videoInfo.Fps;\r\n  scene.countFrame = videoInfo.FrameCount;\r\n  scene.sourceRange = [segment.StartFrame, segment.EndFrame];\r\n  scene.frameRange = [segment.StartFrame, segment.EndFrame];\r\n  scene.sourceHex = segment.StartFrameAHCHex;\r\n  scene.base64Thumbnail = base64Thumbnail;\r\n\r\n  return scene;\r\n},\r\napplyDefaultLayoutFromSegment(scene) {\r\n  scene.scale = Math.min(\r\n    this.sequence.outputSize.width / scene.width,\r\n    this.sequence.outputSize.height / scene.height\r\n  );\r\n  scene.anchorX = this.sequence.outputSize.width / 2;\r\n  scene.anchorY = this.sequence.outputSize.height / 2;\r\n},\r\nasync addNewScene(videoInfo, segment, base64Thumbnail) {\r\n  const newScene = this.createSceneFromSegment(videoInfo, segment, base64Thumbnail);\r\n\r\n  if (this.sequence.smartAdjust) {\r\n    const matchedScene = this.findMatchingScene(newScene);\r\n\r\n    if (matchedScene) {\r\n      Object.assign(newScene, _.pick(matchedScene, [\r\n        'scale', 'anchorX', 'anchorY',\r\n        'horizontalFlip', 'upend', 'growFrame'\r\n      ]));\r\n    } else {\r\n      this.applyDefaultLayoutFromSegment(newScene);\r\n      newScene.growFrame = true;\r\n    }\r\n  } else {\r\n    this.applyDefaultLayoutFromSegment(newScene);\r\n  }\r\n\r\n  this.editedClip.scenes.push(newScene);\r\n},\r\nasync replaceScene(videoInfo, segment, base64Thumbnail) {\r\n  const index = this.editedClip.editedSceneIndex;\r\n\r\n  // âœ… å®‰å…¨æ£€æŸ¥\r\n  if (\r\n    index == null ||\r\n    index < 0 ||\r\n    index >= this.editedClip.scenes.length\r\n  ) {\r\n    console.warn('invalid editedSceneIndex:', index);\r\n    return;\r\n  }\r\n\r\n  const newScene = this.createSceneFromSegment(videoInfo, segment, base64Thumbnail);\r\n\r\n  const currentScene = this.editedClip.scenes[index];\r\n\r\n  if (this.sequence.smartAdjust && currentScene) {\r\n    // âœ… ç»§æ‰¿å½“å‰ scene å‚æ•°ï¼ˆå…³é”®ï¼‰\r\n    Object.assign(newScene, _.pick(currentScene, [\r\n      'scale',\r\n      'anchorX',\r\n      'anchorY',\r\n      'horizontalFlip',\r\n      'upend',\r\n      'growFrame',\r\n      'proportion'\r\n    ]));\r\n  } else {\r\n    this.applyDefaultLayoutFromSegment(newScene);\r\n  }\r\n\r\n  // âœ… è¦†ç›–\r\n  this.editedClip.scenes.splice(index, 1, newScene);\r\n},\r\n    selectScene(index) {\r\n      const clip = this.sequence.clips[this.sequence.selectedIndex];\r\n      if (!clip) return;\r\n\r\n      clip.editedSceneIndex = index; // âœ… å­˜åœ¨ clip å†…éƒ¨\r\n      this.$nextTick(() => {\r\n        const card = this.$refs['card-editedScene']?.$el;\r\n        if (!card) return;\r\n\r\n        const rect = card.getBoundingClientRect();\r\n        const isVisible =\r\n          rect.top >= 0 &&\r\n          rect.bottom <= (window.innerHeight || document.documentElement.clientHeight);\r\n\r\n        if (!isVisible) {\r\n          card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });\r\n        }\r\n      });\r\n    },\r\n    increaseSentenceFontSize() {\r\n      this.fontSize = Math.min(this.fontSize + 2, 50) // æœ€å¤§ 40px\r\n    },\r\n    decrease