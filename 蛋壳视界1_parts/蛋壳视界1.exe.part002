  <v-btn\r\n          color=\"primary\"\r\n          @click=\"register\"\r\n          :loading=\"loading\"\r\n          >{{ $t('register') }}</v-btn\r\n        >\r\n        <v-btn variant=\"text\" @click=\"goLogin\">{{ $t('backToLogin') }}</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-container>\r\n</template>\r\n\r\n<script>\r\nimport aardio from 'aardio'\r\nimport AppBrand from '@/components/AppBrand.vue'\r\n\r\nexport default {\r\n  components: { AppBrand },\r\n  data() {\r\n    return {\r\n      phone: '',\r\n      password: '',\r\n      confirmPassword: '',\r\n      licenseCode: '',\r\n      referralCode: '',\r\n      loading: false,\r\n      errorMessage: '',\r\n      successMessage: '',\r\n    };\r\n  },\r\n  methods: {\r\n    // âœ… æ‰‹æœºå·æ ¼å¼éªŒè¯å‡½æ•°ï¼ˆä½¿ç”¨å›½é™…åŒ–æç¤ºï¼‰\r\n    validatePhone(value) {\r\n      const phoneRegex = /^1[3-9]\\d{9}$/;\r\n      if (!value) return this.$t('phoneEmpty');\r\n      if (!phoneRegex.test(value)) return this.$t('invalidPhone');\r\n      return true;\r\n    },\r\n\r\n    async register() {\r\n      this.errorMessage = '';\r\n      this.successMessage = '';\r\n\r\n      const phoneRegex = /^1[3-9]\\d{9}$/;\r\n      if (!this.phone) {\r\n        this.errorMessage = this.$t('phoneEmpty');\r\n        return;\r\n      }\r\n      if (!phoneRegex.test(this.phone)) {\r\n        this.errorMessage = this.$t('invalidPhone');\r\n        return;\r\n      }\r\n      if (!this.password) {\r\n        this.errorMessage = this.$t('passwordEmpty');\r\n        return;\r\n      }\r\n      if (this.password !== this.confirmPassword) {\r\n        this.errorMessage = this.$t('passwordMismatch');\r\n        return;\r\n      }\r\n      if (!this.licenseCode) {\r\n        this.errorMessage = this.$t('licenseCodeEmpty');\r\n        return;\r\n      }\r\n      if (!this.referralCode) {\r\n        this.errorMessage = this.$t('referralCodeEmpty');\r\n        return;\r\n      }\r\n\r\n      this.loading = true;\r\n      try {\r\n        const machineCode = await aardio.getMachineCode();\r\n        const rawResult = await aardio.register(\r\n          this.phone,\r\n          this.password,\r\n          this.licenseCode,\r\n          this.referralCode,\r\n          machineCode\r\n        );\r\n\r\n        let result;\r\n        try {\r\n          result = typeof rawResult === 'string'\r\n            ? JSON.parse(rawResult)\r\n            : rawResult;\r\n        } catch (e) {\r\n          result = null;\r\n        }\r\n\r\n        if (result && result.success) {\r\n          await aardio.saveLocalKey(this.phone, machineCode, result?.token);\r\n          this.successMessage = this.$t('registrationSuccess');\r\n          setTimeout(() => this.$router.push('/home'), 1200);\r\n        } else {\r\n          this.errorMessage = result?.message || this.$t('registrationFailed');\r\n        }\r\n      } catch (err) {\r\n        this.errorMessage = this.$t('registrationException') + ': ' + err.message;\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n\r\n    goLogin() {\r\n      this.$router.push('/login');\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.v-card {\r\n  width: 90%;\r\n  max-width: 400px;\r\n}\r\n</style>\r\n","import { render } from \"./RegisterPage.vue?vue&type=template&id=6ead14d2&scoped=true\"\nimport script from \"./RegisterPage.vue?vue&type=script&lang=js\"\nexport * from \"./RegisterPage.vue?vue&type=script&lang=js\"\n\nimport \"./RegisterPage.vue?vue&type=style&index=0&id=6ead14d2&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['render',render],['__scopeId',\"data-v-6ead14d2\"]])\n\nexport default __exports__","<template>\r\n  <v-container\r\n    class=\"fill-height d-flex flex-column align-center justify-center\"\r\n  >\r\n    <!-- LOGOéƒ¨åˆ† -->\r\n    <div class=\"d-flex justify-center mb-6\">\r\n      <AppBra