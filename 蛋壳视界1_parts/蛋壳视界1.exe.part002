\n      background: '#0F172A',\r\n      surface: '#1E293B',\r\n      primary: '#3B82F6',\r\n      secondary: '#6366F1',\r\n      accent: '#64748B',\r\n      error: '#F87171',\r\n      info: '#38BDF8',\r\n      success: '#22C55E',\r\n      warning: '#FACC15',\r\n    },\r\n  },\r\n\r\n  // 5. æŸ”å’Œç²‰å½©\r\n  pastel: {\r\n    dark: false,\r\n    colors: {\r\n      background: '#FFF1F3',\r\n      surface: '#FFFAF0',\r\n      primary: '#A7F3D0',\r\n      secondary: '#FBCFE8',\r\n      accent: '#E0E7FF',\r\n      error: '#FCA5A5',\r\n      info: '#93C5FD',\r\n      success: '#6EE7B7',\r\n      warning: '#FDE68A',\r\n    },\r\n  },\r\n\r\n  // 6. æ´»æ³¼äº®è‰²\r\n  vivid: {\r\n    dark: false,\r\n    colors: {\r\n      background: '#FFFFFF',\r\n      surface: '#F0F0F0',\r\n      primary: '#FF3D00',\r\n      secondary: '#FFD600',\r\n      accent: '#00E676',\r\n      error: '#D50000',\r\n      info: '#2962FF',\r\n      success: '#00C853',\r\n      warning: '#FFAB00',\r\n    },\r\n  },\r\n\r\n  // 7. å·¥ä¸šç§‘æŠ€é£Ž\r\n  techDark: {\r\n    dark: true,\r\n    colors: {\r\n      background: '#121212',\r\n      surface: '#1E1E1E',\r\n      primary: '#BB86FC',\r\n      secondary: '#03DAC6',\r\n      accent: '#CF6679',\r\n      error: '#CF6679',\r\n      info: '#2196F3',\r\n      success: '#4CAF50',\r\n      warning: '#FF9800',\r\n    },\r\n  },\r\n\r\n  // 8. æ£®æž—è‡ªç„¶é£Ž\r\n  forest: {\r\n    dark: false,\r\n    colors: {\r\n      background: '#F0FFF4',\r\n      surface: '#E6FFFA',\r\n      primary: '#2F855A',\r\n      secondary: '#68D391',\r\n      accent: '#B2F5EA',\r\n      error: '#E53E3E',\r\n      info: '#319795',\r\n      success: '#38A169',\r\n      warning: '#D69E2E',\r\n    },\r\n  },\r\n  // 9. Premiere ä¸“ä¸šæš—è‰²é£Žæ ¼\r\n  premiereDark: {\r\n    dark: true,\r\n    colors: {\r\n      background: '#1A1A1A',   // æ•´ä½“èƒŒæ™¯\r\n      surface: '#2B2B2B',      // é¢æ¿è¡¨é¢\r\n      primary: '#00BCD4',      // é’è“è‰²é«˜äº®\r\n      secondary: '#8E24AA',    // ç´«è‰²è¾…åŠ©\r\n      accent: '#3949AB',       // è“ç´«å¼ºè°ƒ\r\n      error: '#E53935',\r\n      info: '#29B6F6',\r\n      success: '#66BB6A',\r\n      warning: '#FFA726',\r\n    },\r\n  },\r\n}\r\n\r\nconst vuetify = createVuetify({\r\n  components: {\r\n    ...components,\r\n    VNumberInput, // âœ… æ³¨å†Œå®žéªŒæ€§ç»„ä»¶\r\n  },\r\n  directives,\r\n  icons: {\r\n    aliases: { ...aliases, },\r\n    defaultSet: 'mdi',\r\n    sets: { mdi },\r\n  },\r\n  theme: {\r\n    defaultTheme: 'premiereDark', // é»˜è®¤å¯ç”¨ç®€æ´æ¸…æ–°\r\n    themes: myThemes,\r\n  },\r\n})\r\n\r\nexport default vuetify\r\n","// src/main.js\nimport { createApp, reactive } from 'vue'\nimport App from './App.vue'\nimport router from './router'\nimport aardio from 'aardio'\nimport i18n from './locales/i18n'\n\n// äº‹ä»¶æ€»çº¿\nimport mitt from 'mitt'\nconst emitter = mitt()\n\n// vuetify\nimport vuetify from './plugins/vuetify'\nimport './styles/overrides.css'\n\nconst app = createApp(App)\n\n// â­ åˆ›å»ºå“åº”å¼ license çŠ¶æ€\nconst license = reactive({\n  username: '',\n  machineCode: '',\n  serverToken: ''\n})\n\n// æŒ‚è½½åˆ°å…¨å±€\napp.config.globalProperties.$license = license\n\n// æä¾›ç»™ Composition API\napp.provide('license', license)\n\n// æä¾›äº‹ä»¶æ€»çº¿\napp.provide('emitter', emitter)\n\napp.use(i18n)\napp.use(router)\napp.use(vuetify)\n\n\n// ===============================\n// å…¨å±€è·¯ç”±å®ˆå«\n// ===============================\n\nconst publicPages = [\n  '/login',\n  '/register',\n  '/reset-password',\n  '/change-password',\n  '/edit-video'\n]\n\nrouter.beforeEach(async (to, from, next) => {\n  if(to.query.justLogin !== '1' || to.query.justLogin === '1') return next()\n  // ä¸éœ€è¦éªŒè¯çš„é¡µé¢\n  if (publicPages.includes(to.path) || to.query.justLogin === '1') {\n    return next()\n  }\n\n  try {\n\n    // è°ƒç”¨æœ¬åœ°æŽˆæƒéªŒè¯\n    const verifyResultRaw = await Promise.resolve(aardio.verifyLicense())\n    const result = JSON.parse(verifyResultRaw)\n\n    switch (result.code) {\n      case 'SUCCESS':\n      case 'OK':\n        // æ›´æ–°å…¨å±€ license\n        license.username = result.username\n        license.machineCode = result.machineCode\n        license.serverToken = result.serverToken\n        return next()\n      case 'VerifySUCCESS':\n        // ä¿å­˜æœ¬åœ° license\n        await aardio.saveLocalKey(\n          result.username,\n          result.machineCode,\n          result.serverToken\n        )\n        // æ›´æ–°å…¨å±€ license\n        license.username = result.username\n        license.machineCode = result.machineCode\n        license.serverToken = result.serverToken\n        return next()\n\n      case 'TOO_MANY_DEVICES':\n      case 'LICENSE_INVALID':\n      case 'MACHINE_MISMATCH':\n      case 'USER_DISABLED':\n      case 'USER_NOT_FOUND':\n        console.error('License error:', result.message)\n        return next('/login')\n\n      default:\n        console.error('Unknown license status:', result)\n        return next('/login')\n    }\n\n  } catch (err) {\n\n    console.error('License verification exception:', err)\n\n    return next('/login')\n  }\n})\n\napp.mount('#app')","// The module cache\nvar __webpack_module_cache__ = {};\n\n// The require function\nfunction __webpack_require__(moduleId) {\n\t// Check if module is in cache\n\tvar cachedModule = __webpack_module_cache__[moduleId];\n\tif (cachedModule !== undefined) {\n\t\treturn cachedModule.exports;\n\t}\n\t// Create a new module (and put it into the cache)\n\tvar module = __webpack_module_cache__[moduleId] = {\n\t\tid: moduleId,\n\t\tloaded: false,\n\t\texports: {}\n\t};\n\n\t// Execute the module function\n\t__webpack_modules__[moduleId].call(module.exports, module, module.exports, __webpack_require__);\n\n\t// Flag the module as loaded\n\tmodule.loaded = true;\n\n\t// Return the exports of the module\n\treturn module.exports;\n}\n\n// expose the modules object (__webpack_modules__)\n__webpack_require__.m = __webpack_modules__;\n\n","var 