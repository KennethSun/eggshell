"d-flex flex-column align-center pa-4 brand-card\"\r\n    elevation=\"0\"\r\n    :style=\"cardStyle\"\r\n     width=\"500\"\r\n  >\r\n                            <v-avatar class=\"ma-3\" rounded=\"0\" size=\"120\">\r\n    <!-- LOGO -->\r\n    <v-img\r\n      src=\"/eggshell.png\"\r\n      class=\"mb-3 brand-logo\"\r\n      alt=\"App Logo\"\r\n      contain\r\n    />\r\n                            </v-avatar>\r\n\r\n    <!-- ä¸»å®£ä¼ è¯­ -->\r\n    <div\r\n      :class=\"[\r\n        'text-center font-weight-bold',\r\n        isSmall ? 'text-h5' : 'text-h3'\r\n      ]\"\r\n      :style=\"{ color: primaryTextColor }\"\r\n    >\r\n      {{ $t('mainSlogan') }}\r\n    </div>\r\n\r\n    <!-- å‰¯å®£ä¼ è¯­ -->\r\n    <div\r\n      :class=\"[\r\n        'text-center mt-1',\r\n        isSmall ? 'text-h7' : 'text-h5'\r\n      ]\"\r\n      :style=\"{ color: secondaryTextColor }\"\r\n    >\r\n      {{ $t('secondSlogan') }}\r\n    </div>\r\n  </v-card>\r\n</template>\r\n\r\n<script setup>\r\n/* eslint-disable no-unused-vars */ \r\n/* eslint-disable no-undef */\r\nimport { computed } from 'vue'\r\nimport { useTheme } from 'vuetify'\r\n\r\n// âœ… å¦‚æžœå›¾ç‰‡åœ¨ public æ–‡ä»¶å¤¹é‡Œ\r\nconst props = defineProps({\r\n  size: { type: String, default: 'large' },\r\n  logoSrc: { type: String, default: '/eggshell2.ico' }, // âœ… è¿™é‡Œæ”¹ä¸º public çš„è·¯å¾„\r\n})\r\n\r\nconst isSmall = computed(() => props.size === 'small')\r\nconst theme = useTheme()\r\nconst isDark = computed(() => theme.global.current.value.dark)\r\n\r\n// âœ… èƒŒæ™¯é€æ˜Ž\r\nconst cardStyle = computed(() => ({\r\n  background: 'transparent',\r\n  borderRadius: '16px',\r\n  transition: 'transform 0.3s ease, box-shadow 0.3s ease',\r\n  animation: 'fadeIn 0.6s ease forwards',\r\n}))\r\n\r\nconst primaryTextColor = computed(() =>\r\n  isDark.value ? '#90caf9' : '#3f51b5'\r\n)\r\nconst secondaryTextColor = computed(() =>\r\n  isDark.value ? 'rgba(255, 255, 255, 0.7)' : 'rgba(0, 0, 0, 0.6)'\r\n)\r\n</script>\r\n\r\n<style scoped>\r\n.v-card {\r\n  border: none !important;\r\n}\r\n.brand-logo {\r\n  border-radius: 50%;\r\n  animation: float 3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes float {\r\n  0%, 100% {\r\n    transform: translateY(0);\r\n  }\r\n  50% {\r\n    transform: translateY(-4px);\r\n  }\r\n}\r\n\r\n@keyframes fadeIn {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(12px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n</style>\r\n","import script from \"./AppBrand.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./AppBrand.vue?vue&type=script&setup=true&lang=js\"\n\nimport \"./AppBrand.vue?vue&type=style&index=0&id=01013beb&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['__scopeId',\"data-v-01013beb\"]])\n\nexport default __exports__","<template>\r\n  <v-dialog v-model=\"dialog\" max-width=\"600\">\r\n    <v-card>\r\n      <v-card-title class=\"text-h6\">{{ $t('newVideoProject') }}</v-card-title>\r\n\r\n      <v-card-text>\r\n        <!-- åç§° -->\r\n        <v-text-field\r\n          v-model=\"newSequence.name\"\r\n          :label=\"$t('projectName')\"\r\n          :rules=\"[validateName]\"\r\n          clearable\r\n        />\r\n\r\n        <!-- è·¯å¾„ + æµè§ˆæŒ‰é’® -->\r\n        <v-row dense>\r\n          <v-col cols=\"9\">\r\n            <v-text-field\r\n              v-model=\"newSequence.path\"\r\n              :label=\"$t('path')\"\r\n              clearable\r\n              :error=\"!!pathError\"\r\n              :error-messages=\"pathError\"\r\n            />\r\n          </v-col>\r\n          <v-col cols=\"3\">\r\n            <v-btn color=\"primary\" block @click=\"browsePath\">{{ $t('browseButton') }}</v-btn>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <!-- å®½åº¦ + é«˜åº¦ + åˆ†è¾¨çŽ‡ä¸‹æ‹‰æ¡† -->\r\n        <v-row dense>\r\n          <v-col cols=\"3\">\r\n            <v-text-field\r\n              v-model.number=\"newSequence.outputSize.width\"\r\n              :label=\"$t('width')\"\r\n              type=\"number\"\r\n              :rules=\"[v => validateDimension(v, $t('width'))]\"\r\n            />\r\n          </v-col>\r\n          <v-col cols=\"3\">\r\n            <v-text-field\r\n              v-model.number=\"newSequence.outputSize.height\"\r\n              :label=\"$t('height')\"\r\n              type=\"number\"\r\n              :rules=\"[v => validateDimension(v, $t('height'))]\"\r\n            />\r\n          </v-col>\r\n          <v-col cols=\"6\">\r\n            <v-select\r\n              v-model=\"resolutionOption\"\r\n              :items=\"resolutions\"\r\n              :label=\"$t('selectResolutionTemplate')\"\r\n              @update:modelValue=\"applyResolution\"\r\n            />\r\n          </v-col>\r\n        </v-row>\r\n\r\n      </v-card-text>\r\n\r\n      <v-card-actions>\r\n        <v-spacer />\r\n        <v-btn text @click=\"close\">{{ $t('cancel') }}</v-btn>\r\n        <v-btn color=\"primary\" @click=\"confirm\">{{ $t('confirm') }}</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n\r\n<script>\r\nimport aardio from \"aardio\";\r\nimport { getDefaultSequence } from '@/utils/CommonMethods';\r\n\r\nexport default {\r\n  name: 'CreateVideoDialog',\r\n  props: {\r\n    modelValue: Boolean,\r\n  },\r\n  emits: ['update:modelValue', 'confirm'],\r\n  data() {\r\n    return {\r\n      dialog: false,\r\n      resolutionOption: null,\r\n      resolutions: [\r\n        this.$t('landscape1280x720'),\r\n        this.$t('landscape1920x1080'),\r\n        this.$t('portrait720x1280'),\r\n        this.$t('portrait1080x1920'),\r\n        this.$t('chooseReferenceVideo')\r\n      ],\r\n      newSequence: getDefaultSequence(),\r\n      project_extension: '.json',\r\n      pathError: ''\r\n    };\r\n  },\r\n  watch: {\r\n    modelValue(val) {\r\n      this.dialog = val;\r\n      if (val) this.resetForm();\r\n    },\r\n    dialog(val) {\r\n      this.$emit('update:modelValue', val);\r\n    }\r\n  },\r\n  methods: {\r\n    resetForm() {\r\n      this.newSequence = getDefaultSequence();\r\n      this.resolutionOption = null;\r\n      this.pathError = '';\r\n    },\r\n    close() {\r\n      this.dialog = false;\r\n    },\r\n    async browsePath() {\r\n      const dir_project = await aardio.getProjectDir();\r\n      if (dir_project !== '') {\r\n        this.pathError = '';\r\n        this.newSequence.path = dir_project;\r\n      }\r\n    },\r\n    async applyResolution(option) {\r\n      const map = {\r\n        [this.$t('landscape1280x720')]: [1280, 720],\r\n        [this.$t('landscape1920x1080')]: [1920, 1080],\r\n        [this.$t('portrait720x1280')]: [720, 1280],\r\n        [this.$t('portrait1080x1920')]: [1080, 1920]\r\n      };\r\n\r\n      if (map[option]) {\r\n        [this.newSequence.outputSize.width, this.newSequence.outputSize.height] = map[option];\r\n      } else if (option === this.$t('chooseReferenceVideo')) {\r\n        await this.chooseReferenceVideo();\r\n      }\r\n\r\n      this.resolutionOption = null;\r\n    },\r\n    async chooseReferenceVideo() {\r\n      const dir_video = await aardio.selectFile('Video files|*.mp4;*.mkv;*.avi');\r\n      if (dir_video === '') return;\r\n\r\n      const videoInfo = await aardio.getVideoInfo(dir_video);\r\n      const j_videoInfo = JSON.parse(videoInfo);\r\n      this.newSequence.outputSize.width = j_videoInfo.Width;\r\n      this.newSequence.outputSize.height = j_videoInfo.Height;\r\n    },\r\n    validateName(value) {\r\n      const invalid = /[\\\\/:*?\"<>|]/;\r\n      if (!value) return this.$t('enterProjectName');\r\n      if (invalid.test(value)) return this.$t('invalidCharacters');\r\n      return true;\r\n    },\r\n    validateDimension(value, label) {\r\n      if (!Number.isInteger(value) || value < 200) {\r\n        return `${label}${this.$t('mustBePositiveInteger')}`;\r\n      }\r\n      return true;\r\n    },\r\n    formatDate(date) {\r\n      const year = date.getFullYear();\r\n      const month = String(date.getMonth() + 1).padStart(2, '0');\r\n      const day = String(date.getDate()).padStart(2, '0');\r\n      const hours = String(date.getHours()).padStart(2, '0');\r\n      const minutes = String(date.getMinutes()).padStart(2, '0');\r\n      const seconds = String(date.getSeconds()).padStart(2, '0');\r\n      return `${year}/${month}/${day} ${hours}:${minutes}:${seconds}`;\r\n    },\r\n    async confirm() {\r\n      const nameValid = this.validateName(this.newSequence.name) === true;\r\n      const widthValid = this.validateDimension(this.newSequence.outputSize.width, this.$t('width')) === true;\r\n      const heightValid = this.validateDimension(this.newSequence.outputSize.height, this.$t('height')) === true;\r\n\r\n      if (!nameValid) {\r\n        alert(this.$t('enterValidProjectName'));\r\n        return;\r\n      }\r\n      if (!widthValid) {\r\n        alert(this.$t('enterValidWidth'));\r\n        return;\r\n      }\r\n      if (!heightValid) {\r\n        alert(this.$t('enterValidHeight'));\r\n        return;\r\n      }\r\n\r\n      const dir_project = this.newSequence.path + '\\\\' + this.newSequence.name;\r\n      const path_project = dir_project + '\\\\' + this.newSequence.name + this.project_extension;\r\n      const isDirProjExist = await aardio.isDirExist(dir_project);\r\n\r\n      if (isDirProjExist) {\r\n        const isFileExist = await aardio.isFileExist(path_project);\r\n        if (isFileExist) {\r\n          alert(this.$t('projectAlreadyExists'));\r\n          return;\r\n        } else {\r\n          const jsonString = JSON.stringify(this.newSequence);\r\n          await aardio.saveTextFile(jsonString, path_project);\r\n          await this.updateAndNavigate(path_project);\r\n        }\r\n      } else {\r\n        await aardio.createDir(dir_project, false);\r\n        const jsonString = JSON.stringify(this.newSequence);\r\n        await aardio.saveTextFile(jsonString, path_project);\r\n        await this.updateAndNavigate(path_project);\r\n      }\r\n      this.close();\r\n    },\r\n    async updateAndNavigate(projectPath) {\r\n      const newProject = {\r\n        name: this.newSequence.name,\r\n        path: projectPath,\r\n        createdTime: this.formatDate(new Date())\r\n      };\r\n      this.$emit('projectCreated', newProject, true);\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n","\r\nexport const getDefaultSequence = () => ({\r\n      name: \"\",\r\n      path: \"\",\r\n      frameRate: 24,\r\n      outputSize: { width: 1280, height: 720 },\r\n      backgroundColor: { r: 0, g: 0, b: 0 },\r\n      smartAdjust: true,\r\n      clipThumbnailScale: 1.2,\r\n      sceneThumbnailScale: 2,\r\n      selectedIndex: -1,\r\n      durationThreshold: 4,\r\n      clips: []\r\n    });\r\n// é»˜è®¤ clip ç»“æž„\r\nexport const getDefaultClip = () => ({\r\n        sentence: '',\r\n        comment1: '',\r\n        comment2: '',\r\n        narration: {\r\n          locale: '',\r\n          voiceName: '',\r\n          rate: 1.00,\r\n          speed: 1.0,\r\n          pauseBefore: 0.25,\r\n          pauseAfter: 0.25,\r\n          audioMedia: { filePath: '', duration: 0 },\r\n        },\r\n        scenes: [],\r\n        videoMedia: { filePath: '', duration: 0 },\r\n        editedSceneIndex: 0, \r\n      });\r\nexport const getDefaultScene = () => ({\r\n        proportion: 2,\r\n        type: '',\r\n        fullName: '',\r\n        width: 0,\r\n        height: 0,\r\n        fps: 0,\r\n        countFrame: 0,\r\n        analyzeFile: '',\r\n        sourceRange: [0, 0],\r\n        frameRange: [0, 0],\r\n        sourceHex:'',\r\n        base64Thumbnail: '',\r\n        anchorX: 0,\r\n        anchorY: 0,\r\n        scale: 1,\r\n        upend: false,\r\n        horizontalFlip: false,\r\n        growFrame: false,\r\n        sourceVolume: 0,\r\n        alignSource: false,\r\n      });\r\n// æ ¼å¼åŒ–æ—¶é—´\r\nexport const formatTime = (seconds) => {\r\n  if (seconds < 60) {\r\n    // å°äºŽ1åˆ†é’Ÿï¼Œç›´æŽ¥æ˜¾ç¤ºç§’æ•°ï¼ˆä¿ç•™ä¸¤ä½å°æ•°ï¼‰\r\n    return seconds.toFixed(2); // å¯ä»¥åŠ  's' è¡¨ç¤ºç§’ï¼Œæˆ–è€…ä¸åŠ \r\n  } else {\r\n    // å¤§äºŽç­‰äºŽ1åˆ†é’Ÿï¼Œæ˜¾ç¤ºåˆ†é’Ÿå’Œç§’\r\n    const mins = Math.floor(seconds / 60);\r\n    const secs = (seconds % 60).toFixed(2).padStart(5, '0');\r\n    return `${mins}:${secs}`;\r\n  }\r\n};\r\n// å…¶ä»–å…±ç”¨æ–¹æ³•...\r\nexport const splitSentences = (input) => {\r\n  if (!input || typeof input !== 'string') return [];\r\n  \r\n  // å¸¸è§ç¼©å†™åˆ—è¡¨ï¼ˆå¯æ ¹æ®éœ€è¦æ‰©å±•ï¼‰\r\n  const abbreviationsPattern = /(?:Mr|Mrs|Ms|Dr|Rev|Hon|Sir|Dame|Dott|Sr|Jr|Hr|Fru|Pan|Pani|M|Mme|Mlle|Herr|Fr|Hra|Rva|Dhr|Mevr|Sr|Sra|Srta|Hr|Fru|ÎšÎ¿Ï‚|ÎšÎ±|Sig|Sig\\.ra|Sig\\.na|M\\.|Dr\\.|Prof\\.)\\./g;\r\n  // åˆ†å‰²è§„åˆ™ï¼šä¸­æ–‡å¥å·/æ„Ÿå¹å·/é—®å·ï¼Œæˆ–è‹±æ–‡å¥ç‚¹/é—®å·/æ„Ÿå¹å·åŽè·Ÿç©ºæ ¼/å¼•å·/æ¢è¡Œ\r\n  const splitPattern = /(?<=[ã€‚ï¼ï¼Ÿ])|(?<=[.!?])(?=\\s|[\"'\\n])|(?<=\\n)/g;\r\n  const specialCharacter = 'Â¦'; // ä¸´æ—¶æ›¿æ¢å­—ç¬¦\r\n  \r\n  try {\r\n    // 1. å¤„ç†ç¼©å†™ï¼Œä¸´æ—¶æ›¿æ¢ç¼©å†™ä¸­çš„å¥ç‚¹\r\n    let processedInput = input.replace(abbreviationsPattern, match => \r\n      match.replace('.', specialCharacter)\r\n    );\r\n    \r\n    // 2. åˆ†å‰²å¥å­\r\n    let sentences = processedInput.split(splitPattern);\r\n    \r\n    // 3. æ¸…ç†ç»“æžœ\r\n    return sentences\r\n      .map(sentence => \r\n        sentence.replace(new RegExp(specialCharacter, 'g'), '.')\r\n          .trim()\r\n          // åˆå¹¶è¢«é”™è¯¯åˆ†å‰²çš„è¿žç»­æ ‡ç‚¹\r\n          .replace(/([ã€‚ï¼ï¼Ÿ.!?])\\s*([ã€‚ï¼ï¼Ÿ.!?])/g, '$1$2')\r\n      )\r\n      .filter(sentence => \r\n        // è¿‡æ»¤ç©ºå­—ç¬¦ä¸²å’Œçº¯ç©ºæ ¼\r\n        sentence.length > 0 && !/^\\s+$/.test(sentence)\r\n      );\r\n  } catch (error) {\r\n    console.error('å¥å­åˆ†å‰²å‡ºé”™:', error);\r\n    // å‡ºé”™æ—¶è¿”å›žæ•´ä¸ªæ–‡æœ¬ä½œä¸ºå•ä¸ªå¥å­\r\n    return [input