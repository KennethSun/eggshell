\n    // 3. 清理结果\r\n    return sentences\r\n      .map(sentence => \r\n        sentence.replace(new RegExp(specialCharacter, 'g'), '.')\r\n          .trim()\r\n          // 合并被错误分割的连续标点\r\n          .replace(/([。！？.!?])\\s*([。！？.!?])/g, '$1$2')\r\n      )\r\n      .filter(sentence => \r\n        // 过滤空字符串和纯空格\r\n        sentence.length > 0 && !/^\\s+$/.test(sentence)\r\n      );\r\n  } catch (error) {\r\n    console.error('句子分割出错:', error);\r\n    // 出错时返回整个文本作为单个句子\r\n    return [input.trim()].filter(Boolean);\r\n  }\r\n};","import { render } from \"./CreateVideoDialog.vue?vue&type=template&id=6c31d638\"\nimport script from \"./CreateVideoDialog.vue?vue&type=script&lang=js\"\nexport * from \"./CreateVideoDialog.vue?vue&type=script&lang=js\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['render',render]])\n\nexport default __exports__","<template>\r\n  <v-app>\r\n    <v-main>\r\n      <v-container fluid class=\"pa-0 fill-height\">\r\n        <v-row no-gutters class=\"fill-height\">\r\n          <v-col cols=\"3\" class=\"left-sidebar-wrapper\">\r\n            <v-card\r\n              class=\"pa-4 fill-height rounded-0 d-flex flex-column\"\r\n              elevation=\"4\"\r\n            >\r\n              <v-card-title class=\"text-h7 font-weight-bold\">\r\n                {{ $t('learnVideoTitle') }}\r\n              </v-card-title>\r\n\r\n              <div class=\"flex-grow-1 overflow-y-auto mt-4 px-2\">\r\n                <v-row dense style=\"row-gap: 16px\">\r\n                  <v-col cols=\"12\">\r\n                    <v-card class=\"pa-0\" elevation=\"2\" color=\"#1A1A1A\">\r\n                      <v-card-title class=\"text-subtitle-1 font-weight-bold\">\r\n                        {{ $t('step1Title') }}\r\n                      </v-card-title>\r\n                      <v-card-text>\r\n                        <div style=\"white-space: pre-line\">\r\n                          {{ $t('step1Subtitle') }}\r\n                        </div>\r\n                        <v-btn\r\n                          color=\"primary\"\r\n                          class=\"mt-2\"\r\n                          @click=\"activateWhisper\"\r\n                        >\r\n                          {{ $t('step1Button') }}\r\n                        </v-btn>\r\n                      </v-card-text>\r\n                    </v-card>\r\n                  </v-col>\r\n\r\n                  <v-col cols=\"12\">\r\n                    <v-card class=\"pa-0\" elevation=\"2\" color=\"#1A1A1A\">\r\n                      <v-card-title class=\"text-subtitle-1 font-weight-bold\">\r\n                        {{ $t('step2Title') }}\r\n                      </v-card-title>\r\n                      <v-card-text>\r\n                        <div style=\"white-space: pre-line\">\r\n                          {{ $t('step2Subtitle') }}\r\n                        </div>\r\n                        <v-btn\r\n                          color=\"primary\"\r\n                          class=\"mt-2\"\r\n                          @click=\"activateVideoAnalyze\"\r\n                        >\r\n                          {{ $t('step2Button') }}\r\n                        </v-btn>\r\n                      </v-card-text>\r\n                    </v-card>\r\n                  </v-col>\r\n\r\n                  <v-col cols=\"12\">\r\n                    <v-card class=\"pa-0\" elevation=\"2\" color=\"#1A1A1A\">\r\n                      <v-card-title class=\"text-subtitle-1 font-weight-bold\">\r\n                        {{ $t('step3Title') }}\r\n                      </v-card-title>\r\n                      <v-card-text\r\n                        class=\"whitespace-pre-line\"\r\n                        >{{ $t('step3Subtitle') }}</v-card-text\r\n                      >\r\n                    </v-card>\r\n                  </v-col>\r\n                </v-row>\r\n              </div>\r\n            </v-card>\r\n          </v-col>\r\n\r\n          <v-col\r\n            cols=\"9\"\r\n            class=\"d-flex flex-column align-center justify-start bg-background\"\r\n            style=\"padding-top: 5vh\"\r\n          >\r\n            <div class=\"d-flex justify-center mb-10\">\r\n              <AppBrand size=\"large\" />\r\n            </div>\r\n\r\n            <v-row\r\n              class=\"flex-nowrap justify-center\"\r\n              style=\"max-height: 400px; width: 100%; max-width: 1000px\"\r\n            >\r\n              <v-col cols=\"6\" class=\"h-100\">\r\n                <v-card class=\"h-100 d-flex flex-column\" elevation=\"2\">\r\n                  <v-toolbar color=\"primary\" density=\"comfortable\">\r\n                    <v-toolbar-title class=\"text-subtitle-1 font-weight-medium\">\r\n                      <span\r\n                        class=\"text-truncate\"\r\n                        >{{ $t('openRecentTitle') }}</span\r\n                      >\r\n                    </v-toolbar-title>\r\n                  </v-toolbar>\r\n\r\n                  <v-list\r\n                    v-model:selected=\"selected\"\r\n                    select-strategy=\"leaf\"\r\n                    class=\"flex-grow-1 overflow-y-auto\"\r\n                  >\r\n                    <v-list-item\r\n                      v-for=\"item in recentItems\"\r\n                      :key=\"item.path\"\r\n                      :value=\"item.path\"\r\n                      active-class=\"text-primary\"\r\n                      @click=\"openProject(item)\"\r\n                    >\r\n                      <v-list-item-title>{{ item.name }}</v-list-item-title>\r\n                      <v-list-item-subtitle class=\"text-truncate opacity-60\">\r\n                        {{ item.path }}\r\n                      </v-list-item-subtitle>\r\n                      <template #append>\r\n                        <v-icon\r\n                          size=\"small\"\r\n                          :color=\"selected.includes(item.path) ? 'yellow-darken-3' : ''\"\r\n                        >\r\n                          {{ selected.includes(item.path) ? 'mdi-star' : 'mdi-star-outline' }}\r\n                        </v-icon>\r\n                      </template>\r\n                    </v-list-item>\r\n                  </v-list>\r\n                </v-card>\r\n              </v-col>\r\n\r\n              <v-col cols=\"6\" class=\"h-100\">\r\n                <v-card class=\"h-100 d-flex flex-column\" elevation=\"2\">\r\n                  <v-toolbar color=\"primary\" density=\"comfortable\">\r\n                    <v-toolbar-title class=\"text-subtitle-1 font-weight-medium\">\r\n                      <span\r\n                        class=\"text-truncate\"\r\n                        >{{ $t('getStartedTitle') }}</span\r\n                      >\r\n                    </v-toolbar-title>\r\n                  </v-toolbar>\r\n\r\n                  <v-card-text\r\n                    class=\"flex-grow-1 d-flex flex-column align-center justify-center pa-4\"\r\n                  >\r\n                    <div class=\"card-container\">\r\n                      <v-card\r\n                        class=\"mb-4 action-card\"\r\n                        elevation=\"2\"\r\n                        color=\"#385F73\"\r\n                        @click=\"showVideoProjectCreateDialog = true\"\r\n                      >\r\n                        <v-row no-gutters align=\"center\">\r\n                          <v-col cols=\"4\" class=\"d-flex justify-center\">\r\n                            <v-avatar rounded=\"0\" size=\"50\">\r\n                              <v-img\r\n                                :src=\"require('@/assets/images/video.png')\"\r\n                              />\r\n                            </v-avatar>\r\n                          </v-col>\r\n                          <v-col cols=\"8\">\r\n                            <v-card-title\r\n                              class=\"text-subtitle-1 pa-0\"\r\n                              >{{ $t('createProjectCardTitle') }}</v-card-title\r\n                            >\r\n                            <v-card-subtitle\r\n                              class=\"pa-0 text-caption\"\r\n                              >{{ $t('createProjectCardSubtitle') }}</v-card-subtitle\r\n                            >\r\n                          </v-col>\r\n                        </v-row>\r\n                      </v-card>\r\n\r\n                      <v-card\r\n                        class=\"action-card\"\r\n                        elevation=\"2\"\r\n                        color=\"#952175\"\r\n                        @click=\"openProjectPicker\"\r\n                      >\r\n                        <v-row no-gutters align=\"center\">\r\n                          <v-col cols=\"4\" class=\"d-flex justify-center\">\r\n                            <v-avatar rounded=\"0\" size=\"50\">\r\n                              <v-img\r\n                                :src=\"require('@/assets/images/edit.png')\"\r\n                              />\r\n                            </v-avatar>\r\n                          </v-col>\r\n                          <v-col cols=\"8\">\r\n                            <v-card-title\r\n                              class=\"text-subtitle-1 pa-0\"\r\n                              >{{ $t('openProjectCardTitle') }}</v-card-title\r\n                            >\r\n                            <v-card-subtitle\r\n                              class=\"pa-0 text-caption\"\r\n                              >{{ $t('openProjectCardSubtitle') }}</v-card-subtitle\r\n                            >\r\n                          </v-col>\r\n                        </v-row>\r\n                      </v-card>\r\n                    </div>\r\n                  </v-card-text>\r\n                </v-card>\r\n              </v-col>\r\n            </v-row>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <CreateVideoDialog\r\n          v-model=\"showVideoProjectCreateDialog\"\r\n          @projectCreated=\"handleCreateVideoProject\"\r\n        />\r\n        <div v-show=\"false\" class=\"theme-selector\">\r\n          <v-select\r\n            v-model=\"selectedTheme\"\r\n            :items=\"themeOptions\"\r\n            item-title=\"label\"\r\n            item-value=\"value\"\r\n            :label=\"$t('themeLabel')\"\r\n            dense\r\n            outlined\r\n            hide-details\r\n          ></v-select>\r\n        </div>\r\n        <div class=\"theme-selector d-flex flex-column ga-2\">\r\n          <v-select\r\n            :items=\"languages\"\r\n            item-title=\"label\"\r\n            item-value=\"value\"\r\n            v-model=\"selectedLang\"\r\n            :label=\"$t('languageLabel')\"\r\n            density=\"compact\"\r\n            hide-details\r\n            @update:modelValue=\"changeLanguage\"\r\n          />\r\n        </div>\r\n\r\n        <div class=\"settings-button\">\r\n          <v-menu>\r\n            <template v-slot:activator=\"{ props }\">\r\n              <v-btn v-bind=\"props\">{{ $t('settingsLabel') }}</v-btn>\r\n            </template>\r\n\r\n            <v-list>\r\n              <v-list-item\r\n                v-for=\"(item, index) in settingsItems\"\r\n                :key=\"index\"\r\n                @click=\"onSettingsClick(item)\"\r\n              >\r\n                <v-list-item-title>{{ item.title }}</v-list-item-title>\r\n              </v-list-item>\r\n            </v-list>\r\n          </v-menu>\r\n        </div>\r\n      </v-container>\r\n    </v-main>\r\n  </v-app>\r\n</template>\r\n\r\n<script setup>\r\n\r\nimport { ref, watch } from 'vue'\r\n\r\nimport { useTheme } from 'vuetify'\r\n\r\nimport { useI18n } from 'vue-i18n'\r\n\r\nimport AppBrand from '@/components/AppBrand.vue'\r\n\r\n\r\n\r\nconst { locale } = useI18n({ useScope: 'global' })\r\n\r\n\r\n\r\n// ✅ 多语言选择\r\n\r\nconst languages = [\r\n\r\n  { label: '中文', value: 'zh' },\r\n\r\n  { label: 'English', value: 'en' },\r\n\r\n]\r\n\r\n\r\n\r\nconst selectedLang = ref(localStorage.getItem('lang') || 'zh')\r\n\r\nlocale.value = selectedLang.value\r\n\r\n\r\n\r\nfunction changeLanguage() {\r\n\r\n  locale.value = selectedLang.value\r\n\r\n  localStorage.setItem('lang', selectedLang.value)\r\n\r\n}\r\n\r\n\r\n\r\n// ✅ 主题逻辑\r\n\r\nconst themeOptions = [\r\n\r\n  { label: '简洁清新', value: 'lightClean' },\r\n\r\n  { label: '活泼柔和', value: 'lightSoft' },\r\n\r\n  { label: '现代冷淡', value: 'lightMinimal' },\r\n\r\n  { label: '柔和粉彩', value: 'pastel' },\r\n\r\n  { label: '森林自然风', value: 'forest' },\r\n\r\n  { label: 'Premiere 暗色', value: 'premiereDark' }\r\n\r\n]\r\n\r\nconst theme = useTheme()\r\n\r\nconst selectedTheme = ref(localStorage.getItem('appTheme') || 'premiereDark')\r\n\r\ntheme.global.name.value = selectedTheme.value\r\n\r\nwatch(selectedTheme, (val) => {\r\n\r\n  theme.global.name.value = val\r\n\r\n  localStorage.setItem('appTheme', val)\r\n\r\n})\r\n</script>\r\n\r\n<script>\r\n\r\nimport CreateVideoDialog from '@/components/CreateVideoDialog.vue'\r\n\r\nimport aardio from \"aardio\";\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nexport default {\r\n\r\n  name: 'HomePage',\r\n\r\n  components: { CreateVideoDialog },\r\n\r\n  data() {\r\n\r\n    return {\r\n\r\n      showVideoProjectCreateDialog: false,\r\n\r\n      recentItems: [],\r\n\r\n      selected: [],\r\n\r\n      settingsItems: [\r\n\r\n        {\r\n\r\n          title: this.$t('changePassword'),\r\n\r\n          action: 'changePassword'\r\n\r\n        }\r\n\r\n      ],\r\n\r\n    };\r\n\r\n  },\r\n\r\n  async created() {\r\n\r\n    await this.loadRecentProjects();\r\n\r\n  },\r\n\r\n  methods: {\r\n\r\n    onSettingsClick(item) {\r\n\r\n      if (item.action === 'changePassword') {\r\n\r\n        this.$router.push({ path: '/change-password' });\r\n\r\n      }\r\n\r\n    },\r\n\r\n    async loadRecentProjects() {\r\n\r\n      try {\r\n\r\n        const recentProjectsData = await aardio.getRecentProjects();\r\n\r\n        const projects = JSON.parse(recentProjectsData || '[]');\r\n\r\n\r\n\r\n        const checkedProjects = await Promise.all(\r\n\r\n          projects.map(async project => {\r\n\r\n            try {\r\n\r\n              const exists = await aardio.isFileExist(project.path);\r\n\r\n              return exists\r\n\r\n                ? {\r\n\r\n                    name: project.name || this.$t('unnamedProject'),\r\n\r\n                    path: project.path,\r\n\r\n                    createdTime: project.createdTime || new Date().toISOString(),\r\n\r\n                    accessedTime: project.accessedTime || project.createdTime || new Date().toISOString()\r\n\r\n                  }\r\n\r\n                : null;\r\n\r\n            } catch (error) {\r\n\r\n              console.error(this.$t('checkProjectFail', { path: project.path }), error);\r\n\r\n              return null;\r\n\r\n            }\r\n\r\n          })\r\n\r\n        );\r\n\r\n\r\n\r\n        this.recentItems = checkedProjects.filter(p => p !== null)\r\n\r\n          .sort((a, b) => new Date(b.accessedTime) - new Date(a.accessedTime))\r\n\r\n          .slice(0, 10);\r\n\r\n      } catch (error) {\r\n\r\n        console.error(this.$t('loadRecentFail'), error);\r\n\r\n        this.recentItems = [];\r\n\r\n      }\r\n\r\n    },\r\n\r\n\r\n\r\n    async openProjectPicker() {\r\n\r\n      const fullName = await aardio.openProject();\r\n\r\n      if (!fullName) return;\r\n\r\n      const existingProject = this.recentItems.find(item => item.path === fullName);\r\n\r\n      if (existingProject) {\r\n\r\n        existingProject.accessedTime = new Date().toISOString();\r\n\r\n        await this.updateRecentProjects(existingProject);\r\n\r\n      } else {\r\n\r\n        const newProject = {\r\n\r\n          name: fullName.split('\\\\').pop().split('/').pop(),\r\n\r\n          path: fullName,\r\n\r\n          createdTime: new Date().toISOString(),\r\n\r\n          accessedTime: new Date().toISOString()\r\n\r\n        };\r\n\r\n        await this.updateRecentProjects(newProject);\r\n\r\n      }\r\n\r\n      this.goEditProject(fullName);\r\n\r\n    },\r\n\r\n\r\n\r\n    async openProject(item) {\r\n\r\n      item.accessedTime = new Date().toISOString();\r\n\r\n      await this.updateRecentProjects(item);\r\n\r\n      this.goEditProject(item.path);\r\n\r\n    },\r\n\r\n\r\n\r\n    async goEditProject(fullName) {\r\n\r\n      this.$router.push({ path: '/edit-video', query: { projectFullName: fullName } });\r\n\r\n    },\r\n\r\n\r\n\r\n    async handleCreateVideoProject(newProject) {\r\n\r\n      newProject.accessedTime = new Date().toISOString();\r\n\r\n      await this.updateRecentProjects(newProject);\r\n\r\n      this.goEditProject(newProject.path);\r\n\r\n    },\r\n\r\n\r\n\r\n    async updateRecentProjects(updatedProject) {\r\n\r\n      try {\r\n\r\n        const checkedItems = await Promise.all(\r\n\r\n          this.recentItems.map(async item => {\r\n\r\n            if (item.path === updatedProject.path) return item;\r\n\r\n            const exists = await aardio.isFileExist(item.path);\r\n\r\n            return exists ? item : null;\r\n\r\n          })\r\n\r\n        );\r\n\r\n        this.recentItems = checkedItems.filter(Boolean);\r\n\r\n        const existingIndex = this.recentItems.findIndex(i => i.path === updatedProject.path);\r\n\r\n        if (existingIndex !== -1) this.recentItems.splice(existingIndex, 1);\r\n\r\n        updatedProject.accessedTime ||= new Date().toISOString();\r\n\r\n        this.recentItems.unshift(updatedProject);\r\n\r\n        this.recentItems.sort((a, b) => new Date(b.accessedTime) - new Date(a.accessedTime));\r\n\r\n        if (this.recentItems.length > 10) this.recentItems = this.recentItems.slice(0, 10);\r\n\r\n        await aardio.setRecentProjects(JSON.stringify(this.recentItems));\r\n\r\n      } catch (error) {\r\n\r\n        console.error(this.$t('updateRecentFail'), error);\r\n\r\n      }\r\n\r\n    },\r\n\r\n\r\n\r\n    formatAccessTime(isoTime) {\r\n\r\n      const now = new Date();\r\n\r\n      const accessTime = new Date(isoTime);\r\n\r\n      const diffInSeconds = Math.floor((now - accessTime) / 1000);\r\n\r\n\r\n\r\n      if (diffInSeconds < 60) return `${diffInSeconds}${this.$t('secondsAgo')}`;\r\n\r\n      const diffInMinutes = Math.floor(diffInSeconds / 60);\r\n\r\n      if (diffInMinutes < 60) return `${diffInMinutes}${this.$t('minutesAgo')}`;\r\n\r\n      const diffInHours = Math.floor(diffInMinutes / 60);\r\n\r\n      if (diffInHours < 24) return `${diffInHours}${this.$t('hoursAgo')}`;\r\n\r\n      return accessTime.toLocaleString();\r\n\r\n    },\r\n\r\n      activateWhisper() {\r\n\r\n    aardio.executeSpeechRecognition();\r\n\r\n  },\r\n\r\n  activateVideoAnalyze() {\r\n\r\n    aardio.executeVideoAnalysis();\r\n\r\n  }\r\n\r\n  }\r\n\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 核心布局约束 */\r\n.left-sidebar-wrapper {\r\n  max-width: 480px;\r\n  min-width: 300px;\r\n  height: 100vh;\r\n}\r\n\r\n.h-100 {\r\n  height: 100%;\r\n}\r\n\r\n.card-container {\r\n  width: 100%;\r\n  max-width: 320px;\r\n}\r\n\r\n.action-card {\r\n  cursor: pointer;\r\n  transition: transform 0.2s ease;\r\n  padding: 12px;\r\n}\r\n\r\n.action-card:hover {\r\n  transform: translateY(-3px);\r\n  filter: brightness(1.1);\r\n}\r\n\r\n.overflow-y-auto {\r\n  overflow-y: auto;\r\n}\r\n\r\n/* 自定义滚动条 */\r\n.overflow-y-auto::-webkit-scrollbar {\r\n  width: 4px;\r\n}\r\n.overflow-y-auto::-webkit-scrollbar-thumb {\r\n  background: rgba(var(--v-theme-primary), 0.3);\r\n  border-radius: 10px;\r\n}\r\n\r\n.theme-selector {\r\n  position: fixed;\r\n  bottom: 20px;\r\n  right: 20px;\r\n  width: 120px;\r\n  z-index: 100;\r\n}\r\n\r\n.settings-button {\r\n  position: fixed;\r\n  top: 10px;\r\n  right: 10px;\r\n  z-index: 9999;\r\n}\r\n\r\n/* 移除全局 row 负边距影响 */\r\n.v-row {\r\n  margin: 0;\r\n}\r\n</style>\r\n","import script from \"./HomePage.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./HomePage.vue?vue&type=script&setup=true&lang=js\"\n\nimport \"./HomePage.vue?vue&type=style&index=0&id=171e97fd&scoped=true&lang=css\"\n\nimport exportComponent from \"../../node_modules/vue-loader/dist/exportHelper.js\"\nconst __exports__ = /*#__PURE__*/exportComponent(script, [['__scopeId',\"data-v-171e97fd\"]])\n\nexport default __exports__","<template>\r\n  <v-card>\r\n    <!-- 标签头 -->\r\n    <v-tabs v-model=\"currentTab\" bg-color=\"info\" dark>\r\n      <v-tab\r\n        v-for=\"tab in tabs\"\r\n        :key=\"tab.id\"\r\n        :value=\"tab.id\"\r\n        class=\"d-flex align-center\"\r\n      >\r\n        {{ tab.title }}\r\n        <!-- 关闭按钮 -->\r\n        <v-btn\r\n          icon=\"mdiClose\"\r\n          size=\"x-small\"\r\n          class=\"ml-1\"\r\n          @click.stop=\"closeTab(tab.id)\"\r\n        />\r\n      </v-tab>\r\n\r\n      <!-- 添加按钮 -->\r\n      <v-tab>\r\n        <v-btn icon=\"mdiPlus\" size=\"small\" @click=\"addTab\"></v-btn>\r\n      </v-tab>\r\n    </v-tabs>\r\n\r\n    <!-- 标签内容 -->\r\n    <v-window v-model=\"currentTab\">\r\n      <v-window-item\r\n        v-for=\"tab in tabs\"\r\n        :key=\"tab.id\"\r\n        :value=\"tab.id\"\r\n      >\r\n        <v-card flat class=\"pa-4\">\r\n          {{ tab.content }}\r\n        </v-card>\r\n      </v-window-item>\r\n    </v-window>\r\n  </v-card>\r\n</template>\r\n<script>\r\n\r\nimport {\r\n  mdiClose,\r\n  mdiPlus,\r\n} from '@mdi/js';\r\nexport default {\r\n  data() {\r\n    return {\r\n      mdiClose,\r\n      mdiPlus,\r\n    }\r\n  },\r\n  \r\n  }\r\n</script>\r\n<script setup>\r\nimport { ref } from 'vue'\r\n\r\nlet tabIdCounter = 0\r\n\r\n// 初始标签页\r\nconst tabs = ref([\r\n  { id: ++tabIdCounter, title: '标签 1', content: '这里是标签 1 的内容' },\r\n  { id: ++tabIdCounter, title: '标签 2', content: '这里是标签 2 的内容' }\r\n])\r\n\r\nconst currentTab = ref(tabs.value[0].id)\r\n\r\n// 添加标签页\r\nconst addTab = () => {\r\n  const id = ++tabIdCounter\r\n  tabs.value.push({\r\n    id,\r\n    title: `标签 ${tabs.value.length + 1}`,\r\n    content: `这里是标签 ${tabs.value.length + 1} 的内容`\r\n  })\r\n  currentTab.value = id\r\n}\r\n\r\n// 关闭标签页\r\nconst closeTab = (id) => {\r\n  const index = tabs.value.findIndex(t => t.id === id)\r\n  if (index !== -1) {\r\n    tabs.value.splice(index, 1)\r\n\r\n    // 自动切换到相邻的标签\r\n    if (currentTab.value === id && tabs.value.length > 0) {\r\n      currentTab.value = tabs.value[Math.max(0, index - 1)].id\r\n    }\r\n  }\r\n}\r\n</script>\r\n","import script from \"./CreateAudio.vue?vue&type=script&setup=true&lang=js\"\nexport * from \"./CreateAudio.vue?vue&type=script&setup=true&lang=js\"\n\nconst __exports__ = script;\n\nexport default __exports__","<template>\r\n  <v-container fluid class=\"pa-0 ma-0\">\r\n    <v-snackbar\r\n      v-model=\"snackbar.visible\"\r\n      :color=\"snackbar.color\"\r\n      :timeout=\"1000\"\r\n    >\r\n      {{ snackbar.message }}\r\n    </v-snackbar>\r\n\r\n    <div v-if=\"isLoading\" class=\"loading-overlay\">\r\n      <!-- LOGO部分 -->\r\n      <div class=\"d-flex justify-center mb-6\">\r\n        <AppBrand size=\"large\" />\r\n      </div>\r\n      <v-progress-circular\r\n        indeterminate\r\n        size=\"64\"\r\n        color=\"primary\"\r\n      ></v-progress-circular>\r\n      <div class=\"loading-text\">{{ $t('loadingText') }}</div>\r\n    </div>\r\n\r\n    <template v-else-if=\"sequence.clips.length > 0\">\r\n      <v-row>\r\n        <!-- 左侧列表 (3/12宽度) -->\r\n        <v-col class=\"pr-0\" style=\"flex: 0 0 320px; max-width: 320px\">\r\n          <!-- 工具栏 -->\r\n          <v-row dense class=\"align-center mt-1 ml-1\">\r\n            <v-tooltip location=\"end\" :disabled=\"!enableTooltips\">\r\n              <template v-slot:activator=\"{ props }\">\r\n                <v-icon\r\n                  size=\"28\"\r\n                  color=\"primary\"\r\n                  v-bind=\"props\"\r\n                  @click=\"goHomePage\"\r\n                  class=\"clickable-icon mr-3\"\r\n                >\r\n                  {{ mdiHome }}\r\n                </v-icon>\r\n              </template>\r\n              <span>{{ $t('returnToHomeTooltip') }}</span>\r\n            </v-tooltip>\r\n\r\n            <!-- 设置菜单 -->\r\n            <v-menu\r\n              v-model=\"settingsMenu\"\r\n              :close-on-content-click=\"false\"\r\n              offset-x\r\n              location=\"start\"\r\n            >\r\n              <template v-slot:activator=\"{ props }\">\r\n                <v-tooltip location=\"end\" :disabled=\"!enableTooltips\">\r\n                  <template v-slot:activator=\"{ props: tooltipProps }\">\r\n                    <v-icon\r\n                      ref=\"settingsBtn\"\r\n                      size=\"28\"\r\n                      color=\"blue-grey-darken-2\"\r\n                      v-bind=\"{...props, ...tooltipProps}\"\r\n                      class=\"clickable-icon mr-3\"\r\n                    >\r\n                      {{ mdiTuneVariant }}\r\n                    </v-icon>\r\n                  </template>\r\n                  <span>{{ $t('settingsTooltip') }}</span>\r\n                </v-tooltip>\r\n              </template>\r\n\r\n              <!-- 设置菜单内容 -->\r\n              <v-card width=\"300\" class=\"pa-2\">\r\n                <v-card-title\r\n                  class=\"text-h6\"\r\n                  >{{ $t('settings') }}</v-card-title\r\n                >\r\n                <v-divider></v-divider>\r\n                <v-card-text>\r\n                  <v-row dense>\r\n                    <v-col cols=\"12\">\r\n                      <v-text-field\r\n                        hide-details\r\n                        width=\"100\"\r\n                        variant=\"outlined\"\r\n                        v-model.number=\"sequence.durationThreshold\"\r\n                        type=\"number\"\r\n                        :min=\"1\"\r\n                        :step=\"0.1\"\r\n                        :label=\"$t('timeoutAlertLabel')\"\r\n                        :suffix=\"$t('seconds')\"\r\n                        density=\"compact\"\r\n                      ></v-text-field>\r\n                      <v-tooltip\r\n                        activator=\"parent\"\r\n                        :disabled=\"!enableTooltips\"\r\n                        location=\"bottom\"\r\n                        >{{ $t('timeoutAlertTooltip') }}</v-tooltip\r\n                      >\r\n                    </v-col>\r\n                  </v-row>\r\n\r\n                  <v-row dense>\r\n                    <v-col cols=\"12\">\r\n                      <v-checkbox\r\n                        color=\"primary\"\r\n                        v-model=\"sequence.smartAdjust\"\r\n                        :label=\"$t('smartAdjust')\"\r\n                        class=\"mt-3\"\r\n                      ></v-checkbox>\r\n                    </v-col>\r\n                  </v-row>\r\n\r\n                  <v-row dense>\r\n                    <v-col cols=\"12\">\r\n                      <v-checkbox\r\n                        color=\"primary\"\r\n                        v-model=\"enableTooltips\"\r\n                        :label=\"$t('enableTooltipsLabel')\"\r\n                      ></v-checkbox>\r\n                    </v-col>\r\n                  </v-row>\r\n                </v-card-text>\r\n                <v-card-actions>\r\n                  <v-spacer></v-spacer>\r\n                  <v-btn\r\n                    color=\"primary\"\r\n                    variant=\"text\"\r\n                    @click=\"settingsMenu = false\"\r\n                  >\r\n                    {{ $t('close') }}\r\n                  </v-btn>\r\n                </v-card-actions>\r\n              </v-card>\r\n            </v-menu>\r\n\r\n            <v-tooltip location=\"end\" :disabled=\"!enableTooltips\">\r\n              <template v-slot:activator=\"{ props }\">\r\n                <v-icon\r\n                  size=\"28\"\r\n                  color=\"primary\"\r\n                  v-bind=\"props\"\r\n                  @click=\"saveProjectClick\"\r\n                  class=\"clickable-icon\"\r\n                >\r\n                  {{ mdiContentSave }}\r\n                </v-icon>\r\n              </template>\r\n              <span>{{ $t('save') }}</span>\r\n            </v-tooltip>\r\n          </v-row>\r\n\r\n          <!-- 操作按钮组 -->\r\n          <v-row dense class=\"align-center mt-2 ml-1\">\r\n            <!-- 添加按钮 -->\r\n            <v-tooltip location=\"end\" :disabled=\"!enableTooltips\">\r\n              <template v-slot:activator=\"{ props }\">\r\n                <v-icon\r\n                  size=\"28\"\r\n                  color=\"warning\"\r\n                  v-bind=\"props\"\r\n                  @click=\"addItem\"\r\n                  :disabled=\"isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                  class=\"clickable-icon mr-3\"\r\n                >\r\n                  {{ mdiPlus }}\r\n                </v-icon>\r\n              </template>\r\n              <span>{{ $t('add') }}</span>\r\n            </v-tooltip>\r\n\r\n            <!-- 修改按钮 -->\r\n            <v-tooltip location=\"end\" :disabled=\"!enableTooltips\">\r\n              <template v-slot:activator=\"{ props }\">\r\n                <v-icon\r\n                  size=\"28\"\r\n                  color=\"info\"\r\n                  v-bind=\"props\"\r\n                  @click=\"batchEdit\"\r\n                  :disabled=\"selectedClipIndices.length === 0 || isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                  class=\"clickable-icon mr-3\"\r\n                >\r\n                  {{ mdiPencil }}\r\n                </v-icon>\r\n              </template>\r\n              <span>{{ $t('edit') }}</span>\r\n            </v-tooltip>\r\n\r\n            <!-- 删除按钮 -->\r\n            <v-tooltip location=\"end\" :disabled=\"!enableTooltips\">\r\n              <template v-slot:activator=\"{ props }\">\r\n                <v-icon\r\n                  size=\"28\"\r\n                  color=\"error\"\r\n                  v-bind=\"props\"\r\n                  @click=\"showDeleteConfirm\"\r\n                  :disabled=\"selectedClipIndices.length === 0 || isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                  class=\"clickable-icon mr-3\"\r\n                >\r\n                  {{ mdiDelete }}\r\n                </v-icon>\r\n              </template>\r\n              <span>{{ $t('delete') }}</span>\r\n            </v-tooltip>\r\n\r\n            <!-- 生成音频按钮 -->\r\n            <v-tooltip location=\"end\" :disabled=\"!enableTooltips\">\r\n              <template v-slot:activator=\"{ props }\">\r\n                <v-icon\r\n                  size=\"28\"\r\n                  color=\"purple\"\r\n                  v-bind=\"props\"\r\n                  @click=\"batchGenerateAudio\"\r\n                  :disabled=\"selectedClipIndices.length === 0 || isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                  class=\"clickable-icon mr-3\"\r\n                >\r\n                  {{ mdiWaveform }}\r\n                </v-icon>\r\n              </template>\r\n              <span>{{ $t('generateAudio') }}</span>\r\n            </v-tooltip>\r\n\r\n            <!-- 生成视频按钮 -->\r\n            <v-tooltip location=\"end\" :disabled=\"!enableTooltips\">\r\n              <template v-slot:activator=\"{ props }\">\r\n                <v-icon\r\n                  size=\"28\"\r\n                  color=\"green-darken-2\"\r\n                  v-bind=\"props\"\r\n                  @click=\"batchGenerateVideo\"\r\n                  :disabled=\"selectedClipIndices.length === 0 || isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                  class=\"clickable-icon mr-3\"\r\n                >\r\n                  {{ mdiVideoVintage }}\r\n                </v-icon>\r\n              </template>\r\n              <span>{{ $t('generateVideo') }}</span>\r\n            </v-tooltip>\r\n\r\n            <v-tooltip location=\"end\" :disabled=\"!enableTooltips\">\r\n              <template v-slot:activator=\"{ props }\">\r\n                <v-icon\r\n                  size=\"28\"\r\n                  color=\"error\"\r\n                  v-bind=\"props\"\r\n                  @click=\"exportClips\"\r\n                  :disabled=\"selectedClipIndices.length === 0 || isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                  class=\"clickable-icon\"\r\n                >\r\n                  {{ mdiMerge }}\r\n                </v-icon>\r\n              </template>\r\n              <span>{{ $t('export') }}</span>\r\n            </v-tooltip>\r\n          </v-row>\r\n\r\n          <v-row\r\n            dense\r\n            class=\"align-center mt-2 ml-0\"\r\n            style=\"position: relative\"\r\n          >\r\n            <v-col cols=\"auto\">\r\n              <v-tooltip location=\"bottom\" :disabled=\"!enableTooltips\">\r\n                <template v-slot:activator=\"{ props }\">\r\n                  <v-icon\r\n                    size=\"28\"\r\n                    v-bind=\"props\"\r\n                    @click=\"toggleSelectAll\"\r\n                    :disabled=\"isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                    class=\"clickable-icon\"\r\n                  >\r\n                    {{ mdiSelectAll }}\r\n                  </v-icon>\r\n                </template>\r\n                <span>{{ $t('selectAll') }}</span>\r\n              </v-tooltip>\r\n\r\n              <!-- 筛选菜单 -->\r\n              <v-menu\r\n                v-model=\"filterMenu\"\r\n                :close-on-content-click=\"false\"\r\n                offset-y\r\n              >\r\n                <template v-slot:activator=\"{ props }\">\r\n                  <v-tooltip location=\"bottom\" :disabled=\"!enableTooltips\">\r\n                    <template v-slot:activator=\"{ props: tooltipProps }\">\r\n                      <v-icon\r\n                        size=\"28\"\r\n                        v-bind=\"{...props, ...tooltipProps}\"\r\n                        :disabled=\"isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                        class=\"clickable-icon\"\r\n                      >\r\n                        {{ mdiMenuClose }}\r\n                      </v-icon>\r\n                    </template>\r\n                    <span>{{ $t('searchFilter') }}</span>\r\n                  </v-tooltip>\r\n                </template>\r\n\r\n                <!-- 筛选菜单内容 -->\r\n                <v-list density=\"compact\" width=\"200\"\r\n                    >\r\n                  <v-list-item @click=\"openVoiceFilter\">\r\n                    <v-list-item-title\r\n                      >{{ $t('filterVoice') }}</v-list-item-title\r\n                    >\r\n                  </v-list-item>\r\n                  <v-list-item @click=\"filterByAudioPending\">\r\n                    <v-list-item-title\r\n                      >{{ $t('filterAudioPending') }}</v-list-item-title\r\n                    >\r\n                  </v-list-item>\r\n                  <v-list-item @click=\"filterByVideoPending\">\r\n                    <v-list-item-title\r\n                      >{{ $t('filterVideoPending') }}</v-list-item-title\r\n                    >\r\n                  </v-list-item>\r\n                </v-list>\r\n              </v-menu>\r\n            </v-col>\r\n\r\n            <v-col>\r\n              <!-- 筛选标签 -->\r\n              <div class=\"d-flex flex-wrap gap\">\r\n                <v-chip\r\n                  v-if=\"filters.all\"\r\n                  closable\r\n                  @click:close=\"removeFilter('all')\"\r\n                  color=\"primary\"\r\n                  class=\"ma-1\"\r\n                  size=\"small\"\r\n                  :disabled=\"isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                >\r\n                  {{ $t('allLabel') }}\r\n                </v-chip>\r\n\r\n                <v-chip\r\n                  v-if=\"filters.voice && filters.voice.length > 0\"\r\n                  closable\r\n                  @click:close=\"removeFilter('voice')\"\r\n                  color=\"secondary\"\r\n                  class=\"ma-1\"\r\n                  size=\"small\"\r\n                  :disabled=\"isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                >\r\n                  {{ $t('voiceLabel') }} {{ filters.voice.join(', ') }}\r\n                </v-chip>\r\n\r\n                <v-chip\r\n                  v-if=\"filters.audioPending\"\r\n                  closable\r\n                  @click:close=\"removeFilter('audioPending')\"\r\n                  color=\"orange\"\r\n                  class=\"ma-1\"\r\n                  size=\"small\"\r\n                  :disabled=\"isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                >\r\n                  {{ $t('audioPendingLabel') }}\r\n                </v-chip>\r\n\r\n                <v-chip\r\n                  v-if=\"filters.videoPending\"\r\n                  closable\r\n                  @click:close=\"removeFilter('videoPending')\"\r\n                  color=\"red\"\r\n                  class=\"ma-1\"\r\n                  size=\"small\"\r\n                  :disabled=\"isGeneratingAudio || isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                >\r\n                  {{ $t('videoPendingLabel') }}\r\n                </v-chip>\r\n              </div>\r\n            </v-col>\r\n          </v-row>\r\n\r\n          <!-- 播音员筛选对话框 -->\r\n          <v-card\r\n            v-if=\"voiceDialog\"\r\n            width=\"200\"\r\n            style=\"\r\n              position: absolute;\r\n              top: 80px;\r\n              left: 10px;\r\n              z-index: 1000;\r\n              box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);\r\n            \"\r\n          >\r\n            <v-card-text class=\"pa-2\">\r\n              <v-list>\r\n                <v-list-item v-for=\"voice in availableVoices\" :key=\"voice\">\r\n                  <template v-slot:prepend>\r\n                    <v-checkbox-btn\r\n                      color=\"primary\"\r\n                      v-model=\"selectedVoices\"\r\n                      :value=\"voice\"\r\n                    ></v-checkbox-btn>\r\n                  </template>\r\n                  <v-list-item-title>{{ voice }}</v-list-item-title>\r\n                </v-list-item>\r\n              </v-list>\r\n            </v-card-text>\r\n            <v-card-actions class=\"pa-2\">\r\n              <v-spacer></v-spacer>\r\n              <v-btn\r\n                color=\"error\"\r\n                size=\"small\"\r\n                @click=\"voiceDialog = false\"\r\n                >{{ $t('cancel') }}</v-btn\r\n              >\r\n              <v-btn\r\n                color=\"success\"\r\n                size=\"small\"\r\n                @click=\"applyVoiceFilter\"\r\n                >{{ $t('apply') }}</v-btn\r\n              >\r\n            </v-card-actions>\r\n          </v-card>\r\n\r\n          <v-row\r\n            v-if=\"isBatchGeneratingAudio\"\r\n            dense\r\n            class=\"align-center mt-2 ml-1\"\r\n          >\r\n            <v-col cols=\"12\">\r\n              <v-card color=\"info\" variant=\"tonal\">\r\n                <v-card-text class=\"pa-2\">\r\n                  <v-row align=\"center\" dense>\r\n                    <v-col cols=\"8\">\r\n                      <div class=\"text-caption\">\r\n                        {{ $t('batchAudioGenerating') }}\r\n                      </div>\r\n                      <v-progress-linear\r\n                        v-model=\"batchAudioGenerationProgress\"\r\n                        color=\"primary\"\r\n                        height=\"8\"\r\n                        striped\r\n                      ></v-progress-linear>\r\n                      <div class=\"text-caption\">\r\n                        {{ $t('progressLabel') }}\r\n                        {{ currentBatchAudioIndex}}/{{ totalBatchAudioCount }}\r\n                        ({{ batchAudioGenerationProgress }}%)\r\n                      </div>\r\n                    </v-col>\r\n                    <v-col cols=\"4\" class=\"text-right\">\r\n                      <v-btn\r\n                        color=\"error\"\r\n                        size=\"small\"\r\n                        @click=\"handleCancelBatchAudio\"\r\n                        :disabled=\"!isBatchGeneratingAudio\"\r\n                      >\r\n                        {{ $t('cancel') }}\r\n                      </v-btn>\r\n                    </v-col>\r\n                  </v-row>\r\n                </v-card-text>\r\n              </v-card>\r\n            </v-col>\r\n          </v-row>\r\n\r\n          <v-row\r\n            v-if=\"isBatchGeneratingVideo\"\r\n            dense\r\n            class=\"align-center mt-2 ml-1\"\r\n          >\r\n            <v-col cols=\"12\">\r\n              <v-card color=\"info\" variant=\"tonal\">\r\n                <v-card-text class=\"pa-2\">\r\n                  <v-row align=\"center\" dense>\r\n                    <v-col cols=\"8\">\r\n                      <div class=\"text-caption\">\r\n                        {{ $t('batchVideoGenerating') }}\r\n                      </div>\r\n                      <v-progress-linear\r\n                        v-model=\"batchVideoGenerationProgress\"\r\n                        color=\"primary\"\r\n                        height=\"8\"\r\n                        striped\r\n                      ></v-progress-linear>\r\n                      <div class=\"text-caption\">\r\n                        {{ $t('progressLabel') }}:\r\n                        {{ currentBatchVideoIndex}}/{{ totalBatchVideoCount }}\r\n                        ({{ batchVideoGenerationProgress }}%)\r\n                      </div>\r\n                    </v-col>\r\n                    <v-col cols=\"4\" class=\"text-right\">\r\n                      <v-btn\r\n                        color=\"error\"\r\n                        size=\"small\"\r\n                        @click=\"cancelBatchVideoGeneration = true\"\r\n                        :disabled=\"!isBatchGeneratingVideo\"\r\n                      >\r\n                        {{ $t('cancel') }}\r\n                      </v-btn>\r\n                    </v-col>\r\n                  </v-row>\r\n                </v-card-text>\r\n              </v-card>\r\n            </v-col>\r\n          </v-row>\r\n\r\n          <v-row dense>\r\n            <v-list\r\n              density=\"compact\"\r\n              :style=\"{ maxHeight: `calc(100vh - 185px)`, overflowY: 'auto' }\"\r\n              class=\"sidebar-list\"\r\n            >\r\n              <template\r\n                v-for=\"(clip, index) in sequence.clips\"\r\n                :key=\"clip.id || index\"\r\n              >\r\n                <v-list-item\r\n                  class=\"my-0 pr-0\"\r\n                  @click=\"selectClip(index)\"\r\n                  :class=\"{ 'selected-item': sequence.selectedIndex === index }\"\r\n                >\r\n                  <template #prepend>\r\n                    <div\r\n                      class=\"image-container\"\r\n                      :style=\"{width: `${itemPreviewWidth * sequence.clipThumbnailScale}px`, height: `${itemPreviewHeight * sequence.clipThumbnailScale}px`, position: 'relative', overflow: 'hidden', backgroundColor: '#000000ff'}\"\r\n                    >\r\n                      <img\r\n                        v-if=\"clip.scenes && clip.scenes.length > 0\"\r\n                        :src=\"clip.scenes[0].base64Thumbnail\"\r\n                        :style=\"getItemContentStyle(clip.scenes[0], sequence.clipThumbnailScale)\"\r\n                      />\r\n                      <div\r\n                        class=\"time-overlay\"\r\n                        :style=\"getClipDurationStyle(clip)\"\r\n                      >\r\n                        {{ formatTime(getClipDuration(clip)) }}\r\n                      </div>\r\n                    </div>\r\n                  </template>\r\n\r\n                  <template #default>\r\n                    <div class=\"flex-column px-1 w-100\">\r\n                      <div class=\"item-title\">\r\n                        {{ clip.sentence || $t('noTextContent') }}\r\n                      </div>\r\n                      <div class=\"item-meta d-flex mt-0\">\r\n                        <span style=\"white-space: pre\">\r\n                          {{ String(index + 1).padStart(3, ' ') }}\r\n                        </span>\r\n                        <v-divider vertical class=\"mx-2\" />\r\n                        <span>\r\n                          <!-- 音频图标：点击展开菜单 -->\r\n                          <v-icon\r\n                            :color=\"clip.narration?.audioMedia?.duration > 0 ? 'purple' : 'grey'\"\r\n                            @click=\"openFileInFolder(clip.narration.audioMedia.filePath)\"\r\n                          >\r\n                            {{ mdiWaveform }}\r\n                          </v-icon>\r\n                        </span>\r\n                        <v-divider vertical class=\"mx-2\" />\r\n                        <span>\r\n                          <!-- 视频图标：点击展开菜单 -->\r\n                          <v-icon\r\n                            :color=\"getVideoIconColor(clip)\"\r\n                            @click=\"openFileInFolder(clip.videoMedia.filePath)\"\r\n                          >\r\n                            {{ mdiVideoVintage }}\r\n                          </v-icon>\r\n                        </span>\r\n                        <v-divider vertical class=\"mx-2\" />\r\n                        <span style=\"white-space: pre\">\r\n                          {{ (clip.narration?.voiceName || '').slice(0, 10).padEnd(10, ' ') }}\r\n                        </span>\r\n\r\n                        <v-divider\r\n                          v-if=\"isBatchGeneratingAudio && currentBatchAudioIndex === index\"\r\n                          vertical\r\n                          class=\"mx-2\"\r\n                        />\r\n                        <span\r\n                          v-if=\"isBatchGeneratingAudio && currentBatchAudioIndex === index\"\r\n                          class=\"ml-1 text-primary text-caption\"\r\n                          style=\"white-space: nowrap\"\r\n                        >\r\n                          {{ $t('generatingAudioNow') }}\r\n                        </span>\r\n                        <v-divider\r\n                          v-if=\"isBatchGeneratingVideo && currentBatchVideoIndex === index\"\r\n                          vertical\r\n                          class=\"mx-2\"\r\n                        />\r\n                        <span\r\n                          v-if=\"isBatchGeneratingVideo && currentBatchVideoIndex === index\"\r\n                          class=\"ml-1 text-primary text-caption\"\r\n                          style=\"white-space: nowrap\"\r\n                        >\r\n                          {{ $t('generatingVideoNow') }}\r\n                        </span>\r\n                        <v-spacer></v-spacer><v-spacer></v-spacer>\r\n                        <v-checkbox-btn\r\n                          color=\"primary\"\r\n                          :model-value=\"isClipSelected(index)\"\r\n                          @click.stop=\"toggleClipSelection(index)\"\r\n                          density=\"compact\"\r\n                          hide-details\r\n                          :disabled=\"isBatchGeneratingAudio || isBatchGeneratingVideo\"\r\n                        ></v-checkbox-btn>\r\n                      </div>\r\n                    </div>\r\n                  </template>\r\n                </v-list-item>\r\n              </template>\r\n            </v-list>\r\n          </v-row>\r\n\r\n          <v-row v-show=\"false\" dense class=\"justify-end align-center mt-2\">\r\n            <v-icon\r\n              size=\"x-small\"\r\n              @click=\"sequence.clipThumbnailScale = Math.max(0.5, sequence.clipThumbnailScale - 0.1)\"\r\n            >\r\n              {{ mdiMinus }}\r\n            </v-icon>\r\n\r\n            <span class=\"mx-2\" style=\"min-width: 40px; text-align: center\">\r\n              {{ Math.round(sequence.clipThumbnailScale * 100) }}%\r\n            </span>\r\n\r\n            <v-icon\r\n              size=\"x-small\"\r\n              @click=\"sequence.clipThumbnailScale = Math.min(2.0, sequence.clipThumbnailScale + 0.1)\"\r\n            >\r\n              {{ mdiPlus }}\r\n            </v-icon>\r\n          </v-row>\r\n\r\n          <v-row dense style=\"height: 10px;\">\r\n            <v-text-field\r\n              variant=\"outlined\"\r\n              :label=\"$t('projectPathLabel')\"\r\n              v-model=\"projectDirectory\"\r\n              readonly\r\n            ></v-text-field>\r\n          </v-row>\r\n        </v-col>\r\n\r\n        <!-- 右侧内容区域 (9/12宽度) -->\r\n        <v-col class=\"d-flex flex-column\" style=\"gap: 8px;\">\r\n          <v-card class=\"pa-2\">\r\n            <v-row dense align=\"stretch\" class=\"timeline-row\" style=\"height: 100px;\">\r\n              <!-- 左侧始终为空白 -->\r\n              <v-col cols=\"1\" class=\"text-center pa-0\"></v-col>\r\n\r\n              <!-- 中间时间轴区域 -->\r\n              <v-col\r\n                cols=\"10\"\r\n                class=\"text-center pa-0 timeline-col\"\r\n                v-if=\"editedClip.scenes && editedClip.scenes.length > 0\"\r\n              >\r\n                <div\r\n                  ref=\"timeline\"\r\n                  class=\"timeline\"\r\n                  :style=\"{ height: `${itemPreviewHeight * sequence.sceneThumbnailScale}px` }\"\r\n                >\r\n                  <div\r\n                    v-for=\"(scene, index) in editedClip.scenes\"\r\n                    :key=\"index\"\r\n                    class=\"segment\"\r\n                    :style=\"getSegmentStyle(editedClip, scene)\"\r\n                    @click=\"selectScene(index)\"\r\n                    tabindex=\"0\"\r\n                    @paste=\"replaceSceneWithPaste(editedClip.editedSceneIndex)\"\r\n                  >\r\n                    <!-- 拖动手柄 -->\r\n                    <div\r\n                      v-if=\"index < editedClip.scenes.length - 1\"\r\n                      class=\"handle\"\r\n                      @mousedown=\"startDrag($event, index)\"\r\n                    ></div>\r\n\r\n                    <!-- 时长文字 -->\r\n                    <div\r\n                      class=\"duration-text1\"\r\n                      style=\"font-size: 150%\"\r\n                      :style=\"getDurationClass(editedClip, scene)\"\r\n                    >\r\n                      {{ formatSeconds(getSceneDuration(editedClip, scene)) }}\r\n                    </div>\r\n\r\n                    <!-- 左移按钮 -->\r\n                    <v-btn\r\n                      v-if=\"index > 0\"\r\n                      icon\r\n                      color=\"transparent\"\r\n                      size=\"x-small\"\r\n                      @click.stop=\"moveSceneLeft(index)\"\r\n                      style=\"\r\n                        position: absolute;\r\n                        top: 50%;\r\n                        left: 12px;\r\n                        transform: translateY(-50%);\r\n                        z-index: 2;\r\n                      \"\r\n                    >\r\n                      <v-icon color=\"white\">{{ mdiChevronLeft }}</v-icon>\r\n                    </v-btn>\r\n\r\n                    <!-- 删除按钮 -->\r\n                    <v-btn\r\n                      icon\r\n                      color=\"transparent\"\r\n                      size=\"small\"\r\n                      @click.stop=\"removeScene(index)\"\r\n                      style=\"\r\n                        position: absolute;\r\n                        top: 0px;\r\n                        right: 12px;\r\n                        z-index: 2;\r\n                      \"\r\n                    >\r\n                      <v-icon color=\"error\">{{ mdiDelete }}</v-icon>\r\n                    </v-btn>\r\n                  </div>\r\n                </div>\r\n              </v-col>\r\n\r\n              <!-- 无场景时，中间区域允许粘贴 -->\r\n              <v-col\r\n                v-else\r\n                cols=\"10\"\r\n                class=\"text-center pa-0 timeline-col\"\r\n                @paste=\"handlePaste\"\r\n              >\r\n                <div\r\n                  class=\"d-flex flex-column align-center justify-center paste-area\"\r\n                  :style=\"{ height: `${itemPreviewHeight * sequence.sceneThumbnailScale}px` }\"\r\n                >\r\n                  {{ $t('pasteHintPrefix') }}\r\n                  <v-btn\r\n                    color=\"primary\"\r\n                    density=\"compact\"\r\n                    min-width=\"auto\"\r\n                    class=\"ma-1\"\r\n                    style=\"height: 50px;font-size: 200%\"\r\n                    @click=\"handlePaste\"\r\n                  >\r\n                    {{ $t('pasteButton') }}\r\n                  </v-btn>\r\n                  {{ $t('pasteHintSuffix') }}\r\n                </div>\r\n              </v-col>\r\n\r\n              <!-- 右侧始终允许粘贴 -->\r\n              <v-col\r\n                cols=\"1\"\r\n                class=\"text-center pa-0 timeline-col\"\r\n                @paste=\"handlePaste\"\r\n              >\r\n                <div\r\n                  class=\"d-flex flex-column align-center justify-center paste-area\"\r\n                  :style=\"{ height: `${itemPreviewHeight * sequence.sceneThumbnailScale}px` }\"\r\n                >\r\n                  {{ $t('pasteHintPrefix') }}\r\n                  <v-btn\r\n                    color=\"primary\"\r\n                    density=\"compact\"\r\n                    min-width=\"auto\"\r\n                    class=\"ma-1\"\r\n                    style=\"height: 50px;font-size: 200%\"\r\n                    @click=\"handlePaste\"\r\n                  >\r\n                    {{ $t('pasteButton') }}\r\n                  </v-btn>\r\n                  {{ $t('pasteHintSuffix') }}\r\n                </div>\r\n              </v-col>\r\n            </v-row>\r\n\r\n            <v-row dense align=\"center\" style=\"flex-wrap: nowrap; height: 20px;\">\r\n              <!-- 播放按钮 -->\r\n              <v-col cols=\"1\" class=\"text-right\">\r\n                <v-icon\r\n                  size=\"36\"\r\n                  class=\"rounded-circle pa-1\"\r\n                  v-if=\"editedClip.narration?.audioMedia?.duration > 0\"\r\n                  @click=\"toggleAudioPlayback\"\r\n                >\r\n                  {{ isPlaying ? mdiPause : mdiPlay }}\r\n                </v-icon>\r\n                <span\r\n                  v-if=\"editedClip.narration?.audioMedia?.duration > 0\"\r\n                  >{{ (currentTime ?? 0).toFixed(2) }}</span\r\n                >\r\n              </v-col>\r\n\r\n              <!-- 波形图 -->\r\n              <v-col cols=\"10\" class=\"text-center pa-0\">\r\n                <div ref=\"waveform\"></div>\r\n\r\n                <div v-if=\"editedClip.narration?.audioMedia?.duration <= 0\">\r\n                  {{ $t('noAudioPleaseGenerate') }}\r\n                </div>\r\n              </v-col>\r\n              <v-col cols=\"1\">\r\n                <span\r\n                  v-if=\"editedClip.narration?.audioMedia?.duration > 0\"\r\n                  >{{ (totalTime ?? 0).toFixed(2) }}</span\r\n                >\r\n              </v-col>\r\n            </v-row>\r\n          </v-card>\r\n\r\n          <v-row dense style=\"flex-wrap: nowrap\">\r\n            <v-col style=\"flex: 1 1 auto\">\r\n              <v-card\r\n                class=\"mb-4\"\r\n                color=\"surface\"\r\n                :disabled=\"isBatchGeneratingAudio\"\r\n              >\r\n                <v-card-text class=\"pa-1\">\r\n                  <v-row\r\n                    dense\r\n                    align=\"stretch\"\r\n                    class=\"mb-n1\"\r\n                    style=\"flex-wrap: nowrap; height: 220px;\"\r\n                  >\r\n                    <!-- 左侧 -->\r\n                    <v-col class=\"px-1\" style=\"flex: 1 1 auto\">\r\n                      <v-row dense style=\"height: 155px;\">\r\n                        <v-col cols=\"12\" class=\"px-1 py-0\" style=\"position: relative;\">\r\n                          <!-- 控制字体的图标 -->\r\n                          <div\r\n                            style=\"position: absolute; top: 6px; right: 20px; display: flex; gap: 4px; z-index: 10;\"\r\n                          >\r\n                            <v-icon size=\"x-small\" @click=\"decreaseSentenceFontSize\">{{ mdiMinus }}</v-icon>\r\n                            <v-icon size=\"x-small\" @click=\"increaseSentenceFontSize\">{{ mdiPlus }}</v-icon>\r\n                          </div>\r\n                          <!-- sentence 输入框 -->\r\n                          <v-textarea\r\n                            outlined\r\n                            :label=\"$t('contentLabel')\"\r\n                            v-model=\"editedClip.sentence\"\r\n                            autofocus\r\n                            class=\"large-textarea\"\r\n                            :style=\"{ '--textarea-font-size': fontSize + 'px' }\"\r\n                          ></v-textarea>\r\n                        </v-col>\r\n                      </v-row>\r\n\r\n                      <v-row dense style=\"height: 80px;\">\r\n                        <v-col cols=\"12\" class=\"px-1 py-0\">\r\n                          <!-- comment1 输入框 + tooltip -->\r\n                          <v-tooltip\r\n                            :disabled=\"!enableTooltips\"\r\n                            location=\"bottom\"\r\n                            open-on-hover\r\n                          >\r\n                            <template v-slot:activator=\"{ props }\">\r\n                              <v-textarea\r\n                                outlined\r\n                                :label=\"$t('commentLabel')\"\r\n                                v-model=\"editedClip.comment1\"\r\n                                rows=\"1\"\r\n                                v-bind=\"props\"\r\n                                class=\"second-large-textarea\"\r\n                              ></v-textarea>\r\n                            </template>\r\n                            {{ $t('noteTooltip') }}\r\n                          </v-tooltip>\r\n                        </v-col>\r\n                      </v-row>\r\n                    </v-col>\r\n                    <!-- 右侧 -->\r\n                    <v-col class=\"px-1\" style=\"flex: 0 0 120px\">\r\n                      <v-row dense style=\"height: 50px;\">\r\n                        <v-col cols=\"12\" class=\"px-1 py-0\">\r\n                          <v-number-input\r\n                            v-model=\"editedClip.narration.rate\"\r\n                            :label=\"$t('rateLabel')\"\r\n                            density=\"compact\"\r\n                            :min=\"0.75\"\r\n                            :max=\"1.5\"\r\n                            :step=\"0.05\"\r\n                            :suffix=\"$t('times')\"\r\n                            control-variant=\"stacked\"\r\n                          />\r\n                        </v-col>\r\n                      </v-row>\r\n\r\n                      <v-row dense style=\"height: 50px;\">\r\n                        <v-col cols=\"12\" class=\"px-1 py-0\">\r\n                          <v-select\r\n                            v-model=\"editedClip.narration.locale\"\r\n                            :items=\"list_language_cn.map(lang => lang.locale)\"\r\n                            density=\"compact\"\r\n                            :label=\"$t('languageLabel')\"\r\n                            @update:modelValue=\"onEditedClipLanguageChange\"\r\n                          />\r\n                        </v-col>\r\n                      </v-row>\r\n\r\n                      <v-row dense style=\"height: 50px;\">\r\n                        <v-col cols=\"12\" class=\"px-1 py-0\">\r\n                          <v-select\r\n                            v-model=\"editedClip.narration.voiceName\"\r\n                            :items=\"voiceItems\"\r\n                            density=\"compact\"\r\n                            :label=\"$t('voiceLabelShort')\"\r\n                          />\r\n                        </v-col>\r\n                      </v-row>\r\n                      <v-row dense style=\"height: 100px;\">\r\n                        <v-col class=\"d-flex justify-center px-1 py-0\">\r\n                          <!-- 生成音频按钮 -->\r\n                          <v-btn\r\n                            style=\"\r\n                              width: 120px;\r\n                              height: 60px;\r\n                              font-size: 200%;\r\n                              white-space: normal;\r\n                              text-align: center;\r\n                              line-height: 1.2;\r\n                            \"\r\n                            :color=\"isGeneratingAudio ? 'error' : 'primary'\"\r\n                            @click=\"generateAudio_click(editedClip)\"\r\n                          >\r\n                            {{ isGeneratingAudio ? $t('cancel') : $t('generateAudioButton') }}\r\n                          </v-btn>\r\n                        </v-col>\r\n                      </v-row>\r\n                    </v-col>\r\n                  </v-row>\r\n                </v-card-text>\r\n              </v-card>\r\n            </v-col>\r\n\r\n            <v-col\r\n              class=\"px-1\"\r\n              :style=\"`flex: 0 0 auto; min-width: ${scenePreviewWidth + 120}px; max-width: ${scenePreviewWidth + 120}px;`\"\r\n            >\r\n              <!-- ✅ 单独的 v-card，用于显示当前选中的场景 -->\r\n              <v-card\r\n                ref=\"card-editedScene\"\r\n                class=\"mb-4\"\r\n              >\r\n                <v-card-text class=\"pa-2\">\r\n                  <v-row dense class=\"mb-n2\" style=\"flex-wrap: nowrap\">\r\n                    <v-col\r\n                      cols=\"auto\"\r\n                      :style=\"`flex: 0 0 auto; min-width: ${scenePreviewWidth + 10}px;`\"\r\n                    >\r\n                      <v-row dense class=\"g-0\">\r\n                        <div\r\n                          class=\"scene-container\"\r\n                          :style=\"{\r\n                            width: `${scenePreviewWidth}px`,\r\n                            height: `${scenePreviewHeight}px`,\r\n                            minWidth: `${scenePreviewWidth}px`,\r\n                            minHeight: `${scenePreviewHeight}px`,\r\n                            position: 'relative',\r\n                            overflow: 'hidden',\r\n                            backgroundColor: '#000000ff'\r\n                          }\"\r\n                        >\r\n                          <img\r\n                            tabindex=\"0\"\r\n                            :src=\"editedScene.base64Thumbnail\"\r\n                            class=\"scene-content\"\r\n                            :style=\"getSceneContentStyle(editedScene)\"\r\n                            @paste=\"replaceSceneWithPaste(editedClip.editedSceneIndex)\"\r\n                          />\r\n\r\n                          <div\r\n                            class=\"duration-text\"\r\n                            :class=\"getDurationClass(editedClip, editedScene)\"\r\n                          >\r\n                            {{ formatSeconds(getSceneDuration(editedClip, editedScene)) }}\r\n                          </div>\r\n\r\n                          <!-- 左侧按钮: + / - -->\r\n                          <div\r\n                            style=\"\r\n                              position: absolute;\r\n                              left: 0;\r\n                              top: 50%;\r\n                              transform: translateY(-50%);\r\n                              display: flex;\r\n                              flex-direction: column;\r\n                              align-items: center;\r\n                              gap: 8px;\r\n                              z-index: 10;\r\n                            \"\r\n                          >\r\n                            <v-btn\r\n                              icon\r\n                              size=\"small\"\r\n                              color=\"transparent\"\r\n                              @mousedown=\"handleButtonDown('zoom-in', editedScene)\"\r\n                              @mouseup=\"handleButtonUp\"\r\n                              @mouseleave=\"handleButtonUp\"\r\n                              :title=\"$t('zoomIn')\"\r\n                            >\r\n                              <v-icon>{{ mdiPlus }}</v-icon>\r\n                            </v-btn>\r\n                            <v-btn\r\n                              icon\r\n                              size=\"small\"\r\n                              color=\"transparent\"\r\n                              @mousedown=\"handleButtonDown('zoom-out', editedScene)\"\r\n                              @mouseup=\"handleButtonUp\"\r\n                              @mouseleave=\"handleButtonUp\"\r\n                              :title=\"$t('zoomOut')\"\r\n                            >\r\n                              <v-icon>{{ mdiMinus }}</v-icon>\r\n                            </v-btn>\r\n                          </div>\r\n\r\n                          <!-- 右侧按钮: 方向键 -->\r\n                          <div\r\n                            style=\"\r\n                              position: absolute;\r\n                              right: 0;\r\n                              top: 50%;\r\n                              transform: translateY(-50%);\r\n                              display: flex;\r\n                              flex-direction: column;\r\n                              align-items: center;\r\n                              gap: 0px;\r\n                              z-index: 10;\r\n                            \"\r\n                          >\r\n                            <!-- 上 -->\r\n                            <v-btn\r\n                              icon\r\n                              size=\"small\"\r\n                              color=\"transparent\"\r\n                              @mousedown=\"handleButtonDown('move-up', editedScene)\"\r\n                              @mouseup=\"handleButtonUp\"\r\n                              @mouseleave=\"handleButtonUp\"\r\n                              :title=\"$t('moveUp')\"\r\n                            >\r\n                              <v-icon>{{ mdiChevronUp }}</v-icon>\r\n                            </v-btn>\r\n\r\n                            <!-- 左右一行 -->\r\n                            <div style=\"display: flex; gap: 4px; margin: 4px 0\">\r\n                              <v-btn\r\n                                icon\r\n                                size=\"small\"\r\n                                color=\"transparent\"\r\n                                @mousedown=\"handleButtonDown('move-left', editedScene)\"\r\n                                @mouseup=\"handleButtonUp\"\r\n                                @mouseleave=\"handleButtonUp\"\r\n                                :title=\"$t('moveLeft')\"\r\n                              >\r\n                                <v-icon>{{ mdiChevronLeft }}</v-icon>\r\n                              </v-btn>\r\n                              <v-btn\r\n                                icon\r\n                                size=\"small\"\r\n                                color=\"transparent\"\r\n                                @mousedown=\"handleButtonDown('move-right', editedScene)\"\r\n                                @mouseup=\"handleButtonUp\"\r\n                                @mouseleave=\"handleButtonUp\"\r\n                                :title=\"$t('moveRight')\"\r\n                              >\r\n                                <v-icon>{{ mdiChevronRight }}</v-icon>\r\n                              </v-btn>\r\n                            </div>\r\n\r\n                            <!-- 下 -->\r\n                            <v-btn\r\n                              icon\r\n                              size=\"small\"\r\n                              color=\"transparent\"\r\n                              @mousedown=\"handleButtonDown('move-down', editedScene)\"\r\n                              @mouseup=\"handleButtonUp\"\r\n                              @mouseleave=\"handleButtonUp\"\r\n                              :title=\"$t('moveDown')\"\r\n                            >\r\n                              <v-icon>{{ mdiChevronDown }}</v-icon>\r\n                            </v-btn>\r\n                          </div>\r\n                        </div>\r\n                      </v-row>\r\n\r\n                      <!-- 帧范围滑块 -->\r\n                      <v-row dense class=\"g-0 mb-n2\" style=\"height: 24px;\">\r\n                        <v-range-slider\r\n                          density=\"compact\"\r\n                          v-model=\"editedScene.frameRange\"\r\n                          :model-value=\"[\r\n                            editedScene.frameRange[0] - editedScene.sourceRange[0],\r\n                            editedScene.frameRange[1] - editedScene.sourceRange[0]\r\n                          ]\"\r\n                          :min=\"0\"\r\n                          :max=\"editedScene.sourceRange[1] - editedScene.sourceRange[0]\"\r\n                          :step=\"1\"\r\n                          :disabled=\"editedScene.type === 'image'\"\r\n                          @update:modelValue=\"val => {\r\n                            editedScene.frameRange = [\r\n                              val[0] + editedScene.sourceRange[0],\r\n                              val[1] + editedScene.sourceRange[0]\r\n                            ]\r\n                            handleFrameRangeChange(editedScene)\r\n                          }\"\r\n                          thumb-size=\"12\"\r\n                          class=\"compact-range-slider\"\r\n                        />\r\n                      </v-row>\r\n\r\n                      <!-- 时间信息 -->\r\n                      <v-row class=\"justify-space-between g-0 mt-0 pt-0\" dense>\r\n                        <span>\r\n                          {{ frameToTime(editedScene.frameRange[0]- editedScene.sourceRange[0], editedScene.fps) }}\r\n                        </span>\r\n                        <span\r\n                          class=\"text-center\"\r\n                          :class=\"calculateRemainingTime(editedScene).class\"\r\n                        >\r\n                          {{ calculateRemainingTime(editedScene).time }}\r\n                        </span>\r\n                        <span class=\"text-right\">\r\n                          {{ frameToTime(editedScene.frameRange[1]- editedScene.sourceRange[0], editedScene.fps) }}\r\n                        </span>\r\n                      </v-row>\r\n                    </v-col>\r\n\r\n                    <v-col cols=\"auto\" style=\"flex: 0 0 100px\">\r\n                      <v-row dense class=\"g-0\">\r\n                        <v-checkbox\r\n                          v-model=\"editedScene.upend\"\r\n                          color=\"red-darken-3\"\r\n                          :label=\"$t('reverseLabel')\"\r\n                          :disabled=\"editedScene.type === 'image'\"\r\n                          density=\"compact\"\r\n                          hide-details\r\n                        ></v-checkbox>\r\n                      </v-row>\r\n\r\n                      <v-row dense class=\"g-0\">\r\n                        <v-checkbox\r\n                          v-model=\"editedScene.horizontalFlip\"\r\n                          color=\"red-darken-3\"\r\n                          :label=\"$t('horizontalFlipLabel')\"\r\n                          density=\"compact\"\r\n                          hide-details\r\n                        ></v-checkbox>\r\n                      </v-row>\r\n\r\n                      <v-row dense class=\"g-0\">\r\n                        <v-checkbox\r\n                          v-model=\"editedScene.growFrame\"\r\n                          color=\"red-darken-3\"\r\n                          :label=\"$t('growFrameLabel')\"\r\n                          v-if=\"editedScene.type === 'image'\"\r\n                          density=\"compact\"\r\n                          hide-details\r\n                        ></v-checkbox>\r\n                      </v-row>\r\n\r\n                      <v-row dense>\r\n                        <v-text-field\r\n                          v-model.number=\"editedScene.sourceVolume\"\r\n                          type=\"number\"\r\n                          step=\"0.1\"\r\n                          min=\"0\"\r\n                          max=\"1\"\r\n                          :label=\"$t('originalVolumeLabel')\"\r\n                          density=\"compact\"\r\n                          :disabled=\"editedScene.type === 'image'\"\r\n                        ></v-text-field>\r\n                      </v-row>\r\n\r\n                      <v-row dense>\r\n                        <v-tooltip location=\"top\" max-width=\"360\">\r\n                          <template v-slot:activator=\"{ props }\">\r\n                            <div\r\n                              v-bind=\"props\"\r\n                              class=\"text-caption\"\r\n                              style=\"\r\n                                white-space: nowrap;\r\n                                overflow: hidden;\r\n                                text-overflow: ellipsis;\r\n                              \"\r\n                            >\r\n                              {{ truncatePath(editedScene.fullName, 12) }}\r\n                            </div>\r\n                          </template>\r\n                          <div\r\n                            style=\"\r\n                              white-space: pre-wrap;\r\n                              word-break: break-word;\r\n                            \"\r\n                          >\r\n                            {{ editedScene.fullName }}\r\n                          </div>\r\n                        </v-tooltip>\r\n                      </v-row>\r\n                    </v-col>\r\n                  </v-row>\r\n                </v-card-text>\r\n              </v-card>\r\n            </v-col>\r\n          </v-row>\r\n\r\n          <v-card style=\"height: calc(100vh - 415px); overflow-y: auto;\">\r\n            <v-card-title\r\n              class=\"d-flex align-center justify-space-between py-1 px-3 text-body-2\"\r\n            >\r\n              <span>{{ $t('longVideoSlices') }}</span>\r\n            </v-card-title>\r\n\r\n            <!-- tabs 区域 -->\r\n            <v-tabs\r\n              v-model=\"activeLibrary\"\r\n              show-arrows\r\n              density=\"compact\"\r\n              class=\"tab-compact\"\r\n            >\r\n              <!-- 已有的 tab -->\r\n              <v-tab\r\n                v-for=\"(lib, index) in materialLibraries\"\r\n                :key=\"index\"\r\n                class=\"tab-item\"\r\n                :value=\"index\"\r\n              >\r\n                {{ lib.loading ? $t('importingSegments') : lib.name }}\r\n                <v-icon v-if=\"!lib.loading\" @click.stop=\"removeLibrary(index)\">\r\n                  {{ mdiClose }}\r\n                </v-icon>\r\n              </v-tab>\r\n\r\n              <!-- 添加 tab 的按钮 -->\r\n              <v-tab\r\n                :disabled=\"materialLibraries.some(lib => lib.loading)\"\r\n                @click=\"addMaterialLibrary\"\r\n                class=\"d-flex align-center\"\r\n              >\r\n                <v-icon color=\"warning\">{{ mdiPlus }}</v-icon>\r\n              </v-tab>\r\n            </v-tabs>\r\n\r\n            <!-- tabs 内容 -->\r\n            <v-tabs-window v-model=\"activeLibrary\">\r\n              <v-tabs-window-item\r\n                v-for=\"(lib, libIndex) in materialLibraries\"\r\n                :key=\"libIndex\"\r\n                :value=\"libIndex\"\r\n              >\r\n                <!-- 独立滚动容器 -->\r\n                <div style=\"overflow-y: auto; padding: 8px\">\r\n                  <v-container fluid>\r\n                    <v-row>\r\n                      <v-col\r\n                        v-for=\"(segment, segIndex) in lib.segments\"\r\n                        :key=\"segIndex\"\r\n                        cols=\"3\"\r\n                      >\r\n                        <!-- 你的缩略图卡片 -->\r\n                        <div\r\n                          class=\"thumbnail-card\"\r\n                          :style=\"{ paddingTop: (100 * (segment.thumbHeight / segment.thumbWidth)) + '%' }\"\r\n                          @mouseenter=\"handleMouseEnter(libIndex, lib, segment, segIndex)\"\r\n                          @mouseleave=\"handleMouseLeave(libIndex, segIndex)\"\r\n                        >\r\n                          <img\r\n                            v-if=\"segment.base64Thumbnail\"\r\n                            :src=\"segment.base64Thumbnail\"\r\n                            class=\"thumbnail-img\"\r\n                          />\r\n                          <!-- 预览层 -->\r\n                          <div\r\n                            v-if=\"segment.previewBase64\"\r\n                            class=\"preview-overlay\"\r\n                            :class=\"{ playing: segment.isPlaying }\"\r\n                            :style=\"{ \r\n                              backgroundImage: 'url(' + segment.previewBase64 + ')',\r\n                              backgroundPosition: segment.currentFrame !== undefined ? \r\n                                `${(segment.currentFrame % 4) * 33.333}% ${Math.floor(segment.currentFrame / 4) * 50}%` : '0% 0%'\r\n                            }\"\r\n                            :data-lib=\"libIndex\"\r\n                            :data-seg=\"segIndex\"\r\n                          ></div>\r\n                          <v-btn\r\n                            class=\"thumbnail-left-icon\"\r\n                            variant=\"text\"\r\n                            size=\"small\"\r\n                            @click.stop=\"addScene(lib.info, segment, segment.base64Thumbnail)\"\r\n                          >\r\n                            {{ $t('addScene') }}\r\n                          </v-btn>\r\n\r\n                          <v-btn\r\n                            class=\"thumbnail-right-icon\"\r\n                            variant=\"text\"\r\n                            size=\"small\"\r\n                            @click.stop=\"replaceScene(lib.info, segment, segment.base64Thumbnail)\"\r\n                          >\r\n                            {{ $t('replaceScene') }}\r\n                          </v-btn>\r\n                          <span class=\"duration-text\">\r\n                            {{ formatSeconds(segment.duration) }}\r\n                          </span>\r\n                          <span class=\"frame-range-text\">\r\n                            {{ frameToTime(segment.StartFrame, materialLibraries[libIndex].fps) }}\r\n                            /\r\n                            {{ frameToTime(segment.EndFrame, materialLibraries[libIndex].fps) }}\r\n                          </span>\r\n                        </div>\r\n                      </v-col>\r\n                    </v-row>\r\n                  </v-container>\r\n                </div>\r\n              </v-tabs-window-item>\r\n            </v-tabs-window>\r\n          </v-card>\r\n        </v-col>\r\n      </v-row>\r\n    </template>\r\n\r\n    <!-- 当没有片段时显示添加按钮 -->\r\n    <template v-else>\r\n      <v-row align=\"center\" justify=\"center\" class=\"px-2 py-10\">\r\n        <v-col cols=\"12\" class=\"text-center\">\r\n                      <v-tooltip location=\"end\" :disabled=\"!enableTooltips\">\r\n              <template v-slot:activator=\"{ props }\">\r\n                <v-icon\r\n                  size=\"64\"\r\n                  color=\"primary\"\r\n                  v-bind=\"props\"\r\n                  @click=\"goHomePage\"\r\n                  class=\"clickable-icon mr-3\"\r\n                >\r\n                  {{ mdiHome }}\r\n                </v-icon>\r\n              </template>\r\n              <span>{{ $t('returnToHomeTooltip') }}</span>\r\n            </v-tooltip>\r\n          <v-btn\r\n            color=\"primary\"\r\n            size=\"x-large\"\r\n            class=\"text-h8 mx-2\"\r\n            @click=\"addItem\"\r\n          >\r\n            {{ $t('addFirstRow') }}\r\n          </v-btn>\r\n        </v-col>\r\n      </v-row>\r\n    </template>\r\n  </v-container>\r\n  <!-- 添加新Clip对话框 -->\r\n  <v-dialog v-model=\"addDialog\" max-width=\"1000px\">\r\n    <v-card>\r\n      <v-card-title>{{ $t('addNewClip') }}</v-card-title>\r\n      <v-card-text class=\"pa-1\">\r\n        <v-row dense class=\"g-0\" align=\"stretch\">\r\n          <!-- 左侧 -->\r\n          <v-col cols=\"12\" md=\"9\" class=\"px-1 d-flex flex-column\">\r\n            <v-textarea\r\n              outlined\r\n              :label=\"$t('content')\"\r\n              v-model=\"newClip.sentence\"\r\n              rows=\"3\"\r\n              autofocus\r\n              class=\"mb-2\"\r\n            ></v-textarea>\r\n\r\n            <v-tooltip\r\n              activator=\"parent\"\r\n              :disabled=\"!enableTooltips\"\r\n              location=\"bottom\"\r\n            >\r\n              <template v-slot:activator=\"{ on, attrs }\">\r\n                <v-textarea\r\n                  outlined\r\n                  :label=\"$t('comment')\"\r\n                  v-model=\"newClip.comment1\"\r\n                  rows=\"3\"\r\n                  v-bind=\"attrs\"\r\n                  v-on=\"on\"\r\n                ></v-textarea>\r\n              </template>\r\n              {{ $t('commentTooltip') }}\r\n            </v-tooltip>\r\n          </v-col>\r\n\r\n          <!-- 右侧 -->\r\n          <v-col\r\n            cols=\"12\"\r\n            md=\"3\"\r\n            class=\"px-1 d-flex flex-column justify-space-between\"\r\n          >\r\n            <v-row dense>\r\n              <v-col cols=\"12\">\r\n                <v-number-input\r\n                  v-model=\"newClip.narration.rate\"\r\n                  :label=\"$t('rate')\"\r\n                  density=\"compact\"\r\n                  :min=\"0.75\"\r\n                  :max=\"1.5\"\r\n                  :step=\"0.05\"\r\n                  :suffix=\"$t('times')\"\r\n                  control-variant=\"stacked\"\r\n                />\r\n              </v-col>\r\n            </v-row>\r\n\r\n            <v-row dense>\r\n              <v-col cols=\"12\">\r\n                <v-select\r\n                  v-model=\"newClip.narration.locale\"\r\n                  :items=\"list_language_cn.map(lang => lang.locale)\"\r\n                  density=\"compact\"\r\n                  :label=\"$t('language')\"\r\n                  @update:modelValue=\"onNewClipLanguageChange\"\r\n                />\r\n              </v-col>\r\n            </v-row>\r\n\r\n            <v-row dense>\r\n              <v-col cols=\"12\">\r\n                <v-select\r\n                  v-model=\"newClip.narration.voiceName\"\r\n                  :items=\"newClipVoiceItems\"\r\n                  density=\"compact\"\r\n                  :label=\"$t('voice')\"\r\n                />\r\n              </v-col>\r\n            </v-row>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <v-row dense>\r\n          <v-col cols=\"12\">\r\n            <v-checkbox\r\n              v-model=\"autoSplitSentences\"\r\n              :label=\"$t('autoSplitSentences')\"\r\n            ></v-checkbox>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <v-row dense>\r\n          <v-col cols=\"2\">\r\n            <v-select\r\n              v-model=\"insertClipMode\"\r\n              :items=\"[\r\n                  { title: $t('insertClipAtPosition'), value: 'insertClip' },\r\n                  { title: $t('appendClipBelow'), value: 'appendClip' }\r\n                ]\"\r\n              :label=\"$t('insertClipMode')\"\r\n              density=\"compact\"\r\n            />\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn\r\n          color=\"error\"\r\n          @click=\"addDialog = false\"\r\n          >{{ $t('cancel') }}</v-btn\r\n        >\r\n        <v-btn\r\n          color=\"success\"\r\n          @click=\"confirmAddClip\"\r\n          >{{ $t('confirm') }}</v-btn\r\n        >\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n\r\n  <!-- 批量编辑片段对话框 -->\r\n  <v-dialog v-model=\"batchEditDialog\" max-width=\"1000px\">\r\n    <v-card>\r\n      <v-card-title>{{ $t('batchEditClips') }}</v-card-title>\r\n      <v-card-text>\r\n        <v-row dense class=\"g-2\">\r\n          <!-- 左列: v-textarea -->\r\n          <v-col cols=\"12\" md=\"9\">\r\n            <v-textarea\r\n              outlined\r\n              :label=\"$t('selectedTextContent')\"\r\n              :model-value=\"batchEditTextContent\"\r\n              readonly\r\n              rows=\"12\"\r\n              class=\"mb-2\"\r\n            ></v-textarea>\r\n          </v-col>\r\n\r\n          <!-- 右列: 参数控件 -->\r\n          <v-col cols=\"12\" md=\"3\" class=\"d-flex flex-column\">\r\n            <v-row dense>\r\n              <v-col cols=\"12\">\r\n                <v-number-input\r\n                  v-model=\"batchEditParams.rate\"\r\n                  :label=\"$t('rate')\"\r\n                  density=\"compact\"\r\n                  :min=\"0.75\"\r\n                  :max=\"1.5\"\r\n                  :step=\"0.05\"\r\n                  :suffix=\"$t('times')\"\r\n                  control-variant=\"stacked\"\r\n                />\r\n              </v-col>\r\n            </v-row>\r\n\r\n            <v-row dense>\r\n              <v-col cols=\"12\">\r\n                <v-select\r\n                  v-model=\"batchEditParams.locale\"\r\n                  :items=\"list_language_cn.map(lang => lang.locale)\"\r\n                  :label=\"$t('language')\"\r\n                  density=\"compact\"\r\n                ></v-select>\r\n              </v-col>\r\n            </v-row>\r\n\r\n            <v-row dense>\r\n              <v-col cols=\"12\">\r\n                <v-select\r\n                  v-model=\"batchEditParams.voiceName\"\r\n                  :items=\"batchEditVoiceItems\"\r\n                  :label=\"$t('voice')\"\r\n                  density=\"compact\"\r\n                ></v-select>\r\n              </v-col>\r\n            </v-row>\r\n\r\n            <!-- 第四行: selectedPreset -->\r\n            <v-row dense>\r\n              <v-col cols=\"12\">\r\n                <v-select\r\n                  v-model=\"selectedPreset\"\r\n                  :items=\"parameterPresets\"\r\n                  item-title=\"title\"\r\n                  return-object\r\n                  :label=\"$t('presetSettings')\"\r\n                  density=\"compact\"\r\n                  class=\"mt-2\"\r\n                  @update:modelValue=\"applyPreset\"\r\n                ></v-select>\r\n              </v-col>\r\n            </v-row>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn\r\n          color=\"error\"\r\n          @click=\"batchEditDialog = false\"\r\n          >{{ $t('cancel') }}</v-btn\r\n        >\r\n        <v-btn color=\"success\" @click=\"applyBatchEdit\">{{ $t('apply') }}</v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n\r\n  <!-- 批量删除确认 -->\r\n  <v-dialog v-model=\"deleteConfirmDialog\" max-width=\"500px\">\r\n    <v-card>\r\n      <v-card-text>\r\n        <p>\r\n          {{ $t('deleteConfirmText', { count: selectedClipIndices.length }) }}\r\n        </p>\r\n        <p class=\"text-caption text-medium-emphasis\">\r\n          {{ $t('deleteWarning') }}\r\n        </p>\r\n\r\n        <v-list\r\n          v-if=\"previewDeleteItems.length > 0\"\r\n          density=\"compact\"\r\n          class=\"mt-2\"\r\n        >\r\n          <v-list-item\r\n            v-for=\"(item, index) in previewDeleteItems\"\r\n            :key=\"index\"\r\n            class=\"text-caption\"\r\n          >\r\n            <template v-slot:prepend\r\n              ><v-icon size=\"small\">{{ mdiMenuRight }}</v-icon></template\r\n            >\r\n            <v-list-item-title>{{ item }}</v-list-item-title>\r\n          </v-list-item>\r\n          <v-list-item v-if=\"selectedClipIndices.length > 3\">\r\n            <v-list-item-title class=\"text-caption text-medium-emphasis\">\r\n              {{ $t('remainingClips', { count: selectedClipIndices.length - 3 }) }}\r\n            </v-list-item-title>\r\n          </v-list-item>\r\n        </v-list>\r\n      </v-card-text>\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn\r\n          color=\"grey\"\r\n          variant=\"text\"\r\n          @click=\"deleteConfirmDialog = false\"\r\n          >{{ $t('cancel') }}</v-btn\r\n        >\r\n        <v-btn\r\n          color=\"error\"\r\n          variant=\"elevated\"\r\n          @click=\"confirmBatchDelete\"\r\n          >{{ $t('confirm') }}</v-btn\r\n        >\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n\r\n  <!-- 导出对话框 -->\r\n  <v-dialog v-model=\"exportDialog\" max-width=\"600px\" persistent>\r\n    <v-card>\r\n      <v-card-title>{{ $t('exportClips') }}</v-card-title>\r\n      <v-card-text>\r\n        <!-- 导出类型选择 -->\r\n        <v-row dense>\r\n          <v-col cols=\"12\">\r\n            <v-select\r\n              v-model=\"exportType\"\r\n              :items=\"[\r\n              { text: $t('videoMP4'), value: 'video' },\r\n              { text: $t('audioMP3'), value: 'audio' }\r\n            ]\"\r\n              item-title=\"text\"\r\n              item-value=\"value\"\r\n              :label=\"$t('exportType')\"\r\n              density=\"compact\"\r\n            ></v-select>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <!-- 缺失文件提示 -->\r\n        <v-row dense>\r\n          <v-col cols=\"12\">\r\n            <v-alert\r\n              v-if=\"exportType === 'audio' && missingAudioFiles.length > 0\"\r\n              type=\"warning\"\r\n              density=\"compact\"\r\n              class=\"mb-3\"\r\n            >\r\n              {{ $t('missingAudioFiles', { count: missingAudioFiles.length }) }}\r\n              <div class=\"text-caption mt-1\">\r\n                {{ missingAudioFiles.map(f => f.index + 1).join(', ') }}\r\n              </div>\r\n            </v-alert>\r\n\r\n            <v-alert\r\n              v-if=\"exportType === 'video' && missingVideoFiles.length > 0\"\r\n              type=\"warning\"\r\n              density=\"compact\"\r\n              class=\"mb-3\"\r\n            >\r\n              {{ $t('missingVideoFiles', { count: missingVideoFiles.length }) }}\r\n              <div class=\"text-caption mt-1\">\r\n                {{ missingVideoFiles.map(f => f.index + 1).join(', ') }}\r\n              </div>\r\n            </v-alert>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <!-- 忽略缺失文件按钮 -->\r\n        <template\r\n          v-if=\"!ignoreMissing && ((exportType === 'audio' && missingAudioFiles.length > 0) ||\r\n                                  (exportType === 'video' && missingVideoFiles.length > 0))\"\r\n        >\r\n          <v-row dense>\r\n            <v-col cols=\"10\"></v-col>\r\n            <v-col cols=\"2\">\r\n              <v-btn color=\"primary\" block @click=\"ignoreMissingFiles\">\r\n                {{ $t('ignoreAndContinue') }}\r\n              </v-btn>\r\n            </v-col>\r\n          </v-row>\r\n        </template>\r\n\r\n        <!-- 没有可导出文件的提示 -->\r\n        <v-alert\r\n          v-if=\"(exportType === 'audio' && exportAudioFiles.length === 0) || \r\n              (exportType === 'video' && exportVideoFiles.length === 0)\"\r\n          type=\"error\"\r\n          density=\"compact\"\r\n          class=\"mb-3\"\r\n        >\r\n          {{ $t('noFilesToExport') }}\r\n        </v-alert>\r\n\r\n        <!-- 背景音乐设置 -->\r\n        <template\r\n          v-if=\"ignoreMissing || ((exportType === 'audio' && exportAudioFiles.length > 0) || \r\n                                (exportType === 'video' && exportVideoFiles.length > 0))\"\r\n        >\r\n          <v-row dense>\r\n            <v-col cols=\"10\">\r\n              <v-text-field\r\n                v-model=\"backgroundMusicPath\"\r\n                :label=\"$t('backgroundMusic')\"\r\n                readonly\r\n                density=\"compact\"\r\n                clearable\r\n                :disabled=\"!ignoreMissing && ((exportType === 'audio' && missingAudioFiles.length > 0) ||\r\n                                           (exportType === 'video' && missingVideoFiles.length > 0))\"\r\n              ></v-text-field>\r\n            </v-col>\r\n            <v-col cols=\"2\">\r\n              <v-btn\r\n                color=\"primary\"\r\n                @click=\"browseBackgroundMusic\"\r\n                block\r\n                :disabled=\"!ignoreMissing && ((exportType === 'audio' && missingAudioFiles.length > 0) ||\r\n                                           (exportType === 'video' && missingVideoFiles.length > 0))\"\r\n              >\r\n                {{ $t('browse') }}\r\n              </v-btn>\r\n            </v-col>\r\n          </v-row>\r\n\r\n          <v-row dense>\r\n            <v-col cols=\"10\">\r\n              <v-slider\r\n                v-model=\"backgroundMusicVolume\"\r\n                :label=\"$t('backgroundMusicVolume')\"\r\n                max=\"2\"\r\n                min=\"0.1\"\r\n                step=\"0.1\"\r\n                thumb-label\r\n                density=\"compact\"\r\n                :disabled=\"!ignoreMissing && ((exportType === 'audio' && missingAudioFiles.length > 0) ||\r\n                                           (exportType === 'video' && missingVideoFiles.length > 0))\"\r\n              ></v-slider>\r\n            </v-col>\r\n          </v-row>\r\n        </template>\r\n\r\n        <!-- 导出路径 -->\r\n        <v-row\r\n          dense\r\n          v-if=\"ignoreMissing || ((exportType === 'audio' && exportAudioFiles.length > 0) || \r\n                                (exportType === 'video' && exportVideoFiles.length > 0))\"\r\n        >\r\n          <v-col cols=\"10\">\r\n            <v-text-field\r\n              v-model=\"exportPath\"\r\n              :label=\"$t('savePath')\"\r\n              readonly\r\n              density=\"compact\"\r\n              :disabled=\"!ignoreMissing && ((exportType === 'audio' && missingAudioFiles.length > 0) ||\r\n                                         (exportType === 'video' && missingVideoFiles.length > 0))\"\r\n            ></v-text-field>\r\n          </v-col>\r\n          <v-col cols=\"2\">\r\n            <v-btn\r\n              color=\"primary\"\r\n              @click=\"browseExportPath\"\r\n              block\r\n              :disabled=\"!ignoreMissing && ((exportType === 'audio' && missingAudioFiles.length > 0) ||\r\n                                         (exportType === 'video' && missingVideoFiles.length > 0))\"\r\n            >\r\n              {{ $t('browse') }}\r\n            </v-btn>\r\n          </v-col>\r\n        </v-row>\r\n\r\n        <!-- 文件已存在提示 -->\r\n        <v-alert\r\n          v-if=\"fileExistsWarning\"\r\n          type=\"warning\"\r\n          density=\"compact\"\r\n          class=\"mb-3\"\r\n        >\r\n          <div>{{ $t('fileExists') }}</div>\r\n          <div class=\"text-caption mt-1\">\r\n            {{ exportPathTemp.split('\\\\').pop() }}\r\n          </div>\r\n          <div class=\"text-caption\">{{ $t('overwritePrompt') }}</div>\r\n\r\n          <v-row class=\"mt-2\">\r\n            <v-col cols=\"6\">\r\n              <v-btn\r\n                color=\"error\"\r\n                @click=\"cancelOverwrite\"\r\n                block\r\n                >{{ $t('cancel') }}</v-btn\r\n              >\r\n            </v-col>\r\n            <v-col cols=\"6\">\r\n              <v-btn\r\n                color=\"success\"\r\n                @click=\"confirmOverwrite\"\r\n                block\r\n                >{{ $t('overwriteButton') }}</v-btn\r\n              >\r\n            </v-col>\r\n          </v-row>\r\n        </v-alert>\r\n\r\n        <!-- 导出进度 -->\r\n        <v-row v-if=\"isExporting\" dense>\r\n          <v-col cols=\"12\">\r\n            <v-progress-linear\r\n              v-model=\"exportProgress\"\r\n              color=\"primary\"\r\n              height=\"20\"\r\n              striped\r\n            ></v-progress-linear>\r\n            <div class=\"text-caption text-center mt-1\">\r\n              {{ $t('exportingProgress', { progress: exportProgress }) }}\r\n            </div>\r\n          </v-col>\r\n        </v-row>\r\n      </v-card-text>\r\n\r\n      <v-card-actions>\r\n        <v-spacer></v-spacer>\r\n        <v-btn\r\n          color=\"error\"\r\n          @click=\"exportDialog = false\"\r\n          :disabled=\"isExporting\"\r\n        >\r\n          {{ $t('cancel') }}\r\n        </v-btn>\r\n        <v-btn\r\n          color=\"success\"\r\n          @click=\"confirmExport\"\r\n          :disabled=\"isExporting || \r\n                  (!ignoreMissing && \r\n                   ((exportType === 'audio' && exportAudioFiles.length === 0) || \r\n                    (exportType === 'video' && exportVideoFiles.length === 0))) ||\r\n                  !exportPath ||\r\n                  (fileExistsWarning && !fileExistsResolved)\"\r\n        >\r\n          {{ $t('confirm') }}\r\n        </v-btn>\r\n      </v-card-actions>\r\n    </v-card>\r\n  </v-dialog>\r\n</template>\r\n\r\n<script>\r\nimport aardio from \"aardio\";\r\nimport WaveSurfer from 'wavesurfer.js';\r\nimport _ from 'lodash';\r\nimport { nextTick } from 'vue'\r\nimport {\r\n  mdiHome,\r\n  mdiDelete,\r\n  mdiMenuRight,\r\n  mdiSelectAll,\r\n  mdiPencil,\r\n  mdiMinus,\r\n  mdiPlus,\r\n  mdiChevronLeft,\r\n  mdiChevronRight,\r\n  mdiChevronUp,\r\n  mdiChevronDown,\r\n  mdiPlay,\r\n  mdiPause,\r\n  mdiContentSave,\r\n  mdiVideoVintage,\r\n  mdiMerge,\r\n  mdiWaveform,\r\n  mdiMenuClose,\r\n  mdiTuneVariant,\r\n  mdiClose,\r\n} from '@mdi/js';\r\nimport { list_language_cn } from '@/assets/variables.js';\r\nimport { getDefaultSequence, getDefaultClip, getDefaultScene, formatTime, splitSentences } from '@/utils/CommonMethods';\r\nimport AppBrand from '@/components/AppBrand.vue'\r\n\r\nexport default {\r\n  components: { AppBrand },\r\n  data() {\r\n    return {\r\n      mdiHome,\r\n      mdiPencil,\r\n      mdiMinus,\r\n      mdiPlus,\r\n      mdiDelete,\r\n      mdiMenuRight,\r\n      mdiSelectAll,\r\n      mdiChevronLeft,\r\n      mdiChevronRight,\r\n      mdiChevronUp,\r\n      mdiChevronDown,\r\n      mdiContentSave,\r\n      mdiPlay,\r\n      mdiPause,\r\n      mdiVideoVintage,\r\n      mdiMerge,\r\n      mdiWaveform,\r\n      mdiMenuClose,\r\n      mdiTuneVariant,\r\n      mdiClose,\r\n      snackbar: {\r\n        visible: false,\r\n        message: '',\r\n        color: 'success'\r\n      },\r\n      isLoading: true, // 添加加载状态\r\n      settingsMenu: false, // 控制设置菜单的显示状态\r\n      enableTooltips: true, // 控制所有tooltip的可用性\r\n      debounceTimers: {}, // 用于存储每个场景的防抖定时器\r\n      defaultDebounceTime: 200, // 默认防抖时间\r\n      minDebounceTime: 100, // 最小防抖时间\r\n      maxDebounceTime: 500, // 最大防抖时间\r\n      lastSliderChangeTime: 0, // 记录上次滑块变化时间\r\n      // 项目相关\r\n      projectFullName: '',\r\n      projectDirectory:'',\r\n      projectName:'',\r\n      list_language_cn,\r\n\r\n      // 选择状态\r\n      selectedClipIndices: [],\r\n      addDialog: false,\r\n      newClip: getDefaultClip(),\r\n      newClipVoiceItems: [],\r\n      autoSplitSentences: true,\r\n      insertClipMode: 'appendClip',\r\n\r\n      // 预览尺寸\r\n      scenePreviewWidth: 320,\r\n      scenePreviewHeight: 180,\r\n      itemPreviewWidth: 320,\r\n      itemPreviewHeight: 180,\r\n      previewScale: 1,\r\n\r\n      // 主数据结构\r\n      sequence: getDefaultSequence(),\r\n      //editedClip: getDefaultClip(),\r\n      // 默认场景\r\n      defaultScene: getDefaultScene(),\r\n\r\n      // 语音相关\r\n      synth: window.speechSynthesis,\r\n      list_voice_edge: [],\r\n      voiceItems: [],\r\n      isGeneratingAudio: false,\r\n      cancelAudioGeneration: false,\r\n      currentUtterance: null, // 用于存储当前的语音合成对象\r\n      audioSrc: null,  // 存储生成的音频文件URL\r\n      folder_audio:'AudioClip',\r\n      folder_buff:'Buff',\r\n      audio_original:'original.wav',\r\n      audio_with_silence:'undefine.wav',\r\n      audio_with_speed:'adjust.wav',\r\n      audio_concate:'fullAudio.wav',\r\n      audioPlayer: null,\r\n      folder_video:'VideoClip',\r\n      audioReady: false,\r\n      wavesurfer: null,\r\n      isPlaying: false,\r\n      currentTime: 0,\r\n      totalTime: 0,\r\n      playbackProgress: 0,\r\n      audioDurationFrames: 0,\r\n      seekInProgress: false,\r\n      wasPlayingBeforeSeek: false,\r\n      audioUpdateInterval: null,\r\n      activeButton: null,\r\n      buttonInterval: null,\r\n      buttonActions: {\r\n        'zoom-in': { prop: 'scale', value: 0.01 },\r\n        'zoom-out': { prop: 'scale', value: -0.01 },\r\n        'move-up': { prop: 'anchorY', value: -2 },\r\n        'move-down': { prop: 'anchorY', value: 2 },\r\n        'move-left': { prop: 'anchorX', value: -2 },\r\n        'move-right': { prop: 'anchorX', value: 2 }\r\n      },\r\n      deleteConfirmDialog: false,\r\n      // 批量编辑相关数据\r\n      batchEditDialog: false,\r\n      batchEditParams: {\r\n        rate: 1.0,\r\n        speed: 1.0,\r\n        pauseBefore: 0.25,\r\n        pauseAfter: 0.25,\r\n        locale: '',\r\n        voiceName: ''\r\n      },\r\n      batchEditVoiceItems: [],\r\n      selectedPreset: null,\r\n      parameterPresets: [],\r\n      clearAudioMedia: true,\r\n      clearVideoMedia: true,\r\n\r\n      // 筛选相关数据\r\n      filterMenu: false,\r\n      voiceDialog: false,\r\n      filters: {\r\n        all: false,\r\n        voice: [],\r\n        audioPending: false,\r\n        videoPending: false\r\n      },\r\n      selectedVoices: [],\r\n      isBatchGeneratingAudio: false,\r\n      cancelBatchAudioGeneration: false,\r\n      batchAudioGenerationProgress: 0, // 进度 0-100\r\n      currentBatchAudioIndex: 0, // 当前正在处理的clip索引\r\n      totalBatchAudioCount: 0, // 总clip数量\r\n\r\n      isBatchGeneratingVideo: false,\r\n      cancelBatchVideoGeneration: false,\r\n      batchVideoGenerationProgress: 0, // 进度 0-100\r\n      currentBatchVideoIndex: 0, // 当前正在处理的clip索引\r\n      totalBatchVideoCount: 0, // 总clip数量\r\n      // 导出相关数据\r\n      exportDialog: false,\r\n      exportType: 'video', // 'audio' 或 'video'\r\n      backgroundMusicPath: '',\r\n      backgroundMusicVolume: 0.25,\r\n      exportPath: '',\r\n      lastExportType: '', // 记录上次的导出类型\r\n      lastExportPath: '', // 记录上次的导出路径\r\n      exportAudioFiles: [],\r\n      exportVideoFiles: [],\r\n      missingAudioFiles: [],\r\n      missingVideoFiles: [],\r\n      ignoreMissing: false,\r\n      isExporting: false,\r\n      exportProgress: 0,\r\n      fileExistsWarning: false,\r\n      fileExistsResolved: false,\r\n      exportPathTemp: '',\r\n      dragUpdateTimeout: null,\r\n      materialLibraries: [],\r\n      activeLibrary: 0,\r\n      menuAnalyzeSoftwareOpen: false,\r\n      fontSize: 40,\r\n      //editedScene: getDefaultScene(),\r\n    }\r\n  },\r\n\r\n  watch: {\r\n    exportDialog(newVal) {\r\n      if (!newVal) {\r\n        // 对话框关闭时重置状态\r\n        this.fileExistsWarning = false;\r\n        this.fileExistsResolved = false;\r\n        this.exportPathTemp = '';\r\n      }\r\n    },\r\n    exportType(newType, oldType) {\r\n      // 当导出类型改变时，自动调整导出路径\r\n      if (newType !== oldType && this.exportPath) {\r\n        this.resetExportPathForType();\r\n      }\r\n    },\r\n\r\n\r\n    // 监听序列输出尺寸变化，更新预览尺寸\r\n    'sequence.outputSize': {\r\n      deep: true,\r\n      handler() {\r\n        this.calculatePreviewSize();\r\n      }\r\n    },\r\n    'editedClip.narration.audioMedia.duration'(val) {\r\n        this.currentTime = 0;\r\n        this.totalTime = 0;\r\n        if (val > 0 && this.editedClip?.narration?.audioMedia?.filePath) {\r\n          this.$nextTick(() => {\r\n            this.loadAudio(this.editedClip.narration.audioMedia.filePath, this.editedClip.narration.audioMedia.duration)\r\n          })\r\n        }else {\r\n          // 清除波形\r\n          if (this.wavesurfer) {\r\n            this.wavesurfer.empty()   // 清空波形数据\r\n            this.wavesurfer.destroy() // 如果需要彻底销毁实例\r\n            this.wavesurfer = null\r\n          }\r\n        }\r\n      }\r\n  },\r\n  // 添加组件销毁时的清理\r\nbeforeUnmount() {\r\n  // 清除所有防抖定时器\r\n  Object.values(this.debounceTimers).forEach(timer => {\r\n    clearTimeout(timer);\r\n  });\r\n    document.removeEventListener('mousemove', this.onDrag);\r\n    document.removeEventListener('mouseup', this.stopDrag);\r\n},\r\nasync created() {\r\n  this.isLoading = true; // 开始加载\r\n  const startTime = Date.now(); // 记录开始时间\r\n\r\n  try {\r\n    // 并行执行语音获取和项目加载\r\n    const [voices, projectData] = await Promise.all([\r\n      // 获取语音列表（使用setTimeout确保语音合成器已初始化）\r\n      new Promise(resolve => {\r\n        setTimeout(() => {\r\n          const voices = this.synth.getVoices();\r\n          // 如果语音列表为空，可能需要等待语音合成器初始化\r\n          if (voices && voices.length > 0) {\r\n            resolve(voices);\r\n          } else {\r\n            // 如果语音列表为空，等待一段时间再尝试\r\n            setTimeout(() => {\r\n              resolve(this.synth.getVoices() || []);\r\n            }, 300);\r\n          }\r\n        }, 100);\r\n      }),\r\n\r\n      // 如果有项目路径，则加载项目\r\n      this.$route.query.projectFullName\r\n        ? this.loadProjectData(this.$route.query.projectFullName)\r\n        : Promise.resolve(null)\r\n    ]);\r\n\r\n    this.list_voice_edge = voices;\r\n    this.initializeComboboxes();\r\n    this.calculatePreviewSize();\r\n\r\n    // 如果加载了项目数据，则应用到sequence\r\n    if (projectData) {\r\n      this.sequence = projectData;\r\n\r\n      // 如果有选中的clip，则选中它\r\n      if (this.sequence.clips.length > this.sequence.selectedIndex && this.sequence.selectedIndex >= 0) {\r\n        this.selectClip(this.sequence.selectedIndex);\r\n      }\r\n    }\r\n\r\n    // 计算剩余等待时间\r\n    const elapsedTime = Date.now() - startTime;\r\n    const remainingWaitTime = Math.max(0, 400 - elapsedTime);\r\n\r\n    // 如果有剩余等待时间，则等待\r\n    if (remainingWaitTime > 0) {\r\n      await new Promise(resolve => setTimeout(resolve, remainingWaitTime));\r\n    }\r\n  } catch (error) {\r\n    console.error(\"Initialization failed:\", error);\r\n    // 确保基本功能可用\r\n    this.list_voice_edge = this.synth.getVoices() || [];\r\n    this.initializeComboboxes();\r\n    this.calculatePreviewSize();\r\n  }finally {\r\n      this.isLoading = false; // 结束加载\r\n    }\r\n\r\n  // 初始化编辑clip的场景数组\r\n  if (!this.editedClip.scenes) {\r\n    this.editedClip.scenes = [];\r\n  }\r\n},\r\ncomputed: {\r\n  editedClip: {\r\n    get() {\r\n      return this.sequence?.clips?.[this.sequence.selectedIndex] || getDefaultClip();\r\n    },\r\n    set(val) {\r\n      if (this.sequence?.clips?.[this.sequence.selectedIndex]) {\r\n        Object.assign(this.sequence.clips[this.sequence.selectedIndex], val);\r\n      }\r\n    },\r\n  },\r\n\r\n  editedScene: {\r\n    get() {\r\n      const clip = this.sequence?.clips?.[this.sequence.selectedIndex];\r\n      if (!clip || !clip.scenes) return getDefaultScene();\r\n\r\n      const sceneIndex = clip.editedSceneIndex ?? -1;\r\n      return clip.scenes?.[sceneIndex] || getDefaultScene();\r\n    },\r\n    set(val) {\r\n      const clip = this.sequence?.clips?.[this.sequence.selectedIndex];\r\n      const sceneIndex = clip.editedSceneIndex ?? -1;\r\n\r\n      if (clip && clip.scenes && clip.scenes[sceneIndex]) {\r\n        Object.assign(clip.scenes[sceneIndex], val);\r\n      }\r\n    },\r\n  },\r\n    // 计算可用的播音员列表（去重）\r\n    availableVoices() {\r\n      const voices = new Set();\r\n      this.sequence.clips.forEach(clip => {\r\n        if (clip.narration && clip.narration.voiceName) {\r\n          voices.add(clip.narration.voiceName);\r\n        }\r\n      });\r\n      return Array.from(voices);\r\n    },\r\n    // 计算选中的文本内容\r\n    batchEditTextContent() {\r\n      return this.selectedClipIndices\r\n        .map(index => {\r\n          const clip = this.sequence.clips[index];\r\n          return clip.sentence || this.$t('NoTextContent');\r\n        })\r\n        .join('\\n');\r\n    },\r\n    // 预览要删除的项目（最多显示3个）\r\n    previewDeleteItems() {\r\n      return this.selectedClipIndices\r\n        .slice(0, 3)\r\n        .map(index => {\r\n          const clip = this.sequence.clips[index];\r\n          return clip.sentence ? clip.sentence.substring(0, 50) + (clip.sentence.length > 50 ? '...' : '') : this.$t('NoTextContent');\r\n        });\r\n    },\r\n  },\r\n  methods: {\r\n    showToast(message, color = 'success') {\r\n      this.snackbar.message = message;\r\n      this.snackbar.color = color;\r\n      this.snackbar.visible = true;\r\n    },\r\n    async openFileInFolder(filePath) {\r\n      if (!filePath) return;\r\n      const exists = await aardio.isFileExist(filePath);\r\n      if (!exists) {\r\n        this.showToast(this.$t('FileNotExist'), \"error\");\r\n        return;\r\n      }\r\n      await aardio.openFolderAndSelectFile(filePath);\r\n    },\r\n\r\n    async playFile(filePath) {\r\n      if (!filePath) return;\r\n      const exists = await aardio.isFileExist(filePath);\r\n      if (!exists) {\r\n        this.showToast(this.$t('FileNotExist'), \"error\");\r\n        return;\r\n      }\r\n      await aardio.openFile(filePath);\r\n    },\r\n      async loadProjectData(fullName_json) {\r\n      this.projectFullName = fullName_json;\r\n      if (this.projectFullName) {\r\n        this.projectDirectory = this.projectFullName.substring(0, this.projectFullName.lastIndexOf('\\\\'));\r\n        const fileName = this.projectFullName.split('\\\\').pop();\r\n        this.projectName = fileName;\r\n      }\r\n\r\n      const fileData = await aardio.getFileData(this.projectFullName);\r\n\r\n      if (fileData) {\r\n        try {\r\n          const jsonData = JSON.parse(fileData);\r\n          const sequenceData = Array.isArray(jsonData) ? jsonData[0] : jsonData;\r\n\r\n          if (!sequenceData.clips) {\r\n            sequenceData.clips = [];\r\n          }\r\n\r\n          return sequenceData;\r\n        } catch (e) {\r\n          console.error(\"Failed to parse the project file:\", e);\r\n          return getDefaultSequence();\r\n        }\r\n      } else {\r\n        return getDefaultSequence();\r\n      }\r\n    },\r\n      // 处理鼠标按下事件\r\n    handleButtonDown(action, scene) {\r\n      this.activeButton = action;\r\n      // 立即执行一次\r\n      this.executeButtonAction(action, scene);\r\n      // 设置定时器持续执行\r\n      this.buttonInterval = setInterval(() => {\r\n        this.executeButtonAction(action, scene);\r\n      }, 100); // 每100毫秒执行一次\r\n    },\r\n\r\n    // 处理鼠标释放事件\r\n    handleButtonUp() {\r\n      this.activeButton = null;\r\n      if (this.buttonInterval) {\r\n        clearInterval(this.buttonInterval);\r\n        this.buttonInterval = null;\r\n      }\r\n    },\r\n\r\n  // 执行按钮动作\r\n    executeButtonAction(action, scene) {\r\n      const config = this.buttonActions[action];\r\n      if (!config || !scene) return;\r\n\r\n      // 更新场景属性\r\n      scene[config.prop] += config.value;\r\n\r\n      // 对缩放进行限制（可选）\r\n      if (config.prop === 'scale') {\r\n        scene.scale = Math.max(0.01, Math.min(scene.scale, 10)); // 限制在0.01-4之间\r\n      }\r\n\r\n      // 更新缩略图位置\r\n      this.updateThumbnailPosition(scene);\r\n    },\r\n    goHomePage(){\r\n      this.saveProject();\r\n      this.$router.push('/');\r\n    },\r\n    formatTime(seconds) {\r\n      return formatTime(seconds); // 使用导入的工具函数\r\n    },\r\n    getClipDuration(clip) {\r\n      // 1. 优先使用 videoMedia.duration\r\n      if (clip.videoMedia?.duration > 0) {\r\n        return clip.videoMedia.duration;\r\n      }\r\n\r\n      // 2. 其次使用 narration.audioMedia.duration\r\n      if (clip.narration?.audioMedia?.duration > 0) {\r\n        return clip.narration.audioMedia.duration;\r\n      }\r\n\r\n      // 3. 如果 scenes 不为空，则计算总时长\r\n      if (clip.scenes && clip.scenes.length > 0) {\r\n        let clipDuration = 0;\r\n\r\n        for (const scene of clip.scenes) {\r\n          if (scene.type === 'video') {\r\n            const frameCount = scene.frameRange[1] - scene.frameRange[0] + 1;\r\n            clipDuration += frameCount / scene.fps;\r\n          } else {\r\n            clipDuration += scene.proportion;\r\n          }\r\n        }\r\n\r\n        return clipDuration;\r\n      }\r\n\r\n      // 4. 默认返回 0\r\n      return 0;\r\n    },\r\ngetClipDurationStyle(clip) {\r\n  if (!clip || !clip.scenes || clip.scenes.length === 0) {\r\n    return { color: 'white', backgroundColor: 'rgba(169, 169, 169, 0.4)' };\r\n  }\r\n\r\n  let hasRedText = false;\r\n  let hasRedBg = false;\r\n\r\n  const sequenceFps = Math.round(this.sequence.frameRate || 0);\r\n\r\n  for (const scene of clip.scenes) {\r\n    const roundedFps = Math.round(scene.fps || 0);\r\n    const totalClipDuration = clip?.narration?.audioMedia?.duration || 0;\r\n    if (!roundedFps || !sequenceFps || !totalClipDuration) continue;\r\n\r\n    // 🎯 使用帧数计算可用时长误差\r\n    const totalClipFrames = totalClipDuration * sequenceFps;\r\n    const totalProportion = _.sumBy(clip.scenes, 'proportion') || 1;\r\n    const requiredFrames = (scene.proportion / totalProportion) * totalClipFrames;\r\n\r\n    const startFrame = scene.frameRange?.[0] ?? 0;\r\n    const endFrame = scene.frameRange?.[1] ?? 0;\r\n    const actualFrames = (endFrame - startFrame + 1) * (sequenceFps / roundedFps);\r\n\r\n    const lackFrames = requiredFrames - actualFrames;\r\n    const tolerance = 1;\r\n\r\n    // 超出场景最大允许时长 → 红字\r\n    const duration = this.getSceneDuration(clip, scene);\r\n    if (duration >= (this.sequence.durationThreshold || 0)) {\r\n      hasRedText = true;\r\n    }\r\n\r\n    // 实际素材时长不足 → 红背景\r\n    if (lackFrames > tolerance) {\r\n      hasRedBg = true;\r\n    }\r\n\r\n    if (hasRedText && hasRedBg) break;\r\n  }\r\n  // ✅ 每次返回一个新的对象，避免被 Vue 复用或缓存\r\n  return {\r\n  color: hasRedText ? 'red !important' : 'white !important',\r\n  backgroundColor: hasRedBg\r\n    ? 'rgba(255, 0, 0, 0.4) !important'\r\n    : hasRedText\r\n    ? 'rgba(255, 255, 255, 0.4) !important'\r\n    : 'rgba(169, 169, 169, 0.4) !important',\r\n};\r\n},\r\n\r\n    // 计算预览尺寸\r\n    calculatePreviewSize() {\r\n      if (this.sequence.outputSize.width > this.sequence.outputSize.height) {\r\n        // 横屏视频\r\n        this.previewScale = 320 / this.sequence.outputSize.width;\r\n        this.scenePreviewWidth = 320;\r\n        this.scenePreviewHeight = this.sequence.outputSize.height * this.previewScale;\r\n      } else {\r\n        // 竖屏视频\r\n        this.previewScale = 180 / this.sequence.outputSize.height;\r\n        this.scenePreviewHeight = 180;\r\n        this.scenePreviewWidth = this.sequence.outputSize.width * this.previewScale;\r\n      }\r\n\r\n      // 列表项缩略图是场景预览的1/4大小\r\n      this.itemPreviewWidth = this.scenePreviewWidth / 4;\r\n      this.itemPreviewHeight = this.scenePreviewHeight / 4;\r\n    },\r\n    getSceneContentStyle(scene) {\r\n      // 1. 计算图片在预览中的实际显示尺寸（仅考虑预览缩放）\r\n      const previewWidth = scene.width * this.previewScale;\r\n      const previewHeight = scene.height * this.previewScale;\r\n\r\n      // 2. 应用场景缩放比例（这是关键区别！）\r\n      const displayWidth = previewWidth * scene.scale;\r\n      const displayHeight = previewHeight * scene.scale;\r\n\r\n      // 3. 计算锚点在预览容器中的位置（绝对位置）\r\n      const anchorPreviewX = scene.anchorX * this.previewScale;\r\n      const anchorPreviewY = scene.anchorY * this.previewScale;\r\n\r\n      // 4. 计算图片左上角位置（确保锚点成为变换中心）\r\n      const left = anchorPreviewX - (displayWidth / 2);\r\n      const top = anchorPreviewY - (displayHeight / 2);\r\n\r\n      return {\r\n        width: `${displayWidth}px`,\r\n        height: `${displayHeight}px`,\r\n        left: `${left}px`,\r\n        top: `${top}px`,\r\n        transform: scene.horizontalFlip ? 'scaleX(-1)' : 'none'\r\n      };\r\n    },\r\n    getItemContentStyle(scene, scale) {\r\n      if (!scene) {\r\n        return {\r\n          width: '100%',\r\n          height: '100%',\r\n          objectFit: 'cover'\r\n        };\r\n      }\r\n\r\n      // 1. 计算图片在预览中的实际显示尺寸（仅考虑预览缩放）\r\n      const previewWidth = scene.width * this.previewScale * 0.25 * scale; // 1/4大小\r\n      const previewHeight = scene.height * this.previewScale * 0.25 * scale; // 1/4大小\r\n\r\n      // 2. 应用场景缩放比例\r\n      const displayWidth = previewWidth * scene.scale;\r\n      const displayHeight = previewHeight * scene.scale;\r\n\r\n      // 3. 计算锚点在预览容器中的位置（绝对位置）\r\n      const anchorPreviewX = scene.anchorX * this.previewScale * 0.25 * scale;\r\n      const anchorPreviewY = scene.anchorY * this.previewScale * 0.25 * scale;\r\n\r\n      // 4. 计算图片左上角位置（确保锚点成为变换中心）\r\n      const left = anchorPreviewX - (displayWidth / 2);\r\n      const top = anchorPreviewY - (displayHeight / 2);\r\n\r\n      return {\r\n        width: `${displayWidth}px`,\r\n        height: `${displayHeight}px`,\r\n        left: `${left}px`,\r\n        top: `${top}px`,\r\n        position: 'absolute',\r\n        transform: scene.horizontalFlip ? 'scaleX(-1)' : 'none',\r\n        objectFit: 'cover'\r\n      };\r\n    },\r\n        // 更新缩略图位置\r\n    updateThumbnailPosition(scene) {\r\n      // 确保缩放比例有效\r\n      if (!scene.scale || scene.scale <= 0) {\r\n        scene.scale = Math.min(\r\n          this.sequence.outputSize.width / scene.width,\r\n          this.sequence.outputSize.height / scene.height\r\n        );\r\n      }\r\n\r\n      // 确保锚点在合理范围内\r\n      scene.anchorX = Math.max(0, Math.min(scene.anchorX, this.sequence.outputSize.width));\r\n      scene.anchorY = Math.max(0, Math.min(scene.anchorY, this.sequence.outputSize.height));\r\n\r\n      // 触发视图更新\r\n      this.$forceUpdate();\r\n    },\r\n        // 帧数转时间 (格式: HH:MM:SS.FF)\r\n    frameToTime(frame, fps) {\r\n      if (!fps) return '00:00:00.00';\r\n\r\n      // 帧率取整\r\n      const roundedFps = Math.round(fps);\r\n\r\n      const totalSeconds = frame / roundedFps;\r\n      const hours = Math.floor(totalSeconds / 3600);\r\n      const minutes = Math.floor((totalSeconds % 3600) / 60);\r\n      const seconds = Math.floor(totalSeconds % 60);\r\n      const remainingFrames = Math.floor(frame % roundedFps);\r\n\r\n      return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}.${remainingFrames.toString().padStart(2, '0')}`;\r\n    },\r\nframeToTime1(frame, fps) {\r\n  if (!fps) return '00:00:00.00';\r\n\r\n  const roundedFps = Math.round(fps);\r\n\r\n  const totalSeconds = frame / roundedFps;\r\n  const hours = Math.floor(totalSeconds / 3600);\r\n  const minutes = Math.floor((totalSeconds % 3600) / 60);\r\n  const seconds = Math.floor(totalSeconds % 60);\r\n\r\n  // 计算两位毫秒\r\n  const fractionalSeconds = totalSeconds - Math.floor(totalSeconds);\r\n  const milliseconds = Math.floor(fractionalSeconds * 100); // 保留两位\r\n\r\n  return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}.${milliseconds.toString().padStart(2, '0')}`;\r\n},\r\n\r\n        // 计算剩余时间 (返回格式: HH:MM:SS.FF)\r\n    calculateRemainingTime(scene) {\r\n      if (!this.editedClip.narration?.audioMedia?.duration || !scene.fps) {\r\n        return {\r\n          time: '00:00:00.00',\r\n          class: 'time-positive'\r\n        };\r\n      }\r\n\r\n      const roundedFps = Math.round(scene.fps);\r\n      const sequenceFps = Math.round(this.sequence.frameRate);\r\n\r\n      const totalClipFrames = this.editedClip.narration.audioMedia.duration * sequenceFps;\r\n\r\n      const totalProportion = _.sumBy(this.editedClip.scenes, 'proportion');\r\n      const requiredFrames = (scene.proportion / totalProportion) * totalClipFrames;\r\n\r\n      const actualFrames = (scene.frameRange[1] - scene.frameRange[0] + 1) * (sequenceFps / roundedFps);\r\n\r\n      const remainingFrames = actualFrames - requiredFrames;\r\n      const absFrames = Math.abs(remainingFrames);\r\n\r\n      const timeStr = this.frameToTime(absFrames, sequenceFps);\r\n\r\n      // 这里设定一个容差，比如 1 帧\r\n      const tolerance = 1;\r\n\r\n      if (Math.abs(remainingFrames) <= tolerance) {\r\n        // 只要误差在容差范围内，就当作 +00:00:00.00\r\n        return {\r\n          time: `+00:00:00.00`,\r\n          class: 'time-positive'\r\n        };\r\n      }\r\n\r\n      if (remainingFrames > 0) {\r\n        return {\r\n          time: `+${timeStr}`,\r\n          class: 'time-positive'\r\n        };\r\n      } else {\r\n        return {\r\n          time: `-${timeStr}`,\r\n          class: 'time-negative'\r\n        };\r\n      }\r\n    },\r\n\r\n    // 处理帧范围变化的防抖方法\r\n    handleFrameRangeChange(scene) {\r\n\r\n      const now = Date.now();\r\n      const timeDiff = now - this.lastSliderChangeTime;\r\n      this.lastSliderChangeTime = now;\r\n\r\n      // 动态计算防抖时间：滑动越快，防抖时间越长\r\n      let debounceTime = this.defaultDebounceTime;\r\n      if (timeDiff < 100) { // 快速滑动\r\n        debounceTime = this.maxDebounceTime;\r\n      } else if (timeDiff < 300) { // 中速滑动\r\n        debounceTime = this.defaultDebounceTime;\r\n      } else { // 慢速滑动\r\n        debounceTime = this.minDebounceTime;\r\n      }\r\n\r\n      // 清除之前的定时器\r\n      if (this.debounceTimers[scene.fullName]) {\r\n        clearTimeout(this.debounceTimers[scene.fullName]);\r\n      }\r\n\r\n      // 设置新的定时器\r\n      this.debounceTimers[scene.fullName] = setTimeout(() => {\r\n        this.updateSceneFrameRange(scene);\r\n      }, debounceTime);\r\n    },\r\n\r\n    // 更新场景帧范围\r\n    updateSceneFrameRange(scene) {\r\n      this.updateSceneThumbnail(scene);\r\n    },\r\n  // 更新场景缩略图\r\n      async updateSceneThumbnail(scene) {\r\n        if (scene.fullName && scene.type === 'video') {\r\n          console.error('scene:', scene.sourceHex);\r\n          scene.base64Thumbnail = await aardio.getVideoFrameAsResizedBase64(\r\n            scene.fullName,\r\n            scene.fps,\r\n            scene.frameRange[0],\r\n            this.previewScale * scene.width,\r\n            this.previewScale * scene.height,\r\n            scene.sourceRange[0],\r\n            scene.sourceHex\r\n          );\r\n        }\r\n      },\r\n      // 移除场景\r\n      removeScene(index) {\r\n        const clip = this.editedClip; // editedClip 已经是当前 clip 的引用\r\n        if (!clip?.scenes || index < 0 || index >= clip.scenes.length) return;\r\n\r\n        clip.scenes.splice(index, 1);\r\n\r\n        // 调整当前 clip 的 editedSceneIndex（clip 自己维护）\r\n        const cur = clip.editedSceneIndex ?? -1;\r\n\r\n        if (clip.scenes.length === 0) {\r\n          clip.editedSceneIndex = -1; // 没有场景了\r\n        } else if (cur > index) {\r\n          // 被删项在选中项之前，选中项左移一位\r\n          clip.editedSceneIndex = cur - 1;\r\n        } else if (cur === index) {\r\n          // 删除的是当前选中项：尝试选中“同位置的下一个”，否则选上一个\r\n          const newIndex = Math.min(index, clip.scenes.length - 1);\r\n          clip.editedSceneIndex = newIndex;\r\n        }\r\n        // 如果 cur < index，则不需要改动\r\n      },\r\n      // 处理粘贴事件\r\n      async handlePaste() {\r\n        const pbInfo = await aardio.getPasteboardInfo();\r\n        const result = JSON.parse(pbInfo);\r\n\r\n        if (!result.Type) {\r\n          return; // 不是我们想要的粘贴内容\r\n        }\r\n\r\n        const newScene = _.cloneDeep(this.defaultScene);\r\n        newScene.type = result.Type;\r\n        newScene.fullName = result.FullName;\r\n\r\n        if (result.Type === 'video') {\r\n          newScene.width = result.Width;\r\n          newScene.height = result.Height;\r\n          newScene.fps = result.Fps;\r\n          newScene.countFrame = result.CountFrame;\r\n          newScene.sourceRange = [0, result.CountFrame - 1];\r\n          newScene.frameRange = [0, result.CountFrame - 1];\r\n          newScene.sourceHex = '';\r\n          // 获取视频缩略图\r\n          newScene.base64Thumbnail = await aardio.getVideoFrameAsResizedBase64(\r\n            newScene.fullName,\r\n            newScene.fps,\r\n            0,\r\n            this.previewScale * newScene.width,\r\n            this.previewScale * newScene.height,\r\n            newScene.sourceRange[0],\r\n            newScene.sourceHex\r\n          );\r\n        } else if (result.Type === 'image') {\r\n          newScene.width = result.Width;\r\n          newScene.height = result.Height;\r\n          newScene.countFrame = 1;\r\n          newScene.sourceRange = [0, 0];\r\n          newScene.frameRange = [0, 0];\r\n          newScene.sourceHex = '';\r\n\r\n          newScene.base64Thumbnail = await aardio.getImageAsResizedBase64(\r\n            newScene.fullName,\r\n            this.previewScale * newScene.width,\r\n            this.previewScale * newScene.height\r\n          );\r\n        }\r\n\r\n        // 智能调整场景参数\r\n        if (this.sequence.smartAdjust) {\r\n          const matchedScene = this.findMatchingScene(newScene);\r\n          if (matchedScene) {\r\n            // 复制匹配场景的参数\r\n            newScene.scale = matchedScene.scale;\r\n            newScene.anchorX = matchedScene.anchorX;\r\n            newScene.anchorY = matchedScene.anchorY;\r\n            newScene.horizontalFlip = matchedScene.horizontalFlip;\r\n            newScene.upend = matchedScene.upend;\r\n            newScene.growFrame = matchedScene.growFrame;\r\n          } else {\r\n            // 没有找到匹配场景，使用默认计算\r\n            newScene.scale = Math.min(\r\n              this.sequence.outputSize.width / newScene.width,\r\n              this.sequence.outputSize.height / newScene.height\r\n            );\r\n            newScene.anchorX = this.sequence.outputSize.width / 2;\r\n            newScene.anchorY = this.sequence.outputSize.height / 2;\r\n            newScene.growFrame = true;\r\n          }\r\n        } else {\r\n          // 不使用智能调整，使用默认计算\r\n          newScene.scale = Math.min(\r\n            this.sequence.outputSize.width / newScene.width,\r\n            this.sequence.outputSize.height / newScene.height\r\n          );\r\n          newScene.anchorX = this.sequence.outputSize.width / 2;\r\n          newScene.anchorY = this.sequence.outputSize.height / 2;\r\n        }\r\n\r\n        // 添加到场景列表\r\n        this.editedClip.scenes.push(newScene);\r\n        this.selectScene(this.editedClip.scenes.length - 1);\r\n      },\r\n      // 替换指定索引的场景\r\n      async replaceSceneWithPaste(index) {\r\n        if (\r\n          index == null ||\r\n          index < 0 ||\r\n          index >= this.editedClip.scenes.length\r\n        ) {\r\n          console.warn('invalid scene index:', index);\r\n          return;\r\n        }\r\n\r\n        const pbInfo = await aardio.getPasteboardInfo();\r\n        const result = JSON.parse(pbInfo);\r\n\r\n        if (!result.Type) {\r\n          return; // 不是我们想要的粘贴内容\r\n        }\r\n\r\n        const newScene = _.cloneDeep(this.defaultScene);\r\n        newScene.type = result.Type;\r\n        newScene.fullName = result.FullName;\r\n\r\n        if (result.Type === 'video') {\r\n          newScene.width = result.Width;\r\n          newScene.height = result.Height;\r\n          newScene.fps = result.Fps;\r\n          newScene.countFrame = result.CountFrame;\r\n          newScene.sourceRange = [0, result.CountFrame - 1];\r\n          newScene.frameRange = [0, result.CountFrame - 1];\r\n          newScene.sourceHex = '';\r\n\r\n          // 获取视频缩略图\r\n          newScene.base64Thumbnail = await aardio.getVideoFrameAsResizedBase64(\r\n            newScene.fullName,\r\n            newScene.fps,\r\n            0,\r\n            this.previewScale * newScene.width,\r\n            this.previewScale * newScene.height,\r\n            newScene.sourceRange[0],\r\n            newScene.sourceHex\r\n          );\r\n        } else if (result.Type === 'image') {\r\n          newScene.width = result.Width;\r\n          newScene.height = result.Height;\r\n          newScene.countFrame = 1;\r\n          newScene.sourceRange = [0, 0];\r\n          newScene.frameRange = [0, 0];\r\n          newScene.sourceHex = '';\r\n\r\n          newScene.base64Thumbnail = await aardio.getImageAsResizedBase64(\r\n            newScene.fullName,\r\n            this.previewScale * newScene.width,\r\n            this.previewScale * newScene.height\r\n          );\r\n        }\r\n\r\n        // 智能调整场景参数\r\n        if (this.sequence.smartAdjust) {\r\n          // 尝试从当前场景复制参数\r\n          const currentScene = this.editedClip.scenes[index];\r\n          if (currentScene) {\r\n            newScene.scale = currentScene.scale;\r\n            newScene.anchorX = currentScene.anchorX;\r\n            newScene.anchorY = currentScene.anchorY;\r\n            newScene.horizontalFlip = currentScene.horizontalFlip;\r\n            newScene.upend = currentScene.upend;\r\n          } else {\r\n            // 使用默认计算\r\n            newScene.scale = Math.min(\r\n              this.sequence.outputSize.width / newScene.width,\r\n              this.sequence.outputSize.height / newScene.height\r\n            );\r\n            newScene.anchorX = this.sequence.outputSize.width / 2;\r\n            newScene.anchorY = this.sequence.outputSize.height / 2;\r\n          }\r\n        } else {\r\n          // 不使用智能调整，使用默认计算\r\n          newScene.scale = Math.min(\r\n            this.sequence.outputSize.width / newScene.width,\r\n            this.sequence.outputSize.height / newScene.height\r\n          );\r\n          newScene.anchorX = this.sequence.outputSize.width / 2;\r\n          newScene.anchorY = this.sequence.outputSize.height / 2;\r\n        }\r\n\r\n        newScene.proportion = this.editedClip.scenes[index].proportion;\r\n        // 替换场景\r\n        this.editedClip.scenes.splice(index, 1, newScene);\r\n      },\r\n      // 查找匹配的场景\r\n      findMatchingScene(newScene) {\r\n        // 1. 首先在当前clip的scenes中查找\r\n        const currentClipIndex = this.sequence.selectedIndex;\r\n        const currentClip = currentClipIndex >= 0 ? this.sequence.clips[currentClipIndex] : null;\r\n        const currentScenes = currentClip ? currentClip.scenes : [];\r\n\r\n        // 查找顺序: 当前clip中前面的场景 -> 后面的场景\r\n        let matchedScene = this.findInCurrentClipScenes(newScene, currentScenes);\r\n        if (matchedScene) return matchedScene;\r\n\r\n        // 2. 然后在其他clip中查找\r\n        // 先查找前面的clip(从近到远)\r\n        for (let i = currentClipIndex - 1; i >= 0; i--) {\r\n          matchedScene = this.findInClipScenes(newScene, this.sequence.clips[i].scenes);\r\n          if (matchedScene) return matchedScene;\r\n        }\r\n\r\n        // 再查找后面的clip(从近到远)\r\n        for (let i = currentClipIndex + 1; i < this.sequence.clips.length; i++) {\r\n          matchedScene = this.findInClipScenes(newScene, this.sequence.clips[i].scenes);\r\n          if (matchedScene) return matchedScene;\r\n        }\r\n\r\n        // 3. 如果还没有找到，放宽条件：只匹配width和height\r\n        matchedScene = this.findInCurrentClipScenes(newScene, currentScenes, false);\r\n        if (matchedScene) return matchedScene;\r\n\r\n        for (let i = currentClipIndex - 1; i >= 0; i--) {\r\n          matchedScene = this.findInClipScenes(newScene, this.sequence.clips[i].scenes, false);\r\n          if (matchedScene) return matchedScene;\r\n        }\r\n\r\n        for (let i = currentClipIndex + 1; i < this.sequence.clips.length; i++) {\r\n          matchedScene = this.findInClipScenes(newScene, this.sequence.clips[i].scenes, false);\r\n          if (matchedScene) return matchedScene;\r\n        }\r\n\r\n        return null;\r\n      },\r\n\r\n      // 在当前clip的场景中查找匹配项\r\n      findInCurrentClipScenes(newScene, scenes, matchType = true) {\r\n        const newSceneIndex = this.editedClip.scenes.length; // 新场景将添加到的索引\r\n\r\n        // 先向前查找\r\n        for (let i = newSceneIndex - 1; i >= 0; i--) {\r\n          const scene = scenes[i];\r\n          if (this.isSceneMatch(newScene, scene, matchType)) {\r\n            return scene;\r\n          }\r\n        }\r\n\r\n        // 再向后查找\r\n        for (let i = newSceneIndex; i < scenes.length; i++) {\r\n          const scene = scenes[i];\r\n          if (this.isSceneMatch(newScene, scene, matchType)) {\r\n            return scene;\r\n          }\r\n        }\r\n\r\n        return null;\r\n      },\r\n\r\n      // 在指定clip的场景中查找匹配项\r\n      findInClipScenes(newScene, scenes, matchType = true) {\r\n        for (const scene of scenes) {\r\n          if (this.isSceneMatch(newScene, scene, matchType)) {\r\n            return scene;\r\n          }\r\n        }\r\n        return null;\r\n      },\r\n\r\n      // 判断场景是否匹配\r\n      isSceneMatch(newScene, scene, matchType = true) {\r\n        if (!scene) return false;\r\n\r\n        // 检查宽度和高度是否匹配\r\n        const sizeMatch = scene.width === newScene.width && scene.height === newScene.height;\r\n        if (!sizeMatch) return false;\r\n\r\n        // 如果要求类型匹配，则检查类型\r\n        if (matchType) {\r\n          return scene.type === newScene.type;\r\n        }\r\n\r\n        return true;\r\n      },\r\n\r\n    // 触发粘贴操作\r\n    triggerPaste() {\r\n      //this.handlePaste();\r\n    },\r\n\r\n    // 初始化下拉框\r\n    initializeComboboxes() {\r\n      if (!this.editedClip.narration.locale && this.list_language_cn.length > 0) {\r\n        this.editedClip.narration.locale = this.list_language_cn[0].locale;\r\n      }\r\n      this.updateVoiceItems();\r\n    },\r\n\r\n    // 语言变更处理\r\n    onEditedClipLanguageChange() {\r\n      this.updateVoiceItems();\r\n    },\r\n\r\n    // 更新语音列表\r\n    updateVoiceItems() {\r\n      const locale = this.list_language_cn.find(lang => lang.locale === this.editedClip.narration.locale)?.locale;\r\n      if (locale) {\r\n        const voices = this.list_voice_edge;\r\n        this.voiceItems = voices.filter(voice => voice.lang === locale).map(voice => voice.name.split(\" \")[1]);\r\n        if (!this.voiceItems.includes(this.editedClip.narration.voiceName)) {\r\n          this.editedClip.narration.voiceName = this.voiceItems[0] || '';\r\n        }\r\n      } else {\r\n        this.voiceItems = [];\r\n        this.editedClip.narration.voiceName = '';\r\n      }\r\n    },\r\n\r\n    // 新clip语言变更处理\r\n    onNewClipLanguageChange() {\r\n      const locale = this.list_language_cn.find(lang =>\r\n        lang.locale === this.newClip.narration.locale)?.locale;\r\n      if (locale) {\r\n        const voices = this.list_voice_edge;\r\n        this.newClipVoiceItems = voices.filter(voice => voice.lang === locale).map(voice => voice.name.split(\" \")[1]);\r\n        if (!this.newClipVoiceItems.includes(this.newClip.narration.voiceName)) {\r\n          this.newClip.narration.voiceName = this.newClipVoiceItems[0] || '';\r\n        }\r\n      } else {\r\n        this.newClipVoiceItems = [];\r\n        this.newClip.narration.voiceName = '';\r\n      }\r\n    },\r\n\r\n    // 项目操作\r\n    async openProjectPicker() {\r\n      const fullName_json = await aardio.openProject();\r\n      if (fullName_json) {\r\n        await this.openProject(fullName_json);\r\n      }\r\n    },\r\n\r\n    async openProject(fullName_json) {\r\n      this.projectFullName = fullName_json;\r\n      if (this.projectFullName) {\r\n        this.projectDirectory = this.projectFullName.substring(0, this.projectFullName.lastIndexOf('\\\\'));\r\n        const fileName = this.projectFullName.split('\\\\').pop();\r\n        this.projectName = fileName;\r\n      }\r\n      const fileData = await aardio.getFileData(this.projectFullName);\r\n\r\n      if (fileData) {\r\n        try {\r\n          const jsonData = JSON.parse(fileData);\r\n          this.sequence = Array.isArray(jsonData) ? jsonData[0] : jsonData;\r\n\r\n          if (!this.sequence.clips) {\r\n            this.sequence.clips = [];\r\n          }\r\n\r\n          if (this.sequence.clips.length > this.sequence.selectedIndex) {\r\n            this.selectClip(this.sequence.selectedIndex);\r\n          } else {\r\n            this.sequence.selectedIndex = -1;\r\n          }\r\n        } catch (e) {\r\n          console.error(\"Failed to parse the project file:\", e);\r\n          this.resetProject();\r\n        }\r\n      } else {\r\n        this.resetProject();\r\n      }\r\n    },\r\n\r\n    // 重置项目\r\n    resetProject() {\r\n      this.sequence = {\r\n        ...this.sequence,\r\n        clips: [],\r\n        selectedIndex: -1\r\n      };\r\n      this.resetEditedClip();\r\n    },\r\n\r\n    async saveProject() {\r\n      if (this.projectFullName) {\r\n        const dataToSave = JSON.stringify(this.sequence, null, 2);\r\n        await aardio.saveTextFile(dataToSave, this.projectFullName);\r\n      }\r\n    },\r\n    async saveProjectClick() {\r\n      await this.saveProject();\r\n      this.showToast(this.$t('saveSuccessToast'), 'success');\r\n    },\r\n\r\n    // 选择片段\r\n    selectClip(index) {\r\n      if (index >= 0 && index < this.sequence.clips.length) {\r\n        this.isPlaying = false;\r\n        this.sequence.selectedIndex = index;\r\n\r\n        // 不再 cloneDeep，editedClip 会自动根据 computed 指向目标 clip\r\n        if (this.editedClip.narration?.locale) {\r\n          this.onEditedClipLanguageChange();\r\n        }\r\n      } else {\r\n        this.resetEditedClip();\r\n      }\r\n    },\r\n\r\n    // 重置编辑表单\r\n    resetEditedClip() {\r\n      this.editedClip = getDefaultClip();\r\n      this.editedClip.scenes = [];\r\n    },\r\n\r\n    // 编辑片段\r\n    editClip(index) {\r\n      this.selectClip(index);\r\n    },\r\n\r\n    // 删除片段\r\n    deleteClip(index) {\r\n      this.sequence.clips.splice(index, 1);\r\n\r\n      // 更新选中索引\r\n      if (this.sequence.clips.length === 0) {\r\n        // 如果没有clip了，重置选中索引为-1\r\n        this.sequence.selectedIndex = -1;\r\n      } else if (this.sequence.selectedIndex >= index) {\r\n        this.sequence.selectedIndex = Math.max(0, this.sequence.selectedIndex - 1);\r\n      }\r\n\r\n      // 更新选中状态\r\n      this.selectedClipIndices = this.selectedClipIndices\r\n        .filter(i => i !== index)\r\n        .map(i => i > index ? i - 1 : i);\r\n    },\r\n\r\n    // 删除当前\r\n    deleteCurrent() {\r\n      if (this.sequence.selectedIndex >= 0) {\r\n        this.deleteClip(this.sequence.selectedIndex);\r\n      }\r\n    },\r\n\r\n    // 批量操作\r\n    // 显示删除确认对话框\r\n    showDeleteConfirm() {\r\n      if (this.selectedClipIndices.length === 0) return;\r\n      this.deleteConfirmDialog = true;\r\n    },\r\n\r\n    // 确认批量删除\r\n    confirmBatchDelete() {\r\n      // 从大到小排序索引，避免删除时索引变化\r\n      const indicesToDelete = [...this.selectedClipIndices].sort((a, b) => b - a);\r\n\r\n      indicesToDelete.forEach(index => {\r\n        this.sequence.clips.splice(index, 1);\r\n      });\r\n\r\n      // 更新选中索引 - 添加检查是否没有clip了\r\n      if (this.sequence.clips.length === 0) {\r\n        this.sequence.selectedIndex = -1;\r\n      } else if (this.selectedClipIndices.includes(this.sequence.selectedIndex)) {\r\n        this.sequence.selectedIndex = Math.max(0, Math.min(this.sequence.selectedIndex, this.sequence.clips.length - 1));\r\n      }\r\n\r\n      // 清空选中状态\r\n      this.selectedClipIndices = [];\r\n      this.saveProject();\r\n\r\n      // 关闭对话框\r\n      this.deleteConfirmDialog = false;\r\n    },\r\n\r\n    // 原来的batchDelete方法可以删除或保留作为别名\r\n    batchDelete() {\r\n      this.showDeleteConfirm();\r\n    },\r\n    // 批量编辑方法\r\n    batchEdit() {\r\n      if (this.selectedClipIndices.length === 0) return;\r\n\r\n      // 获取第一个选中clip的参数作为初始值\r\n      const firstClip = this.sequence.clips[this.selectedClipIndices[0]];\r\n      this.batchEditParams = {\r\n        rate: firstClip.narration.rate,\r\n        speed: firstClip.narration.speed,\r\n        pauseBefore: firstClip.narration.pauseBefore,\r\n        pauseAfter: firstClip.narration.pauseAfter,\r\n        locale: firstClip.narration.locale,\r\n        voiceName: firstClip.narration.voiceName\r\n      };\r\n\r\n      // 更新语音选项\r\n      this.onBatchEditLanguageChange();\r\n\r\n      // 生成参数预设\r\n      this.generateParameterPresets();\r\n\r\n      // 打开对话框\r\n      this.batchEditDialog = true;\r\n    },\r\n\r\n    // 批量编辑语言变更处理\r\n    onBatchEditLanguageChange() {\r\n      const locale = this.list_language_cn.find(lang =>\r\n        lang.locale === this.batchEditParams.locale)?.locale;\r\n      if (locale) {\r\n        const voices = this.list_voice_edge;\r\n        this.batchEditVoiceItems = voices\r\n          .filter(voice => voice.lang === locale)\r\n          .map(voice => voice.name.split(\" \")[1]);\r\n\r\n        if (!this.batchEditVoiceItems.includes(this.batchEditParams.voiceName)) {\r\n          this.batchEditParams.voiceName = this.batchEditVoiceItems[0] || '';\r\n        }\r\n      } else {\r\n        this.batchEditVoiceItems = [];\r\n        this.batchEditParams.voiceName = '';\r\n      }\r\n    },\r\n\r\n    // 生成参数预设\r\n    generateParameterPresets() {\r\n      const uniqueParams = new Map();\r\n      this.sequence.clips.forEach((clip) => {\r\n        if (!clip?.narration) return;\r\n        const key = JSON.stringify({\r\n          rate: clip.narration.rate,\r\n          speed: clip.narration.speed,\r\n          pauseBefore: clip.narration.pauseBefore,\r\n          pauseAfter: clip.narration.pauseAfter,\r\n          voiceName: clip.narration.voiceName\r\n        });\r\n        if (!uniqueParams.has(key)) {\r\n          uniqueParams.set(key, {\r\n            rate: clip.narration.rate,\r\n            speed: clip.narration.speed,\r\n            pauseBefore: clip.narration.pauseBefore,\r\n            pauseAfter: clip.narration.pauseAfter,\r\n            locale: clip.narration.locale,\r\n            voiceName: clip.narration.voiceName\r\n          });\r\n        }\r\n      });\r\n\r\n      this.parameterPresets = Array.from(uniqueParams.values()).map((params, index) => ({\r\n        value: index,\r\n        title: `${params.voiceName}___Rate${params.rate}`,\r\n        params\r\n      }));\r\n\r\n      if (this.parameterPresets.length > 0) {\r\n        //this.selectedPreset = this.parameterPresets[0];\r\n      }\r\n    },\r\n\r\n    // 应用预设\r\n\r\n    applyPreset(preset) {\r\n      if (preset?.params) {\r\n        this.batchEditParams = { ...preset.params };\r\n        this.onBatchEditLanguageChange();\r\n      }\r\n    },\r\n\r\n    // 应用批量编辑\r\n    applyBatchEdit() {\r\n      this.selectedClipIndices.forEach(index => {\r\n        const clip = this.sequence.clips[index];\r\n\r\n        // 更新参数\r\n        clip.narration.rate = this.batchEditParams.rate;\r\n        clip.narration.speed = this.batchEditParams.speed;\r\n        clip.narration.pauseBefore = this.batchEditParams.pauseBefore;\r\n        clip.narration.pauseAfter = this.batchEditParams.pauseAfter;\r\n        clip.narration.locale = this.batchEditParams.locale;\r\n        clip.narration.voiceName = this.batchEditParams.voiceName;\r\n\r\n        if(this.clearAudioMedia){\r\n          clip.narration.audioMedia.filePath = '';\r\n          clip.narration.audioMedia.duration = 0;\r\n        }\r\n        if(this.clearVideoMedia){\r\n          clip.videoMedia.filePath = '';\r\n          clip.videoMedia.duration = 0;\r\n        }\r\n\r\n        // 如果正在编辑当前clip，更新编辑表单\r\n        if (index === this.sequence.selectedIndex) {\r\n          this.editedClip.narration = { ...clip.narration };\r\n        }\r\n      });\r\n\r\n      this.saveProject();\r\n      this.batchEditDialog = false;\r\n    },\r\n\r\n    // 导航\r\n    prevItem() {\r\n      if (this.sequence.selectedIndex > 0) {\r\n        this.selectClip(this.sequence.selectedIndex - 1);\r\n      }\r\n    },\r\n\r\n    nextItem() {\r\n      if (this.sequence.selectedIndex < this.sequence.clips.length - 1) {\r\n        this.selectClip(this.sequence.selectedIndex + 1);\r\n      }\r\n    },\r\n    // 打开添加对话框\r\n    addItem() {\r\n      // 继承当前选中clip的narration设置\r\n      if (this.sequence.selectedIndex >= 0 && this.sequence.clips.length > 0) {\r\n        const currentClip = this.sequence.clips[this.sequence.selectedIndex];\r\n        Object.keys(currentClip.narration).forEach(key => {\r\n          const value = currentClip.narration[key];\r\n          if (value !== null && value !== undefined && value !== '') {\r\n            this.newClip.narration[key] = _.cloneDeep(value);\r\n          }\r\n        });\r\n        this.newClip.narration.audioMedia.filePath = '';\r\n        this.newClip.narration.audioMedia.duration = 0;\r\n      }else{\r\n        this.newClip.narration.locale = this.list_language_cn[0].locale;\r\n      }\r\n      this.onNewClipLanguageChange();\r\n      this.addDialog = true;\r\n    },\r\n\r\n    // 确认添加clip\r\n    confirmAddClip() {\r\n      if (!this.autoSplitSentences || !this.newClip.sentence?.trim()) {\r\n        this.addSingleClip();\r\n      } else {\r\n        this.splitAndAddClips();\r\n      }\r\n      this.saveProject();\r\n      this.addDialog = false;\r\n    },\r\n\r\n    // 添加单个clip\r\n    addSingleClip() {\r\n      const insertIndex = this.getInsertIndex();\r\n\r\n      this.sequence.clips.splice(insertIndex, 0, _.cloneDeep(this.newClip));\r\n      this.selectClip(insertIndex);\r\n      this.resetNewClip();\r\n    },\r\n\r\n    // 分割并添加多个clip\r\n    splitAndAddClips() {\r\n      const sentences = splitSentences(this.newClip.sentence);\r\n      const comments1 = this.autoSplitSentences\r\n        ? splitSentences(this.newClip.comment1)\r\n        : [this.newClip.comment1 || ''];\r\n      const comments2 = this.autoSplitSentences\r\n        ? splitSentences(this.newClip.comment2)\r\n        : [this.newClip.comment2 || ''];\r\n\r\n      // ⭐ 用统一方法\r\n      const insertIndex = this.getInsertIndex();\r\n\r\n      const newClips = sentences.map((sentence, index) => {\r\n        const clip = _.cloneDeep(this.newClip);\r\n        clip.sentence = sentence;\r\n        clip.comment1 = comments1[index % comments1.length] || '';\r\n        clip.comment2 = comments2[index % comments2.length] || '';\r\n        return clip;\r\n      });\r\n\r\n      if (newClips.length > 0) {\r\n        this.sequence.clips.splice(insertIndex, 0, ...newClips);\r\n        this.selectClip(insertIndex);\r\n      }\r\n\r\n      this.resetNewClip();\r\n    },\r\n\r\n\r\n      // 重置新clip表单\r\n      resetNewClip() {\r\n        this.newClip = getDefaultClip();\r\n        this.autoSplitSentences = true;\r\n        this.insertClipMode = 'appendClip';\r\n      },\r\n\r\n      getInsertIndex() {\r\n        const selectedIndex = this.sequence.selectedIndex;\r\n\r\n        // 没选中 → 默认加到最后\r\n        if (selectedIndex < 0) {\r\n          return this.sequence.clips.length;\r\n        }\r\n\r\n        // 根据模式决定\r\n        if (this.insertClipMode === 'insertClip') {\r\n          return selectedIndex;       // 👉 插入到当前前面\r\n        } else {\r\n          return selectedIndex + 1;   // 👉 插入到当前后面\r\n        }\r\n      },\r\n      withTimeout(promise, ms, onTimeout) {\r\n        return new Promise((resolve, reject) => {\r\n          const timer = setTimeout(() => {\r\n            if (onTimeout) onTimeout();\r\n            reject(new Error(\"TIMEOUT\"));\r\n          }, ms);\r\n\r\n          promise\r\n            .then((res) => {\r\n              clearTimeout(timer);\r\n              resolve(res);\r\n            })\r\n            .catch((err) => {\r\n              clearTimeout(timer);\r\n              reject(err);\r\n            });\r\n        });\r\n      },\r\n      async handleCancelBatchAudio() {\r\n        this.cancelBatchAudioGeneration = true;\r\n\r\n        // 强制打断当前任务\r\n        this.synth.cancel();\r\n        await aardio.stopRecord();\r\n      },\r\n      estimateSpeechDuration(text, rate = 1) {\r\n        if (!text) return 0;\r\n\r\n        // 判断是否主要是中文\r\n        const chineseChars = text.match(/[\\u4e00-\\u9fa5]/g)?.length || 0;\r\n        const totalChars = text.length;\r\n\r\n        let duration = 0;\r\n\r\n        if (chineseChars / totalChars > 0.5) {\r\n          // 中文：按 5字/秒\r\n          duration = totalChars / 5;\r\n        } else {\r\n          // 英文：按 160 wpm ≈ 2.7 words/sec\r\n          const words = text.trim().split(/\\s+/).length;\r\n          duration = words / 2.7;\r\n        }\r\n\r\n        // 标点增加停顿（经验值）\r\n        const punctuation = (text.match(/[,.!?，。！？]/g) || []).length;\r\n        duration += punctuation * 0.2;\r\n\r\n        // 应用语速\r\n        duration = duration / rate;\r\n\r\n        return duration; // 秒\r\n      },\r\n      async batchGenerateVideo() {\r\n\r\n        // 开始批量生成\r\n        this.isBatchGeneratingVideo = true;\r\n        this.cancelBatchVideoGeneration = false;\r\n        this.batchVideoGenerationProgress = 0;\r\n        this.totalBatchVideoCount = this.selectedClipIndices.length;\r\n        this.currentBatchVideoIndex = 0;\r\n\r\n        const dir_video = this.projectDirectory + '\\\\' + this.folder_video;\r\n        const dir_buff = this.projectDirectory + '\\\\' + this.folder_buff;\r\n\r\n        try {\r\n          // 创建必要的目录\r\n          await aardio.createDir(dir_video, false);\r\n\r\n          // 按顺序处理每个选中的clip\r\n          for (let i = 0; i < this.selectedClipIndices.length; i++) {\r\n            if (this.cancelBatchVideoGeneration) {\r\n              break;\r\n            }\r\n\r\n            // 更新当前处理索引\r\n            this.currentBatchVideoIndex = this.selectedClipIndices[i];\r\n            const clipIndex = this.selectedClipIndices[i];\r\n            const clip = this.sequence.clips[clipIndex];\r\n\r\n            // 检查clip是否有效\r\n            if (!clip || (!clip.sentence && (!clip.scenes || clip.scenes.length === 0))) {\r\n              console.warn(`Skip invalid clip (index: ${clipIndex})`);\r\n              continue;\r\n            }\r\n\r\n            try {\r\n\r\n              // 如果音频不存在，先生成音频\r\n              if (!clip.narration.audioMedia.duration || clip.narration.audioMedia.duration === 0) {\r\n                const dir_audio = this.projectDirectory + '\\\\' + this.folder_audio;\r\n                await aardio.createDir(dir_audio, false);\r\n\r\n                const audioName = await this.getMediaName(dir_audio, clipIndex, clip.sentence, 'wav');\r\n                const fullname_audio_output = dir_audio + '\\\\' + audioName + '.wav';\r\n\r\n                try {\r\n                  // 确保临时目录存在且为空\r\n                  await aardio.createDir(dir_buff, true);\r\n                  const estimated = this.estimateSpeechDuration(clip.sentence, clip.narration.rate);\r\n                  // 给 2 倍冗余，防止误差\r\n                  const timeout = Math.max(estimated * 2000, 5000);\r\n                  await this.withTimeout(\r\n                    this.recordAudio(clip, dir_buff, fullname_audio_output, timeout),\r\n                    timeout, \r\n                    () => {\r\n                      console.warn(\"TTS 超时，强制中断\");\r\n\r\n                      this.synth.cancel();        // 停止语音\r\n                      aardio.stopRecord();        // 停止录音\r\n                    }\r\n                  );\r\n                } catch (error) {\r\n                  if (error.message !== 'CANCELLED') {\r\n                    console.error('Error generating audio:', error);\r\n                  }\r\n                } finally {\r\n                  await aardio.deleteDir(dir_buff);\r\n                }\r\n\r\n                // 检查音频是否成功生成\r\n                if (!clip.narration.audioMedia.duration || clip.narration.audioMedia.duration === 0) {\r\n                  console.warn(`Error generating audio, skip clip (index: ${clipIndex})`);\r\n                  continue;\r\n                }\r\n              }\r\n\r\n              // 生成视频\r\n              await this.generateVideo(clipIndex, clip, dir_video);\r\n\r\n              // 更新当前编辑的clip（如果正在编辑）\r\n              if (this.sequence.selectedIndex === clipIndex) {\r\n                this.editedClip.videoMedia = {...clip.videoMedia};\r\n              }\r\n\r\n            } catch (error) {\r\n              console.error(`Error generating video ${i + 1}:`, error);\r\n              this.showToast(`Failed to generate video ${i + 1}: ${error.message}`, 'error');\r\n            } finally {\r\n              // 清理临时目录\r\n\r\n              // 更新进度（无论成功或失败）\r\n              this.batchVideoGenerationProgress = Math.round(((i + 1) / this.selectedClipIndices.length) * 100);\r\n            }\r\n          }\r\n\r\n        } catch (error) {\r\n          console.error('Batch video generation error:', error);\r\n        } finally {\r\n          // 最终清理\r\n          try {\r\n            await aardio.deleteDir(dir_buff);\r\n          } catch (cleanupError) {\r\n            console.error('Final cleanup of temporary directory failed:', cleanupError);\r\n          }\r\n          this.saveProject();\r\n          this.isBatchGeneratingVideo = false;\r\n          this.cancelBatchVideoGeneration = false;\r\n        }\r\n      },\r\n      async generateVideo(clipIndex, clip, dir_video){\r\n\r\n        const dir_buff = this.projectDirectory+'\\\\'+this.folder_buff;\r\n        await aardio.createDir(dir_buff, true);\r\n\r\n        const videoName = await this.getMediaName(dir_video, clipIndex, clip.sentence, 'mp4');\r\n        const fullname_video_output = dir_video+'\\\\'+videoName+'.mp4';\r\n\r\n        // 创建副本并将 base64Thumbnail 设置为空字符串\r\n        const clipForProcessing = JSON.parse(JSON.stringify(clip));\r\n        clipForProcessing.scenes.forEach(scene => {\r\n            scene.base64Thumbnail = \"\"; // 设置为空字符串\r\n        });\r\n\r\n        const jsonString = JSON.stringify(clipForProcessing, null, 2);\r\n        const fullName_clip = dir_buff+'\\\\clip.json';\r\n        await aardio.saveTextFile(jsonString, fullName_clip);\r\n        await aardio.clipToH264Video(this.sequence.frameRate,\r\n          this.sequence.outputSize.width,\r\n          this.sequence.outputSize.height,\r\n          0,\r\n          0,\r\n          0,\r\n          fullName_clip,\r\n          fullname_video_output,\r\n          dir_buff\r\n        );\r\n        const isFileExist = await aardio.isFileExist(fullname_video_output);\r\n        if(isFileExist){\r\n          clip.videoMedia.filePath = fullname_video_output;\r\n          const videoInfo = await aardio.getVideoInfo(fullname_video_output);\r\n          const j_videoInfo = JSON.parse(videoInfo);\r\n          clip.videoMedia.duration = j_videoInfo.Duration;\r\n        }\r\n      },\r\n      // 批量生成音频方法\r\n      async batchGenerateAudio() {\r\n\r\n        // 开始批量生成\r\n        this.isBatchGeneratingAudio = true;\r\n        this.cancelBatchAudioGeneration = false;\r\n        this.batchAudioGenerationProgress = 0;\r\n        this.totalBatchAudioCount = this.selectedClipIndices.length;\r\n        this.currentBatchAudioIndex = 0;\r\n\r\n        const dir_audio = this.projectDirectory + '\\\\' + this.folder_audio;\r\n        await aardio.createDir(dir_audio, false);\r\n\r\n        const dir_buff = this.projectDirectory + '\\\\' + this.folder_buff;\r\n\r\n        try {\r\n          // 按顺序处理每个选中的clip\r\n          for (let i = 0; i < this.selectedClipIndices.length; i++) {\r\n            if (this.cancelBatchAudioGeneration) {\r\n              break; // 如果取消则退出循环\r\n            }\r\n\r\n            await aardio.createDir(dir_buff, true);\r\n\r\n            \r\n            this.currentBatchAudioIndex = this.selectedClipIndices[i];\r\n            const clipIndex = this.selectedClipIndices[i];\r\n            const clip = this.sequence.clips[clipIndex];\r\n            if (!clip.sentence || clip.sentence.trim() === \"\") {\r\n              continue;\r\n            }\r\n            const audioName = await this.getMediaName(dir_audio, clipIndex, clip.sentence, 'wav');\r\n            const fullname_audio_output = dir_audio + '\\\\' + audioName + '.wav';\r\n\r\n            try {\r\n              const estimated = this.estimateSpeechDuration(clip.sentence, clip.narration.rate);\r\n              // 给 2 倍冗余，防止误差\r\n              const timeout = Math.max(estimated * 2000, 5000);\r\n              await this.withTimeout(\r\n                this.recordAudio(clip, dir_buff, fullname_audio_output, timeout),\r\n                timeout, \r\n                () => {\r\n                  console.warn(\"TTS 超时，强制中断\");\r\n\r\n                  this.synth.cancel();        // 停止语音\r\n                  aardio.stopRecord();        // 停止录音\r\n                }\r\n              );\r\n              if(this.sequence.selectedIndex==clipIndex){\r\n                this.editedClip.narration.audioMedia = clip.narration.audioMedia;\r\n              }\r\n              // 成功完成后更新进度\r\n              this.batchAudioGenerationProgress = Math.round(((i + 1) / this.selectedClipIndices.length) * 100);\r\n              //保存项目\r\n              this.saveProject();\r\n\r\n            } catch (error) {\r\n              if (error.message !== 'CANCELLED') {\r\n                console.error(`Error generating audio ${i + 1}:`, error);\r\n              } else {\r\n                break; // 如果取消则退出循环\r\n              }\r\n            }finally {\r\n              // 立即清理当前clip的临时目录\r\n              await aardio.deleteDir(dir_buff);\r\n            }\r\n\r\n          }\r\n\r\n        } catch (error) {\r\n          console.error('Batch audio generation error:', error);\r\n        } finally {\r\n          // 确保最终停止所有录音\r\n          await aardio.stopRecord();\r\n          if (this.synth.speaking) {\r\n            this.synth.cancel();\r\n          }\r\n          await aardio.deleteDir(dir_buff);\r\n          this.isBatchGeneratingAudio = false;\r\n        }\r\n      },\r\n      async generateAudio_click(clip){\r\n        if (this.isGeneratingAudio) {\r\n          // 如果正在生成，点击则取消\r\n          this.cancelAudioGeneration = true;\r\n          if (this.currentUtterance) {\r\n            this.synth.cancel(); // 停止语音合成\r\n          }\r\n          await aardio.stopRecord(); // 停止录音\r\n          this.isGeneratingAudio = false;\r\n          return;\r\n        }\r\n\r\n        // 开始生成音频\r\n        this.isGeneratingAudio = true;\r\n        this.cancelAudioGeneration = false;\r\n\r\n\r\n        const dir_audio = this.projectDirectory + '\\\\' + this.folder_audio;\r\n        await aardio.createDir(dir_audio, false);\r\n\r\n        const dir_buff = this.projectDirectory + '\\\\' + this.folder_buff;\r\n        await aardio.createDir(dir_buff, true);\r\n\r\n        const audioName = await this.getMediaName(dir_audio, this.sequence.selectedIndex, clip.sentence, 'wav');\r\n        const fullname_audio_output = dir_audio + '\\\\' + audioName + '.wav';\r\n\r\n        try {\r\n              const estimated = this.estimateSpeechDuration(clip.sentence, clip.narration.rate);\r\n              // 给 2 倍冗余，防止误差\r\n              const timeout = Math.max(estimated * 2000, 5000);\r\n              await this.withTimeout(\r\n                this.recordAudio(clip, dir_buff, fullname_audio_output, timeout),\r\n                timeout, \r\n                () => {\r\n                  console.warn(\"TTS 超时，强制中断\");\r\n\r\n                  this.synth.cancel();        // 停止语音\r\n                  aardio.stopRecord();        // 停止录音\r\n                }\r\n              );\r\n          const isFileExist = await aardio.isFileExist(fullname_audio_output);\r\n          if(isFileExist)\r\n          {\r\n            this.saveProject();\r\n          }\r\n        } catch (error) {\r\n          if (error.message !== 'CANCELLED') {\r\n            console.error('Error generating audio:', error);\r\n          }\r\n        } finally {\r\n          await aardio.deleteDir(dir_buff);\r\n          this.isGeneratingAudio = false;\r\n        }\r\n      },\r\n      async getMediaName(dir, clipIndex, sentence, ext) {\r\n        // 1️⃣ 处理 sentence（前10字符 + 去非法字符）\r\n        const safeSentence = (sentence || '')\r\n          .substring(0, 10)\r\n          .replace(/[\\\\/:*?\"<>|]/g, '')  // Windows非法字符\r\n          .replace(/\\s+/g, '_');         // 空格转下划线\r\n\r\n        // 2️⃣ 时间字符串 MMDDHHmmss\r\n        const now = new Date();\r\n        const pad = (n) => n.toString().padStart(2, '0');\r\n        const timeStr =\r\n          pad(now.getMonth() + 1) +\r\n          pad(now.getDate()) +\r\n          pad(now.getHours()) +\r\n          pad(now.getMinutes()) +\r\n          pad(now.getSeconds());\r\n\r\n        // ⭐ 注意：clipIndex + 1\r\n        let baseName = `${clipIndex + 1}_${safeSentence}_${timeStr}`;\r\n\r\n        let fullPath = `${dir}\\\\${baseName}.${ext}`;\r\n        let isFileExist = true;\r\n\r\n        try {\r\n          isFileExist = await aardio.isFileExist(fullPath);\r\n        } catch (error) {\r\n          console.error(error);\r\n        }\r\n\r\n        // 3️⃣ 防重名\r\n        if (isFileExist) {\r\n          const randomSuffix = Math.floor(Math.random() * 10000);\r\n          baseName = `${baseName}_${randomSuffix}`;\r\n          fullPath = `${dir}\\\\${baseName}.${ext}`;\r\n\r\n          try {\r\n            isFileExist = await aardio.isFileExist(fullPath);\r\n          } catch (error) {\r\n            console.error(error);\r\n          }\r\n\r\n          // 极小概率再次冲突 → 递归\r\n          if (isFileExist) {\r\n            await new Promise(resolve => setTimeout(resolve, 50));\r\n            return await this.getMediaName(dir, clipIndex, sentence, ext);\r\n          }\r\n        }\r\n\r\n        return baseName;\r\n      },\r\n      generateUUID() {\r\n        // 使用当前时间戳和随机数生成唯一标识符\r\n        const timestamp = Date.now().toString(36); // 转换为36进制字符串\r\n        const random = Math.random().toString(36).substring(2, 10); // 随机数的36进制字符串\r\n        const uuid = (timestamp + random).substring(0, 8); // 截取前5位字符\r\n        return uuid;\r\n      },\r\n      async recordAudio(clip, dir_buff, fullname_audio_output, timeout) {\r\n        try {\r\n          let audioStart = 0;\r\n          let audioEnd = 0;\r\n          const fullname_audio_original = dir_buff + '\\\\' + this.audio_original;\r\n\r\n          await this.record(clip.sentence, clip.narration.voiceName, clip.narration.rate, fullname_audio_original, timeout );\r\n          if (this.cancelBatchAudioGeneration) {\r\n            throw new Error(\"CANCELLED\");\r\n          }\r\n          const fullname_audio_with_silence = dir_buff + '\\\\' + this.audio_with_silence;\r\n          await aardio.ffmpeg_add_silence(fullname_audio_original, 2, 2, fullname_audio_with_silence);\r\n\r\n          let fullname_audio_buff = fullname_audio_with_silence;\r\n          if (clip.narration.speed != 1) {\r\n            const fullname_audio_with_speed = dir_buff + '\\\\' + this.audio_with_speed;\r\n            await aardio.ffmpeg_change_speed(fullname_audio_with_silence, clip.narration.speed, fullname_audio_with_speed);\r\n            fullname_audio_buff = fullname_audio_with_speed;\r\n          }\r\n\r\n          const audioStartEnd = await aardio.getAudioStartEnd(fullname_audio_buff, clip.narration.pauseBefore, clip.narration.pauseAfter);\r\n          audioStart = parseFloat(audioStartEnd.split(\"-\")[0]);\r\n          audioEnd = parseFloat(audioStartEnd.split(\"-\")[1]);\r\n\r\n          await aardio.ffmpeg_audio_cut(fullname_audio_buff, audioStart, audioEnd, fullname_audio_output);\r\n\r\n          // 只有成功完成才更新clip状态\r\n          clip.narration.audioMedia.filePath = fullname_audio_output;\r\n          clip.narration.audioMedia.duration = audioEnd - audioStart;\r\n\r\n        } catch (error) {\r\n          if (error.message === 'CANCELLED') {\r\n            console.log('Audio generation canceled.');\r\n            throw error;\r\n          } else {\r\n            console.error('generateAudio error: ', error);\r\n            throw error;\r\n          }\r\n        }\r\n      },\r\n      async record(text, voice, rate, fullname_audio, timeout) {\r\n\r\n        // 向宿主发送开始录制请求\r\n        await aardio.startRecord(fullname_audio);\r\n\r\n        try {\r\n          await this.speak(text, voice, rate, timeout);\r\n        } catch (error) {\r\n          // 如果被取消，停止录音\r\n          if (error.message === 'CANCELLED') {\r\n            await aardio.stopRecord();\r\n          }\r\n          throw error;\r\n        }\r\n      },\r\n      speak(text, voice, rate, timeout = 8000) {\r\n        return new Promise((resolve, reject) => {\r\n          let finished = false;\r\n          this.utterThis = new SpeechSynthesisUtterance(text);\r\n\r\n          const safeResolve = async () => {\r\n            if (finished) return;\r\n            finished = true;\r\n\r\n            clearTimeout(timer);\r\n\r\n            try {\r\n              await aardio.stopRecord();\r\n            } catch (e) {\r\n              console.warn(\"stopRecord failed:\", e);\r\n            }\r\n\r\n            resolve();\r\n          };\r\n\r\n          const safeReject = (err) => {\r\n            if (finished) return;\r\n            finished = true;\r\n\r\n            clearTimeout(timer);\r\n            reject(err);\r\n          };\r\n\r\n          // ⭐ 超时控制（带 speaking 兜底）\r\n          const timer = setTimeout(() => {\r\n            if (finished) return;\r\n\r\n            // 延迟一点再判断（解决 speaking 延迟问题）\r\n            setTimeout(() => {\r\n              if (finished) return;\r\n\r\n              if (!this.synth.speaking) {\r\n                console.warn(\"onend 丢失（延迟检测），自动补偿结束\");\r\n                safeResolve();\r\n              } else {\r\n                console.warn(\"TTS 真卡死，强制终止\");\r\n                this.synth.cancel();\r\n                safeReject(new Error(\"TTS_TIMEOUT\"));\r\n              }\r\n            }, 100); // ⭐ 关键：100ms 二次确认\r\n          }, timeout);\r\n\r\n          this.utterThis.onend = () => {\r\n            safeResolve();\r\n          };\r\n\r\n          this.utterThis.onerror = (event) => {\r\n            safeReject(event);\r\n          };\r\n\r\n          this.utterThis.voice = this.list_voice_edge.find(v => {\r\n            return v.name.split(\" \")[1] === voice;\r\n          });\r\n\r\n          this.utterThis.rate = rate;\r\n\r\n          this.synth.speak(this.utterThis);\r\n        });\r\n      },\r\n      truncatePath(fullPath, maxLength = 40) {\r\n        if (!fullPath) return '';\r\n\r\n        const separator = fullPath.includes('/') ? '/' : '\\\\';\r\n        const parts = fullPath.split(separator);\r\n        const fileName = parts.pop(); // 提取文件名\r\n\r\n        // 如果总长度 < maxLength，直接返回原路径\r\n        if (fullPath.length <= maxLength) return fullPath;\r\n\r\n        // 否则，从路径开头和结尾各取一部分，中间用 ... 代替\r\n        let remainingLength = maxLength - fileName.length - 3; // 3 是 \"...\"\r\n        if (remainingLength <= 0) return `...${separator}${fileName}`;\r\n\r\n        const startLength = Math.floor(remainingLength / 2);\r\n        const endLength = remainingLength - startLength;\r\n\r\n        const startPath = parts.join(separator).substring(0, startLength);\r\n        const endPath = parts.join(separator).slice(-endLength);\r\n\r\n        return `${startPath}...${separator}${endPath}${separator}${fileName}`;\r\n      },\r\n\r\n    // 加载音频\r\n    async loadAudio(path, duration) {\r\n      const exists = await aardio.isFileExist(path);\r\n      if (!exists) return\r\n      const base64Audio = await aardio.convertAudioFileToBase64(path)\r\n      if (!base64Audio) return\r\n\r\n      // 解码 Base64 成 Blob\r\n      const byteCharacters = atob(base64Audio)\r\n      const byteNumbers = new Array(byteCharacters.length)\r\n      for (let i = 0; i < byteCharacters.length; i++) {\r\n        byteNumbers[i] = byteCharacters.charCodeAt(i)\r\n      }\r\n      const byteArray = new Uint8Array(byteNumbers)\r\n      const blob = new Blob([byteArray], { type: 'audio/wav' })\r\n      const objectUrl = URL.createObjectURL(blob)\r\n\r\n      // 如果已存在实例，销毁\r\n      if (this.wavesurfer) {\r\n        this.wavesurfer.destroy()\r\n      }\r\n\r\n      await this.$nextTick()\r\n      if (!this.$refs.waveform) {\r\n        console.warn('Waveform container is pending. Will retry.')\r\n        setTimeout(() => this.loadAudio(path, duration), 100)\r\n        return\r\n      }\r\n      // 创建 wavesurfer\r\n      this.wavesurfer = WaveSurfer.create({\r\n        container: this.$refs.waveform,\r\n        waveColor: '#ccc',\r\n        progressColor: '#fccc84ff',\r\n        cursorColor: '#3f51b5',\r\n        height: 16,\r\n      })\r\n\r\n      await this.wavesurfer.load(objectUrl)\r\n        this.currentTime = 0;\r\n        this.totalTime = duration;\r\n\r\n      // 监听事件\r\n      this.wavesurfer.on('audioprocess', () => {\r\n        this.currentTime = this.wavesurfer.getCurrentTime()\r\n      })\r\n      this.wavesurfer.on('finish', () => {\r\n        this.isPlaying = false\r\n        this.currentTime = this.totalTime\r\n      })\r\n      this.wavesurfer.on('interaction', () => {\r\n        this.currentTime = this.wavesurfer.getCurrentTime()\r\n      })\r\n    },\r\n\r\n  // 切换播放/暂停\r\n  toggleAudioPlayback() {\r\n      if (this.wavesurfer) {\r\n        this.wavesurfer.playPause()\r\n        this.isPlaying = this.wavesurfer.isPlaying()\r\n      }\r\n    },\r\n  moveSceneLeft(index) {\r\n    if (index <= 0) return;\r\n    const scenes = [...this.editedClip.scenes];\r\n    // Swap current scene with previous one\r\n    [scenes[index - 1], scenes[index]] = [scenes[index], scenes[index - 1]];\r\n    this.editedClip.scenes = scenes;\r\n  },\r\n\r\n  moveSceneRight(index) {\r\n    if (index >= this.editedClip.scenes.length - 1) return;\r\n    const scenes = [...this.editedClip.scenes];\r\n    // Swap current scene with next one\r\n    [scenes[index], scenes[index + 1]] = [scenes[index + 1], scenes[index]];\r\n    this.editedClip.scenes = scenes;\r\n  },\r\n\r\ngetDurationClass(clip, scene) {\r\n  const duration = this.getSceneDuration(clip, scene);\r\n\r\n  // 图片始终白色\r\n  if (scene.type === 'image') {\r\n    return {\r\n      color: 'white',\r\n      backgroundColor: 'rgba(169, 169, 169, 0.4)',\r\n    };\r\n  }\r\n\r\n  const roundedFps = Math.round(scene.fps || 0);\r\n  const sequenceFps = Math.round(this.sequence.frameRate || 0);\r\n  const totalClipDuration = clip?.narration?.audioMedia?.duration || 0;\r\n\r\n  // 如果关键数据缺失，则使用默认样式\r\n  if (!roundedFps || !sequenceFps || !totalClipDuration) {\r\n    return {\r\n      color: 'white',\r\n      backgroundColor: 'rgba(169, 169, 169, 0.4)',\r\n    };\r\n  }\r\n\r\n  // === 计算逻辑 ===\r\n  const startFrame = scene.frameRange?.[0] ?? 0;\r\n  const endFrame = scene.frameRange?.[1] ?? 0;\r\n\r\n  // 实际可用帧数（以序列帧率换算）\r\n  const actualFrames = (endFrame - startFrame + 1) * (sequenceFps / roundedFps);\r\n\r\n  // 序列总帧数\r\n  const totalClipFrames = totalClipDuration * sequenceFps;\r\n\r\n  // 当前片段理论需要的帧数（按比例分配）\r\n  const totalProportion = _.sumBy(clip.scenes, 'proportion') || 1;\r\n  const requiredFrames = (scene.proportion / totalProportion) * totalClipFrames;\r\n\r\n  // 判断“可提供时长不足”\r\n  const lackFrames = requiredFrames - actualFrames; // > 0 表示素材时长不够\r\n  const tolerance = 1; // 容差：1帧\r\n\r\n  // === 样式逻辑 ===\r\n  let color = 'white';\r\n  let backgroundColor = 'rgba(169, 169, 169, 0.4)';\r\n\r\n  // 超过时长阈值 → 红字\r\n  if (duration >= (this.sequence.durationThreshold || 0)) {\r\n    color = 'red';\r\n    backgroundColor = 'rgba(255, 255, 255, 0.4)';\r\n  }\r\n\r\n  // 素材可提供时长不够 → 红背景\r\n  if (lackFrames > tolerance) {\r\n    backgroundColor = 'rgba(255, 0, 0, 0.4)';\r\n  }\r\n\r\n  return { color, backgroundColor };\r\n},\r\n\r\n  formatSeconds(seconds) {\r\n    return seconds.toFixed(2);\r\n  },\r\n  // 切换全选状态\r\n  toggleSelectAll() {\r\n    const totalClips = this.sequence.clips.length;\r\n\r\n    // 检查是否已经全选\r\n    const isAllSelected = this.selectedClipIndices.length === totalClips && totalClips > 0;\r\n\r\n    if (isAllSelected) {\r\n      // 如果已经全选，则取消全选\r\n      this.selectedClipIndices = [];\r\n      this.filters.all = false;\r\n    } else {\r\n      // 如果没有全选，则全选\r\n      this.selectAll();\r\n    }\r\n  },\r\n\r\n  // 全选 - 与其他筛选条件互斥\r\n  selectAll() {\r\n    this.filterMenu = false;\r\n\r\n    // 全选时清除其他筛选条件\r\n    this.filters = {\r\n      all: true,\r\n      voice: [],\r\n      audioPending: false,\r\n      videoPending: false\r\n    };\r\n\r\n    // 选中所有片段\r\n    this.selectedClipIndices = Array.from(\r\n      { length: this.sequence.clips.length },\r\n      (_, i) => i\r\n    );\r\n  },\r\n\r\n    // 打开播音员筛选\r\n    openVoiceFilter() {\r\n      this.filterMenu = false;\r\n      this.selectedVoices = [...this.filters.voice];\r\n      this.voiceDialog = true;\r\n    },\r\n\r\n    // 应用播音员筛选 - 可以与其他条件共存\r\n    applyVoiceFilter() {\r\n      this.voiceDialog = false;\r\n\r\n      // 如果当前是全选状态，先取消全选\r\n      if (this.filters.all) {\r\n        this.filters.all = false;\r\n      }\r\n\r\n      // 更新语音筛选条件，保留其他条件\r\n      this.filters.voice = [...this.selectedVoices];\r\n\r\n      // 重新应用所有筛选条件\r\n      this.applyAllFilters();\r\n    },\r\n\r\n    // 筛选音频待生成 - 可以与其他条件共存\r\n    filterByAudioPending() {\r\n      this.filterMenu = false;\r\n\r\n      // 如果当前是全选状态，先取消全选\r\n      if (this.filters.all) {\r\n        this.filters.all = false;\r\n      }\r\n\r\n      // 切换音频待生成状态，保留其他条件\r\n      this.filters.audioPending = !this.filters.audioPending;\r\n\r\n      // 重新应用所有筛选条件\r\n      this.applyAllFilters();\r\n    },\r\n\r\n    // 筛选视频待生成 - 可以与其他条件共存\r\n    filterByVideoPending() {\r\n      this.filterMenu = false;\r\n\r\n      // 如果当前是全选状态，先取消全选\r\n      if (this.filters.all) {\r\n        this.filters.all = false;\r\n      }\r\n\r\n      // 切换视频待生成状态，保留其他条件\r\n      this.filters.videoPending = !this.filters.videoPending;\r\n\r\n      // 重新应用所有筛选条件\r\n      this.applyAllFilters();\r\n    },\r\n    // 应用所有筛选条件\r\n    applyAllFilters() {\r\n      // 如果没有激活任何筛选条件，清空选中项\r\n      if (!this.filters.all &&\r\n          this.filters.voice.length === 0 &&\r\n          !this.filters.audioPending &&\r\n          !this.filters.videoPending) {\r\n        this.selectedClipIndices = [];\r\n        return;\r\n      }\r\n\r\n      const filteredIndices = [];\r\n\r\n      // 根据所有激活的筛选条件选择片段\r\n      this.sequence.clips.forEach((clip, index) => {\r\n        let shouldSelect = false;\r\n\r\n        // 全选优先级最高\r\n        if (this.filters.all) {\r\n          shouldSelect = true;\r\n        }\r\n        // 多个筛选条件组合\r\n        else {\r\n          // 检查语音筛选\r\n          const voiceMatch = this.filters.voice.length === 0 ||\r\n                          this.filters.voice.includes(clip.narration?.voiceName || '');\r\n\r\n          // 检查音频待生成筛选\r\n          const audioPendingMatch = !this.filters.audioPending ||\r\n                                  !clip.narration?.audioMedia?.duration ||\r\n                                  clip.narration.audioMedia.duration === 0;\r\n\r\n          // 检查视频待生成筛选\r\n          const videoPendingMatch = !this.filters.videoPending ||\r\n                                  !clip.videoMedia?.duration ||\r\n                                  clip.videoMedia.duration === 0;\r\n\r\n          // 必须满足所有激活的筛选条件\r\n          shouldSelect = voiceMatch && audioPendingMatch && videoPendingMatch;\r\n        }\r\n\r\n        if (shouldSelect) {\r\n          filteredIndices.push(index);\r\n        }\r\n      });\r\n\r\n      // 更新选中项\r\n      this.selectedClipIndices = filteredIndices;\r\n    },\r\n\r\n    // 移除筛选条件\r\n    removeFilter(type) {\r\n      if (type === 'all') {\r\n        this.filters.all = false;\r\n      } else if (type === 'voice') {\r\n        this.filters.voice = [];\r\n      } else if (type === 'audioPending') {\r\n        this.filters.audioPending = false;\r\n      } else if (type === 'videoPending') {\r\n        this.filters.videoPending = false;\r\n      }\r\n\r\n      // 移除筛选条件后重新应用剩余的条件\r\n      this.applyAllFilters();\r\n    },\r\n\r\n    // 检查是否选中\r\n    isClipSelected(index) {\r\n      return this.selectedClipIndices.includes(index);\r\n    },\r\n\r\n    // 切换选择状态\r\n    toggleClipSelection(index) {\r\n      const idx = this.selectedClipIndices.indexOf(index);\r\n      if (idx > -1) {\r\n        this.selectedClipIndices.splice(idx, 1);\r\n      } else {\r\n        this.selectedClipIndices.push(index);\r\n      }\r\n      // 排序\r\n      this.selectedClipIndices.sort((a, b) => a - b);\r\n    },\r\n    // 导出片段\r\n  async exportClips() {\r\n    // 初始化数组\r\n    this.exportAudioFiles = [];\r\n    this.exportVideoFiles = [];\r\n    this.missingAudioFiles = [];\r\n    this.missingVideoFiles = [];\r\n\r\n    // 检查选中的片段\r\n    for (const index of this.selectedClipIndices) {\r\n      const clip = this.sequence.clips[index];\r\n\r\n      // 检查音频文件\r\n      if (clip.narration?.audioMedia?.filePath) {\r\n        const filePath = clip.narration.audioMedia.filePath;\r\n        const exists = await aardio.isFileExist(filePath);\r\n\r\n        if (exists) {\r\n          this.exportAudioFiles.push({\r\n            path: filePath,\r\n            index: index\r\n          });\r\n        } else {\r\n          this.missingAudioFiles.push({\r\n            path: filePath,\r\n            index: index\r\n          });\r\n          // 更新序列中的数据\r\n          clip.narration.audioMedia.filePath = '';\r\n          clip.narration.audioMedia.duration = 0;\r\n        }\r\n      } else {\r\n        this.missingAudioFiles.push({\r\n          path: '',\r\n          index: index\r\n        });\r\n      }\r\n\r\n      // 检查视频文件\r\n      if (clip.videoMedia?.filePath) {\r\n        const filePath = clip.videoMedia.filePath;\r\n        const exists = await aardio.isFileExist(filePath);\r\n\r\n        if (exists) {\r\n          this.exportVideoFiles.push({\r\n            path: filePath,\r\n            index: index\r\n          });\r\n        } else {\r\n          this.missingVideoFiles.push({\r\n            path: filePath,\r\n            index: index\r\n          });\r\n          // 更新序列中的数据\r\n          clip.videoMedia.filePath = '';\r\n          clip.videoMedia.duration = 0;\r\n        }\r\n      } else {\r\n        this.missingVideoFiles.push({\r\n          path: '',\r\n          index: index\r\n        });\r\n      }\r\n    }\r\n    // 重置导出路径，如果类型不匹配或需要更新\r\n    this.resetExportPathForType();\r\n    // 打开导出对话框\r\n    this.exportDialog = true;\r\n    this.ignoreMissing = false;\r\n  },\r\n\r\n  //根据导出类型重置路径\r\n  resetExportPathForType() {\r\n    // 如果上次导出类型与当前类型不同，或者路径为空，重置路径\r\n    if (this.lastExportType !== this.exportType || !this.exportPath) {\r\n      this.exportPath = '';\r\n      this.lastExportType = this.exportType;\r\n      this.lastExportPath = '';\r\n    }\r\n    // 如果上次导出类型相同但路径存在，确保扩展名正确\r\n    else if (this.exportPath) {\r\n      const correctExtension = this.exportType === 'audio' ? '.mp3' : '.mp4';\r\n      if (!this.exportPath.toLowerCase().endsWith(correctExtension)) {\r\n        // 移除旧扩展名，添加新扩展名\r\n        const basePath = this.exportPath.replace(/\\.[^/.]+$/, \"\");\r\n        this.exportPath = basePath + correctExtension;\r\n      }\r\n    }\r\n  },\r\n  // 浏览背景音乐\r\n  async browseBackgroundMusic() {\r\n    const fullName_music = await aardio.selectFile('Audio files|*.mp3;*.wav;*.aac|All files|*.*');\r\n    if (fullName_music !== '') {\r\n      this.backgroundMusicPath = fullName_music;\r\n    }\r\n  },\r\n\r\n  // 浏览导出路径\r\nasync browseExportPath() {\r\n  const extension = this.exportType === 'audio' ? '.mp3' : '.mp4';\r\n  const filter = this.exportType === 'audio' ? 'MP3 files|*.mp3': 'MP4 files|*.mp4'\r\n\r\n  // 如果已有路径，使用它作为默认路径（但确保扩展名正确）\r\n  let defaultPath = '';\r\n  if (this.exportPath) {\r\n    const basePath = this.exportPath.replace(/\\.[^/.]+$/, \"\");\r\n    defaultPath = basePath + extension;\r\n  }\r\n\r\n  const fullName_export = await aardio.saveFile(filter, defaultPath);\r\n  if (fullName_export) {\r\n    // 确保文件扩展名正确\r\n    let finalPath = fullName_export;\r\n    if (!finalPath.toLowerCase().endsWith(extension)) {\r\n      finalPath += extension;\r\n    }\r\n\r\n    // 检查文件是否存在\r\n    const exists = await aardio.isFileExist(finalPath);\r\n    if (exists) {\r\n      // 文件已存在，显示警告\r\n      this.exportPathTemp = finalPath;\r\n      this.fileExistsWarning = true;\r\n      this.fileExistsResolved = false;\r\n    } else {\r\n      // 文件不存在，直接设置路径\r\n      this.exportPath = finalPath;\r\n      this.lastExportPath = finalPath;\r\n      this.fileExistsResolved = true;\r\n    }\r\n  }\r\n},\r\n\r\n// 确认覆盖已存在文件\r\nconfirmOverwrite() {\r\n  this.exportPath = this.exportPathTemp;\r\n  this.fileExistsWarning = false;\r\n  this.fileExistsResolved = true;\r\n},\r\n\r\n// 取消覆盖\r\ncancelOverwrite() {\r\n  this.exportPathTemp = '';\r\n  this.fileExistsWarning = false;\r\n  this.fileExistsResolved = false;\r\n},\r\n\r\n    // 忽略缺失文件\r\n    ignoreMissingFiles() {\r\n      this.ignoreMissing = true;\r\n    },\r\n\r\n    // 确认导出\r\n    async confirmExport() {\r\n      this.isExporting = true;\r\n      this.exportProgress = 0;\r\n\r\n      const dir_buff = this.projectDirectory + '\\\\' + this.folder_buff;\r\n      try {\r\n        await aardio.createDir(dir_buff, true);\r\n\r\n        const concatFilePath = dir_buff + '\\\\concat.txt';\r\n\r\n        // 创建文件列表\r\n        const fileList = this.exportType === 'audio' ?\r\n          this.exportAudioFiles : this.exportVideoFiles;\r\n\r\n        if (fileList.length === 0) {\r\n          this.showToast(this.$t('NoFilesAvailableForExport'), 'error');\r\n          this.isExporting = false;\r\n          return;\r\n        }\r\n\r\n        // 创建concat文件内容\r\n        let concatContent = '';\r\n        for (const file of fileList) {\r\n          // 转义路径中的单引号\r\n          const escapedPath = file.path.replace(/'/g, \"'\\\\''\");\r\n          concatContent += `file '${escapedPath}'\\n`;\r\n        }\r\n\r\n        // 保存concat文件\r\n        await aardio.saveTextFile(concatContent, concatFilePath);\r\n\r\n        if(await aardio.isFileExist(this.exportPath)) {\r\n          await aardio.deleteFile(this.exportPath);\r\n        }\r\n        const result = await aardio.exportClips(\r\n          concatFilePath,\r\n          this.exportPath,\r\n          this.backgroundMusicPath,\r\n          this.backgroundMusicVolume,\r\n          this.exportType,\r\n          dir_buff\r\n        );\r\n        console.error(\"result\",result);\r\n        // 调用合并函数\r\n        this.showToast(this.$t('ExportSuccess'), 'success');\r\n        this.exportDialog = false;\r\n\r\n      } catch (error) {\r\n        console.error('Export failed:', error);\r\n        this.showToast('Export failed.', 'error');\r\n      }\r\n      // 清理临时目录\r\n      await aardio.deleteDir(dir_buff);\r\n      this.isExporting = false;\r\n    },\r\n    // 计算场景持续时间\r\n    getSceneDuration(clip, scene) {\r\n      // 第一种情况：音频时长大于0\r\n      if (clip.narration?.audioMedia?.duration > 0) {\r\n        const totalProportion = _.sumBy(clip.scenes, 'proportion');\r\n        if (totalProportion <= 0) return 0;\r\n\r\n        return (scene.proportion / totalProportion) * clip.narration.audioMedia.duration;\r\n      }\r\n      // 第二种情况：音频时长小于等于0\r\n      else {\r\n        // 视频类型：使用有效时长\r\n        if (scene.type === 'video') {\r\n          const frameCount = scene.frameRange[1] - scene.frameRange[0] + 1;\r\n          return frameCount / scene.fps;\r\n        }\r\n        // 图片类型：使用proportion作为时长\r\n        else {\r\n          return scene.proportion;\r\n        }\r\n      }\r\n    },\r\n\r\n    // 计算场景有效时长\r\n    getSceneEffectiveDuration(scene) {\r\n      if (scene.type === 'video') {\r\n        const frameCount = scene.frameRange[1] - scene.frameRange[0] + 1;\r\n        return frameCount / scene.fps;\r\n      } else {\r\n        // 图片类型认为有效时长无限大\r\n        return Number.MAX_VALUE;\r\n      }\r\n    },\r\n\r\n    // 获取时间轴分段样式\r\ngetSegmentStyle(clip, scene) {\r\n  const totalDuration = clip.narration?.audioMedia?.duration > 0\r\n    ? clip.narration.audioMedia.duration\r\n    : _.sumBy(clip.scenes, s => this.getSceneDuration(clip, s));\r\n\r\n  const sceneDuration = this.getSceneDuration(clip, scene);\r\n  const percentage = (sceneDuration / totalDuration) * 100;\r\n\r\n  let style = {\r\n    width: `${percentage}%`,\r\n    position: 'relative',\r\n    backgroundColor: '#000000', // 兜底背景\r\n  };\r\n\r\n  if (scene.base64Thumbnail) {\r\n    style.backgroundImage = `url(${scene.base64Thumbnail})`;\r\n    style.backgroundSize = 'cover';\r\n    //style.backgroundSize = '100% 100%'; // 强制宽高填满\r\n    style.backgroundPosition = 'center';\r\n    style.opacity = 1; // 设置透明度\r\n  }\r\n\r\n  return style;\r\n},\r\n\r\n\r\n    // 开始拖拽调整场景比例\r\n    startDrag(e, index) {\r\n      e.preventDefault();\r\n\r\n      // mark handle for styling，后面 stopDrag 会移除\r\n      if (e.target.classList && e.target.classList.contains('handle')) {\r\n        e.target.classList.add('dragging');\r\n        this._dragHandle = e.target; // 保存引用，方便移除 class\r\n      }\r\n\r\n      document.body.style.userSelect = 'none';\r\n      this.draggingIndex = index;\r\n      this.startX = e.clientX;\r\n\r\n      // 保存起始 proportions（数值化）\r\n      this.startProportions = this.editedClip.scenes.map(s => Number(s.proportion) || 0);\r\n\r\n      // 起始总和\r\n      this.totalProportion = _.sum(this.startProportions) || 0.000001; // 避免 0\r\n\r\n      document.addEventListener('mousemove', this.onDrag);\r\n      document.addEventListener('mouseup', this.stopDrag);\r\n    },\r\n    onDrag(e) {\r\n      if (this.draggingIndex === null) return;\r\n\r\n    // 立即更新，不使用防抖以获得更流畅的体验\r\n      const timeline = this.$refs.timeline;\r\n      if (!timeline) return;\r\n\r\n      const deltaX = e.clientX - this.startX;\r\n      const totalWidth = timeline.offsetWidth;\r\n\r\n      // 计算比例变化（基于总宽度的百分比）\r\n      const deltaProportionPercent = (deltaX / totalWidth) * this.totalProportion;\r\n\r\n      // 更新当前场景的比例（限制最小值）\r\n      const newProportions = [...this.startProportions];\r\n      const newCurrentProportion = Math.max(0.1, newProportions[this.draggingIndex] + deltaProportionPercent);\r\n\r\n      // 计算需要从相邻场景调整的比例\r\n      const proportionDelta = newCurrentProportion - newProportions[this.draggingIndex];\r\n\r\n      // 更新当前场景\r\n      newProportions[this.draggingIndex] = newCurrentProportion;\r\n\r\n      // 调整下一个场景的比例（如果有）\r\n      const nextIndex = this.draggingIndex + 1;\r\n      if (nextIndex < newProportions.length) {\r\n        newProportions[nextIndex] = Math.max(0.1, newProportions[nextIndex] - proportionDelta);\r\n      }\r\n\r\n      // 确保总比例不变\r\n      const newTotal = _.sum(newProportions);\r\n      if (Math.abs(newTotal - this.totalProportion) > 0.01) {\r\n        // 如果有误差，进行微调（通常由于浮点计算）\r\n        const adjustment = this.totalProportion - newTotal;\r\n        if (nextIndex < newProportions.length) {\r\n          newProportions[nextIndex] += adjustment;\r\n        } else if (this.draggingIndex > 0) {\r\n          newProportions[this.draggingIndex - 1] += adjustment;\r\n        }\r\n      }\r\n\r\n      // 更新所有场景的比例\r\n      this.editedClip.scenes.forEach((scene, i) => {\r\n        scene.proportion = newProportions[i];\r\n      });\r\n\r\n      // 立即刷新视图（如果你的框架响应式正常，这一步可以省）\r\n      this.$forceUpdate();\r\n    },\r\n    // onDrag —— 新逻辑：只修改当前 scene 的 value（proportion）\r\n    onDrag_proportion(e) {\r\n      if (this.draggingIndex === null) return;\r\n\r\n      const timeline = this.$refs.timeline;\r\n      if (!timeline) return;\r\n\r\n      const deltaX = e.clientX - this.startX;\r\n      const totalWidth = timeline.offsetWidth || 1;\r\n\r\n      // 将鼠标位移换算为 proportion 的增量（相对于起始总和）\r\n      const deltaProportion = (deltaX / totalWidth) * this.totalProportion;\r\n\r\n      // 新值 = 起始值 + 增量（并设下限）\r\n      const MIN = 0.1;\r\n      let newValue = (this.startProportions[this.draggingIndex] || 0) + deltaProportion;\r\n      if (newValue < MIN) newValue = MIN;\r\n\r\n      // 只更新当前 scene 的 proportion，其他 scene 不变\r\n      this.editedClip.scenes[this.draggingIndex].proportion = newValue;\r\n\r\n      // 立即刷新视图（如果你的框架响应式正常，这一步可以省）\r\n      this.$forceUpdate();\r\n    },\r\n\r\n    // stopDrag\r\n    stopDrag() {\r\n      // 清除拖动样式\r\n      if (this._dragHandle && this._dragHandle.classList) {\r\n        this._dragHandle.classList.remove('dragging');\r\n        this._dragHandle = null;\r\n      }\r\n\r\n      // 清除防抖定时器（如果你有）\r\n      if (this.dragUpdateTimeout) {\r\n        clearTimeout(this.dragUpdateTimeout);\r\n        this.dragUpdateTimeout = null;\r\n      }\r\n\r\n      this.draggingIndex = null;\r\n      document.body.style.userSelect = '';\r\n      document.body.style.webkitUserSelect = '';\r\n\r\n      document.removeEventListener('mousemove', this.onDrag);\r\n      document.removeEventListener('mouseup', this.stopDrag);\r\n    },\r\n    getVideoIconColor(clip) {\r\n        // 1. 时长无效\r\n        if (!clip.videoMedia || clip.videoMedia.duration <= 0) {\r\n          return 'grey';\r\n        }\r\n\r\n        // 2. 遍历 scene，检查是否存在 type === 'video' 且 duration 超过阈值\r\n        const threshold = this.sequence.durationThreshold || 0;\r\n\r\n        for (const scene of clip.scenes || []) {\r\n          if (scene.type === 'video') {\r\n            const duration = this.getSceneDurationForClip(scene, clip); // 使用新方法\r\n            if (duration >= threshold) {\r\n              return 'error';\r\n            }\r\n          }\r\n        }\r\n\r\n        // 3. 默认情况\r\n        return 'green-darken-2';\r\n      },\r\n\r\n    // 新增方法：为特定 clip 计算场景时长\r\n    getSceneDurationForClip(scene, clip) {\r\n      // 第一种情况：音频时长大于0\r\n      if (clip.narration?.audioMedia?.duration > 0) {\r\n        const totalProportion = _.sumBy(clip.scenes, 'proportion');\r\n        if (totalProportion <= 0) return 0;\r\n\r\n        return (scene.proportion / totalProportion) * clip.narration.audioMedia.duration;\r\n      }\r\n      // 第二种情况：音频时长小于等于0\r\n      else {\r\n        // 视频类型：使用有效时长\r\n        if (scene.type === 'video') {\r\n          const frameCount = scene.frameRange[1] - scene.frameRange[0] + 1;\r\n          return frameCount / scene.fps;\r\n        }\r\n        // 图片类型：使用proportion作为时长\r\n        else {\r\n          return scene.proportion;\r\n        }\r\n      }\r\n    },\r\n    async addMaterialLibrary() {\r\n  const dir_analyzeFile = await aardio.selectFile('Json file|*.json');\r\n  if (!dir_analyzeFile) return;\r\n  const json = await aardio.getFileData(dir_analyzeFile);\r\n  const analyzeResult = JSON.parse(json);\r\n\r\n  const baseDir = dir_analyzeFile.substring(0, dir_analyzeFile.lastIndexOf(\"\\\\\"));\r\n\r\n  // 先 push 一个占位的库，tab 立刻显示\r\n  const newLib = {\r\n    fullName: dir_analyzeFile,\r\n    name: this.$t('ImportingLibrary'),\r\n    info: analyzeResult.Info,\r\n    thumbsWidth: analyzeResult.ThumbsWidth,\r\n    thumbsHeight: analyzeResult.ThumbsHeight,\r\n    preview: analyzeResult.Preview,\r\n    fps: analyzeResult.Info.Fps,\r\n    segments: [],\r\n    loading: true, // 用来标记是否正在导入\r\n  };\r\n  this.materialLibraries.push(newLib);\r\n  const libIndex = this.materialLibraries.length - 1;\r\n  this.activeLibrary = libIndex;\r\n\r\n  // 异步加载 segments\r\n  const segments = [];\r\n  for (const seg of analyzeResult.Segments) {\r\n    const thumbPath = `${baseDir}\\\\${analyzeResult.Thumbs}\\\\${seg.StartFrame}.jpg`.replace(/\\\\\\\\/g, '\\\\');\r\n    const base64Thumbnail = await aardio.getImageAsBase64(thumbPath);\r\n    const duration = (seg.EndFrame - seg.StartFrame + 1) / analyzeResult.Info.Fps;\r\n    segments.push({\r\n      ...seg,\r\n      base64Thumbnail,\r\n      duration,\r\n      thumbWidth: analyzeResult.ThumbsWidth,\r\n      thumbHeight: analyzeResult.ThumbsHeight,\r\n      previewBase64: '',\r\n      isPlaying: false,\r\n    });\r\n  }\r\n\r\n  // 导入完成后更新库\r\n  this.materialLibraries[libIndex] = {\r\n    ...newLib,\r\n    name: this.getFileNameWithoutExt(analyzeResult.Info.FullName),\r\n    segments,\r\n    loading: false,\r\n  };\r\n},\r\n    removeLibrary(index) {\r\n    this.materialLibraries.splice(index, 1);\r\n    if (this.activeLibrary >= this.materialLibraries.length) {\r\n    this.activeLibrary = this.materialLibraries.length - 1;\r\n    }\r\n    },\r\n    getFileNameWithoutExt(path) {\r\n    return path.split('\\\\').pop().replace(/\\.[^/.]+$/, '');\r\n    },\r\n    handleMouseEnter(libIndex, lib, segment, segIndex) {\r\n      // 先清理旧的\r\n      if (segment.hoverTimer) {\r\n        clearTimeout(segment.hoverTimer);\r\n        segment.hoverTimer = null;\r\n      }\r\n\r\n      // 设置 0.3 秒延迟\r\n      segment.hoverTimer = setTimeout(() => {\r\n        this.startPreview(libIndex, lib, segment, segIndex);\r\n      }, 300);\r\n    },\r\n\r\n    handleMouseLeave(libIndex, segIndex) {\r\n      const segment = this.materialLibraries[libIndex].segments[segIndex];\r\n\r\n      // 鼠标移开时清除定时器\r\n      if (segment.hoverTimer) {\r\n        clearTimeout(segment.hoverTimer);\r\n        segment.hoverTimer = null;\r\n      }\r\n\r\n      // 停止预览\r\n      this.stopPreview(libIndex, segIndex);\r\n    },\r\n    stopAllSegments() {\r\n    if (!this.materialLibraries) return;\r\n\r\n    this.materialLibraries.forEach(library => {\r\n      if (library.segments && Array.isArray(library.segments)) {\r\n        library.segments.forEach(segment => {\r\n          segment.isPlaying = false;\r\n        });\r\n      }\r\n    });\r\n  },\r\nasync startPreview(libIndex, lib, segment, segIndex) {\r\n  this.stopAllSegments();\r\n  try {\r\n    if (!segment.previewBase64) {\r\n      const baseDir = lib.fullName.substring(0, lib.fullName.lastIndexOf(\"\\\\\"));\r\n      const previewPath = `${baseDir}\\\\${lib.preview}\\\\${segment.StartFrame}.jpg`.replace(/\\\\\\\\/g, '\\\\');\r\n      const base64Preview = await aardio.getVideoPreviewAsBase64(\r\n        lib.info.FullName,\r\n        lib.fps,\r\n        segment.StartFrame,\r\n        segment.StartFrameAHCHex,\r\n        lib.thumbsWidth,\r\n        lib.thumbsHeight,\r\n        0.5,\r\n        previewPath\r\n      );\r\n\r\n      if (base64Preview) {\r\n        const img = new Image();\r\n        img.onload = () => {\r\n          this.materialLibraries[libIndex].segments[segIndex].previewBase64 = base64Preview;\r\n\r\n          nextTick(() => {\r\n            setTimeout(() => {\r\n              this.startJsAnimation(libIndex, segIndex);\r\n            }, 100);\r\n          });\r\n        };\r\n        img.src = base64Preview;\r\n      }\r\n    } else {\r\n      this.startJsAnimation(libIndex, segIndex);\r\n    }\r\n  } catch (error) {\r\n    console.error('Preview failed.', error);\r\n  }\r\n},\r\n\r\nstartJsAnimation(libIndex, segIndex) {\r\n  const segment = this.materialLibraries[libIndex].segments[segIndex];\r\n  segment.isPlaying = true;\r\n  segment.currentFrame = 0;\r\n  segment.animationInterval = null;\r\n\r\n  const frameDuration = 1000 / 24; // 24fps，每帧约41.67ms\r\n  const totalFrames = 12;\r\n\r\n  segment.animationInterval = setInterval(() => {\r\n    segment.currentFrame = (segment.currentFrame + 1) % totalFrames;\r\n\r\n    // 计算背景位置\r\n    const col = segment.currentFrame % 4;\r\n    const row = Math.floor(segment.currentFrame / 4);\r\n    const x = col * 33.333;\r\n    const y = row * 50;\r\n\r\n    // 更新样式\r\n    const previewElement = document.querySelector(`[data-lib=\"${libIndex}\"][data-seg=\"${segIndex}\"] .preview-overlay`);\r\n    if (previewElement) {\r\n      previewElement.style.backgroundPosition = `${x}% ${y}%`;\r\n    }\r\n\r\n  }, frameDuration);\r\n},\r\n\r\nstopPreview(libIndex, segIndex) {\r\n  const segment = this.materialLibraries[libIndex].segments[segIndex];\r\n  segment.isPlaying = false;\r\n  if (segment.animationInterval) {\r\n    clearInterval(segment.animationInterval);\r\n    segment.animationInterval = null;\r\n  }\r\n},\r\nasync addScene(videoInfo, segment, base64Thumbnail) {\r\n  // 检查是否存在相邻片段\r\n  const lastScene = this.editedClip.scenes[this.editedClip.scenes.length - 1];\r\n\r\n  if (lastScene &&\r\n      lastScene.fullName === videoInfo.FullName &&\r\n      lastScene.sourceRange[1] === segment.StartFrame - 1) {\r\n\r\n    // 提示用户是否拼接\r\n    const shouldMerge = await this.showMergeConfirm();\r\n\r\n    if (shouldMerge) {\r\n      // 拼接片段：更新最后一个scene的结束帧\r\n      lastScene.sourceRange[1] = segment.EndFrame;\r\n      lastScene.frameRange[1] = segment.EndFrame;\r\n\r\n      // 更新缩略图（可选，使用新片段的缩略图）\r\n      //lastScene.base64Thumbnail = base64Thumbnail;\r\n\r\n      console.log('Clip has been spliced to adjacent clip.');\r\n      return;\r\n    }\r\n  }\r\n\r\n  // 如果不拼接或不符合拼接条件，添加新片段\r\n  await this.addNewScene(videoInfo, segment, base64Thumbnail);\r\n  this.selectScene(this.editedClip.scenes.length - 1);\r\n},\r\n\r\n// 显示确认对话框的方法\r\nasync showMergeConfirm() {\r\n  return new Promise((resolve) => {\r\n    const result = confirm(this.$t('confirmAppendORAdd'));\r\n    resolve(result);\r\n  });\r\n},\r\ncreateSceneFromSegment(videoInfo, segment, base64Thumbnail) {\r\n  const scene = _.cloneDeep(this.defaultScene);\r\n\r\n  scene.type = 'video';\r\n  scene.fullName = videoInfo.FullName;\r\n  scene.width = videoInfo.Width;\r\n  scene.height = videoInfo.Height;\r\n  scene.fps = videoInfo.Fps;\r\n  scene.countFrame = videoInfo.FrameCount;\r\n  scene.sourceRange = [segment.StartFrame, segment.EndFrame];\r\n  scene.frameRange = [segment.StartFrame, segment.EndFrame];\r\n  scene.sourceHex = segment.StartFrameAHCHex;\r\n  scene.base64Thumbnail = base64Thumbnail;\r\n\r\n  return scene;\r\n},\r\napplyDefaultLayoutFromSegment(scene) {\r\n  scene.scale = Math.min(\r\n    this.sequence.outputSize.width / scene.width,\r\n    this.sequence.outputSize.height / scene.height\r\n  );\r\n  scene.anchorX = this.sequence.outputSize.width / 2;\r\n  scene.anchorY = this.sequence.outputSize.height / 2;\r\n},\r\nasync addNewScene(videoInfo, segment, base64Thumbnail) {\r\n  const newScene = this.createSceneFromSegment(videoInfo, segment, base64Thumbnail);\r\n\r\n  if (this.sequence.smartAdjust) {\r\n    const matchedScene = this.findMatchingScene(newScene);\r\n\r\n    if (matchedScene) {\r\n      Object.assign(newScene, _.pick(matchedScene, [\r\n        'scale', 'anchorX', 'anchorY',\r\n        'horizontalFlip', 'upend', 'growFrame'\r\n      ]));\r\n    } else {\r\n      this.applyDefaultLayoutFromSegment(newScene);\r\n      newScene.growFrame = true;\r\n    }\r\n  } else {\r\n    this.applyDefaultLayoutFromSegment(newScene);\r\n  }\r\n\r\n  this.editedClip.scenes.push(newScene);\r\n},\r\nasync replaceScene(videoInfo, segment, base64Thumbnail) {\r\n  const index = this.editedClip.editedSceneIndex;\r\n\r\n  // ✅ 安全检查\r\n  if (\r\n    index == null ||\r\n    index < 0 ||\r\n    index >= this.editedClip.scenes.length\r\n  ) {\r\n    console.warn('invalid editedSceneIndex:', index);\r\n    return;\r\n  }\r\n\r\n  const newScene = this.createSceneFromSegment(videoInfo, segment, base64Thumbnail);\r\n\r\n  const currentScene = this.editedClip.scenes[index];\r\n\r\n  if (this.sequence.smartAdjust && currentScene) {\r\n    // ✅ 继承当前 scene 参数（关键）\r\n    Object.assign(newScene, _.pick(currentScene, [\r\n      'scale',\r\n      'anchorX',\r\n      'anchorY',\r\n      'horizontalFlip',\r\n      'upend',\r\n      'growFrame',\r\n      'proportion'\r\n    ]));\r\n  } else {\r\n    this.applyDefaultLayoutFromSegment(newScene);\r\n  }\r\n\r\n  // ✅ 覆盖\r\n  this.editedClip.scenes.splice(index, 1, newScene);\r\n},\r\n    selectScene(index) {\r\n      const clip = this.sequence.clips[this.sequence.selectedIndex];\r\n      if (!clip) return;\r\n\r\n      clip.editedSceneIndex = index; // ✅ 存在 clip 内部\r\n      this.$nextTick(() => {\r\n        const card = this.$refs['card-editedScene']?.$el;\r\n        if (!card) return;\r\n\r\n        const rect = card.getBoundingClientRect();\r\n        const isVisible =\r\n          rect.top >= 0 &&\r\n          rect.bottom <= (window.innerHeight || document.documentElement.clientHeight);\r\n\r\n        if (!isVisible) {\r\n          card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });\r\n        }\r\n      });\r\n    },\r\n    increaseSentenceFontSize() {\r\n      this.fontSize = Math.min(this.fontSize + 2, 50) // 最大 40px\r\n    },\r\n    decreaseSentenceFontSize() {\r\n      this.fontSize = Math.max(this.fontSize - 2, 20) // 最小 10px\r\n    },\r\n\r\n    }\r\n  }\r\n</script>\r\n\r\n<style scoped>\r\n::v-deep(.large-textarea textarea) {\r\n  font-size: var(--textarea-font-size) !important;\r\n  min-height: 155px; /* 最小高度 */\r\n  max-height: 155px; /* 最大高度 */\r\n  overflow-y: auto;  /* 超出滚动 */\r\n}\r\n::v-deep(.second-large-textarea textarea) {\r\n  font-size: 32px;\r\n}\r\n\r\n.sidebar-list {\r\n  background-color: transparent;\r\n  padding-right: 0 !important;\r\n  height: calc(100vh - 100px);\r\n}\r\n\r\n.sidebar-list .v-list-item {\r\n  padding-right: 0 !important;\r\n}\r\n\r\n.item-title {\r\n  font-size: 0.875rem;\r\n  line-height: 1.1;\r\n  font-weight: 400;\r\n}\r\n\r\n.item-meta {\r\n  font-size: 0.75rem;\r\n}\r\n\r\n.image-container {\r\n  position: relative;\r\n  overflow: hidden;\r\n  background-color: #000000ff;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.image-container img {\r\n  position: absolute;\r\n  max-width: none;\r\n}\r\n\r\n.time-overlay {\r\n  position: absolute;\r\n  bottom: 0;\r\n  right: 0;\r\n  font-size: 12px;\r\n  padding: 2px 4px;\r\n  pointer-events: none;\r\n}\r\n\r\n.v-slider-thumb__label {\r\n  top: unset !important;\r\n  bottom: -40px !important;\r\n}\r\n\r\n.v-slider-thumb__label::before {\r\n  top: unset !important;\r\n  bottom: 100% !important;\r\n  border-top-color: transparent !important;\r\n  border-bottom-color: currentColor !important;\r\n}\r\n.scene-container {\r\n  position: relative;\r\n  overflow: hidden;\r\n  background-color: #000000ff;\r\n  margin: 0 auto;\r\n}\r\n\r\n.scene-content {\r\n  position: absolute;\r\n  display: block;\r\n  max-width: none; /* 允许图片超出原始尺寸 */\r\n}\r\n/* 新增的场景编辑样式 */\r\n.scene-thumbnail {\r\n  object-fit: contain;\r\n  background-color: #000000ff;\r\n}\r\n\r\n.paste-area {\r\n  cursor: pointer;\r\n  border: 2px dashed #ccc;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.paste-area:hover {\r\n  border-color: #1976d2;\r\n  background-color: #f5f5f5;\r\n}\r\n.audio-player {\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.time-display {\r\n  min-width: 40px;\r\n  text-align: center;\r\n  font-family: monospace;\r\n  font-size: 0.9rem;\r\n}\r\n\r\n.v-slider__thumb {\r\n  height: 16px;\r\n  width: 16px;\r\n}\r\n\r\n.v-slider--disabled {\r\n  opacity: 1 !important;\r\n}\r\n.custom-audio-slider {\r\n  width: 100%;\r\n  height: 4px;\r\n  background: #e0e0e0;\r\n  border-radius: 2px;\r\n  outline: none;\r\n  margin: 0 0px;\r\n}\r\n\r\n.custom-audio-slider::-webkit-slider-thumb {\r\n  -webkit-appearance: none;\r\n  appearance: none;\r\n  width: 12px;\r\n  height: 12px;\r\n  background: #1976d2;\r\n  cursor: pointer;\r\n  border-radius: 50%;\r\n}\r\n\r\n.custom-audio-slider::-moz-range-thumb {\r\n  width: 12px;\r\n  height: 12px;\r\n  background: #1976d2;\r\n  cursor: pointer;\r\n  border-radius: 50%;\r\n}\r\n.time-positive {\r\n  color: #4caf50; /* 绿色 - 多余的帧 */\r\n}\r\n\r\n.time-negative {\r\n  color: #f44336; /* 红色 - 缺少的帧 */\r\n}\r\n.duration-text1 {\r\n  position: absolute;\r\n  top: 50%; /* 垂直居中 */\r\n  left: 50%; /* 水平居中 */\r\n  transform: translate(-50%, -50%); /* 精确居中 */\r\n  padding: 2px 4px;\r\n  border-radius: 2px;\r\n  font-size: 0.75rem;\r\n  color: white;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  pointer-events: none; /* ✅ 避免挡住左右按钮/拖动手柄 */\r\n}\r\n.duration-text {\r\n  position: absolute;\r\n  right: 4px;\r\n  bottom: 4px;\r\n  padding: 2px 4px;\r\n  border-radius: 2px;\r\n  font-size: 0.75rem;\r\n  color: white;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n}\r\n.duration-text-white {\r\n  color: white;\r\n}\r\n\r\n.duration-text-red {\r\n  color: #f44336;\r\n}\r\n.batch-progress {\r\n  background-color: #e3f2fd;\r\n  border-radius: 4px;\r\n  padding: 8px;\r\n  margin: 8px 0;\r\n}\r\n\r\n.batch-progress-text {\r\n  font-size: 0.75rem;\r\n  color: rgba(0, 0, 0, 0.6);\r\n}\r\n\r\n.filter-menu {\r\n  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n.gap {\r\n  gap: 4px;\r\n}\r\n\r\n/* 点击外部关闭菜单 */\r\n::v-deep .v-overlay__content {\r\n  position: absolute;\r\n  top: 40px;\r\n  left: 0;\r\n}\r\n\r\n.batch-edit-textarea {\r\n  font-family: monospace;\r\n  line-height: 1.4;\r\n}\r\n\r\n.delete-preview-item {\r\n  font-size: 0.8rem;\r\n  line-height: 1.3;\r\n}\r\n\r\n.loading-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  align-items: center;\r\n  z-index: 9999;\r\n}\r\n\r\n.loading-text {\r\n  margin-top: 16px;\r\n  font-size: 1.1rem;\r\n}\r\n\r\n/* 时间轴样式 */\r\n.timeline {\r\n  display: flex;\r\n  width: 100%;\r\n  height: 48px;\r\n  border: 1px solid #ccc;\r\n  position: relative;\r\n  margin-bottom: 16px;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n}\r\n\r\n.segment {\r\n  position: relative;\r\n  height: 100%;\r\n  color: #fff;\r\n  font-size: 12px;\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: center;\r\n  justify-content: flex-start;\r\n  transition: width 0.2s ease;\r\n}\r\n.segment-thumbnail {\r\n  flex-shrink: 0;\r\n  margin-right: 4px;\r\n}\r\n\r\n.segment-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  text-align: center;\r\n  font-size: 20px;\r\n  line-height: 1.2;\r\n  border-radius: 4px;\r\n  padding: 2px 4px;\r\n}\r\n\r\n.scene-duration {\r\n  opacity: 0.8;\r\n}\r\n\r\n.handle {\r\n  position: absolute;\r\n  right: 0;\r\n  top: 0;\r\n  width: 6px;\r\n  height: 100%;\r\n  background: rgba(255, 255, 255, 0.7);\r\n  cursor: col-resize;\r\n  z-index: 10;\r\n}\r\n\r\n.handle:hover {\r\n  background: rgba(255, 255, 255, 0.9);\r\n}\r\n\r\n.no-scenes-message {\r\n  text-align: center;\r\n  padding: 16px;\r\n  color: rgba(0, 0, 0, 0.6);\r\n  font-style: italic;\r\n}\r\n\r\n.scene-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));\r\n  gap: 6px;\r\n}\r\n\r\n.thumbnail-card {\r\n  position: relative;\r\n  max-width: 320px;\r\n  max-height: 180px;\r\n  overflow: hidden;\r\n  border-radius: 6px;\r\n  background: #000;\r\n  cursor: pointer;\r\n}\r\n.thumbnail-img {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  display: block;\r\n}\r\n.thumbnail-left-icon {\r\n  position: absolute;\r\n  left: 4px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  background: rgba(0, 0, 0, 0.6);\r\n  color: #fff;\r\n  border-radius: 50%;\r\n  cursor: pointer;\r\n}\r\n.thumbnail-right-icon {\r\n  position: absolute;\r\n  right: 4px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  background: rgba(0, 0, 0, 0.6);\r\n  color: #fff;\r\n  border-radius: 50%;\r\n  cursor: pointer;\r\n}\r\n\r\n.preview-right-icon {\r\n  position: absolute;\r\n  right: 4px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  background: rgba(0, 0, 0, 0.6);\r\n  color: #fff;\r\n  border-radius: 50%;\r\n  cursor: pointer;\r\n}\r\n.frame-range-text {\r\n  position: absolute;\r\n  left: 4px;\r\n  bottom: 4px;\r\n  font-size: 0.75rem;\r\n  color: white;\r\n  background: rgba(0, 0, 0, 0.5);\r\n  padding: 2px 4px;\r\n  border-radius: 2px;\r\n}\r\n.preview-overlay {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-size: 400% 300%;\r\n  background-repeat: no-repeat;\r\n  background-position: 0% 0%;\r\n  opacity: 0;\r\n  transition: opacity 0.3s;\r\n  pointer-events: none;\r\n}\r\n\r\n.preview-overlay.playing {\r\n  opacity: 1;\r\n  animation: preview-play 2s steps(1) infinite; /* 12帧 ÷ 24fps = 0.5秒 */\r\n}\r\n\r\n@keyframes preview-play {\r\n  0% {\r\n    background-position: 0% 0%;\r\n  }\r\n  8.33% {\r\n    background-position: 33.333% 0%;\r\n  }\r\n  16.67% {\r\n    background-position: 66.667% 0%;\r\n  }\r\n  25% {\r\n    background-position: 100% 0%;\r\n  }\r\n  33.33% {\r\n    background-position: 0% 50%;\r\n  }\r\n  41.67% {\r\n    background-position: 33.333% 50%;\r\n  }\r\n  50% {\r\n    background-position: 66.667% 50%;\r\n  }\r\n  58.33% {\r\n    background-position: 100% 50%;\r\n  }\r\n  66.67% {\r\n    background-position: 0% 100%;\r\n  }\r\n  75% {\r\n    background-position: 33.333% 100%;\r\n  }\r\n  83.33% {\r\n    background-position: 66.667% 100%;\r\n  }\r\n  91.67% {\r\n    background-position: 100% 100%;\r\n  }\r\n  100% {\r\n    background-position: 0% 0%;\r\n  }\r\n}\r\n.tab-item {\r\n  min-width: 160px; /* tab 宽度可调 */\r\n  padding: 0 !important; /* 去掉默认 padding */\r\n}\r\n/* 针对所有滚动条 */\r\n::-webkit-scrollbar {\r\n  width: 3px; /* 垂直滚动条宽度 */\r\n  height: 8px; /* 水平滚动条高度 */\r\n}\r\n\r\n/* 滚动条轨道 */\r\n::-webkit-scrollbar-track {\r\n  background: #f1f1f1;\r\n  border-radius: 4px;\r\n}\r\n\r\n/* 滚动条滑块 */\r\n::-webkit-scrollbar-thumb {\r\n  background: #888;\r\n  border-radius: 4px;\r\n}\r\n\r\n/* 滑块 hover */\r\n::-webkit-scrollbar-thumb:hover {\r\n  background: #555;\r\n}\r\n.compact-range-slider {\r\n  --v-slider-track-size: 4px; /* 轨道厚度 */\r\n  --v-slider-thumb-size: 12px; /* 滑块直径 */\r\n  --v-slider-track-inactive-opacity: 0.2;\r\n  padding-top: 0 !important;\r\n  padding-bottom: 0 !important;\r\n  margin-top: -4px; /* 减少上下空白 */\r\n  margin-bottom: -14px;\r\n}\r\n\r\n.compact-range-slider .v-slider-track__container {\r\n  height: 4px !important;\r\n}\r\n\r\n.compact-range-slider .v-slider-thumb__surface {\r\n  width: 12px !important;\r\n  height: 12px !important;\r\n}\r\n.time-current,\r\n.time-total {\r\n  position: absolute;\r\n  bottom: 4px;\r\n  font-size: 0.75rem;\r\n  color: #fff;\r\n  background-color: rgba(0, 0, 0, 0.6);\r\n  padding: 2px 6px;\r\n  border-radius: 4px;\r\n}\r\n\r\n.time-current {\r\n  left: 6px;\r\n}\r\n\r\n.time-total {\r\n  right: 6px;\r\n}\r\n\r\n.v-card {\r\n  background-color: rgb(var(--v-theme-surface));\r\n  border: 1px solid #3a3a3a;\r\n  color: #e0e0e0;\r\n}\r\n\r\n.v-toolbar {\r\n  background-color: #2b2b2b !important;\r\n  border-bottom: 1px solid #333;\r\n}\r\n\r\n.v-slider-track__fill {\r\n  background-color: rgb(var(--v-theme-primary)) !important;\r\n}\r\n\r\n.v-slider-thumb {\r\n  border-color: rgb(var(--v-theme-primary)) !important;\r\n}\r\n\r\n.v-text-field input,\r\n.v-textarea textarea {\r\n  color: #e0e0e0 !important;\r\n}\r\n\r\n.v-data-table {\r\n  background-color: #1e1e1e !important;\r\n  color: #e0e0e0 !important;\r\n}\r\n\r\n.v-data-table-header {\r\n  background-color: #2b2b2b !important;\r\n}\r\n\r\n.v-data-table__tr:hover {\r\n  background-color: rgba(0, 188, 212, 0.1) !important;\r\n}\r\n\r\n/* 占位块视觉 */\r\n.library-placeholder,\r\n.timeline-placeholder,\r\n.property-placeholder {\r\n  background-color: #1e1e1e;\r\n  color: #9e9e9e;\r\n  border: 1px dashed #3a3a3a;\r\n  border-radius: 4px;\r\n  text-align: center;\r\n  padding: 40px 0;\r\n  font-size: 0.9rem;\r\n  user-select: none;\r\n}\r\n\r\n.timeline-row {\r\n  align-items: stretch !important; /* 保证所有列高度对齐 */\r\n}\r\n\r\n.timeline-col {\r\n  display: flex;\r\n  align-items: stretch;\r\n}\r\n\r\n.timeline,\r\n.paste-area {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n.selected-item {\r\n  background-color: rgba(33, 150, 243, 0.15); /* 浅蓝色透明背景 */\r\n  border-left: 3px solid #2196f3; /* 左侧加一点标识线，可选 */\r\n  transition: background-color 0.2s ease;\r\n}\r\n\r\n.v-list-item:hover {\r\n  background-color: rgba(33, 150, 243, 0.08); /* 悬停时淡蓝 */\r\n}\r\n</style>\r\n","export var types = ['国内录音版','国外下载版'];\r\nexport var list_language_cn = [\r\n    { locale: 'zh-CN', localeName: '中文(中国)' },\r\n    { locale: 'zh-CN-liaoning', localeName: '中文(辽宁)' },\r\n    { locale: 'zh-CN-shaanxi', localeName: '中文(陕西)' },\r\n    { locale: 'zh-TW', localeName: '中文(台湾)' },\r\n    { locale: 'zh-HK', localeName: '中文(香港)' },\r\n    { locale: 'en-US', localeName: '英语(美国)' },\r\n    { locale: 'en-AU', localeName: '英语(澳大利亚)' },\r\n    { locale: 'en-CA', localeName: '英语(加拿大)' },\r\n    { locale: 'en-HK', localeName: '英语(香港)' },\r\n    { locale: 'en-IN', localeName: '英语(印度)' },\r\n    { locale: 'en-IE', localeName: '英语(爱尔兰)' },\r\n    { locale: 'en-KE', localeName: '英语(肯尼亚)' },\r\n    { locale: 'en-NZ', localeName: '英语(新西兰)' },\r\n    { locale: 'en-NG', localeName: '英语(尼日利亚)' },\r\n    { locale: 'en-PH', localeName: '英语(菲律宾)' },\r\n    { locale: 'en-SG', localeName: '英语(新加坡)' },\r\n    { locale: 'en-ZA', localeName: '英语(南非)' },\r\n    { locale: 'en-TZ', localeName: '英语(坦桑尼亚)' },\r\n    { locale: 'en-GB', localeName: '英语(英国)' },\r\n    { locale: 'af-ZA', localeName: '南非荷兰语(南非)' },\r\n    { locale: 'sq-AL', localeName: '阿尔巴尼亚语(阿尔巴尼亚)' },\r\n    { locale: 'am-ET', localeName: '阿姆哈拉语(埃塞俄比亚)' },\r\n    { locale: 'ar-DZ', localeName: '阿拉伯语(阿尔及利亚)' },\r\n    { locale: 'ar-BH', localeName: '阿拉伯语(巴林)' },\r\n    { locale: 'ar-EG', localeName: '阿拉伯语(埃及)' },\r\n    { locale: 'ar-IQ', localeName: '阿拉伯语(伊拉克)' },\r\n    { locale: 'ar-