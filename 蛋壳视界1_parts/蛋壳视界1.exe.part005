MP3\",\r\n  missingAudioFiles: \"{count} clips are missing audio files.\",\r\n  missingVideoFiles: \"{count} clips are missing video files.\",\r\n  fileExistsWarning: \"File already exists. Overwrite?\",\r\n  resetPassword: \"Reset Password\",\r\n  currentPassword: \"Current Password\",\r\n  newPassword: \"New Password\",\r\n  confirmNewPassword: \"Confirm New Password\",\r\n  resetPasswordSuccess: \"Password has been successfully updated\",\r\n  resetPasswordFailed: \"Failed to update password\",\r\n  resetPasswordException: \"Password update exception\",\r\n  forgetPassword: \"Forgot password?\",\r\n  \r\n  changePasswordSuccess: \"Password has been successfully updated\",\r\n  changePasswordFailed: \"Failed to update password\",\r\n  changePasswordException: \"Password update exception\",\r\n\r\n  learnVideoTitle: \"Create a Video in Just 5 Simple Steps\",\r\n  learnVideoSubtitle: \"DeepSeek + ShellVision Vision makes video creation easy for everyone.\",\r\n\r\n  step1Title: \"1 Generate Copy\",\r\n  step1Subtitle:\r\n    \"Locate a video you wish to imitate and copy its link. \\n\\nUsing appropriate tools, search for “YouTube video download” to download the video. \\n\\nUtilize “AI Speech Recognition” tool to transcribe the video to text. \\n\\nFinally, input this text into ChatGPT for automated copy generation.\",\r\n  step1Button: \"AI Speech Recognition\",\r\n\r\n  step2Title: \"2 Download Resources\",\r\n  step2Subtitle: \"Google search “MovieName 720p torrent” to find downloadable movie resources.\\n\\nUse AI to analyze and segment long videos automatically.\",\r\n  step2Button: \"AI Long Video Analysis\",\r\n\r\n  step3Title: \"3 Composite Video\",\r\n  step3Subtitle:\r\n    \"Import the copy and video clips into “Eggshell Vision” to synthesize a video.\",\r\n\r\n  settingsLabel: \"Settings\",\r\n  changePassword: \"Change Password\",\r\n  backToLogin: \"Back\",\r\n  addScene: \"add\",\r\n  replaceScene: \"replace\",\r\n};\r\n","import { createI18n } from 'vue-i18n'\r\nimport zh from './zh'\r\nimport en from './en'\r\n\r\nconst i18n = createI18n({\r\n  legacy: false, // composition API 模式\r\n  locale: 'zh', // 默认语言\r\n  fallbackLocale: 'en',\r\n  messages: {\r\n    zh,\r\n    en\r\n  }\r\n})\r\n\r\nexport default i18n\r\nexport const i18nInstance = i18n.global","// src/plugins/vuetify.js\r\nimport 'vuetify/styles'\r\nimport { createVuetify } from 'vuetify'\r\nimport * as components from 'vuetify/components'\r\nimport * as directives from 'vuetify/directives'\r\nimport { aliases, mdi } from 'vuetify/iconsets/mdi-svg'\r\nimport { VNumberInput } from 'vuetify/labs/VNumberInput'\r\n\r\nconst myThemes = {\r\n  // 1. 简洁清新\r\n  lightClean: {\r\n    dark: false,\r\n    colors: {\r\n      background: '#FFFFFF',\r\n      surface: '#F9FAFB',\r\n      primary: '#5B8DEF',\r\n      secondary: '#A78BFA',\r\n      accent: '#F3F4F6',\r\n      error: '#EF4444',\r\n      info: '#3B82F6',\r\n      success: '#10B981',\r\n      warning: '#F59E0B',\r\n    },\r\n  },\r\n\r\n  // 2. 柔和轻盈\r\n  lightSoft: {\r\n    dark: false,\r\n    colors: {\r\n      background: '#FFFCF9',\r\n      surface: '#FFF7F5',\r\n      primary: '#FB7185',\r\n      secondary: '#FBBF24',\r\n      accent: '#FEF3C7',\r\n      error: '#DC2626',\r\n      info: '#60A5FA',\r\n      success: '#34D399',\r\n      warning: '#F97316',\r\n    },\r\n  },\r\n\r\n  // 3. 极简现代\r\n  lightMinimal: {\r\n    dark: false,\r\n    colors: {\r\n      background: '#FFFFFF',\r\n      surface: '#F3F4F6',\r\n      primary: '#2563EB',\r\n      secondary: '#9CA3AF',\r\n      accent: '#E5E7EB',\r\n      error: '#DC2626',\r\n      info: '#3B82F6',\r\n      success: '#16A34A',\r\n      warning: '#D97706',\r\n    },\r\n  },\r\n\r\n  // 4. 暗色海洋\r\n  darkOcean: {\r\n    dark: true,\r\n    colors: {\r\n      background: '#0F172A',\r\n      surface: '#1E293B',\r\n      primary: '#3B82F6',\r\n      secondary: '#6366F1',\r\n      accent: '#64748B',\r\n      error: '#F87171',\r\n      info: '#38BDF8',\r\n      success: '#22C55E',\r\n      warning: '#FACC15',\r\n    },\r\n  },\r\n\r\n  // 5. 柔和粉彩\r\n  pastel: {\r\n    dark: false,\r\n    colors: {\r\n      background: '#FFF1F3',\r\n      surface: '#FFFAF0',\r\n      primary: '#A7F3D0',\r\n      secondary: '#FBCFE8',\r\n      accent: '#E0E7FF',\r\n      error: '#FCA5A5',\r\n      info: '#93C5FD',\r\n      success: '#6EE7B7',\r\n      warning: '#FDE68A',\r\n    },\r\n  },\r\n\r\n  // 6. 活泼亮色\r\n  vivid: {\r\n    dark: false,\r\n    colors: {\r\n      background: '#FFFFFF',\r\n      surface: '#F0F0F0',\r\n      primary: '#FF3D00',\r\n      secondary: '#FFD600',\r\n      accent: '#00E676',\r\n      error: '#D50000',\r\n      info: '#2962FF',\r\n      success: '#00C853',\r\n      warning: '#FFAB00',\r\n    },\r\n  },\r\n\r\n  // 7. 工业科技风\r\n  techDark: {\r\n    dark: true,\r\n    colors: {\r\n      background: '#121212',\r\n      surface: '#1E1E1E',\r\n      primary: '#BB86FC',\r\n      secondary: '#03DAC6',\r\n      accent: '#CF6679',\r\n      error: '#CF6679',\r\n      info: '#2196F3',\r\n      success: '#4CAF50',\r\n      warning: '#FF9800',\r\n    },\r\n  },\r\n\r\n  // 8. 森林自然风\r\n  forest: {\r\n    dark: false,\r\n    colors: {\r\n      background: '#F0FFF4',\r\n      surface: '#E6FFFA',\r\n      primary: '#2F855A',\r\n      secondary: '#68D391',\r\n      accent: '#B2F5EA',\r\n      error: '#E53E3E',\r\n      info: '#319795',\r\n      success: '#38A169',\r\n      warning: '#D69E2E',\r\n    },\r\n  },\r\n  // 9. Premiere 专业暗色风格\r\n  premiereDark: {\r\n    dark: true,\r\n    colors: {\r\n      background: '#1A1A1A',   // 整体背景\r\n      surface: '#2B2B2B',      // 面板表面\r\n      primary: '#00BCD4',      // 青蓝色高亮\r\n      secondary: '#8E24AA',    // 紫色辅助\r\n      accent: '#3949AB',       // 蓝紫强调\r\n      error: '#E53935',\r\n      info: '#29B6F6',\r\n      success: '#66BB6A',\r\n      warning: '#FFA726',\r\n    },\r\n  },\r\n}\r\n\r\nconst vuetify = createVuetify({\r\n  components: {\r\n    ...components,\r\n    VNumberInput, // ✅ 注册实验性组件\r\n  },\r\n  directives,\r\n  icons: {\r\n    aliases: { ...aliases, },\r\n    defaultSet: 'mdi',\r\n    sets: { mdi },\r\n  },\r\n  theme: {\r\n    defaultTheme: 'premiereDark', // 默认启用简洁清新\r\n    themes: myThemes,\r\n  },\r\n})\r\n\r\nexport default vuetify\r\n","// src/main.js\nimport { createApp, reactive } from 'vue'\nimport App from './App.vue'\nimport router from './router'\nimport aardio from 'aardio'\nimport i18n from './locales/i18n'\n\n// 事件总线\nimport mitt from 'mitt'\nconst emitter = mitt()\n\n// vuetify\nimport vuetify from './plugins/vuetify'\nimport './styles/overrides.css'\n\nconst app = createApp(App)\n\n// ⭐ 创建响应式 license 状态\nconst license = reactive({\n  username: '',\n  machineCode: '',\n  serverToken: ''\n})\n\n// 挂载到全局\napp.config.globalProperties.$license = license\n\n// 提供给 Composition API\napp.provide('license', license)\n\n// 提供事件总线\napp.provide('emitter', emitter)\n\napp.use(i18n)\napp.use(router)\napp.use(vuetify)\n\n\n// ===============================\n// 全局路由守卫\n// ===============================\n\nconst publicPages = [\n  '/login',\n  '/register',\n  '/reset-password',\n  '/change-password',\n  '/edit-video'\n]\n\nrouter.beforeEach(async (to, from, next) => {\n  if(to.query.justLogin !== '1' || to.query.justLogin === '1') return next()\n  // 不需要验证的页面\n  if (publicPages.includes(to.path) || to.query.justLogin === '1') {\n    return next()\n  }\n\n  try {\n\n    // 调用本地授权验证\n    const verifyResultRaw = await Promise.resolve(aardio.verifyLicense())\n    const result = JSON.parse(verifyResultRaw)\n\n    switch (result.code) {\n      case 'SUCCESS':\n      case 'OK':\n        // 更新全局 license\n        license.username = result.username\n        license.machineCode = result.machineCode\n        license.serverToken = result.serverToken\n        return next()\n      case 'VerifySUCCESS':\n        // 保存本地 license\n        await aardio.saveLocalKey(\n          result.username,\n          result.machineCode,\n          result.serverToken\n        )\n        // 更新全局 license\n        license.username = result.username\n        license.machineCode = result.machineCode\n        license.serverToken = result.serverToken\n        return next()\n\n      case 'TOO_MANY_DEVICES':\n      case 'LICENSE_INVALID':\n      case 'MACHINE_MISMATCH':\n      case 'USER_DISABLED':\n      case 'USER_NOT_FOUND':\n        console.error('License error:', result.message)\n        return next('/login')\n\n      default:\n        console.error('Unknown license status:', result)\n        return next('/login')\n    }\n\n  } catch (err) {\n\n    console.error('License verification exception:', err)\n\n    return next('/login')\n  }\n})\n\napp.mount('#app')","// The module cache\nvar __webpack_module_cache__ = {};\n\n// The require function\nfunction __webpack_require__(moduleId) {\n\t// Check if module is in cache\n\tvar cachedModule = __webpack_module_cache__[moduleId];\n\tif (cachedModule !== undefined) {\n\t\treturn cachedModule.exports;\n\t}\n\t// Create a new module (and put it into the cache)\n\tvar module = __webpack_module_cache__[moduleId] = {\n\t\tid: moduleId,\n\t\tloaded: false,\n\t\texports: {}\n\t};\n\n\t// Execute the module function\n\t__webpack_modules__[moduleId].call(module.exports, module, module.exports, __webpack_require__);\n\n\t// Flag the module as loaded\n\tmodule.loaded = true;\n\n\t// Return the exports of the module\n\treturn module.exports;\n}\n\n// expose the modules object (__webpack_modules__)\n__webpack_require__.m = __webpack_modules__;\n\n","var deferred = [];\n__webpack_require__.O = function(result, chunkIds, fn, priority) {\n\tif(chunkIds) {\n\t\tpriority = priority || 0;\n\t\tfor(var i = deferred.length; i > 0 && deferred[i - 1][2] > priority; i--) deferred[i] = deferred[i - 1];\n\t\tdeferred[i] = [chunkIds, fn, priority];\n\t\treturn;\n\t}\n\tvar notFulfilled = Infinity;\n\tfor (var i = 0; i < deferred.length; i++) {\n\t\tvar chunkIds = deferred[i][0];\n\t\tvar fn = deferred[i][1];\