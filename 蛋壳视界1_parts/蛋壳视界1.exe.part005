ioPendingLabel: \"音频待生成\",\r\n  videoPendingLabel: \"视频待生成\",\r\n  batchAudioGenerating: \"正在批量生成音频\",\r\n  batchVideoGenerating: \"正在批量生成视频\",\r\n  projectPathLabel: \"项目路径\",\r\n  pasteHintPrefix: \"复制视频/图片\",\r\n  pasteButton: \"粘贴\",\r\n  pasteHintSuffix: \"\",\r\n  contentLabel: \"正文\",\r\n  commentLabel: \"备注\",\r\n  noteTooltip: \"这只是一份备注，有时正文使用外语，那么备注就可以是中文翻译，方便我们阅读\",\r\n  rateLabel: \"语速\",\r\n  speedLabel: \"加速\",\r\n  pauseBeforeLabel: \"句前停顿\",\r\n  pauseAfterLabel: \"句后停顿\",\r\n  languageLabel: \"语言\",\r\n  voiceLabelShort: \"播音员\",\r\n  zoomIn: \"放大\",\r\n  zoomOut: \"缩小\",\r\n  moveUp: \"上移\",\r\n  moveDown: \"下移\",\r\n  moveLeft: \"左移\",\r\n  moveRight: \"右移\",\r\n  reverseLabel: \"倒放\",\r\n  growFrameLabel: \"渐近\",\r\n  horizontalFlipLabel: \"水平翻转\",\r\n  originalVolumeLabel: \"原音\",\r\n  confirmAppendORAdd:\r\n    '当前已存在相邻片段，您可以将本片段拼接到相邻片段的后面，是否拼接？\\n\\n点击\"确定\"拼接，点击\"取消\"添加新片段',\r\n  invalidResponseFormat: \"返回数据格式错误\",\r\n  loginFailedCheckCredentials: \"登录失败，请检查用户名或密码。\",\r\n  loginException: \"登录异常\",\r\n\r\n  userRegistration: \"用户注册\",\r\n  phoneNumber: \"手机号\",\r\n  password: \"密码\",\r\n  confirmPassword: \"确认密码\",\r\n  licenseCode: \"注册码\",\r\n  referralCode: \"邀请码\",\r\n  userLogin: \"用户登录\",\r\n  login:\"登录\",\r\n  register: \"注册\",\r\n  backToHomePage: \"取消\",\r\n  phoneEmpty: \"手机号不能为空\",\r\n  invalidPhone: \"请输入有效的手机号\",\r\n  passwordEmpty: \"密码不能为空\",\r\n  passwordMismatch: \"两次输入的密码不一致\",\r\n  currentPasswordEmpty: \"请输入当前密码。\",\r\n  licenseCodeEmpty: \"请输入注册码。\",\r\n  referralCodeEmpty: \"请输入邀请码。\",\r\n  registrationSuccess: \"注册成功，请登录。\",\r\n  registrationFailed: \"注册失败，请重试。\",\r\n  registrationException: \"注册异常\",\r\n\r\n  NoFilesAvailableForExport: \"没有可导出的文件\",\r\n  ExportSuccess: \"导出成功\",\r\n  FileNotExist: \"文件不存在\",\r\n  NoTextContent: \"无文本内容\",\r\n  ImportingLibrary: \"正在导入素材库...\",\r\n  presetSettings: \"快捷设置\",\r\n  clearAudioMedia: \"同时清除已有音频\",\r\n  clearVideoMedia: \"同时清除已有视频\",\r\n  deleteConfirmText: \"您确定要删除选中的 {count} 个片段吗？\",\r\n  remainingClips: \"还有 {count} 个片段...\",\r\n  videoMP4: \"视频 MP4\",\r\n  audioMP3: \"音频 MP3\",\r\n  missingAudioFiles: \"有 {count} 个片段缺少音频文件。\",\r\n  missingVideoFiles: \"有 {count} 个片段缺少视频文件。\",\r\n  fileExistsWarning: \"文件已存在，是否覆盖？\",\r\n  resetPassword: \"重置密码\",\r\n  currentPassword: \"当前密码\",\r\n  newPassword: \"新密码\",\r\n  confirmNewPassword: \"确认新密码\",\r\n  resetPasswordSuccess: \"密码已成功修改\",\r\n  resetPasswordFailed: \"密码修改失败\",\r\n  resetPasswordException: \"密码修改请求异常\",\r\n  forgetPassword: \"忘记密码？\",\r\n  \r\n  changePasswordSuccess: \"密码已成功修改\",\r\n  changePasswordFailed: \"密码修改失败\",\r\n  changePasswordException: \"密码修改请求异常\",\r\n\r\n  learnVideoTitle: \"做视频只需简单3步\",\r\n  learnVideoSubtitle: \"DeepSeek + 蛋壳视界，让小白也能轻松做视频。\",\r\n\r\n  step1Title: \"1、生成文案\",\r\n  step1Subtitle: \"在某平台找到想要模仿的视频，复制视频链接。\\n\\n科学上网，搜索“Youtube视频下载”、“抖音视频下载”，下载视频。\\n\\n使用“AI语音识别”工具将视频语音转换为文本。\\n\\n将文本喂给DeepSeek或ChatGPT，自动生成文案。\",\r\n  step1Button: \"AI语音识别\",\r\n\r\n  step2Title: \"2、资源下载\",\r\n  step2Subtitle: \"电影资源下载：科学上网，搜索“电影名 720p torrent”。\\n\\n其他资源下载：“共享网盘”工具。\\n\\n如果视频太长，使用“AI长视频切片分析”工具进行切割。\",\r\n  step2Button: \"AI视频切片\",\r\n\r\n  step3Title: \"3、合成视频\",\r\n  step3Subtitle: \"把文案和视频切片输入“蛋壳视界”，合成视频。\",\r\n\r\n  settingsLabel: \"设置\",\r\n  changePassword: \"修改密码\",\r\n  backToLogin: \"返回\",\r\n  addScene: \"添加\",\r\n  replaceScene: \"替换\",\r\n};\r\n","export default {\r\n  mainSlogan: \"Eggshell Vision\",\r\n  secondSlogan: \"Your video starter pack: Powered by AI. Made for beginners.\",\r\n  newVideoProject: \"New Video Project\",\r\n  projectName: \"Project Name\",\r\n  path: \"Path\",\r\n  browseButton: \"Browse\",\r\n  width: \"Width\",\r\n  height: \"Height\",\r\n  selectResolutionTemplate: \"Select Resolution Template\",\r\n  cancel: \"Cancel\",\r\n  confirm: \"Confirm\",\r\n  landscape1280x720: \"Landscape 1280 x 720\",\r\n  landscape1920x1080: \"Landscape 1920 x 1080\",\r\n  portrait720x1280: \"Portrait 720 x 1280\",\r\n  portrait1080x1920: \"Portrait 1080 x 1920\",\r\n  chooseReferenceVideo: \"Choose reference video\",\r\n  videoFileFilter: \"Video files|*.mp4;*.mkv;*.avi\",\r\n  enterProjectName: \"Please enter a project name\",\r\n  invalidCharacters: \"Name contains invalid characters: \\\\ / : * ? \\\" < > |\",\r\n  mustBePositiveInteger: \" must be a positive integer of at least 200\",\r\n  enterValidProjectName: \"Please enter a valid project name.\",\r\n  enterValidWidth: \"Please enter a valid width.\",\r\n  enterValidHeight: \"Please enter a valid height.\",\r\n  projectAlreadyExists: \"A project with the same name already exists in this directory.\",\r\n\r\n  addNewClip: \"Add New Clip\",\r\n  bodyText: \"Main Text\",\r\n  comment: \"Comment\",\r\n  commentTooltip:\r\n    \"This is just a note. If the main text is in a foreign language, you can write the Chinese translation here for easier understanding.\",\r\n  rate: \"Speech Rate\",\r\n  speed: \"Acceleration\",\r\n  pauseBefore: \"Pause Before Sentence\",\r\n  pauseAfter: \"Pause After Sentence\",\r\n  language: \"Language\",\r\n  speaker: \"Speaker\",\r\n  autoSplitSentences: \"Auto Split Sentences\",\r\n  insertClipMode: \"Insert Mode\",\r\n  appendClipBelow: \"Append\",\r\n  insertClipAtPosition: \"Insert\",\r\n\r\n  batchEditClips: \"Batch Edit Clips\",\r\n  selectedTextContent: \"Selected Text Content\",\r\n  quickPreset: \"Quick Preset\",\r\n  apply: \"Apply\",\r\n\r\n  confirmDeletePrompt: \"Are you sure you want to delete the selected\",\r\n  clipsCountSuffix: \"clips?\",\r\n  irreversibleWarning: \"This action cannot be undone. Please proceed carefully.\",\r\n  moreClipsHint: \"More clips...\",\r\n\r\n  exportClips: \"Export Clips\",\r\n  exportType: \"Export Type\",\r\n  videoMp4: \"Video MP4\",\r\n  audioMp3: \"Audio MP3\",\r\n  missingAudioWarning: \"{count} audio clips are missing:\",\r\n  missingVideoWarning: \"{count} video clips are missing:\",\r\n  ignoreAndContinue: \"Ignore and Continue\",\r\n  noAudioToExport: \"No audio files available for export\",\r\n  noVideoToExport: \"No video files available for export\",\r\n  backgroundMusic: \"Background Music\",\r\n  browse: \"Browse\",\r\n  backgroundMusicVolume: \"Background Music Volume\",\r\n  savePath: \"Save Path\",\r\n  fileExists: \"File already exists:\",\r\n  overwritePrompt: \"Overwrite this file?\",\r\n  exportInProgress: \"Exporting... {progress}%\",\r\n  exportSuccess: \"Export completed successfully!\",\r\n  exportFailed: \"Export failed!\",\r\n  noFilesToExport: \"No files to export!\",\r\n\r\n  audioGenerationCancelled: \"Audio generation cancelled\",\r\n  waveformContainerNotReady: \"Waveform container not ready, retrying...\",\r\n  selectMaterialFile: \"Select Material File\",\r\n  importingMaterialLibrary: \"Importing Material Library...\",\r\n  segmentMerged: \"Segments merged successfully\",\r\n  mergeAdjacentSegmentPrompt:\r\n    \"The new segment is adjacent to the last one. Merge them?\",\r\n  previewFailed: \"Preview failed\",\r\n\r\n  backToHome: \"Back to Home\",\r\n  returnToHomeTooltip: \"Return to home\",\r\n  loadingOverlayText: \"Loading...\",\r\n  save: \"Save\",\r\n  saveTooltip: \"Save\",\r\n  saveSuccessToast: \"Project saved successfully.\",\r\n  settings: \"Settings\",\r\n  settingsTooltip: \"Settings\",\r\n  add: \"Add\",\r\n  addTooltip: \"Add\",\r\n  edit: \"Edit\",\r\n  editTooltip: \"Edit\",\r\n  delete: \"Delete\",\r\n  deleteTooltip: \"Delete\",\r\n  generateAudio: \"Generate Audio\",\r\n  generateAudioTooltip: \"Generate Audio\",\r\n  generateAudioButton: \"Audio Gen\",\r\n  generateVideo: \"Generate Video\",\r\n  generateVideoTooltip: \"Generate Video\",\r\n  play: \"Play\",\r\n  stop: \"Stop\",\r\n  refresh: \"Refresh\",\r\n  openFolder: \"Open Folder\",\r\n  export: \"Export\",\r\n  exportTooltip: \"Export\",\r\n  openRecentTitle: \"Open Recent\",\r\n  searchTooltip: \"Search\",\r\n  moreOptionsTooltip: \"More options\",\r\n  getStartedTitle: \"Get Started\",\r\n  createProjectTooltip: \"Create a new video project\",\r\n  createProjectCardTitle: \"New Project\",\r\n  createProjectCardSubtitle: \"Create AI Voice and Visuals.\",\r\n  openProjectTooltip: \"Open an existing project\",\r\n  openProjectCardTitle: \"Open Project\",\r\n  openProjectCardSubtitle: \"Open a local JSON project file.\",\r\n  themeLabel: \"Theme\",\r\n  unnamedProject: \"Untitled Project\",\r\n  checkProjectFail: \"Failed to check project: {path}\",\r\n  loadRecentFail: \"Failed to load recent projects.\",\r\n  updateRecentFail: \"Failed to update recent projects.\",\r\n  secondsAgo: \" seconds ago\",\r\n  minutesAgo: \" minutes ago\",\r\n  hoursAgo: \" hours ago\",\r\n  loadingText: \"Loading...\",\r\n\r\n  timeoutAlertLabel: \"Timeout Reminder\",\r\n  timeoutAlertTooltip:\r\n    \"When using copyrighted video clips, if a clip is too long it may be detected by platforms — set a timeout reminder to avoid this.\",\r\n  smartAdjust: \"Smart Adjust\",\r\n  enableTooltipsLabel: \"Enable Tooltips\",\r\n  close: \"Close\",\r\n\r\n  selectAll: \"Select all\",\r\n  searchFilter: \"Search / Filter\",\r\n  voice: \"Voice\",\r\n  audioPending: \"Audio pending\",\r\n  videoPending: \"Video pending\",\r\n  noTextContent: \"No text content\",\r\n  generatingAudioNow: \"Generating audio\",\r\n  generatingVideoNow: \"Generating video\",\r\n  projectPath: \"Project Path\",\r\n  pasteHintCtrlV: \"Press Ctrl+V or\",\r\n  pasteClick: \"Click\",\r\n  pasteVideoOrImage: \"to paste video or image\",\r\n  noAudioPleaseGenerate: \"No audio yet, please generate audio\",\r\n  content: \"Content\",\r\n  times: \"x\",\r\n  seconds: \"s\",\r\n  longVideoSlices: \"Long video slices\",\r\n  importingLibrary: \"Importing library...\",\r\n  importingSegments: \"Importing segments\",\r\n  batchAudioProgressText: \"Batch generating audio\",\r\n  batchVideoProgressText: \"Batch generating video\",\r\n  cancelBatchAudioButton: \"Cancel\",\r\n  cancelBatchVideoButton: \"Cancel\",\r\n  progressLabel: \"Progress:\",\r\n  add